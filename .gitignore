.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# large / re-fetchable sources (checksums are in sources/manifest.json)
sources/nexus/
sources/_clones/
sources/dpv/
sources/aiid/
sources/avid/
# staged incidents hold CC BY-SA text from AIID (see config: sources.aiid)
staging/incidents.csv
# secrets
.env
sources/manual/beam_core.ttl
# LLM extractors: response caches and prompt previews (never commit)
extractor/*/cache/
extractor/*/output/prompts_preview/
# profiles and motif proposals quote AIID text (CC BY-SA 4.0); keep them out of the repository
extractor/llm_motif/output/profiles.jsonl
extractor/llm_motif/output/motifs.jsonl
extractor/llm_motif/output/*.md
site/*
!site/.gitkeep
# local working notes (survey, decisions, issues, full changelog) - not pushed
doc_local/
