{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/airkg/llm_mitigation/response.schema.json",
  "title": "Mitigation links proposed for one risk",
  "type": "object",
  "properties": {
    "links": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "mitigation_id": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "required": ["mitigation_id", "confidence", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": ["links"],
  "additionalProperties": false
}
