@prefix :    <http://example.org/airkg#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### -- SHACL Example


:RiskShape a sh:NodeShape ;
    sh:targetClass :Risk ;
    sh:property [
        sh:path :affects ;
        sh:class :Stakeholder
    ] .

:RiskMotifShape a sh:NodeShape ;
    sh:targetClass :RiskMotif ;
    sh:property [
        sh:path :indicatesRisk ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class :Risk ;
    ] ;
    sh:property [
        sh:path :hasManifestCondition ;
        sh:class :Element ;
    ] ;
    sh:property [
        sh:path :inContext ;
        sh:minCount 1 ;
        sh:class :Context ;
    ] ;
    sh:sparql [
        sh:message " Location {?value} is not an element of this motif's context {$this}." ;
        sh:prefixes :airkgPrefixes ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this :hasManifestCondition ?value .
                FILTER NOT EXISTS {
                    $this :inContext ?context .
                    ?context a :ArchitecturalContext ;
                             :hasElement $value .
                }
            }
        """ ;
    ] .


:ArchitecturalContextShape a sh:NodeShape ;
    sh:targetClass :ArchitecturalContext ;
    sh:property [
        sh:path :hasElement ;
        sh:minCount 2 ;
        sh:class :Element
    ] .


:AIWorkflowShape a sh:NodeShape ;
    sh:targetClass :AIWorkflow ;
    sh:property [ sh:path :hasArchitecturalContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :ArchitecturalContext ] ;
    sh:property [ sh:path :hasApplicationContext ; sh:class :ApplicationContext ] ;
    sh:property [ sh:path :isWorkflowOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class :AISystem ] .


:MotifDetectionShape a sh:NodeShape ;
    sh:targetClass :AIWorkflow ;
    sh:severity sh:Info ;
    sh:sparql[
        sh:message "Workflow matches risk motif {?value}, which indicates risk \"{?riskName}\" ({?risk}); it manifests at {?location}." ;
        sh:prefixes :airkgPrefixes;
        sh:select """
            SELECT $this ?value ?risk ?riskName ?location
            WHERE {
                ?value a :RiskMotif ;
                       :indicatesRisk ?risk .
                OPTIONAL { ?risk :name ?rn }
                BIND (COALESCE(?rn, STR(?risk)) AS ?riskName)

                # 1. CONTEXT: no required application context is missing
                FILTER NOT EXISTS {
                    ?value :inContext ?ctx .
                    ?ctx a/rdfs:subClassOf* :ApplicationContext .
                    FILTER NOT EXISTS {
                        { $this :hasApplicationContext ?ctx }
                        UNION
                        { $this :isWorkflowOf/:hasContext ?ctx }
                    }
                }

                # 2. ELEMENTS: no template element without a matching workflow element
                FILTER NOT EXISTS {
                    ?value :inContext ?arch .
                    ?arch a :ArchitecturalContext ;
                          :hasElement ?t .
                    ?t a ?tType .
                    ?tType rdfs:subClassOf* :Element .
                    FILTER NOT EXISTS {
                        $this :hasArchitecturalContext/:hasElement ?e .
                        ?e a/rdfs:subClassOf* ?tType .
                    }
                }

                # 3. FLOWS: no template uses/produces relation without a matching workflow relation
                FILTER NOT EXISTS {
                    ?value :inContext ?arch2 .
                    ?arch2 a :ArchitecturalContext ;
                           :hasElement ?t1 , ?t2 .
                    ?t1 ?p ?t2 .
                    FILTER (?p IN (:uses, :produces))
                    ?t1 a ?t1Type . ?t1Type rdfs:subClassOf* :Element .
                    ?t2 a ?t2Type . ?t2Type rdfs:subClassOf* :Element .
                    FILTER NOT EXISTS {
                        $this :hasArchitecturalContext/:hasElement ?e1 , ?e2 .
                        ?e1 ?p ?e2 .
                        ?e1 a/rdfs:subClassOf* ?t1Type .
                        ?e2 a/rdfs:subClassOf* ?t2Type .
                    }
                }

                # 4. LOCATION: the workflow element(s) where the risk manifests.
                OPTIONAL {
                    ?value :hasManifestCondition ?mc .
                    ?mc a ?mcType .
                    ?mcType rdfs:subClassOf* :Element .
                    $this :hasArchitecturalContext/:hasElement ?location .
                    ?location a/rdfs:subClassOf* ?mcType .
                    FILTER NOT EXISTS {
                        ?mc ?q ?n .
                        FILTER (?q IN (:uses, :produces))
                        ?n a ?nType . ?nType rdfs:subClassOf* :Element .
                        FILTER NOT EXISTS {
                            $this :hasArchitecturalContext/:hasElement ?ln .
                            ?location ?q ?ln .
                            ?ln a/rdfs:subClassOf* ?nType .
                        }
                    }
                    FILTER NOT EXISTS {
                        ?n2 ?q2 ?mc .
                        FILTER (?q2 IN (:uses, :produces))
                        ?n2 a ?n2Type . ?n2Type rdfs:subClassOf* :Element .
                        FILTER NOT EXISTS {
                            $this :hasArchitecturalContext/:hasElement ?ln2 .
                            ?ln2 ?q2 ?location .
                            ?ln2 a/rdfs:subClassOf* ?n2Type .
                        }
                    }
                }
            }
        """ ;
    ] .


:airkgPrefixes a owl:Ontology ;
    sh:declare [ sh:prefix "" ;     sh:namespace "http://example.org/airkg#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

