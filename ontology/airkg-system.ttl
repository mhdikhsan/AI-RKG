                      :name "Ticket embedding model" ;
                      :version "2.1" .


###  http://example.org/airkg#TicketIndexingWorkflow
:TicketIndexingWorkflow rdf:type owl:NamedIndividual ,
                                 :AISystemWorkflow ;
                        :addressesTask :InformationRetrievalTask ;
                        :containsMotif :DocumentIndexingMotif ,
                                       :SourceDataPreparationMotif ,
                                       :SourceDataRepresentationMotif ;
                        :hasAutonomyLevel :HumanSupervises ;
                        :hasDeploymentEnvironment :InternalTool ;
                        :hasInput :SupportTicketArchive ;
                        :hasOutput :TicketVectorIndex ;
                        :hasProcess :EmbedTickets ;
                        :hasTechnicalObjective :KeepIndexCurrent ;
