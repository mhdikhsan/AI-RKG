###  http://example.org/airkg#IndexFreshness
:IndexFreshness rdf:type owl:NamedIndividual ,
                         :TechnicalSuccessCriterion ;
                :description "Share of closed tickets that are in the index within 24 hours." ;
                :metric "tickets indexed within 24 hours" ;
                :name "Index freshness" ;
                :targetValue 99.0 ;
                :unit "percent" .


###  http://example.org/airkg#KeepIndexCurrent
