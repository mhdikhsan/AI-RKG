@prefix : <http://example.org/airkg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/airkg#> .

<http://example.org/airkg/system> rdf:type owl:Ontology ;
                                   owl:imports <http://example.org/airkg/core> ;
                                   rdfs:comment "Description of one AI system (system, workflows, components, business context) and the results of matching it against the core module (meetsCondition, containsMotif, hasRiskPattern, hasMitigationPattern)"@en ;
                                   rdfs:label "AI Risk Ontology - system module"@en ;
                                   owl:versionInfo 0.1 .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/airkg#addressesTask
:addressesTask rdf:type owl:ObjectProperty ;
               rdfs:domain :AISystemWorkflow ;
               rdfs:range :Task .


###  http://example.org/airkg#containsMotif
:containsMotif rdf:type owl:ObjectProperty ;
               rdfs:domain :AISystemWorkflow ;
               rdfs:range :Motif .


###  http://example.org/airkg#contributesTo
:contributesTo rdf:type owl:ObjectProperty ;
               rdfs:domain :TechnicalObjective ;
               rdfs:range :BusinessObjective .


###  http://example.org/airkg#hasAutonomyLevel
:hasAutonomyLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :AISystemWorkflow ;
                  rdfs:range :AutonomyLevel .


###  http://example.org/airkg#hasBusinessContext
:hasBusinessContext rdf:type owl:ObjectProperty ;
                    rdfs:domain :AISystem ;
                    rdfs:range :BusinessContext .


###  http://example.org/airkg#hasBusinessObjective
:hasBusinessObjective rdf:type owl:ObjectProperty ;
                      rdfs:domain :BusinessContext ;
                      rdfs:range :BusinessObjective .


###  http://example.org/airkg#hasBusinessProcess
:hasBusinessProcess rdf:type owl:ObjectProperty ;
                    rdfs:domain :BusinessContext ;
                    rdfs:range :BusinessProcess .


###  http://example.org/airkg#hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              owl:inverseOf :isComponentOf ;
              rdfs:domain :AISystem ;
              rdfs:range :AISystemComponent .


###  http://example.org/airkg#hasComponentRole
:hasComponentRole rdf:type owl:ObjectProperty ;
                  rdfs:domain :AISystemComponent ;
                  rdfs:range :ComponentRole .


###  http://example.org/airkg#hasDataType
:hasDataType rdf:type owl:ObjectProperty ;
             rdfs:domain :Data ;
             rdfs:range :DataType .


###  http://example.org/airkg#hasDeploymentEnvironment
:hasDeploymentEnvironment rdf:type owl:ObjectProperty ;
                          rdfs:domain :AISystemWorkflow ;
                          rdfs:range :DeploymentEnvironment .


###  http://example.org/airkg#hasDomain
:hasDomain rdf:type owl:ObjectProperty ;
           rdfs:domain :BusinessContext ;
           rdfs:range :Domain .


###  http://example.org/airkg#hasInput
:hasInput rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :involvesComponent ;
          rdfs:domain :AISystemWorkflow ;
          rdfs:range :Data .


###  http://example.org/airkg#hasMitigationPattern
:hasMitigationPattern rdf:type owl:ObjectProperty ;
                      rdfs:domain :AISystemWorkflow ;
                      rdfs:range :MitigationPattern .


###  http://example.org/airkg#hasOutput
:hasOutput rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :involvesComponent ;
           rdfs:domain :AISystemWorkflow ;
           rdfs:range :Data .


###  http://example.org/airkg#hasProcess
:hasProcess rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :involvesComponent ;
            rdfs:domain :AISystemWorkflow ;
            rdfs:range :Process .


###  http://example.org/airkg#hasPurpose
:hasPurpose rdf:type owl:ObjectProperty ;
            rdfs:domain :AISystem ;
            rdfs:range :Purpose .


###  http://example.org/airkg#hasRiskPattern
:hasRiskPattern rdf:type owl:ObjectProperty ;
                rdfs:domain :AISystemWorkflow ;
                rdfs:range :RiskPattern .


###  http://example.org/airkg#hasStakeholder
:hasStakeholder rdf:type owl:ObjectProperty ;
                rdfs:domain :BusinessContext ;
                rdfs:range :Stakeholder .


###  http://example.org/airkg#hasStakeholderRole
:hasStakeholderRole rdf:type owl:ObjectProperty ;
                    rdfs:domain :Stakeholder ;
                    rdfs:range :StakeholderRole .


###  http://example.org/airkg#hasTechnicalObjective
:hasTechnicalObjective rdf:type owl:ObjectProperty ;
                       rdfs:domain :AISystemWorkflow ;
                       rdfs:range :TechnicalObjective .


###  http://example.org/airkg#hasWorkflow
:hasWorkflow rdf:type owl:ObjectProperty ;
             owl:inverseOf :isWorkflowOf ;
             rdfs:domain :AISystem ;
             rdfs:range :AISystemWorkflow .


###  http://example.org/airkg#involvesActor
:involvesActor rdf:type owl:ObjectProperty ;
               rdfs:domain :Process ;
               rdfs:range :Actor .


###  http://example.org/airkg#involvesComponent
:involvesComponent rdf:type owl:ObjectProperty ;
                   rdfs:domain :AISystemWorkflow ;
                   rdfs:range :AISystemComponent .


###  http://example.org/airkg#isComponentOf
:isComponentOf rdf:type owl:ObjectProperty ;
               rdfs:domain :AISystemComponent ;
               rdfs:range :AISystem .


###  http://example.org/airkg#isWorkflowOf
:isWorkflowOf rdf:type owl:ObjectProperty ;
              rdfs:domain :AISystemWorkflow ;
              rdfs:range :AISystem .


###  http://example.org/airkg#measuredBy
:measuredBy rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :BusinessObjective
                                        :TechnicalObjective
                                      )
                        ] ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :BusinessSuccessCriterion
                                       :TechnicalSuccessCriterion
                                     )
                       ] .


###  http://example.org/airkg#meetsCondition
:meetsCondition rdf:type owl:ObjectProperty ;
                rdfs:domain :AISystemWorkflow ;
                rdfs:range :Condition .


###  http://example.org/airkg#produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:domain :Process ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :AIModel
                                     :Data
                                   )
                     ] ;
          rdfs:seeAlso <http://w3id.org/beam/core#produce> .


###  http://example.org/airkg#supports
:supports rdf:type owl:ObjectProperty ;
          rdfs:domain :AISystemWorkflow ;
          rdfs:range :BusinessProcess .


###  http://example.org/airkg#uses
:uses rdf:type owl:ObjectProperty ;
      rdfs:domain :Process ;
      rdfs:range [ rdf:type owl:Class ;
                   owl:unionOf ( :AIModel
                                 :Data
                               )
                 ] ;
      rdfs:seeAlso <http://w3id.org/beam/core#use> .


###  http://example.org/airkg#usesModel
:usesModel rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :involvesComponent ;
           rdfs:domain :AISystemWorkflow ;
           rdfs:range :AIModel .


#################################################################
#    Data properties
#################################################################

###  http://example.org/airkg#metric
:metric rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:string .


###  http://example.org/airkg#targetValue
:targetValue rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:decimal .


###  http://example.org/airkg#unit
:unit rdf:type owl:DatatypeProperty ;
      rdfs:range xsd:string .


###  http://example.org/airkg#version
:version rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://example.org/airkg#AIModel
:AIModel rdf:type owl:Class ;
         rdfs:subClassOf :AISystemComponent ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :version ;
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:comment "A model the system uses to infer (custom, combination of OECD + TUV)."@en ;
         rdfs:label "AI Model"@en ;
         rdfs:seeAlso <http://w3id.org/beam/core#Model> .


###  http://example.org/airkg#AISystem
:AISystem rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasBusinessContext ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :BusinessContext
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasComponent ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :AIModel
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasComponent ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Data
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasComponent ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Process
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasComponent ;
                            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                            owl:onClass :AISystemComponent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPurpose ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Purpose
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasWorkflow ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :AISystemWorkflow
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :description ;
                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :name ;
                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :version ;
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                          ] ;
          rdfs:comment "An overall AI system; it does not focus on one specific task. Definition: EU AI Act, Article 3(1)."@en ;
          rdfs:label "AI System"@en ;
          rdfs:seeAlso <http://w3id.org/beam/core#System> ,
                       <https://w3id.org/airo#AISystem> .


###  http://example.org/airkg#AISystemComponent
:AISystemComponent rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasComponentRole ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :ComponentRole
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :isComponentOf ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :AISystem
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :name ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                   rdfs:comment "A functional element of an AI system"@en ;
                   rdfs:label "AI System Component"@en ;
                   rdfs:seeAlso <http://w3id.org/beam/core#Element> .


###  http://example.org/airkg#AISystemWorkflow
:AISystemWorkflow rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :addressesTask ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Task
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasDeploymentEnvironment ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :DeploymentEnvironment
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasInput ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Data
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasOutput ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Data
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasProcess ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Process
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasTechnicalObjective ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :TechnicalObjective
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :involvesComponent ;
                                    owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                                    owl:onClass :AISystemComponent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :supports ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :BusinessProcess
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasAutonomyLevel ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :AutonomyLevel
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :isWorkflowOf ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :AISystem
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :description ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :name ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:comment "A subset of the components of one AI system that addresses a specific task; it receives inputs, produces outputs and involves at least one process."@en ;
                  rdfs:label "AI System Workflow"@en .


###  http://example.org/airkg#Actor
:Actor rdf:type owl:Class ;
       rdfs:subClassOf :AISystemComponent ;
       rdfs:comment "A human or a software agent that takes part in a process."@en ;
       rdfs:label "Actor"@en ;
       rdfs:seeAlso <http://w3id.org/beam/core#Agent> .


###  http://example.org/airkg#BusinessContext
:BusinessContext rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasBusinessObjective ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :BusinessObjective
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasBusinessProcess ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :BusinessProcess
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasDomain ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Domain
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasStakeholder ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Stakeholder
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :name ;
                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 rdfs:comment "The organizational setting in which an AI system is used. It contains business processes, business objectives, stakeholders and a domain."@en ;
                 rdfs:label "Business Context"@en .


###  http://example.org/airkg#BusinessObjective
:BusinessObjective rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :measuredBy ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :BusinessSuccessCriterion
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :description ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :name ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                   rdfs:comment "A measurable result the organization wants to reach."@en ;
                   rdfs:label "Business Objective"@en .


###  http://example.org/airkg#BusinessProcess
:BusinessProcess rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :name ;
                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                 ] ;
                 rdfs:comment "The work of the organization that a workflow supports"@en ;
                 rdfs:label "Business Process"@en ;
                 rdfs:seeAlso <https://sBPMN.github.io/2.0/classes#process> .


###  http://example.org/airkg#BusinessSuccessCriterion
:BusinessSuccessCriterion rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :description ;
                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :name ;
                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :metric ;
                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :targetValue ;
                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :unit ;
                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                          ] ;
                          rdfs:comment "How reaching a business objective is measured."@en ;
                          rdfs:label "Business Success Criterion"@en .


###  http://example.org/airkg#Data
:Data rdf:type owl:Class ;
      rdfs:subClassOf :AISystemComponent ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasDataType ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :DataType
                      ] ;
      rdfs:comment "Any data the system uses or produces, from one input to a whole dataset (dpv:Data)."@en ;
      rdfs:label "Data"@en ;
      rdfs:seeAlso <http://w3id.org/beam/core#Data> ,
                   <https://w3id.org/dpv#Data> .


###  http://example.org/airkg#NeSySystem
:NeSySystem rdf:type owl:Class ;
            rdfs:subClassOf :AISystem ;
            rdfs:comment "An AI system that has both statistical and semantic models."@en ;
            rdfs:label "NeSy System"@en .


###  http://example.org/airkg#Process
:Process rdf:type owl:Class ;
         rdfs:subClassOf :AISystemComponent ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :produces ;
                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :uses ;
                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         rdfs:comment "One step inside the system, e.g. train, infer, transform, generate (boxology:Process)."@en ;
         rdfs:label "Process"@en ;
         rdfs:seeAlso <http://w3id.org/beam/core#Process> .


###  http://example.org/airkg#SemanticModel
:SemanticModel rdf:type owl:Class ;
               rdfs:subClassOf :AIModel ;
               rdfs:comment "A knowledge-based model, e.g. an ontology, a knowledge graph or a rule base."@en ;
               rdfs:label "Semantic Model"@en ;
               rdfs:seeAlso <http://w3id.org/beam/core#SemanticModel> .


###  http://example.org/airkg#Stakeholder
:Stakeholder rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasStakeholderRole ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :StakeholderRole
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :name ;
                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:comment "A person or organization that provides, uses or is affected by the system."@en ;
             rdfs:label "Stakeholder"@en ;
             rdfs:seeAlso <https://w3id.org/airo#Stakeholder> .


###  http://example.org/airkg#StatisticalModel
:StatisticalModel rdf:type owl:Class ;
                  rdfs:subClassOf :AIModel ;
                  rdfs:comment "A learned model, e.g. an LLM or a classifier."@en ;
                  rdfs:label "Statistical Model"@en ;
                  rdfs:seeAlso <http://w3id.org/beam/core#StatisticalModel> .


###  http://example.org/airkg#SubSymbolicSystem
:SubSymbolicSystem rdf:type owl:Class ;
                   rdfs:subClassOf :AISystem ;
                   rdfs:comment "An AI system whose AI models are all statistical models."@en ;
                   rdfs:label "Sub-Symbolic System"@en .


###  http://example.org/airkg#SymbolicSystem
:SymbolicSystem rdf:type owl:Class ;
                rdfs:subClassOf :AISystem ;
                rdfs:comment "An AI system whose AI models are all semantic models."@en ;
                rdfs:label "Symbolic System"@en .


###  http://example.org/airkg#TechnicalObjective
:TechnicalObjective rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :contributesTo ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :BusinessObjective
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :measuredBy ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :TechnicalSuccessCriterion
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :description ;
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :name ;
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                    ] ;
                    rdfs:comment "What a workflow must achieve technically."@en ;
                    rdfs:label "Technical Objective"@en .


###  http://example.org/airkg#TechnicalSuccessCriterion
:TechnicalSuccessCriterion rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :description ;
                                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :name ;
                                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :metric ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :targetValue ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty :unit ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ;
                           rdfs:comment "How reaching a technical objective is measured."@en ;
                           rdfs:label "Technical Success Criterion"@en .


#################################################################
#    Individuals
#################################################################

###  http://example.org/airkg#AnswerFaithfulness
:AnswerFaithfulness rdf:type owl:NamedIndividual ,
                             :TechnicalSuccessCriterion ;
                    :description "Share of answers fully supported by the retrieved passages." ;
                    :metric "faithfulness" ;
                    :name "Answer faithfulness" ;
                    :targetValue 90.0 ;
                    :unit "percent" .


###  http://example.org/airkg#AnswerFromTickets
:AnswerFromTickets rdf:type owl:NamedIndividual ,
                            :TechnicalObjective ;
                   :contributesTo :ResolveAtFirstContact ;
                   :measuredBy :AnswerFaithfulness ;
                   :description "Answers are grounded in the retrieved ticket passages." ;
                   :name "Answer from the ticket archive" .


###  http://example.org/airkg#AnswerLLM
:AnswerLLM rdf:type owl:NamedIndividual ,
                    :StatisticalModel ;
           :hasComponentRole :GenerativeModelRole ;
           :description "Large language model that writes the answer." ;
           :name "Answer LLM" ;
           :version "2026-03" .


###  http://example.org/airkg#AnswerQuickly
:AnswerQuickly rdf:type owl:NamedIndividual ,
                        :TechnicalObjective ;
               :contributesTo :ReduceHandlingCost ;
               :measuredBy :ResponseTime ;
               :description "The customer gets an answer within seconds." ;
               :name "Answer quickly" .


###  http://example.org/airkg#AssembledPrompt
:AssembledPrompt rdf:type owl:NamedIndividual ,
                          :Data ;
                 :hasComponentRole :PromptRole ;
                 :hasDataType :PersonalData ;
                 :description "Instructions, the question and the retrieved passages." ;
                 :name "Assembled prompt" .


###  http://example.org/airkg#BuildPrompt
:BuildPrompt rdf:type owl:NamedIndividual ,
                      :Process ;
             :hasComponentRole :PromptAssemblyStepRole ;
             :produces :AssembledPrompt ;
