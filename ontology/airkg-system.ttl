:KnowledgeBaseAdmin rdf:type owl:NamedIndividual ,
                             :Actor ;
                    :hasComponentRole :HumanOperatorRole ;
                    :description "Starts and watches the indexing run." ;
                    :name "Knowledge base administrator" .


###  http://example.org/airkg#LegacyRAGWorkflow
:LegacyRAGWorkflow rdf:type owl:NamedIndividual ,
                            :AISystemWorkflow ;
                   :addressesTask :ContentGenerationTask ,
                                  :InformationRetrievalTask ;
                   :containsMotif :DataControlMotif ,
                                  :GeneratedOutputToCustomerMotif ,
                                  :GenerationOnDerivedDataMotif ,
                                  :GenerativeInferenceMotif ,
                                  :InputScreeningMotif ,
                                  :OutputToCustomerMotif ,
                                  :RetrievalAugmentedGenerationMotif ,
                                  :RetrievedContentScreeningMotif ,
                                  :ThirdPartyModelSupplyMotif ,
                                  :UserPromptedGenerationMotif ;
                   :hasAutonomyLevel :NoHumanInvolved ;
                   :hasDeploymentEnvironment :PublicFacingService ;
                   :hasInput :CustomerQuestion ;
                   :hasMitigationPattern :LabelGeneratedContentPattern ,
                                         :ScreenUserInputPattern ;
                   :hasOutput :GeneratedAnswer ;
                   :hasProcess :BuildPrompt ,
                               :GenerateAnswer ,
                               :RetrievePassages ,
                               :ScreenQuestion ;
                   :hasRiskPattern :DirectPromptInjectionPattern ,
                                   :OpaqueThirdPartyModelPattern ,
                                   :PersonalDataDisclosureThroughRetrievalPattern ,
                                   :UnreviewedAnswerPattern ;
                   :hasTechnicalObjective :AnswerFromTickets ,
                                          :AnswerQuickly ;
                   :meetsCondition :OutputShownToEndUser ,
                                   :RetrievedContentIncludedInPrompt ,
                                   :SuppliedModelNotInspectable ,
                                   :UserInputIncludedInPrompt ;
                   :supports :HandleCustomerEnquiries ;
                   :usesModel :AnswerLLM ,
                              :TicketEmbeddingModel ;
                   :description "Answers a customer question from the ticket archive." ;
                   :name "LegacyRAGWorkflow" .


