###  http://example.org/airkg#ReduceHandlingCost
:ReduceHandlingCost rdf:type owl:NamedIndividual ,
                             :BusinessObjective ;
                    :measuredBy :CostPerEnquiry ;
                    :description "Handling a customer enquiry costs less than last year." ;
