{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/airkg/llm_motif/motif.schema.json",
  "title": "One RiskMotif proposal for a group of profiles (enums are filled in per call)",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 600 },
    "risk_id": { "type": "string" },
    "elements": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^m[0-9]+$" },
          "class": { "type": "string" },
          "label": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "required": ["id", "class", "label"],
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "relation": { "type": "string", "enum": ["uses", "produces"] },
          "to": { "type": "string" }
        },
        "required": ["from", "relation", "to"],
        "additionalProperties": false
      }
    },
    "contexts": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "class": { "type": "string" },
          "existing": { "type": "string" },
          "value": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "required": ["class", "existing", "value"],
        "additionalProperties": false
      }
    },
    "manifest_condition": { "type": "string" },
    "support": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "issues": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  },
  "required": ["name", "description", "risk_id", "elements", "flows", "contexts", "manifest_condition", "support",
               "confidence", "issues"],
  "additionalProperties": false
}
