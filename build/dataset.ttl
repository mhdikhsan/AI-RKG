<http://example.org/airkg/dataset/accepted-motifs> a void:Dataset,
        dcat:Dataset ;
    dct:bibliographicCitation "Derived from the AI Incident Database (CC BY-SA 4.0) and the AI Vulnerability Database (MIT); provenance per motif in staging/accepted_motifs.csv."@en ;
