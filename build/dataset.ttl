        <https://incidentdatabase.ai/> ;
    dct:title "Risk motifs proposed by an LLM from AIID incidents and AVID records, accepted by a human reviewer (extractor/llm_motif/)"@en ;
    void:triples 443 ;
    prov:wasDerivedFrom <https://github.com/IBM/ai-atlas-nexus/tree/54fcc4e935150004dfec483d32387a58225e09ba> .

