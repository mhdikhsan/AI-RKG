    dct:description "Generated by the AI-RKG core pipeline from IBM AI Atlas Nexus commit 54fcc4e935150004dfec483d32387a58225e09ba (fetched 2026-11-17)."@en ;
    dct:identifier "build/accepted_motifs.nt" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:rightsHolder "AI-RKG authors (motifs and review decisions)" ;
