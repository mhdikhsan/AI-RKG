mitigation:A0001_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits"@en ;
    ak:description "A formal review of an organisation’s compliance with standards, policies, and procedures, typically carried out by an external party. AI auditing is a rapidly growing field, but builds on long histories of auditing in other fields, including financial, environmental, and health regulation." ;
    ak:identifier "A0001_Bengio2025" ;
    ak:name "Audits" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0001_Bengio2025 .

mitigation:A0002_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Benchmarks"@en ;
    ak:description "A standardised, often quantitative test or metric used to evaluate and compare the performance of AI systems on a fixed set of tasks designed to represent real- world usage" ;
    ak:identifier "A0002_Bengio2025" ;
    ak:name "Benchmarks" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0002_Bengio2025 .

mitigation:A0003_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Bowtie Method"@en ;
    ak:description "A technique for visualising risk quantitatively and qualitatively, providing clear differentiation between proactive and reactive risk management, intended to help prevent and mitigate major accident hazards. Oil companies and national governments use the bowtie method." ;
    ak:identifier "A0003_Bengio2025" ;
    ak:name "Bowtie Method" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0003_Bengio2025 .

mitigation:A0004_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Defence in Depth"@en ;
    ak:description "The idea that multiple independent and overlapping layers of defence can be implemented such that if one fails, others will still be effective. An example comes from the field of infectious diseases, where multiple preventative measures (e.g. vaccines, masks, hand washing) can layer to reduce overall risk." ;
    ak:identifier "A0004_Bengio2025" ;
    ak:name "Defence in Depth" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0004_Bengio2025 .

mitigation:A0005_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation"@en ;
    ak:description "There are numerous documentation best practices, guidelines, and requirements for AI systems to track e.g. training data, model design and functionality, intended use cases, limitations, and risks. Model cards’ and ‘system cards’ are examples of prominent AI documentation standards" ;
    ak:identifier "A0005_Bengio2025" ;
    ak:name "Documentation" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0005_Bengio2025 .

mitigation:A0006_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Engagement with Relevant Experts and Communities"@en ;
    ak:description "Domain experts, users, and impacted communities have unique insights into likely risks. There are emerging guidelines for participatory and inclusive AI." ;
    ak:identifier "A0006_Bengio2025" ;
    ak:name "Engagement with Relevant Experts and Communities" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0006_Bengio2025 .

mitigation:A0007_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "If-Then Commitments"@en ;
    ak:description "A set of technical and organisational protocols and commitments to manage risks at varying levels as AI models become more capable. Some companies developing general- purpose AI employ these types of commitments as responsible scaling policies or similar frameworks." ;
    ak:identifier "A0007_Bengio2025" ;
    ak:name "If-Then Commitments" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0007_Bengio2025 .

mitigation:A0008_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Impact Assessment"@en ;
    ak:description "A tool used to assess the potential impacts of a technology or project. The EU AI Act requires developers of high- risk AI systems to carry out Fundamental Rights Impact Assessments." ;
    ak:identifier "A0008_Bengio2025" ;
    ak:name "Impact Assessment" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0008_Bengio2025 .

mitigation:A0009_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incident Reporting"@en ;
    ak:description "The process of systematically documenting and sharing cases in which developing or deploying AI has caused direct or indirect harms. Incident reporting is common in many domains, from human resources to cybersecurity. It has also become more common for AI." ;
    ak:identifier "A0009_Bengio2025" ;
    ak:name "Incident Reporting" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0009_Bengio2025 .

mitigation:A0010_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Evaluation"@en ;
    ak:description "Processes to assess and measure an AI system's performance on a particular task. There are countless AI evaluations to assess different capabilities and risks, including for security." ;
    ak:identifier "A0010_Bengio2025" ;
    ak:name "Model Evaluation" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0010_Bengio2025 .

mitigation:A0011_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Red Teaming"@en ;
    ak:description "An exercise in which a group of people or automated systems pretend to be an adversary and attack an organisation’s systems in order to identify vulnerabilities." ;
    ak:identifier "A0011_Bengio2025" ;
    ak:name "Red Teaming" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0011_Bengio2025 .

mitigation:A0012_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk management frameworks"@en ;
    ak:description "Whole organisation frameworks to reduce gaps in risk coverage and ensure various risk activities (i.e. all of the above) are cohesively structured and aligned, risk roles and responsibilities are clearly defined, and checks and balances are in place to avoid silos and manage conflicts of interest. In other safety critical industries, the Three Lines of Defence framework – separating risk ownership, oversight and audit – is widely used and can be usefully applied to advanced AI companies" ;
    ak:identifier "A0012_Bengio2025" ;
    ak:name "Risk management frameworks" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0012_Bengio2025 .

mitigation:A0013_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Register"@en ;
    ak:description "A risk management tool that serves as a repository of all risks, their prioritisation, owners, and mitigation plans. They are sometimes used to fulfil regulatory compliance. Risk registers are a relatively standard tool used across many industries, including cybersecurity and recently AI." ;
    ak:identifier "A0013_Bengio2025" ;
    ak:name "Risk Register" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0013_Bengio2025 .

mitigation:A0014_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Taxonomy"@en ;
    ak:description "A way to categorise and organise risks across multiple dimensions. There are several well- known risk taxonomies for AI." ;
    ak:identifier "A0014_Bengio2025" ;
    ak:name "Risk Taxonomy" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0014_Bengio2025 .

mitigation:A0015_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Thresholds"@en ;
    ak:description "Quantitative or qualitative limits that distinguish acceptable from unacceptable risks and trigger specific risk management actions when exceeded. Risk thresholds for general- purpose AI are being determined by a combination of assessments of capabilities, impact, compute, reach, and other factors." ;
    ak:identifier "A0015_Bengio2025" ;
    ak:name "Risk Thresholds" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0015_Bengio2025 .

mitigation:A0016_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Tolerance"@en ;
    ak:description "The level of risk an organisation is willing to take on. In AI, risks tolerances are often left up to AI companies, but regulatory regimes can help identify unacceptable risks that are legally prohibited" ;
    ak:identifier "A0016_Bengio2025" ;
    ak:name "Risk Tolerance" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0016_Bengio2025 .

mitigation:A0017_Bengio2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety Analysis"@en ;
    ak:description "Helps understand the dependencies between components and the system that they are part of, in order to anticipate how component failures could lead to system-level hazards. This approach is used across safety- critical fields, e.g. to anticipate and prevent aircraft crashes or nuclear reactor core meltdowns" ;
    ak:identifier "A0017_Bengio2025" ;
    ak:name "Safety Analysis" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0017_Bengio2025 .

mitigation:A0018_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety Cases"@en ;
    ak:description "Safety cases require developers to demonstrate safety. A safety case is a structured argument supported by evidence that a system is acceptably safe to operate in a particular context. Safety cases are common in many industries, including defence, aerospace, and railways." ;
    ak:identifier "A0018_Bengio2025" ;
    ak:name "Safety Cases" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0018_Bengio2025 .

mitigation:A0019_Bengio2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety of The Intended Function"@en ;
    ak:description "An approach that requires engineers to provide evidence that a system is safe when operating as intended. This approach is used in many engineering fields, such as in the construction and testing of road vehicles." ;
    ak:identifier "A0019_Bengio2025" ;
    ak:name "Safety of The Intended Function" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0019_Bengio2025 .

mitigation:A0020_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Scenario Analysis"@en ;
    ak:description "Developing plausible future scenarios and analysing how risks materialise. Scenario analysis and planning are widely used across industries including for the energy sector and to address uncertainties of power systems." ;
    ak:identifier "A0020_Bengio2025" ;
    ak:name "Scenario Analysis" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0020_Bengio2025 .

mitigation:A0021_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Threat Modelling"@en ;
    ak:description "A process to identify threats and vulnerabilities to a system. Threat modelling is commonly used to support AI security throughout AI research and development" ;
    ak:identifier "A0021_Bengio2025" ;
    ak:name "Threat Modelling" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0021_Bengio2025 .

mitigation:A0022_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Whistleblower protection"@en ;
    ak:description "Whistleblowers can play an important role in alerting authorities to dangerous risks at AI companies due to the proprietary nature of many AI advancements. Incentives and protections for whistleblowers are expected to be an important part of advanced AI risk governance." ;
    ak:identifier "A0022_Bengio2025" ;
    ak:name "Whistleblower protection" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0022_Bengio2025 .

mitigation:A0023_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Delphi Method"@en ;
    ak:description "A group decision-making technique that uses a series of questionnaires to gather consensus from a panel of experts. The Delphi method has been used to help identify key AI risks." ;
    ak:identifier "A0023_Bengio2025" ;
    ak:name "Delphi Method" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0023_Bengio2025 .

mitigation:A0024_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Responsible Release and Deployment Strategies"@en ;
    ak:description "There is a spectrum of release and deployment strategies for AI including staged releases, cloud- based or API access, deployment safety controls, and acceptable use policies. There are some emerging industry practices that focus on release and deployment strategies for general- purpose AI." ;
    ak:identifier "A0024_Bengio2025" ;
    ak:name "Responsible Release and Deployment Strategies" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0024_Bengio2025 .

mitigation:A0025_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Matrices"@en ;
    ak:description "A visual tool that helps prioritise risks according to their likelihood of occurrence and potential impact. Risk matrices are used in many industries and for many purposes, such as by financial institutions for evaluating credit risk, or by companies to assess possible disruptions to their supply chains" ;
    ak:identifier "A0025_Bengio2025" ;
    ak:name "Risk Matrices" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0025_Bengio2025 .

mitigation:A0026_Bengio2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety by Design"@en ;
    ak:description "An approach that centres user safety in the design and development of products and services. This approach is common across engineering and safety- critical fields including aviation and energy." ;
    ak:identifier "A0026_Bengio2025" ;
    ak:name "Safety by Design" ;
    ak:source "https://arxiv.org/abs/2501.17805"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0026_Bengio2025 .

mitigation:A0027_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document compute usage"@en ;
    ak:description "Given that computing power is key to frontier AI development (Sastry et al., 2024), frontier developers can be required to document their compute resources including details such as the usage, providers, and the location of compute clusters." ;
    ak:identifier "A0027_Casper2025" ;
    ak:name "Document compute usage" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0027_Casper2025 .

mitigation:A0028_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation availability"@en ;
    ak:description "All of the above documentation can be made available to the public (redacted) and AI governing authorities (unredacted)." ;
    ak:identifier "A0028_Casper2025" ;
    ak:name "Documentation availability" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0028_Casper2025 .

mitigation:A0029_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation comparison in court"@en ;
    ak:description "To incentivize a race to the top where frontier developers pursue established best safety practices, courts can be given the power to compare documentation for defendants with that of peer developers." ;
    ak:identifier "A0029_Casper2025" ;
    ak:name "Documentation comparison in court" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0029_Casper2025 .

mitigation:A0030_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incident reporting"@en ;
    ak:description "Frontier developers can be required to document and report on substantial incidents in a timely manner." ;
    ak:identifier "A0030_Casper2025" ;
    ak:name "Incident reporting" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0030_Casper2025 .

mitigation:A0031_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent third-party risk assessments"@en ;
    ak:description "Developers can be required to have an independent third-party conduct and produce a report (including access, methods, and findings) on risk assessments of frontier systems (Raji et al., 2022; Anderljung et al., 2023; Casper et al., 2024). They can also be required to document if and what “safe harbor” policies they have to facilitate independent evaluation and red-teaming (Longpre et al., 2024)." ;
    ak:identifier "A0031_Casper2025" ;
    ak:name "Independent third-party risk assessments" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0031_Casper2025 .

mitigation:A0032_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Internal risk assessments"@en ;
    ak:description "Developers can be required to conduct and report on internal risk assessments of frontier systems." ;
    ak:identifier "A0032_Casper2025" ;
    ak:name "Internal risk assessments" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0032_Casper2025 .

mitigation:A0033_Casper2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Labeling AI-generated content"@en ;
    ak:description "To aid in digital forensics, content produced from AI systems can be labeled with metadata, watermarks, and notices." ;
    ak:identifier "A0033_Casper2025" ;
    ak:name "Labeling AI-generated content" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0033_Casper2025 .

mitigation:A0034_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model registration"@en ;
    ak:description "Developers can be required to register (McKernon et al., 2024) frontier systems with governing bodies (regardless of whether they will be externally deployed)." ;
    ak:identifier "A0034_Casper2025" ;
    ak:name "Model registration" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0034_Casper2025 .

mitigation:A0035_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model specification and basic info"@en ;
    ak:description "Developers can be required to document intended use cases and behaviors (e.g., OpenAI, 2024) and basic information about frontier systems such as scale." ;
    ak:identifier "A0035_Casper2025" ;
    ak:name "Model specification and basic info" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0035_Casper2025 .

mitigation:A0036_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Plans to minimize risks to society"@en ;
    ak:description "Developers can be required to produce a report on risks (Slattery et al., 2024) posed by their frontier systems and risk mitigation practices that they are taking to reduce them." ;
    ak:identifier "A0036_Casper2025" ;
    ak:name "Plans to minimize risks to society" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0036_Casper2025 .

mitigation:A0037_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Post-deployment monitoring reports"@en ;
    ak:description "Developers can be required to establish procedures for monitoring and periodically reporting on the uses and impacts of their frontier systems." ;
    ak:identifier "A0037_Casper2025" ;
    ak:name "Post-deployment monitoring reports" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0037_Casper2025 .

mitigation:A0038_Casper2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security measures"@en ;
    ak:description "Given the challenges of securing model weights and the hazards of leaks (Nevo et al., 2024), frontier developers can be required to document high-level noncompromising information about their security measures (e.g., Anthropic, 2024)." ;
    ak:identifier "A0038_Casper2025" ;
    ak:name "Security measures" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0038_Casper2025 .

mitigation:A0039_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Shutdown procedures"@en ;
    ak:description "Developers can be required to document if and which protocols exist to shut down frontier systems that are under their control." ;
    ak:identifier "A0039_Casper2025" ;
    ak:name "Shutdown procedures" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0039_Casper2025 .

mitigation:A0040_Casper2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Whistleblower protections"@en ;
    ak:description "Regulations can explicitly prevent retaliation and offer incentives for whistleblowers who report violations of those regulations." ;
    ak:identifier "A0040_Casper2025" ;
    ak:name "Whistleblower protections" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0040_Casper2025 .

mitigation:A0041_Casper2025 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "AI governance institutes"@en ;
    ak:description "National governments (or international coalitions) can create AI governance institutes to research risks, evaluate systems, and curate best risk management practices that developers are encouraged to adhere to." ;
    ak:identifier "A0041_Casper2025" ;
    ak:name "AI governance institutes" ;
    ak:source "https://arxiv.org/abs/2502.09618"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0041_Casper2025 .

mitigation:A0042_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish AI system access controls"@en ;
    ak:description "Implement comprehensive access management including role-based access control (RBAC), authentication mechanisms, and audit logging for AI models and associated resources." ;
    ak:identifier "A0042_Eisenberg2025" ;
    ak:name "Establish AI system access controls" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0042_Eisenberg2025 .

mitigation:A0043_Eisenberg2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI asset protection framework"@en ;
    ak:description "Deploy technical protection measures including encryption, secure enclaves, and versioning controls for AI models and associated data." ;
    ak:identifier "A0043_Eisenberg2025" ;
    ak:name "Implement AI asset protection framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0043_Eisenberg2025 .

mitigation:A0044_Eisenberg2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish security validation framework"@en ;
    ak:description "Execute comprehensive pre-deployment security validation including AI-specific vulnerability assessments, penetration testing, and security requirement verification." ;
    ak:identifier "A0044_Eisenberg2025" ;
    ak:name "Establish security validation framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0044_Eisenberg2025 .

mitigation:A0045_Eisenberg2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement continuous security testing system"@en ;
    ak:description "Deploy ongoing security testing mechanisms including automated vulnerability scanning, continuous security monitoring, and periodic reassessment of security controls." ;
    ak:identifier "A0045_Eisenberg2025" ;
    ak:name "Implement continuous security testing system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0045_Eisenberg2025 .

mitigation:A0046_Eisenberg2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI security defense system"@en ;
    ak:description "Deploy active defense mechanisms combining continuous security monitoring, input validation, adversarial detection, and adaptive response capabilities specific to AI systems." ;
    ak:identifier "A0046_Eisenberg2025" ;
    ak:name "Implement AI security defense system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0046_Eisenberg2025 .

mitigation:A0047_Eisenberg2025 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish AI system integration framework"@en ;
    ak:description "Define and implement a comprehensive framework for AI system integration including architecture review, compatibility testing, and integration validation processes." ;
    ak:identifier "A0047_Eisenberg2025" ;
    ak:name "Establish AI system integration framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0047_Eisenberg2025 .

mitigation:A0048_Eisenberg2025 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI system lifecycle management"@en ;
    ak:description "Deploy systematic processes for AI system maintenance, updates, and retraining, including version control, deployment pipelines, and performance monitoring to ensure consistent system reliability and performance." ;
    ak:identifier "A0048_Eisenberg2025" ;
    ak:name "Implement AI system lifecycle management" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0048_Eisenberg2025 .

mitigation:A0049_Eisenberg2025 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement scalable AI infrastructure"@en ;
    ak:description "Apply architecture and infrastructure practices to ensure AI systems can scale effectively, including load testing, resource monitoring, and capacity planning to maintain performance under increased demand." ;
    ak:identifier "A0049_Eisenberg2025" ;
    ak:name "Implement scalable AI infrastructure" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0049_Eisenberg2025 .

mitigation:A0050_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish AI system documentation framework"@en ;
    ak:description "Implement comprehensive documentation requirements and processes covering training data provenance, system architecture, model cards, and component interactions to ensure transparent documentation of both the data lifecycle and system design." ;
    ak:identifier "A0050_Eisenberg2025" ;
    ak:name "Establish AI system documentation framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0050_Eisenberg2025 .

mitigation:A0051_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI system monitoring and logging infrastructure"@en ;
    ak:description "Deploy comprehensive monitoring and logging systems that capture AI system behavior, decisions, performance metrics, and real-time data source usage at multiple levels of granularity for full system observability, including tracking of data lineage during inference." ;
    ak:identifier "A0051_Eisenberg2025" ;
    ak:name "Implement AI system monitoring and logging infrastructure" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0051_Eisenberg2025 .

mitigation:A0052_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish AI decision explanation framework"@en ;
    ak:description "Implement mechanisms and tools for generating human-understandable explanations of AI system decisions, including feature importance, decision paths, confidence levels, and clear attribution of data sources and their characteristics used during inference." ;
    ak:identifier "A0052_Eisenberg2025" ;
    ak:mitigates risk:atlas-over-or-under-reliance,
        risk:llm052025-improper-output-handling,
        risk:llm062025-excessive-agency ;
    ak:name "Establish AI decision explanation framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0052_Eisenberg2025 .

mitigation:A0053_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish and apply performance testing and validation framework"@en ;
    ak:description "Implement comprehensive performance requirements, testing protocols, and validation procedures to ensure AI systems meet capability requirements and maintain reliable operation across intended use cases." ;
    ak:identifier "A0053_Eisenberg2025" ;
    ak:name "Establish and apply performance testing and validation framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0053_Eisenberg2025 .

mitigation:A0054_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement performance monitoring and robustness system"@en ;
    ak:description "Implement continuous monitoring and testing mechanisms to evaluate AI system robustness, generalization capabilities, and performance stability across varying conditions and environments while in production." ;
    ak:identifier "A0054_Eisenberg2025" ;
    ak:name "Implement performance monitoring and robustness system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0054_Eisenberg2025 .

mitigation:A0055_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish and apply fairness testing and validation framework"@en ;
    ak:description "Implement comprehensive procedures to validate model fairness during development and pre-deployment, including test dataset creation, metric definition, and systematic assessment of performance disparities across demographic groups." ;
    ak:identifier "A0055_Eisenberg2025" ;
    ak:name "Establish and apply fairness testing and validation framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0055_Eisenberg2025 .

mitigation:A0056_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement fairness monitoring and remediation system"@en ;
    ak:description "Deploy continuous monitoring systems to detect fairness issues in production, including automated drift detection, performance disparity alerts, and systematic remediation procedures." ;
    ak:identifier "A0056_Eisenberg2025" ;
    ak:name "Implement fairness monitoring and remediation system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0056_Eisenberg2025 .

mitigation:A0057_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish universal access and performance design framework"@en ;
    ak:description "Establish and follow a structured framework ensuring the AI system is designed and developed to deliver consistent, high-quality performance and accessibility for all intended user groups, regardless of their characteristics or circumstances." ;
    ak:identifier "A0057_Eisenberg2025" ;
    ak:name "Establish universal access and performance design framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0057_Eisenberg2025 .

mitigation:A0058_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish content safety policy and boundaries"@en ;
    ak:description "Define and document comprehensive content safety policies, including prohibited content categories, acceptable content guidelines, output constraints, and required safeguards. Establish clear thresholds, classification criteria, and escalation levels for different types of harmful content. Include specific criteria for content that could enable or promote malicious use." ;
    ak:identifier "A0058_Eisenberg2025" ;
    ak:name "Establish content safety policy and boundaries" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0058_Eisenberg2025 .

mitigation:A0059_Eisenberg2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement content moderation system"@en ;
    ak:description "Implement automated and/or human-in-the-loop content moderation mechanisms to detect and filter harmful content in real-time, including content classification, blocking procedures, and automated enforcement of safety boundaries. Include detection of potential malicious use patterns." ;
    ak:identifier "A0059_Eisenberg2025" ;
    ak:name "Implement content moderation system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0059_Eisenberg2025 .

mitigation:A0060_Eisenberg2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement content safety incident response"@en ;
    ak:description "Establish procedures for investigating, documenting, and remediating harmful content incidents that bypass moderation systems, including coordination with relevant authorities, root cause analysis, and system improvement protocols. Include specific procedures for suspected malicious use cases." ;
    ak:identifier "A0060_Eisenberg2025" ;
    ak:name "Implement content safety incident response" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0060_Eisenberg2025 .

mitigation:A0061_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish information quality assurance framework"@en ;
    ak:description "Implement comprehensive mechanisms to assess, verify, and improve the factual accuracy of AI system outputs, including source validation, fact-checking procedures, and uncertainty communication protocols." ;
    ak:identifier "A0061_Eisenberg2025" ;
    ak:name "Establish information quality assurance framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0061_Eisenberg2025 .

mitigation:A0062_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish frontier AI safety framework"@en ;
    ak:description "Establish and enforce policies governing system AI scaling decisions, including risk assessment requirements, capability thresholds, and deployment constraints. Define clear criteria for when and how system capabilities can be expanded based on safety considerations." ;
    ak:identifier "A0062_Eisenberg2025" ;
    ak:name "Establish frontier AI safety framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0062_Eisenberg2025 .

mitigation:A0063_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement adversarial testing and red team program"@en ;
    ak:description "Conduct systematic adversarial testing and red team exercises focused on probing AI system capabilities, identifying potential misuse vectors, and exposing unintended harmful behaviors. Testing should explore ways the system could be manipulated to produce dangerous outputs, bypass safety guardrails, or exhibit undesired emergent behaviors. Include scenarios involving both individual and coordinated attempts to exploit the system’s capabilities." ;
    ak:identifier "A0063_Eisenberg2025" ;
    ak:name "Implement adversarial testing and red team program" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0063_Eisenberg2025 .

mitigation:A0064_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement system usage monitoring and prevention"@en ;
    ak:description "Monitor and prevent malicious or otherwise disallowed behavioral patterns including automated abuse, coordination across accounts, and systematic manipulation attempts." ;
    ak:identifier "A0064_Eisenberg2025" ;
    ak:name "Implement system usage monitoring and prevention" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0064_Eisenberg2025 .

mitigation:A0065_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI system usage verification program"@en ;
    ak:description "Deploy comprehensive measures to verify user identity, document intended use cases, and ensure AI system usage complies with instructions. This includes KYC procedures for user verification, clear documentation of permitted uses, and user acknowledgment of instructions." ;
    ak:identifier "A0065_Eisenberg2025" ;
    ak:name "Implement AI system usage verification program" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0065_Eisenberg2025 .

mitigation:A0066_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI System Disclosure Requirements"@en ;
    ak:description "Deploy mechanisms to ensure clear, timely disclosure of AI system use to end users, including automated notifications of AI involvement in interactions, explicit identification of AI-generated content, and clear communication of when users are interacting with AI systems." ;
    ak:identifier "A0066_Eisenberg2025" ;
    ak:name "Implement AI System Disclosure Requirements" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0066_Eisenberg2025 .

mitigation:A0067_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement a privacy protection framework"@en ;
    ak:description "Implement comprehensive privacy protection measures to prevent exposure of PII and sensitive information, including data minimization, anonymization procedures, and privacy-preserving inference techniques." ;
    ak:identifier "A0067_Eisenberg2025" ;
    ak:name "Implement a privacy protection framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0067_Eisenberg2025 .

mitigation:A0068_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement a privacy incident detection and response"@en ;
    ak:description "Deploy monitoring and response mechanisms to detect and address potential privacy exposures, including PII leak detection, sensitive information monitoring, and privacy incident handling procedures." ;
    ak:identifier "A0068_Eisenberg2025" ;
    ak:name "Implement a privacy incident detection and response" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0068_Eisenberg2025 .

mitigation:A0069_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish user rights and recourse framework"@en ;
    ak:description "Implement comprehensive mechanisms for user reporting, feedback collection, incident investigation, and recourse provision, including clear procedures for users to report issues, request explanations or corrections, appeal decisions, and receive appropriate remediation. The system should handle various types of user concerns including system errors, unfair treatment, privacy violations, and safety issues." ;
    ak:identifier "A0069_Eisenberg2025" ;
    ak:name "Establish user rights and recourse framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0069_Eisenberg2025 .

mitigation:A0070_Eisenberg2025 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement AI literacy and competency program"@en ;
    ak:description "Implement comprehensive training and education programs to ensure personnel develop and maintain appropriate levels of AI literacy, risk awareness, and operational competency. This includes role-based training on AI capabilities, limitations, safety protocols, ethical considerations, and proper system usage." ;
    ak:identifier "A0070_Eisenberg2025" ;
    ak:name "Implement AI literacy and competency program" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0070_Eisenberg2025 .

mitigation:A0071_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish human-AI interaction safety framework"@en ;
    ak:description "Implement comprehensive safeguards to ensure appropriate levels of human oversight, control, and agency in AI system interactions, including decision autonomy requirements, override capabilities, and dependency prevention measures." ;
    ak:identifier "A0071_Eisenberg2025" ;
    ak:name "Establish human-AI interaction safety framework" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0071_Eisenberg2025 .

mitigation:A0072_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement psychological impact management system"@en ;
    ak:description "Establish monitoring and intervention procedures to detect and prevent unhealthy user-AI relationships, including emotional dependency tracking, interaction boundary enforcement, and well-being safeguards." ;
    ak:identifier "A0072_Eisenberg2025" ;
    ak:name "Implement psychological impact management system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0072_Eisenberg2025 .

mitigation:A0073_Eisenberg2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement environmental impact management system"@en ;
    ak:description "Implement comprehensive environmental impact monitoring and optimization procedures, including energy efficiency measures, carbon footprint tracking, and hardware lifecycle management." ;
    ak:identifier "A0073_Eisenberg2025" ;
    ak:name "Implement environmental impact management system" ;
    ak:source "https://arxiv.org/abs/2503.05937"^^xsd:anyURI ;
