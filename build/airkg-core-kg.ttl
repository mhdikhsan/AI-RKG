    skos:exactMatch nexus:A0747_NIST2024 .

mitigation:A0748_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity; Value Chain and Component Integration"@en ;
    ak:description "Leverage feedback and recommendations from organizational boards or committees related to the deployment of GAI applications and content provenance when using third-party pre-trained models." ;
    ak:identifier "A0748_NIST2024" ;
    ak:name "Information Integrity; Value Chain and Component Integration" ;
