        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration"@en ;
    ak:description "Evaluate the use of sentiment analysis to gauge user sentiment regarding GAI content performance and impact, and work in collaboration with AI Actors experienced in user research and experience." ;
