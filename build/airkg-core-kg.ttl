@prefix ak: <http://example.org/airkg#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix mitigation: <http://example.org/airkg/mitigation/> .
@prefix nexus: <https://w3id.org/ai-atlas-nexus/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix risk: <http://example.org/airkg/risk/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/airkg> a owl:Ontology ;
    rdfs:label "AI Risk Pattern Ontology"@en ;
    owl:versionInfo "1.0"@en .

ak:Agent a owl:Class ;
    rdfs:subClassOf ak:Element .

ak:Engineer a owl:Class ;
    rdfs:subClassOf ak:Generate .

ak:Objective a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:metric ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:targetValue ],
        ak:ApplicationContext .

ak:SemanticModel a owl:Class ;
    rdfs:subClassOf ak:Model .

ak:Train a owl:Class ;
    rdfs:subClassOf ak:Generate .

