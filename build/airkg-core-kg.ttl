    skos:exactMatch nexus:A0734_NIST2024 .

mitigation:A0735_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Harmful Bias and Homogenization"@en ;
    ak:description "Use structured feedback mechanisms to solicit and capture user input about AI generated content to detect subtle shifts in quality or alignment with community and societal values. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0735_NIST2024" ;
    ak:name "Human-AI Configuration; Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
