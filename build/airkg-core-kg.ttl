mitigation:A0257_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Report new model deployments to the AG within 30 days"@en ;
    ak:identifier "A0257_Wiener2024" ;
    ak:name "Report new model deployments to the AG within 30 days" ;
