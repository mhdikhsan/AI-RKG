        owl:NamedIndividual ;
    rdfs:label "Information Integrity"@en ;
    ak:description "Implement real-time monitoring processes for analyzing generated content performance and trustworthiness characteristics related to content provenance to identify deviations from the desired standards and trigger alerts for human intervention." ;
    ak:identifier "A0747_NIST2024" ;
    ak:name "Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
