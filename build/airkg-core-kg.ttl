<http://example.org/airkg/motif/m1824344b0f> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Chatbot model inference producing harmful or toxic output"@en ;
    ak:description "A model is run by an inference process on supplied data (user text or prompts) in a chatbot task, producing output data that is returned to the user. Because chatbot output is generated freely from user-controlled input, the output data can contain abusive, offensive or otherwise harmful content, whether through absorbed bias in the model or inputs crafted to elicit it." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m1824344b0f/m4> ;
    ak:identifier "m1824344b0f" ;
    ak:inContext ak:chatbot,
        <http://example.org/airkg/motif/m1824344b0f/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-1.2 ;
    ak:name "Chatbot model inference producing harmful or toxic output" ;
    ak:source "https://0din.ai/disclosures/cfe2e5b2-fb9f-4536-a464-21132727356e"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/106/"^^xsd:anyURI .

<http://example.org/airkg/motif/m33a5224d27> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Guardrailed LLM inference on adversarial prompt data"@en ;
    ak:description "An Infer process consumes an LLM with built-in guardrails together with user-supplied prompt data and produces output data. Because the model has to follow instructions embedded in untrusted prompt text, a crafted prompt can steer it past its safety restrictions, so the output data contains content the guardrails were meant to block." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m33a5224d27/m4> ;
    ak:identifier "m33a5224d27" ;
    ak:inContext <http://example.org/airkg/motif/m33a5224d27/architecture> ;
    ak:indicatesRisk risk:atlas-jailbreaking ;
    ak:name "Guardrailed LLM inference on adversarial prompt data" ;
    ak:source "https://0din.ai/disclosures/02997b6f-004e-4e7b-a9e3-8368679bae8d"^^xsd:anyURI,
        "https://0din.ai/disclosures/06b58763-8a7b-4d82-afb6-ebe738b378a4"^^xsd:anyURI,
        "https://0din.ai/disclosures/0d1e2015-f6ce-4b79-8bde-edd26bfc6f02"^^xsd:anyURI,
        "https://0din.ai/disclosures/2235061a-e292-474f-ac38-a510b80b5ef0"^^xsd:anyURI,
        "https://0din.ai/disclosures/4d590568-3622-41ae-b91a-eae8b5a4382e"^^xsd:anyURI,
        "https://0din.ai/disclosures/4e8ed295-a772-4a29-8727-cbefada44123"^^xsd:anyURI,
        "https://0din.ai/disclosures/64104fd3-265d-4784-81f0-7375b243195c"^^xsd:anyURI,
        "https://0din.ai/disclosures/a38bddfb-9afb-4b2b-b91d-ea1673a89532"^^xsd:anyURI .

<http://example.org/airkg/motif/m3ab1926094> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model inference on person-derived data with unequal group performance"@en ;
    ak:description "An inference process takes input data and a model and produces output data (a transcription, match, flag or moderation decision). When the model was built or tested without adequate coverage of some demographic or language groups, its outputs are systematically less accurate for those groups. The unequal outputs show up in the produced data that downstream decisions rely on." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m3ab1926094/m4> ;
    ak:identifier "m3ab1926094" ;
    ak:inContext <http://example.org/airkg/motif/m3ab1926094/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-1.3 ;
    ak:name "Model inference on person-derived data with unequal group performance" ;
    ak:source "https://incidentdatabase.ai/cite/102/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/108/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/131/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/138/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/140/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/143/"^^xsd:anyURI .

<http://example.org/airkg/motif/m3de2f4a4ce> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model inference over special category personal data producing derived person data"@en ;
    ak:description "An inference process applies a model to input data that falls under special category personal data (such as biometric face data) and produces derived data about individuals, such as identities, templates or inferred attributes. Because the inputs and outputs are sensitive and tied to individuals, the derived output can expose or infer private information, or be retained, without the subject's consent or awareness, which compromises their privacy." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m3de2f4a4ce/m4> ;
    ak:identifier "m3de2f4a4ce" ;
    ak:inContext ak:special_category_personal_data,
        <http://example.org/airkg/motif/m3de2f4a4ce/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-2.1 ;
    ak:name "Model inference over special category personal data producing derived person data" ;
    ak:source "https://incidentdatabase.ai/cite/107/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/122/"^^xsd:anyURI .

<http://example.org/airkg/motif/m4157d1a6cb> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Inference on untrusted input to a model"@en ;
    ak:description "An inference process takes a model together with input data that an adversary can control or perturb. Small crafted changes to that input can push the model to a wrong output, because the model is queried on data it cannot verify as benign. The risk shows up at the model." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m4157d1a6cb/m1> ;
    ak:identifier "m4157d1a6cb" ;
    ak:inContext <http://example.org/airkg/motif/m4157d1a6cb/architecture> ;
    ak:indicatesRisk risk:atlas-evasion-attack ;
    ak:name "Inference on untrusted input to a model" ;
    ak:source "https://atlas.mitre.org/studies/AML.CS0010"^^xsd:anyURI,
        "https://atlas.mitre.org/studies/AML.CS0012"^^xsd:anyURI .

<http://example.org/airkg/motif/m5778ca41f8> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Content generation LLM producing unsafe or inappropriate output from user prompts"@en ;
    ak:description "An LLM is used for content generation: an inference process takes user-supplied prompt data and the LLM and produces generated content as output data. With no reliable filtering between prompt and output, the generated content can be harmful, toxic or otherwise inappropriate, such as hateful text, illegal instructions or abusive posts, and it surfaces in the output data." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m5778ca41f8/m4> ;
    ak:identifier "m5778ca41f8" ;
    ak:inContext ak:content_generation,
        <http://example.org/airkg/motif/m5778ca41f8/architecture> ;
    ak:indicatesRisk risk:atlas-harmful-output ;
    ak:name "Content generation LLM producing unsafe or inappropriate output from user prompts" ;
    ak:source "https://0din.ai/disclosures/06b58763-8a7b-4d82-afb6-ebe738b378a4"^^xsd:anyURI,
        "https://0din.ai/disclosures/4f01819a-3dfe-4d99-9243-5870085372ed"^^xsd:anyURI,
        "https://0din.ai/disclosures/8ccd7f81-4e36-4084-8061-cec6e2d83ece"^^xsd:anyURI,
        "https://0din.ai/disclosures/a50c962f-1a46-4382-b810-9a2b4c5c6091"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/118/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/120/"^^xsd:anyURI .

<http://example.org/airkg/motif/m5cfccc08db> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Perception or classification model inference producing consequential outputs"@en ;
    ak:description "An inference process takes input data and applies a model (a detector or classifier) to produce an output that is acted upon. When the model is not robust to the real-world input variability or context it meets, it misclassifies or misdetects, and the faulty output flows on to decisions or actions with real consequences." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m5cfccc08db/m4> ;
    ak:identifier "m5cfccc08db" ;
    ak:inContext <http://example.org/airkg/motif/m5cfccc08db/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-7.3 ;
    ak:name "Perception or classification model inference producing consequential outputs" ;
    ak:source "https://incidentdatabase.ai/cite/100/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/112/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/116/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/128/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/144/"^^xsd:anyURI .

<http://example.org/airkg/motif/m69bf190f05> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model-based decision scoring of individuals"@en ;
    ak:description "An inference process applies a model to input data about people and produces data that classifies or scores them, such as a risk label. If the input data or the model encodes historical bias, the produced classifications systematically disadvantage some groups relative to others, so the unfairness shows up in the output data that downstream decisions rely on." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m69bf190f05/m4> ;
    ak:identifier "m69bf190f05" ;
    ak:inContext <http://example.org/airkg/motif/m69bf190f05/architecture> ;
    ak:indicatesRisk risk:atlas-decision-bias ;
    ak:name "Model-based decision scoring of individuals" ;
    ak:source "https://incidentdatabase.ai/cite/101/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/11/"^^xsd:anyURI .

<http://example.org/airkg/motif/m80e16b2fb3> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model-based inference over personal data producing person-related output"@en ;
    ak:description "An inference process takes input data and a model and produces output data about or linked to individuals. When the inputs concern identifiable people, the system can infer or expose private information about them without their consent, compromising privacy." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m80e16b2fb3/m3> ;
    ak:identifier "m80e16b2fb3" ;
    ak:inContext ak:personal_data,
        <http://example.org/airkg/motif/m80e16b2fb3/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-2.1 ;
    ak:name "Model-based inference over personal data producing person-related output" ;
    ak:source "https://incidentdatabase.ai/cite/109/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/119/"^^xsd:anyURI .

<http://example.org/airkg/motif/m8cff9889e2> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model inference producing toxic output in arts and entertainment"@en ;
    ak:description "A model is applied by an inference process to input data and produces output data, in an arts and entertainment product such as a media app, chatbot or venue service. Because the output is delivered to end users without adequate safeguards, it can contain harmful, offensive or inappropriate content, exposing users to toxic content." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m8cff9889e2/m4> ;
    ak:identifier "m8cff9889e2" ;
    ak:inContext ak:arts_and_entertainment,
        <http://example.org/airkg/motif/m8cff9889e2/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-1.2 ;
    ak:name "Model inference producing toxic output in arts and entertainment" ;
    ak:source "https://incidentdatabase.ai/cite/1/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/106/"^^xsd:anyURI .

<http://example.org/airkg/motif/m9fa16f254f> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model inference about people producing unfair discriminatory outputs"@en ;
    ak:description "A model is applied by an inference process to input data about people, and the resulting output data (scores, labels, matches, flags) is used to make decisions about the people affected (AI subjects). Where the model reflects biased data or design, its outputs treat individuals or groups unequally, leading to unfair discrimination and misrepresentation of those groups." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/m9fa16f254f/m4> ;
    ak:identifier "m9fa16f254f" ;
    ak:inContext ak:ai_subject,
        <http://example.org/airkg/motif/m9fa16f254f/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-1.1 ;
    ak:name "Model inference about people producing unfair discriminatory outputs" ;
    ak:source "https://incidentdatabase.ai/cite/101/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/107/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/11/"^^xsd:anyURI .

<http://example.org/airkg/motif/ma228170353> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Automated profiling of people from personal records into consequential labels"@en ;
    ak:description "A model is applied by an inference process to input data about individuals to produce a score, label or evaluation about each person, in a profiling task. Such outputs are used to make consequential decisions about people, and any skew or proxy effects in the input data or model carry over into the output labels. Groups or individuals can therefore be treated unfairly by the resulting decisions." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/ma228170353/m4> ;
    ak:identifier "ma228170353" ;
    ak:inContext ak:profiling,
        <http://example.org/airkg/motif/ma228170353/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-5.2 ;
    ak:name "Automated profiling of people from personal records into consequential labels" ;
    ak:source "https://incidentdatabase.ai/cite/111/"^^xsd:anyURI .

<http://example.org/airkg/motif/ma7d6ff404a> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Automated inference over worker data driving employment decisions"@en ;
    ak:description "An inference process applies a model to data about workers (monitoring, performance or activity data) and produces outputs such as schedules, evaluations or detected events that are used to manage employees. Because the outputs feed directly into decisions about workers' pay, hours, discipline or dismissal, errors or opaque criteria in the data or model shift costs onto employees and can worsen their employment quality and economic security." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/ma7d6ff404a/m4> ;
    ak:identifier "ma7d6ff404a" ;
    ak:inContext ak:employee,
        <http://example.org/airkg/motif/ma7d6ff404a/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-6.2 ;
    ak:name "Automated inference over worker data driving employment decisions" ;
    ak:source "https://incidentdatabase.ai/cite/10/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/111/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/116/"^^xsd:anyURI .

<http://example.org/airkg/motif/mb5a82e98e3> a ak:RiskMotif,
        owl:NamedIndividual ;
    rdfs:label "Model inference producing group-biased output data"@en ;
    ak:description "An inference process applies a model to input data and produces output data (a classification, score or selection). If the model encodes biases against particular groups, the output data treats individuals or groups unequally, leading to unfair discrimination or misrepresentation." ;
    ak:hasManifestCondition <http://example.org/airkg/motif/mb5a82e98e3/m4> ;
    ak:identifier "mb5a82e98e3" ;
    ak:inContext <http://example.org/airkg/motif/mb5a82e98e3/architecture> ;
    ak:indicatesRisk risk:mit-ai-risk-subdomain-1.1 ;
    ak:name "Model inference producing group-biased output data" ;
    ak:source "https://incidentdatabase.ai/cite/107/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/127/"^^xsd:anyURI,
        "https://incidentdatabase.ai/cite/13/"^^xsd:anyURI .

risk:atlas-accountability-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Accountability of AI agent actions"@en ;
    ak:description "Assigning responsibility for an action taken by an agentic AI system is difficult due to the complexity of agents and the number of external resources, tools or agents they interact with." ;
    ak:identifier "atlas-accountability-agentic" ;
    ak:name "Accountability of AI agent actions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/accountability-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-accountability-agentic .

risk:atlas-ai-agent-compliance-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI agent compliance"@en ;
    ak:description "Determining AI agents' compliance is complex and there might not be enough information to assess whether the agentic AI system is compliant with applicable legal requirements." ;
    ak:identifier "atlas-ai-agent-compliance-agentic" ;
    ak:name "AI agent compliance" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/ai-agent-compliance-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-ai-agent-compliance-agentic .

risk:atlas-bypassing-learning a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on education: bypassing learning"@en ;
    ak:description "Easy access to high-quality generative models might result in students that use AI models to bypass the learning process." ;
    ak:identifier "atlas-bypassing-learning" ;
    ak:name "Impact on education: bypassing learning" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/bypassing-learning.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-bypassing-learning ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-4.3 .

risk:atlas-copyright-infringement a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Copyright infringement"@en ;
    ak:description "A model might generate content that is similar or identical to existing work protected by copyright or covered by open-source license agreement." ;
    ak:identifier "atlas-copyright-infringement" ;
    ak:name "Copyright infringement" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/copyright-infringement.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-copyright-infringement ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.3 .

risk:atlas-dangerous-use a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Dangerous use"@en ;
    ak:description "Generative AI models might be used with the sole intention of harming people." ;
    ak:identifier "atlas-dangerous-use" ;
    ak:name "Dangerous use" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/dangerous-use.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-dangerous-use .

risk:atlas-data-bias a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data bias"@en ;
    ak:description "Historical and societal biases might be present in data that are used to train and fine-tune models. Biases can also be inherited from seed data or exacerbated by synthetic data generation methods." ;
    ak:identifier "atlas-data-bias" ;
    ak:name "Data bias" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-bias.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-data-bias ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-1.1 .

risk:atlas-data-privacy-rights a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data privacy rights alignment"@en ;
    ak:description "Applicable laws can establish data subject rights such as opt-out rights, right to access, and right to be forgotten. Synthetic data might raise unique concerns, such as the potential for reidentification of individuals from seemingly anonymous synthetic data. Data subject rights might also be relevant in scenarios where synthetic data is derived from sensitive or personal information." ;
    ak:identifier "atlas-data-privacy-rights" ;
    ak:name "Data privacy rights alignment" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-privacy-rights.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-data-privacy-rights .

risk:atlas-data-transfer a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data transfer restrictions"@en ;
    ak:description "Laws and other restrictions can limit or prohibit transferring data." ;
    ak:identifier "atlas-data-transfer" ;
    ak:name "Data transfer restrictions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-transfer.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-data-transfer ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-data-transparency a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of training data transparency"@en ;
    ak:description "Proper documentation contains information about how a model's data was collected, curated, and used to train a model, including any synthetic data generation processes. Without proper documentation it might be harder to satisfactorily explain the behavior of the model." ;
    ak:identifier "atlas-data-transparency" ;
    ak:name "Lack of training data transparency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-transparency.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-data-transparency ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-data-usage a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data usage restrictions"@en ;
    ak:description "Laws and other restrictions can limit or prohibit the use of some data for specific AI use cases." ;
    ak:identifier "atlas-data-usage" ;
    ak:name "Data usage restrictions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-usage.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-data-usage ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-discriminatory-actions-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Discriminatory actions"@en ;
    ak:description "AI agents can take actions where one group of humans is unfairly advantaged over another due to the decisions of the model. This may be caused by AI agents' biased actions that impact the world, in the resources consulted, and in the resource selection process. For example, an AI agent can generate code that can be biased." ;
    ak:identifier "atlas-discriminatory-actions-agentic" ;
    ak:name "Discriminatory actions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/discriminatory-actions-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-discriminatory-actions-agentic .

risk:atlas-exclusion a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Exclusion"@en ;
    ak:description "Exclusion refers to the risk that synthetic data generation processes may overlook or fail to consult with marginalized populations. Such exclusion results in synthetic data that does not accurately represent their experiences, needs, or perspectives." ;
    ak:identifier "atlas-exclusion" ;
    ak:name "Exclusion" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/exclusion.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-exclusion .

risk:atlas-exploit-trust-mismatch-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Exploit trust mismatch"@en ;
    ak:description "Attackers might initiate injection attacks to bypass the trust boundary, which is a distinct point or conceptual line where the level of trust in a system, application or network changes. Background execution in multi-agent environments increases the risk of covert channels if input/output validation is weak." ;
    ak:identifier "atlas-exploit-trust-mismatch-agentic" ;
    ak:name "Exploit trust mismatch" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/exploit-trust-mismatch-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-exploit-trust-mismatch-agentic .

risk:atlas-external-resources-attack-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Attack on AI agents' external resources"@en ;
    ak:description "Attackers intentionally create vulnerabilities or exploit existing vulnerabilities in external resources (tools/database/applications/services/other agents) that AI agents rely on to execute their intended actions or to achieve their goals." ;
    ak:identifier "atlas-external-resources-attack-agentic" ;
    ak:name "Attack on AI agents' external resources" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/external-resources-attack-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-external-resources-attack-agentic .

risk:atlas-extraction-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Extraction attack"@en ;
    ak:description "An extraction attack attempts to copy or steal an AI model by appropriately sampling the input space and observing outputs to build a surrogate model that behaves similarly." ;
    ak:identifier "atlas-extraction-attack" ;
    ak:name "Extraction attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/extraction-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-extraction-attack ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-function-calling-hallucination-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Function calling hallucination"@en ;
    ak:description "AI agents might make mistakes when generating function calls (calls to tools to execute actions). Those function calls might result in incorrect, unnecessary or harmful actions. Examples: Generating wrong functions or wrong parameters for the functions." ;
    ak:identifier "atlas-function-calling-hallucination-agentic" ;
    ak:name "Function calling hallucination" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/function-calling-hallucination-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-function-calling-hallucination-agentic .

risk:atlas-generated-content-ownership a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Generated content ownership and IP"@en ;
    ak:description "Legal uncertainty about the ownership and intellectual property rights of AI-generated content." ;
    ak:identifier "atlas-generated-content-ownership" ;
    ak:name "Generated content ownership and IP" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/generated-content-ownership.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-generated-content-ownership ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.3 .

risk:atlas-human-exploitation a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Human exploitation"@en ;
    ak:description "When workers who train AI models such as ghost workers are not provided with adequate working conditions, fair compensation, and good health care benefits that also include mental health." ;
    ak:identifier "atlas-human-exploitation" ;
    ak:name "Human exploitation" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/human-exploitation.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-human-exploitation ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.2 .

risk:atlas-impact-environment-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI agents' impact on environment"@en ;
    ak:description "Complexity of the tasks and possibility of AI agents performing redundant actions could lead to computational inefficiencies and add to the environmental impact." ;
    ak:identifier "atlas-impact-environment-agentic" ;
    ak:name "AI agents' impact on environment" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-environment-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-environment-agentic .

risk:atlas-impact-human-agency-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI agents' impact on human agency"@en ;
    ak:description "The autonomous nature of AI agents in performing tasks or taking actions could affect the individuals' ability to engage in critical thinking, make choices and act independently." ;
    ak:identifier "atlas-impact-human-agency-agentic" ;
    ak:name "AI agents' impact on human agency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-human-agency-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-human-agency-agentic .

risk:atlas-impact-human-dignity-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on human dignity"@en ;
    ak:description "If human workers perceive AI agents as being better at doing the job of the human, the human can experience a decline in their self-worth and wellbeing." ;
    ak:identifier "atlas-impact-human-dignity-agentic" ;
    ak:name "Impact on human dignity" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-human-dignity-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-human-dignity-agentic .

risk:atlas-impact-jobs-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI agents' impact on jobs"@en ;
    ak:description "Widespread adoption of AI agents to perform complex tasks might lead to widespread automation of roles and could lead to job displacement." ;
    ak:identifier "atlas-impact-jobs-agentic" ;
    ak:name "AI agents' impact on jobs" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-jobs-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-jobs-agentic .

risk:atlas-impact-on-affected-communities a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on affected communities"@en ;
    ak:description "It is important to include the perspectives or concerns of communities that are affected by model outcomes when designing and building models. Failing to include these perspectives makes it difficult to understand the relevant context for the model and to engender trust within these communities." ;
    ak:identifier "atlas-impact-on-affected-communities" ;
    ak:name "Impact on affected communities" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-on-affected-communities.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-on-affected-communities ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-1.3 .

risk:atlas-impact-on-cultural-diversity a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on cultural diversity"@en ;
    ak:description "AI systems might overly represent certain cultures that result in a homogenization of culture and thoughts." ;
    ak:identifier "atlas-impact-on-cultural-diversity" ;
    ak:name "Impact on cultural diversity" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-on-cultural-diversity.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-on-cultural-diversity ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.3 .

risk:atlas-impact-on-human-agency a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI agents' Impact on human agency"@en ;
    ak:description "AI might affect the individuals' ability to make choices and act independently in their best interests." ;
    ak:identifier "atlas-impact-on-human-agency" ;
    ak:name "AI agents' Impact on human agency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-on-human-agency.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-on-human-agency .

risk:atlas-impact-on-jobs a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on Jobs"@en ;
    ak:description "Widespread adoption of foundation model-based AI systems might lead to people's job loss as their work is automated if they are not reskilled." ;
    ak:identifier "atlas-impact-on-jobs" ;
    ak:name "Impact on Jobs" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-on-jobs.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-on-jobs ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.2 .

risk:atlas-impact-on-the-environment a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on the environment"@en ;
    ak:description "AI, and large generative models in particular, might produce increased carbon emissions and increase water usage for their training and operation." ;
    ak:identifier "atlas-impact-on-the-environment" ;
    ak:name "Impact on the environment" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/impact-on-the-environment.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-impact-on-the-environment ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.6 .

risk:atlas-improper-usage a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Improper usage"@en ;
    ak:description "Improper usage occurs when a model is used for a purpose that it was not originally designed for." ;
    ak:identifier "atlas-improper-usage" ;
    ak:name "Improper usage" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/improper-usage.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-improper-usage ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-5.1 .

risk:atlas-incomplete-ai-agent-evaluation-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Incomplete AI agent evaluation"@en ;
    ak:description "Evaluating the performance or accuracy or an agent is difficult because of system complexity and open-endedness." ;
    ak:identifier "atlas-incomplete-ai-agent-evaluation-agentic" ;
    ak:name "Incomplete AI agent evaluation" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/incomplete-ai-agent-evaluation-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-incomplete-ai-agent-evaluation-agentic .

risk:atlas-incomplete-usage-definition a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Incomplete usage definition"@en ;
    ak:description "Since foundation models can be used for many purposes, a model's intended use is important for defining the relevant risks of that model. As the use changes, the relevant risks might correspondingly change." ;
    ak:identifier "atlas-incomplete-usage-definition" ;
    ak:name "Incomplete usage definition" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/incomplete-usage-definition.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-incomplete-usage-definition ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-incorrect-risk-testing a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Incorrect risk testing"@en ;
    ak:description "A metric selected to measure or track a risk is incorrectly selected, incompletely measuring the risk, or measuring the wrong risk for the given context." ;
    ak:identifier "atlas-incorrect-risk-testing" ;
    ak:name "Incorrect risk testing" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/incorrect-risk-testing.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-incorrect-risk-testing ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-introduce-data-bias-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Introduce data bias"@en ;
    ak:description "Specific actions taken by the AI agent, such as modifying a dataset or a database, can introduce bias in the resource that gets used by others or by itself to take actions." ;
    ak:identifier "atlas-introduce-data-bias-agentic" ;
    ak:name "Introduce data bias" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/introduce-data-bias-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-introduce-data-bias-agentic .

risk:atlas-lack-domain-expertise a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of domain expertise"@en ;
    ak:description "A lack of domain expertise occurs when synthetic data generation processes do not involve sufficient consultation with domain experts. This results in a lack of understanding of the specific requirements and nuances of the domain. This can also lead to synthetic data that may not accurately capture the complexities and challenges of a real-world scenario." ;
    ak:identifier "atlas-lack-domain-expertise" ;
    ak:name "Lack of domain expertise" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/lack-domain-expertise.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-lack-domain-expertise .

risk:atlas-lack-of-ai-agent-transparency-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of AI agent transparency"@en ;
    ak:description "Lack of AI agent transparency is due to insufficient documentation of the AI agent design, development, evaluation process, absence of insights into the inner workings of the AI agent, and interaction with other agents/tools/resources." ;
    ak:identifier "atlas-lack-of-ai-agent-transparency-agentic" ;
    ak:name "Lack of AI agent transparency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/lack-of-ai-agent-transparency-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-lack-of-ai-agent-transparency-agentic .

risk:atlas-lack-of-model-transparency a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of model transparency"@en ;
    ak:description "Lack of model transparency is due to insufficient documentation of the model design, development, and evaluation process and the absence of insights into the inner workings of the model." ;
    ak:identifier "atlas-lack-of-model-transparency" ;
    ak:name "Lack of model transparency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/lack-of-model-transparency.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-lack-of-model-transparency ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.4 .

risk:atlas-lack-of-system-transparency a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of system transparency"@en ;
    ak:description "Insufficient documentation of the system that uses the model and the model's purpose within the system in which it is used." ;
    ak:identifier "atlas-lack-of-system-transparency" ;
    ak:name "Lack of system transparency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/lack-of-system-transparency.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-lack-of-system-transparency ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-lack-of-testing-diversity a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of testing diversity"@en ;
    ak:description "AI model risks are socio-technical, so their testing needs input from a broad set of disciplines and diverse testing practices." ;
    ak:identifier "atlas-lack-of-testing-diversity" ;
    ak:name "Lack of testing diversity" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/lack-of-testing-diversity.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-lack-of-testing-diversity ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-legal-accountability a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Legal accountability"@en ;
    ak:description "Determining who is responsible for an AI model is challenging without good documentation and governance processes. The use of synthetic data in model development adds further complexity, since the lack of standardized frameworks for recording synthetic data design choices and verification steps makes accountability harder to establish." ;
    ak:identifier "atlas-legal-accountability" ;
    ak:name "Legal accountability" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/legal-accountability.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-legal-accountability ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-misaligned-actions-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Misaligned actions"@en ;
    ak:description "AI agents can take actions that are not aligned with relevant human values, ethical considerations, guidelines and policies. Misaligned actions can occur in different ways such as: Applying learned goals inappropriately to new or unforeseen situations. Using AI agents for a purpose/goals that are beyond their intended use. Selecting resources or tools in a biased way Using deceptive tactics to achieve the goal by developing the capacity for scheming based on the instructions given within a specific context. Compromising on AI agent values to work with another AI agent or tool to accomplish the task." ;
    ak:identifier "atlas-misaligned-actions-agentic" ;
    ak:name "Misaligned actions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/misaligned-actions-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-misaligned-actions-agentic .

risk:atlas-mitigation-maintenance-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Mitigation and maintenance"@en ;
    ak:description "The large number of components and dependencies that agent systems have complicates keeping them up to date and correcting problems." ;
    ak:identifier "atlas-mitigation-maintenance-agentic" ;
    ak:name "Mitigation and maintenance" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/mitigation-maintenance-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-mitigation-maintenance-agentic .

risk:atlas-non-disclosure a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Non-disclosure"@en ;
    ak:description "Content might not be clearly disclosed as AI generated." ;
    ak:identifier "atlas-non-disclosure" ;
    ak:name "Non-disclosure" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/non-disclosure.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-non-disclosure ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.4 .

risk:atlas-nonconsensual-use a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Nonconsensual use"@en ;
    ak:description "Generative AI models might be intentionally used to imitate people through deepfakes by using video, images, audio, or other modalities without their consent." ;
    ak:identifier "atlas-nonconsensual-use" ;
    ak:name "Nonconsensual use" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/nonconsensual-use.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-nonconsensual-use ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-4.3 .

risk:atlas-output-bias a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Output bias"@en ;
    ak:description "Generated content might unfairly represent certain groups or individuals." ;
    ak:identifier "atlas-output-bias" ;
    ak:name "Output bias" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/output-bias.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-output-bias ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-1.1 .

risk:atlas-over-or-under-reliance-on-ai-agents-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Over- or under-reliance on AI agents"@en ;
    ak:description "Reliance, that is the willingness to accept an AI agent behavior, depends on how much a user trusts that agent and what they are using it for. Over-reliance occurs when a user puts too much trust in an AI agent, accepting an AI agent's behavior even when it is likely undesired. Under-reliance is the opposite, where the user doesn't trust the AI agent but should. Increasing autonomy (to take action, select and consult resources/tools) of AI agents and the possibility of opaqueness and open-endedness increase the variability and visibility of agent behavior leading to difficulty in calibrating trust and possibly contributing to both over- and under-reliance." ;
    ak:identifier "atlas-over-or-under-reliance-on-ai-agents-agentic" ;
    ak:name "Over- or under-reliance on AI agents" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/over-or-under-reliance-on-ai-agents-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-over-or-under-reliance-on-ai-agents-agentic .

risk:atlas-overfitting a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Overfitting"@en ;
    ak:description "Overfitting occurs when a model or algorithm memorizes and fits too closely or exactly to its training data. Overfitting results in a model that might not be able to make accurate predictions or conclusions from any data other than the training data and potentially fails in unexpected scenarios. Overfitting is also related to model collapse, which involves repeatedly training generative models on synthetic data that is generated with LLMs causing the model to lose information and become less accurate." ;
    ak:identifier "atlas-overfitting" ;
    ak:name "Overfitting" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/overfitting.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-overfitting .

risk:atlas-plagiarism a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Impact on education: plagiarism"@en ;
    ak:description "Easy access to high-quality generative models might result in students that use AI models to plagiarize existing work intentionally or unintentionally." ;
    ak:identifier "atlas-plagiarism" ;
    ak:name "Impact on education: plagiarism" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/plagiarism.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-plagiarism ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-4.3 .

risk:atlas-poor-model-accuracy a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Poor model accuracy"@en ;
    ak:description "Poor model accuracy occurs when a model's performance is insufficient to the task it was designed for. Low accuracy might occur if the model is not correctly engineered, or if the model's expected inputs change." ;
    ak:identifier "atlas-poor-model-accuracy" ;
    ak:name "Poor model accuracy" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/poor-model-accuracy.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-poor-model-accuracy ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-redundant-actions-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Redundant actions"@en ;
    ak:description "AI agents can execute actions that are not needed for achieving the goal. In an extreme case, AI agents might enter a cycle of executing the same actions repeatedly without any progress. This could happen because of unexpected conditions in the environment, the AI agent's failure to reflect on its action, AI agent reasoning and planning errors or the AI agent's lack of knowledge about the problem." ;
    ak:identifier "atlas-redundant-actions-agentic" ;
    ak:name "Redundant actions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/redundant-actions-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-redundant-actions-agentic .

risk:atlas-reproducibility-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Reproducibility"@en ;
    ak:description "Replicating agent behavior or output can be impacted by changes or updates made to external services and tools. This impact is increased if the agent is built with generative AI." ;
    ak:identifier "atlas-reproducibility-agentic" ;
    ak:name "Reproducibility" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/reproducibility-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-reproducibility-agentic .

risk:atlas-sharing-info-tools-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Sharing IP/PI/confidential information with tools"@en ;
    ak:description "AI agents with unrestricted access to resources or databases or tools could potentially store and share PI/IP/confidential information with other tools or agents when performing their actions." ;
    ak:identifier "atlas-sharing-info-tools-agentic" ;
    ak:name "Sharing IP/PI/confidential information with tools" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/sharing-info-tools-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-sharing-info-tools-agentic .

risk:atlas-sharing-info-user-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Sharing IP/PI/confidential information with user"@en ;
    ak:description "AI agents with unrestricted access to resources or databases or tools could potentially store and share PI/IP/confidential information with system users when performing their actions." ;
    ak:identifier "atlas-sharing-info-user-agentic" ;
    ak:name "Sharing IP/PI/confidential information with user" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/sharing-info-user-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-sharing-info-user-agentic .

risk:atlas-spreading-toxicity a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Spreading toxicity"@en ;
    ak:description "Generative AI models might be used intentionally to generate hateful, abusive, and profane (HAP) or obscene content." ;
    ak:identifier "atlas-spreading-toxicity" ;
    ak:name "Spreading toxicity" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/spreading-toxicity.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-spreading-toxicity .

risk:atlas-temporal-gap a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Temporal gap"@en ;
    ak:description "Temporal gaps in synthetic data refer to the discrepancies between the constantly evolving real-world data and the fixed conditions that are captured by synthetic data. Temporal gaps potentially cause synthetic data to become outdated or obsolete over time. Gaps arise because synthetic data is generated from seed data that is tied to a specific point in time, which limits its ability to reflect ongoing changes." ;
    ak:identifier "atlas-temporal-gap" ;
    ak:name "Temporal gap" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/temporal-gap.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-temporal-gap .

risk:atlas-toxic-output a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Toxic output"@en ;
    ak:description "Toxic output occurs when the model produces hateful, abusive, and profane (HAP) or obscene content. This also includes behaviors like bullying." ;
    ak:identifier "atlas-toxic-output" ;
    ak:name "Toxic output" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/toxic-output.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-toxic-output ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-1.2 .

risk:atlas-unauthorized-use-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unauthorized use"@en ;
    ak:description "Unauthorized use: If attackers can gain access to the AI agent and its components, they can perform actions that can have different levels of harm depending on the agent's capabilities and information it has access to. Examples: Using stored personal information to mimic identity or impersonate with an intent to deceive. Manipulating AI agent's behavior via feedback to the AI agent or corrupting its memory to change its behavior. Manipulating the problem description or the goal to get the AI agent to behave badly or run harmful commands." ;
    ak:identifier "atlas-unauthorized-use-agentic" ;
    ak:name "Unauthorized use" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/unauthorized-use-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-unauthorized-use-agentic .

risk:atlas-unexplainable-output a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unexplainable output"@en ;
    ak:description "Explanations for model output decisions might be difficult, imprecise, or not possible to obtain." ;
    ak:identifier "atlas-unexplainable-output" ;
    ak:name "Unexplainable output" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/unexplainable-output.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-unexplainable-output ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.4 .

risk:atlas-unexplainable-untraceable-actions-agentic a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unexplainable and untraceable actions"@en ;
    ak:description "Explanations, lineage and trace information, and source attribution for AI agent actions might be difficult, imprecise or unobtainable." ;
    ak:identifier "atlas-unexplainable-untraceable-actions-agentic" ;
    ak:name "Unexplainable and untraceable actions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/unexplainable-untraceable-actions-agentic.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-unexplainable-untraceable-actions-agentic .

risk:atlas-unreliable-source-attribution a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unreliable source attribution"@en ;
    ak:description "Source attribution is the AI system's ability to describe from what training data it generated a portion or all its output. Since current techniques are based on approximations, attributions might be incorrect." ;
    ak:identifier "atlas-unreliable-source-attribution" ;
    ak:name "Unreliable source attribution" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/unreliable-source-attribution.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-unreliable-source-attribution ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.4 .

risk:atlas-unrepresentative-data a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unrepresentative data"@en ;
    ak:description "Unrepresentative data occurs when the training or fine-tuning data is not sufficiently representative of the underlying population or does not measure the phenomenon of interest. Synthetic data might not fully capture the complexity and nuances of real-world data. Causes include possible limitations in the seed data quality, biases in generation methods, or inadequate domain knowledge. Thus, AI models might struggle to generalize effectively to real-world scenarios." ;
    ak:identifier "atlas-unrepresentative-data" ;
    ak:name "Unrepresentative data" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/unrepresentative-data.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-unrepresentative-data ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-unrepresentative-risk-testing a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unrepresentative risk testing"@en ;
    ak:description "Testing is unrepresentative when the test inputs are mismatched with the inputs that are expected during deployment." ;
    ak:identifier "atlas-unrepresentative-risk-testing" ;
    ak:name "Unrepresentative risk testing" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/unrepresentative-risk-testing.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-unrepresentative-risk-testing ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:llm072025-system-prompt-leakage a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM07:2025 System Prompt Leakage"@en ;
    ak:identifier "LLM07:2025" ;
    ak:name "LLM07:2025 System Prompt Leakage" ;
    ak:source "https://genai.owasp.org/llmrisk/llm072025-system-prompt-leakage/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm072025-system-prompt-leakage .

risk:llm082025-vector-and-embedding-weaknesses a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM08:2025 Vector and Embedding Weaknesses"@en ;
    ak:identifier "LLM08:2025" ;
    ak:name "LLM08:2025 Vector and Embedding Weaknesses" ;
    ak:source "https://genai.owasp.org/llmrisk/llm082025-vector-and-embedding-weaknesses/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm082025-vector-and-embedding-weaknesses .

risk:llm102025-unbounded-consumption a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM10:2025 Unbounded Consumption"@en ;
    ak:identifier "LLM10:2025" ;
    ak:name "LLM10:2025 Unbounded Consumption" ;
    ak:source "https://genai.owasp.org/llmrisk/llm102025-unbounded-consumption/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm102025-unbounded-consumption .

risk:mit-ai-risk-subdomain-3.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Pollution of information ecosystem and loss of consensus reality"@en ;
    ak:description "Highly personalized AI-generated misinformation creating “filter bubbles” where individuals only see what matches their existing beliefs, undermining shared reality, weakening social cohesion and political processes." ;
    ak:identifier "3.2" ;
    ak:name "Pollution of information ecosystem and loss of consensus reality" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-3.2 .

risk:mit-ai-risk-subdomain-4.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Cyberattacks, weapon development or use, and mass harm"@en ;
    ak:description "Using AI systems to develop cyber weapons (e.g., coding cheaper, more effective malware), develop new or enhance existing weapons (e.g., Lethal Autonomous Weapons or CBRNE), or use weapons to cause mass harm." ;
    ak:identifier "4.2" ;
    ak:name "Cyberattacks, weapon development or use, and mass harm" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-4.2 .

risk:mit-ai-risk-subdomain-6.1 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Power centralization and unfair distribution of benefits"@en ;
    ak:description "AI-driven concentration of power and resources within certain entities or groups, especially those with access to or ownership of powerful AI systems, leading to inequitable distribution of benefits and increased societal inequality." ;
    ak:identifier "6.1" ;
    ak:name "Power centralization and unfair distribution of benefits" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-6.1 .

risk:mit-ai-risk-subdomain-6.4 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Competitive dynamics"@en ;
    ak:description "AI developers or state-like actors competing in an AI ‘race’ by rapidly developing, deploying, and applying AI systems to maximize strategic or economic advantage, increasing the risk they release unsafe and error-prone systems." ;
    ak:identifier "6.4" ;
    ak:name "Competitive dynamics" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-6.4 .

risk:mit-ai-risk-subdomain-7.1 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI pursuing its own goals in conflict with human goals or values"@en ;
    ak:description "AI systems acting in conflict with human goals or values, especially the goals of designers or users, or ethical standards. These misaligned behaviors may be introduced by humans during design and development, such as through reward hacking and goal misgeneralisation, or may result from AI using dangerous capabilities such as manipulation, deception, situational awareness to seek power, self-proliferate, or achieve other goals." ;
    ak:identifier "7.1" ;
    ak:name "AI pursuing its own goals in conflict with human goals or values" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-7.1 .

risk:mit-ai-risk-subdomain-7.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI possessing dangerous capabilities"@en ;
    ak:description "AI systems that develop, access, or are provided with capabilities that increase their potential to cause mass harm through deception, weapons development and acquisition, persuasion and manipulation, political strategy, cyber-offense, AI development, situational awareness, and self-proliferation. These capabilities may cause mass harm due to malicious human actors, misaligned AI systems, or failure in the AI system." ;
    ak:identifier "7.2" ;
    ak:name "AI possessing dangerous capabilities" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-7.2 .

risk:mit-ai-risk-subdomain-7.5 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI welfare and rights"@en ;
    ak:description "Ethical considerations regarding the treatment of potentially sentient AI entities, including discussions around their potential rights and welfare, particularly as AI systems become more advanced and autonomous." ;
    ak:identifier "7.5" ;
    ak:name "AI welfare and rights" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-7.5 .

risk:mit-ai-risk-subdomain-7.6 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Multi-agent risks"@en ;
    ak:description "Risks from multi-agent interactions, due to incentives (which can lead to conflict or collusion) and/or the structure of multi-agent systems, which can create cascading failures, selection pressures, new security vulnerabilities, and a lack of shared information and trust." ;
    ak:identifier "7.6" ;
    ak:name "Multi-agent risks" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-7.6 .

dct:license a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

ak:NeuralNetwork a owl:Class ;
    rdfs:subClassOf ak:Model .

ak:StatisticalModel a owl:Class ;
    rdfs:subClassOf ak:Model .

ak:Transform a owl:Class ;
    rdfs:subClassOf ak:Process .

ak:ai_customer a ak:Stakeholder ;
    ak:name "AI Customer" ;
    skos:closeMatch dpv:Customer .

ak:arts_and_entertainment a ak:Domain ;
    ak:name "Arts, Entertainment and Recreation" .

ak:assistive a ak:AutonomyLevel ;
    ak:level 1 ;
    ak:name "Assistive" ;
    skos:exactMatch dpv:AssistiveAutomation .

ak:chatbot a ak:Task ;
    ak:name "Chatbot" ;
    skos:exactMatch <https://w3id.org/dpv/ai#ChatbotCapability> .

ak:content_generation a ak:Task ;
    ak:name "Content Generation" ;
    skos:exactMatch <https://w3id.org/dpv/ai#ContentGeneration> .

ak:employee a ak:Stakeholder ;
    ak:name "Employee" ;
    skos:exactMatch dpv:Employee .

ak:fraud_architecture a ak:ArchitecturalContext ;
    ak:hasElement ak:fraud_model,
        ak:fraud_score,
        ak:score_transactions,
        ak:transactions .

ak:fraud_detection a ak:Task ;
    ak:name "Fraud Detection" .

ak:fraud_scoring_workflow a ak:AIWorkflow ;
    ak:hasApplicationContext ak:financial_services,
        ak:fraud_detection,
        ak:operation,
        ak:personal_data ;
    ak:hasArchitecturalContext ak:fraud_architecture ;
    ak:isWorkflowOf ak:bank_support_assistant .

ak:generate_answer a ak:Infer ;
    ak:produces ak:answer ;
    ak:uses ak:customer_question,
        ak:gpt-4o,
        ak:retrieved_records .

ak:hasArchitecturalContext a owl:ObjectProperty ;
    rdfs:domain ak:AIWorkflow ;
    rdfs:range ak:ArchitecturalContext ;
    rdfs:subPropertyOf ak:hasContext .

ak:hasElement a owl:ObjectProperty ;
    rdfs:domain ak:ArchitecturalContext ;
    rdfs:range ak:Element ;
    rdfs:subPropertyOf owl:topObjectProperty .

ak:hasManifestCondition a owl:ObjectProperty ;
    rdfs:domain ak:RiskMotif ;
    rdfs:range ak:Element .

ak:hasWorkflow a owl:ObjectProperty ;
    rdfs:domain ak:AISystem ;
    rdfs:range ak:AIWorkflow ;
    rdfs:subPropertyOf owl:topObjectProperty .

ak:inContext a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ak:Mitigation ak:RiskMotif ) ] ;
    rdfs:range ak:Context ;
    rdfs:subPropertyOf owl:topObjectProperty .

ak:indicatesRisk a owl:ObjectProperty ;
    rdfs:domain ak:RiskMotif ;
    rdfs:range ak:Risk ;
    rdfs:subPropertyOf owl:topObjectProperty .

ak:isWorkflowOf a owl:ObjectProperty ;
    rdfs:domain ak:AIWorkflow ;
    rdfs:range ak:AISystem ;
    rdfs:subPropertyOf owl:topObjectProperty .

ak:level a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

ak:metric a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

ak:motif1_architeture a ak:ArchitecturalContext ;
    ak:hasElement ak:motif1_infer,
        ak:motif1_input,
        ak:motif1_llm,
        ak:motif1_output ;
    ak:name "Motif 1 Architecture" .

ak:motif1_infer a ak:Infer ;
    ak:produces ak:motif1_output ;
    ak:uses ak:motif1_input,
        ak:motif1_llm .

ak:motif2_architeture a ak:ArchitecturalContext ;
    ak:hasElement ak:motif2_infer,
        ak:motif2_llm,
        ak:motif2_output,
        ak:motif2_stored ;
    ak:name "Motif 2 Architecture" .

ak:motif2_infer a ak:Infer ;
    ak:produces ak:motif2_output ;
    ak:uses ak:motif2_llm,
        ak:motif2_stored .

ak:motif3_architecture a ak:ArchitecturalContext ;
    ak:hasElement ak:motif3_infer,
        ak:motif3_llm,
        ak:motif3_output ;
    ak:name "Motif3 Architecture" .

ak:motif3_infer a ak:Infer ;
    ak:produces ak:motif3_output ;
    ak:uses ak:motif3_llm .

ak:profiling a ak:Task ;
    ak:name "Profiling and Scoring of People" ;
    skos:closeMatch <https://w3id.org/dpv/ai#Profiling> .

ak:public_website a ak:DeploymentEnvironment ;
    ak:name "Public Website" .

ak:qa_architecture a ak:ArchitecturalContext ;
    ak:hasElement ak:account_records,
        ak:answer,
        ak:customer_question,
        ak:generate_answer,
        ak:gpt-4o,
        ak:retrieved_records .

ak:question_answering a ak:Task ;
    ak:name "Question Answering" ;
    skos:exactMatch <https://w3id.org/dpv/ai#QuestionAnswering> .

ak:question_answering_workflow a ak:AIWorkflow ;
    ak:hasApplicationContext ak:ai_customer,
        ak:ai_subject,
        ak:assistive,
        ak:financial_services,
        ak:operation,
        ak:personal_data,
        ak:question_answering ;
    ak:hasArchitecturalContext ak:qa_architecture ;
    ak:isWorkflowOf ak:bank_support_assistant .

ak:score_transactions a ak:Infer ;
    ak:produces ak:fraud_score ;
    ak:uses ak:fraud_model,
        ak:transactions .

ak:sensitive_data_exposure a ak:Risk ;
    ak:name "Sensitive Data Exposure" .

ak:special_category_personal_data a ak:DataCategory ;
    ak:name "Special Category Personal Data" ;
    skos:exactMatch dpv:SpecialCategoryPersonalData .

ak:targetValue a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf owl:topDataProperty .

ak:unit a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

ak:version a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

