mitigation:A0167_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Military, warfare & intelligence applications:"@en ;
    ak:description "Any information related to engagements with militaries and intelligence agencies." ;
    ak:identifier "A0167_Future_of_Life_Institute2024" ;
