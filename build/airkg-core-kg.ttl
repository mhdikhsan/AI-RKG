mitigation:A0463_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Configuration Outcome Monitoring"@en ;
    ak:description "Implement systems to continually monitor and track the outcomes of human-GAI configurations for future refinement and improvements." ;
    ak:identifier "A0463_NIST2024" ;
    ak:name "Configuration Outcome Monitoring" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
