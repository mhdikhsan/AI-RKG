        owl:NamedIndividual ;
    rdfs:label "Fine-Tuning Access Threshold"@en ;
    ak:description "Has your firm set a risk or capabilities threshold beyond which access to model fine-tuning should be restricted to prevent harm to the public? If yes, please elaborate on the threshold." ;
    ak:identifier "A0113_Future_of_Life_Institute2024" ;
