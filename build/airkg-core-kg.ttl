mitigation:A0165_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Dangerous capability evaluations"@en ;
    ak:description "This indicator reports on pre-deployment capability evaluations related to catastrophic risks. Model evaluations for other risks are not included here, as the empirical tests covered in the ‘Current Harms’ section provide a superior metric. Information includes evaluated risk domains, available information regarding model versions & task-specific fine-tuning, and relevant sources. We note that quality of evaluations may differ." ;
    ak:identifier "A0165_Future_of_Life_Institute2024" ;
    ak:name "Dangerous capability evaluations" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0165_Future_of_Life_Institute2024 .

