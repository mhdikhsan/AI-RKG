mitigation:A0114_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-tuning protections"@en ;
    ak:description "Fine-tuning restrictions that ensure the integrity of safety mitigations." ;
    ak:identifier "A0114_Future_of_Life_Institute2024" ;
    ak:name "Fine-tuning protections" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
