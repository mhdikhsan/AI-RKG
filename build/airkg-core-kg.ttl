mitigation:A0109_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Early Warning Evaluations for Catastrophic Risks"@en ;
    ak:description "Does your organization evaluate models during training for early warning signs of capabilities related to catastrophic risks to ensure risk thresholds are not exceeded? Please describe the regularity and scope of these evaluations and specify whether models are specifically fine-tuned to elicit the capabilities in question." ;
    ak:identifier "A0109_Future_of_Life_Institute2024" ;
    ak:name "Early Warning Evaluations for Catastrophic Risks" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
