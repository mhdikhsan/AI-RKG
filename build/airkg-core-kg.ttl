        owl:NamedIndividual ;
    rdfs:label "Establish a general purpose incident response mechanism"@en ;
    ak:description "Establish processes to enable incident monitoring and reporting. This includes defining ”serious incidents” or set a threshold for formal reporting based on regulatory requirements to third-parties, regulators, and impacted individuals." ;
