        owl:NamedIndividual ;
    rdfs:label "Information Integrity; Information Security; Value Chain and Component Integration"@en ;
    ak:description "Review various transparency artifacts (e.g., system cards and model cards) for third-party models." ;
    ak:identifier "A0746_NIST2024" ;
    ak:name "Information Integrity; Information Security; Value Chain and Component Integration" ;
