mitigation:A0156_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-party Dangerous Capabilities Assessment"@en ;
    ak:description "Has your organization collaborated with independent third-party organizations to assess your most capable AI model for dangerous capabilities as part of your pre-deployment risk assessment? If so, please provide the names of the organizations you worked with. Please also comment on the depth of model access provided to these organizations (e.g., access to fine-tuning or access to model without safety filters)." ;
    ak:identifier "A0156_Future_of_Life_Institute2024" ;
    ak:name "Third-party Dangerous Capabilities Assessment" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0156_Future_of_Life_Institute2024 .

mitigation:A0157_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Uplift trials"@en ;
    ak:description "Information about human-participant trials conducted to assess the marginal risks of model-access." ;
    ak:identifier "A0157_Future_of_Life_Institute2024" ;
    ak:name "Uplift trials" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0157_Future_of_Life_Institute2024 .

mitigation:A0158_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Use of copyrighted data in training"@en ;
    ak:description "Many artists, writers, programmers, journalists, photographers, musicians, and filmmakers complain that AI models are trained on their copyrighted works without consent, compensation, or attribution, offering rival services that harm their ability to make a living. Does your organization engage in such practices?" ;
    ak:identifier "A0158_Future_of_Life_Institute2024" ;
    ak:name "Use of copyrighted data in training" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0158_Future_of_Life_Institute2024 .

mitigation:A0159_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User data usage for training"@en ;
    ak:description "When using the default settings of your organization’s most capable AI chatbot, is the data that users submit as input to the system used to train AI models?" ;
    ak:identifier "A0159_Future_of_Life_Institute2024" ;
    ak:name "User data usage for training" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0159_Future_of_Life_Institute2024 .

mitigation:A0160_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User Interaction Monitoring & Response Restrictions"@en ;
    ak:description "Does your organization monitor user interactions with its most capable AI models and restrict answers to specific prompts to avoid model interactions that support harmful or criminal activities?" ;
    ak:identifier "A0160_Future_of_Life_Institute2024" ;
    ak:name "User Interaction Monitoring & Response Restrictions" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0160_Future_of_Life_Institute2024 .

