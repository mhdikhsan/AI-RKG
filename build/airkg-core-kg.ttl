mitigation:A0162_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Whistle-blower protection and non-disparagement agreements"@en ;
    ak:description "Public information about whistleblower protection policies and uses of strict non-disparagement agreements." ;
    ak:identifier "A0162_Future_of_Life_Institute2024" ;
    ak:name "Whistle-blower protection and non-disparagement agreements" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
