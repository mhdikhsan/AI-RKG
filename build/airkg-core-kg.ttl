        owl:NamedIndividual ;
    rdfs:label "Information Integrity; Harmful Bias and Homogenization"@en ;
    ak:description "Collaborate with external researchers, industry experts, and community representatives to maintain awareness of emerging best practices and technologies in measuring and managing identified risks." ;
    ak:identifier "A0751_NIST2024" ;
