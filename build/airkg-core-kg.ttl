        owl:NamedIndividual ;
    rdfs:label "Implementation of cybersecurity frameworks"@en ;
    ak:description "AGI labs should comply with information security standards (e.g. ISO/IEC 27001 or NIST Cybersecurity Framework). These standards need to be tailored to an AGI context." ;
    ak:identifier "A0119_Future_of_Life_Institute2024" ;
    ak:name "Implementation of cybersecurity frameworks" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
