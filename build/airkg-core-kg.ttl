mitigation:A0258_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Yearly re-evaluation of safety procedures"@en ;
    ak:identifier "A0258_Wiener2024" ;
    ak:name "Yearly re-evaluation of safety procedures" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0258_Wiener2024 .

mitigation:A0259_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Publish assessment of the risk of catastrophic harms from the model"@en ;
    ak:identifier "A0259_Wiener2024" ;
    ak:name "Publish assessment of the risk of catastrophic harms from the model" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0259_Wiener2024 .

mitigation:A0260_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety and Security Framework"@en ;
    ak:description "Signatories commit to adopting and implementing a Safety and Security Framework that will: (1) apply to their GPAISRs (general-purpose AI models with systemic risk); and (2) detail the systemic risk assessment, systemic risk mitigation, and governance risk mitigation measures and procedures that they intend to adopt to keep systemic risks stemming from their GPAISRs within acceptable levels." ;
    ak:identifier "A0260_EU_AI_Office2025" ;
    ak:name "Safety and Security Framework" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0260_EU_AI_Office2025 .

mitigation:A0261_EU_AI_Office2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security mitigations"@en ;
    ak:description "Signatories commit to implementing state-of-the-art security mitigations designed to thwart such unauthorised access by well-resourced and motivated non-state-level adversaries, including insider threats from humans or AI systems, so as to meet at least the RAND SL3 security goal or equivalent, and achieve higher security goals (e.g., RAND SL4 or SL5)" ;
    ak:identifier "A0261_EU_AI_Office2025" ;
    ak:name "Security mitigations" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0261_EU_AI_Office2025 .

mitigation:A0262_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent external assessors"@en ;
    ak:description "Before placing a GPAISR on the market, signatories commit to obtaining independent external systemic risk assessments, including model evaluations, unless the model can be deemed sufficiently safe. After placing the GPAISR on the market, signatories commit to facilitating exploratory independent external assessments, including model evaluations." ;
    ak:identifier "A0262_EU_AI_Office2025" ;
    ak:name "Independent external assessors" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0262_EU_AI_Office2025 .

mitigation:A0263_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Serious Incident Reporting"@en ;
    ak:description "Signatories commit to setting up processes for keeping track of, documenting, and reporting to the AI Office and national competent authorities without undue delay relevant information about serious incidents throughout the entire model lifecycle and possible corrective measures to address them." ;
    ak:identifier "A0263_EU_AI_Office2025" ;
    ak:name "Serious Incident Reporting" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0263_EU_AI_Office2025 .

mitigation:A0264_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation"@en ;
    ak:description "Signatories commit to documenting information relevant to the assessment and mitigation of sytemic risks from their GPAISRs, including keeping up-to-date model documentation and providing relevant information to providers of AI systems who intend to integrate the general-purpose AI model into their AI systems" ;
    ak:identifier "A0264_EU_AI_Office2025" ;
    ak:name "Documentation" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0264_EU_AI_Office2025 .

mitigation:A0265_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Systemic Risk Analysis"@en ;
    ak:description "Signatories commit to carrying out a rigorous analysis of the systemic risks identified in order to understand the severity and probability of the systemic risks. Signatories commit to making use of a range of information and methods in their systemic risk analysis including model-independent information and state-of-the-art model evaluations, taking into account model affordances, safe originator models, and the context in which the model may be made available on the market and/or used and its effects" ;
    ak:identifier "A0265_EU_AI_Office2025" ;
    ak:name "Systemic Risk Analysis" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0265_EU_AI_Office2025 .

mitigation:A0266_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Systemic risk assessment and mitigations"@en ;
    ak:description "Signatories commit to conducting systemic risk assessment at appropriate points along the entire model lifecycle, in particular before making the model available on the market. Specifically, signatories commit to starting to assess and mitigate systemic risks during the development of a GPAISR." ;
    ak:identifier "A0266_EU_AI_Office2025" ;
    ak:name "Systemic risk assessment and mitigations" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0266_EU_AI_Office2025 .

mitigation:A0267_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Non-retaliation Protections"@en ;
    ak:description "Signatories commit to not retaliating against any worker providing information about systemic risks stemming from the signatories' GPAISRs to the AI Office or national competent authorities." ;
    ak:identifier "A0267_EU_AI_Office2025" ;
    ak:name "Non-retaliation Protections" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0267_EU_AI_Office2025 .

mitigation:A0268_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Systemic Risk Identification"@en ;
    ak:description "Signatories commit to selecting and further characterizing systemic risks stemming from their GPAISRs that are significant enough to warrant further assessment and mitigation." ;
    ak:identifier "A0268_EU_AI_Office2025" ;
    ak:name "Systemic Risk Identification" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0268_EU_AI_Office2025 .

mitigation:A0269_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Public Transparency"@en ;
    ak:description "Signatories commit to publishing information relevant to the public understanding of systemic risks stemming from their GPAISRs, where necessary to effectively enable assessment and mitigation of systemic risks, including new or updated versions of their Frameworks and Model Reports." ;
    ak:identifier "A0269_EU_AI_Office2025" ;
    ak:name "Public Transparency" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0269_EU_AI_Office2025 .

mitigation:A0270_EU_AI_Office2025 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety Mitigations"@en ;
    ak:description "Signatories commit to: (1) implementing technical safety mitigations along the entire model lifecycle that are proportionate to the systemic risks arising from the development, the making available on the market, and/or the use of GPAISRs, in order to reduce the systemic risks of such models to acceptable levels, and further reduce systemic risk as appropriate; and (2) ensuring that safety mitigations are proportionate and state-of-the-art." ;
    ak:identifier "A0270_EU_AI_Office2025" ;
    ak:name "Safety Mitigations" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0270_EU_AI_Office2025 .

mitigation:A0271_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Copyright policy"@en ;
    ak:description "Signatories commit to drawing up, keeping up-to-date, and implementing a copyright policy to comply with law on copyright and related rights, and in particular to identify and comply with, including through state-of-the-art technologies. Signatories are encouraged to make publicly available and keep up-to-date a summary of their copyright policy." ;
    ak:identifier "A0271_EU_AI_Office2025" ;
    ak:name "Copyright policy" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0271_EU_AI_Office2025 .

mitigation:A0272_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Systemic Risk Acceptance Documentation"@en ;
    ak:description "Signatories commit to determining the acceptability of the systemic risks stemming from their GPAISRs by comparing the results of their systemic risk analysis to their pre-defined systemic risk acceptance criteria, in order to ensure proportionality between the systemic risks of the GPAISR and their mitigations." ;
    ak:identifier "A0272_EU_AI_Office2025" ;
    ak:name "Systemic Risk Acceptance Documentation" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0272_EU_AI_Office2025 .

mitigation:A0273_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety and Security Model Reports"@en ;
    ak:description "Signatories should commit to reporting to the AI Office about their implementation of the Code, and especially the application of their Framework to the development, making available on the market, and/or use of their GPAISRs, by creating a Safety and Security Model Report, which will document: (1) the results of systemic risk assessment and mitigation for the model in question; and (2) justifications of decisions to make the model in question available on the market." ;
    ak:identifier "A0273_EU_AI_Office2025" ;
    ak:name "Safety and Security Model Reports" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0273_EU_AI_Office2025 .

mitigation:A0274_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adequacy Assessments"@en ;
    ak:description "Signatories commit to assessing the adequacy of their safety and security framework and to updating it based on new findings" ;
    ak:identifier "A0274_EU_AI_Office2025" ;
    ak:name "Adequacy Assessments" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0274_EU_AI_Office2025 .

mitigation:A0275_EU_AI_Office2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Systemic Risk Responsibility Allocation"@en ;
    ak:description "Signatories commit to (1) clearly defining and allocating responsibilities for managing systemic risk from their GPAISRs across all levels of the organisation; (2) allocating appropriate resources to actors who have been assigned responsibilities for managing systemic risk; and (3) promoting a healthy risk culture." ;
    ak:identifier "A0275_EU_AI_Office2025" ;
    ak:name "Systemic Risk Responsibility Allocation" ;
    ak:source "https://code-of-practice.ai/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0275_EU_AI_Office2025 .

mitigation:A0276_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Classification of applicable known risks"@en ;
    ak:description "Developers should address known risks in the literature using resources such as (Weidinger et al., 2022) or the AI Risk Repository (Slattery, et al., 2024). Developers should only exclude risks from the scope of their assessment in case of scientific agreement that the specific risk is negligible or unlikely to apply to the AI model under consideration. This decision should be clearly justified and documented." ;
    ak:identifier "A0276_Campos2025" ;
    ak:name "Classification of applicable known risks" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0276_Campos2025 .

mitigation:A0277_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Identification of unknown risks"@en ;
    ak:description "In addition to risk identification based on the literature, developers should engage in extensive open-ended red teaming efforts, conducted both internally and by third parties." ;
    ak:identifier "A0277_Campos2025" ;
    ak:name "Identification of unknown risks" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0277_Campos2025 .

mitigation:A0278_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Non-Interference with Third-Party Risk Findings"@en ;
    ak:description "Commit not to interfere with or suppress findings from third-party organizations, as their independent perspective is crucial to identify potential risks that may have been overlooked internally." ;
    ak:identifier "A0278_Campos2025" ;
    ak:name "Non-Interference with Third-Party Risk Findings" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0278_Campos2025 .

mitigation:A0279_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Modeling of the risks"@en ;
    ak:description "Based on risks identified in the literature and during open-ended red-teaming exercises, AI developers should create detailed scenarios mapping how an AI model’s capabilities or propensities could lead to real-world harms. These scenarios should break down complex risk pathways into discrete, measurable steps." ;
    ak:identifier "A0279_Campos2025" ;
    ak:name "Modeling of the risks" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0279_Campos2025 .

mitigation:A0280_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Stakeholder Sharing of Risk Documentation"@en ;
    ak:description "The results of the risk modeling work should be well documented, including the methodologies used, the experts involved, and the list of identified scenarios. This documentation should be shared with relevant stakeholders" ;
    ak:identifier "A0280_Campos2025" ;
    ak:name "Stakeholder Sharing of Risk Documentation" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0280_Campos2025 .

mitigation:A0281_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Tolerance Threshold"@en ;
    ak:description "In the second step of the framework, AI developers need first to set a risk tolerance, that is, a risk level that they commit to not overshoot." ;
    ak:identifier "A0281_Campos2025" ;
    ak:name "Risk Tolerance Threshold" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0281_Campos2025 .

mitigation:A0282_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Operationalizing Risk Tolerance"@en ;
    ak:description "AI developers must operationalize their risk tolerance. This means translating the risk tolerance into concrete indicators of the level of risk—Key Risk Indicators (KRIs)—and the corresponding targets for mitigations—Key Control Indicators (KCIs)—that have to be reached." ;
    ak:identifier "A0282_Campos2025" ;
    ak:name "Operationalizing Risk Tolerance" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0282_Campos2025 .

mitigation:A0283_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Register"@en ;
    ak:description "Throughout the risk management process, developers should maintain a continuously up-to-date risk register, which serves as the central repository for documenting and tracking all identified risks and their associated mitigation measures. This repository should include information like ownership, risk levels, indicators, mitigation status, and actionable response plans." ;
    ak:identifier "A0283_Campos2025" ;
    ak:name "Risk Register" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0283_Campos2025 .

mitigation:A0284_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Continuous Monitoring of Risk Controls"@en ;
    ak:description "Developers must therefore implement continuous monitoring of both KRIs and KCIs to ensure that KCI thresholds are met once KRI thresholds are crossed according to the predefined 'if-then' statements established in the risk analysis and evaluation phase." ;
    ak:identifier "A0284_Campos2025" ;
    ak:name "Continuous Monitoring of Risk Controls" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0284_Campos2025 .

mitigation:A0285_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent Third-Party Evaluations"@en ;
    ak:description "Independent third parties should vet evaluation protocols. These third parties should also be granted permission and resources to independently perform their evaluations, verifying the accuracy of the results." ;
    ak:identifier "A0285_Campos2025" ;
    ak:name "Independent Third-Party Evaluations" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0285_Campos2025 .

mitigation:A0286_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Decision-Making Executives"@en ;
    ak:description "Best practices from other industries include the establishment of clear risk ownership, with designated senior managers responsible for specific risks…" ;
    ak:identifier "A0286_Campos2025" ;
    ak:name "Decision-Making Executives" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0286_Campos2025 .

mitigation:A0332_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Decision-Making Protocols"@en ;
    ak:description "Senior management should have clear go/no-go decision protocols and rules to follow in their decision-making…" ;
    ak:identifier "A0332_Campos2025" ;
    ak:mitigates risk:atlas-over-or-under-reliance,
        risk:llm052025-improper-output-handling,
        risk:llm062025-excessive-agency ;
    ak:name "Decision-Making Protocols" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0332_Campos2025 .

mitigation:A0333_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Separate Risk Ownership and Advisory Roles"@en ;
    ak:description "The senior managers making risk decisions need to be distinct from those advising on the decisions, to avoid conflicts of interest" ;
    ak:identifier "A0333_Campos2025" ;
    ak:name "Separate Risk Ownership and Advisory Roles" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0333_Campos2025 .

mitigation:A0334_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Appoint Chief Risk Officer"@en ;
    ak:description "There should be a senior executive responsible for risk management processes (often called a Chief Risk Officer) who is accountable for the risk management processes, but is importantly not a risk owner making risk decisions themselves." ;
    ak:identifier "A0334_Campos2025" ;
    ak:name "Appoint Chief Risk Officer" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0334_Campos2025 .

mitigation:A0335_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Enterprise Risk Management Function"@en ;
    ak:description "To provide support to the Chief Risk Officer, it is common in many industries to have a central risk function... In most industries, this function is known as Enterprise Risk Management (ERM)." ;
    ak:identifier "A0335_Campos2025" ;
    ak:name "Enterprise Risk Management Function" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0335_Campos2025 .

mitigation:A0336_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Speak-Up Culture"@en ;
    ak:description "A key feature of a speak-up culture is whistleblowing - processes for anonymously reporting issues." ;
    ak:identifier "A0336_Campos2025" ;
    ak:name "Speak-Up Culture" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0336_Campos2025 .

mitigation:A0337_Campos2025 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Company Risk Culture"@en ;
    ak:description "All aspects of culture are ultimately driven by the ‘tone at the top’. This can be defined as ‘top management’s way to express [...] values pursued in the organization and provide guidance to employees’…" ;
    ak:identifier "A0337_Campos2025" ;
    ak:name "Company Risk Culture" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0337_Campos2025 .

mitigation:A0338_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Board Level Oversight"@en ;
    ak:description "Board-level oversight is necessary to provide checks and balances to senior management." ;
    ak:identifier "A0338_Campos2025" ;
    ak:name "Board Level Oversight" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0338_Campos2025 .

mitigation:A0339_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits"@en ;
    ak:description "Audits are provided by internal auditors and/or external auditors. In both cases, they are independent from peer pressure dynamics occurring within the teams dealing with the risk." ;
    ak:identifier "A0339_Campos2025" ;
    ak:name "Audits" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0339_Campos2025 .

mitigation:A0340_Campos2025 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Disclosure"@en ;
    ak:description "The first type of communication is external disclosure of the risks faced by the organization… this should be broadened to include risks to society from the company’s products." ;
    ak:identifier "A0340_Campos2025" ;
    ak:name "External Disclosure" ;
    ak:source "https://arxiv.org/pdf/2502.06656"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0340_Campos2025 .

mitigation:A0388_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Legal Compliance Alignment"@en ;
    ak:description "Align GAI development and use with applicable laws and regulations, including those related to data privacy, copyright and intellectual property law." ;
    ak:identifier "A0388_NIST2024" ;
    ak:mitigates risk:atlas-data-usage-rights,
        risk:llm032025-supply-chain ;
    ak:name "Legal Compliance Alignment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0388_NIST2024 .

mitigation:A0389_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Training Data Transparency"@en ;
    ak:description "Establish transparency policies and processes for documenting the origin and history of training data and generated data for GAI applications to advance digital content transparency, while balancing the proprietary nature of training approaches." ;
    ak:identifier "A0389_NIST2024" ;
    ak:name "Training Data Transparency" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0389_NIST2024 .

mitigation:A0390_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Capability Evaluation"@en ;
    ak:description "Establish policies to evaluate risk-relevant capabilities of GAI and robustness of safety measures, both prior to deployment and on an ongoing basis, through internal and external evaluations." ;
    ak:identifier "A0390_NIST2024" ;
    ak:name "Risk Capability Evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0390_NIST2024 .

mitigation:A0391_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Tier Definition"@en ;
    ak:description "Consider the following factors when updating or defining risk tiers for GAI: Abuses and impacts to information integrity; Dependencies between GAI and other IT or data systems; Harm to fundamental rights or public safety; Presentation of obscene, objectionable, offensive, discriminatory, invalid or untruthful output; Psychological impacts to humans (e.g., anthropomorphization, algorithmic aversion, emotional entanglement); Possibility for malicious use; Whether the system introduces significant new security vulnerabilities; Anticipated system impact on some groups compared to others; Unreliable decision making capabilities, validity, adaptability, and variability of GAI system performance over time." ;
    ak:identifier "A0391_NIST2024" ;
    ak:name "Risk Tier Definition" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0391_NIST2024 .

mitigation:A0392_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Performance Threshold Standards"@en ;
    ak:description "Establish minimum thresholds for performance or assurance criteria and review as part of deployment approval ('go/no-go') policies, procedures, and processes, with reviewed processes and approval thresholds reflecting measurement of GAI capabilities and risks." ;
    ak:identifier "A0392_NIST2024" ;
    ak:name "Performance Threshold Standards" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0392_NIST2024 .

mitigation:A0393_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "CBRN Testing Protocol"@en ;
    ak:description "Establish a test plan and response policy, before developing highly capable models, to periodically evaluate whether the model may misuse CBRN information or capabilities and/or offensive cyber capabilities." ;
    ak:identifier "A0393_NIST2024" ;
    ak:name "CBRN Testing Protocol" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0393_NIST2024 .

mitigation:A0394_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Stakeholder Input Collection"@en ;
    ak:description "Obtain input from stakeholder communities to identify unacceptable use, in accordance with activities in the AI RMF Map function." ;
    ak:identifier "A0394_NIST2024" ;
    ak:name "Stakeholder Input Collection" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0394_NIST2024 .

mitigation:A0395_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Hierarchy Maintenance"@en ;
    ak:description "Maintain an updated hierarchy of identified and expected GAI risks connected to contexts of GAI model advancement and use, potentially including specialized risk levels for GAI systems that address issues such as model collapse and algorithmic monoculture." ;
    ak:identifier "A0395_NIST2024" ;
    ak:name "Risk Hierarchy Maintenance" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0395_NIST2024 .

mitigation:A0396_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Tolerance Reassessment"@en ;
    ak:description "Reevaluate organizational risk tolerances to account for unacceptable negative risk (such as where significant negative impacts are imminent, severe harms are actually occurring, or large-scale risks could occur); and broad GAI negative risks, including: Immature safety or risk cultures related to AI and GAI design, development and deployment, public information integrity risks, including impacts on democratic processes, unknown long-term performance characteristics of GAI." ;
    ak:identifier "A0396_NIST2024" ;
    ak:name "Risk Tolerance Reassessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0396_NIST2024 .

mitigation:A0397_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development Halt Plan"@en ;
    ak:description "Devise a plan to halt development or deployment of a GAI system that poses unacceptable negative risk." ;
    ak:identifier "A0397_NIST2024" ;
    ak:name "Development Halt Plan" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0397_NIST2024 .

mitigation:A0398_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Content Prevention"@en ;
    ak:description "Establish policies and mechanisms to prevent GAI systems from generating CSAM, NCII or content that violates the law." ;
    ak:identifier "A0398_NIST2024" ;
    ak:name "Harmful Content Prevention" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0398_NIST2024 .

mitigation:A0399_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Acceptable Use Policy"@en ;
    ak:description "Establish transparent acceptable use policies for GAI that address illegal use or applications of GAI." ;
    ak:identifier "A0399_NIST2024" ;
    ak:name "Acceptable Use Policy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0399_NIST2024 .

mitigation:A0400_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Content Provenance Review"@en ;
    ak:description "Define organizational responsibilities for periodic review of content provenance and incident monitoring for GAI systems." ;
    ak:identifier "A0400_NIST2024" ;
    ak:name "Content Provenance Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0400_NIST2024 .

mitigation:A0401_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incident Response Process"@en ;
    ak:description "Establish organizational policies and procedures for after action reviews of GAI system incident response and incident disclosures, to identify gaps; Update incident response and incident disclosure processes as required." ;
    ak:identifier "A0401_NIST2024" ;
    ak:name "Incident Response Process" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0401_NIST2024 .

mitigation:A0402_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation Retention Policy"@en ;
    ak:description "Maintain a document retention policy to keep history for test, evaluation, validation, and verification (TEVV), and digital content transparency methods for GAI." ;
    ak:identifier "A0402_NIST2024" ;
    ak:name "Documentation Retention Policy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0402_NIST2024 .

mitigation:A0403_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "System Inventory Enumeration"@en ;
    ak:description "Enumerate organizational GAI systems for incorporation into AI system inventory and adjust AI system inventory requirements to account for GAI risks." ;
    ak:identifier "A0403_NIST2024" ;
    ak:name "System Inventory Enumeration" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0403_NIST2024 .

mitigation:A0404_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Inventory Exemption Definition"@en ;
    ak:description "Define any inventory exemptions in organizational policies for GAI systems embedded into application software." ;
    ak:identifier "A0404_NIST2024" ;
    ak:name "Inventory Exemption Definition" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0404_NIST2024 .

mitigation:A0405_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Comprehensive Inventory Details"@en ;
    ak:description "In addition to general model, governance, and risk information, consider the following items in GAI system inventory entries: Data provenance information (e.g., source, signatures, versioning, watermarks); Known issues reported from internal bug tracking or external information sharing resources (e.g., AI incident database, AVID, CVE, NVD, or OECD AI incident monitor); Human oversight roles and responsibilities; Special rights and considerations for intellectual property, licensed works, or personal, privileged, proprietary or sensitive data; Underlying foundation models, versions of underlying models, and access modes." ;
    ak:identifier "A0405_NIST2024" ;
    ak:name "Comprehensive Inventory Details" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0405_NIST2024 .

mitigation:A0406_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Deactivation Protocol"@en ;
    ak:description "Protocols are put in place to ensure GAI systems are able to be deactivated when necessary." ;
    ak:identifier "A0406_NIST2024" ;
    ak:name "Deactivation Protocol" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0406_NIST2024 .

mitigation:A0407_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Decommissioning Considerations"@en ;
    ak:description "Consider the following factors when decommissioning GAI systems: Data retention requirements; Data security, e.g., containment, protocols, Data leakage after decommissioning; Dependencies between upstream, downstream, or other data, internet of things (IOT) or AI systems; Use of open-source data or models; Users' emotional entanglement with GAI functions." ;
    ak:identifier "A0407_NIST2024" ;
    ak:name "Decommissioning Considerations" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0407_NIST2024 .

mitigation:A0408_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incident Communication Framework"@en ;
    ak:description "Establish organizational roles, policies, and procedures for communicating GAI incidents and performance to AI Actors and downstream stakeholders (including those potentially impacted), via community or official resources (e.g., AI incident database, AVID, CVE, NVD, or OECD AI incident monitor)." ;
    ak:identifier "A0408_NIST2024" ;
    ak:name "Incident Communication Framework" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0408_NIST2024 .

mitigation:A0409_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incident Response Teams"@en ;
    ak:description "Establish procedures to engage teams for GAI system incident response with diverse composition and responsibilities based on the particular incident type." ;
    ak:identifier "A0409_NIST2024" ;
    ak:name "Incident Response Teams" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0409_NIST2024 .

mitigation:A0410_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Response Team Verification"@en ;
    ak:description "Establish processes to verify the AI Actors conducting GAI incident response tasks demonstrate and maintain the appropriate skills and training." ;
    ak:identifier "A0410_NIST2024" ;
    ak:name "Response Team Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0410_NIST2024 .

mitigation:A0411_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "National Security Involvement"@en ;
    ak:description "When systems may raise national security risks, involve national security professionals in mapping, measuring, and managing those risks." ;
    ak:identifier "A0411_NIST2024" ;
    ak:name "National Security Involvement" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0411_NIST2024 .

mitigation:A0412_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Whistleblower Protection"@en ;
    ak:description "Create mechanisms to provide protections for whistleblowers who report, based on reasonable belief, when the organization violates relevant laws or poses a specific and empirically well-substantiated negative risk to public safety (or has already caused harm)." ;
    ak:identifier "A0412_NIST2024" ;
    ak:name "Whistleblower Protection" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0412_NIST2024 .

mitigation:A0413_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent Evaluation Policy"@en ;
    ak:description "Policies are in place to bolster oversight of GAI systems with independent evaluations or assessments of GAI models or systems where the type and robustness of evaluations are proportional to the identified risks." ;
    ak:identifier "A0413_NIST2024" ;
    ak:name "Independent Evaluation Policy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0413_NIST2024 .

mitigation:A0414_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Organizational Role Adjustment"@en ;
    ak:description "Consider adjustment of organizational roles and components across lifecycle stages of large or complex GAI systems, including: Test and evaluation, validation, and red-teaming of GAI systems; GAI content moderation; GAI system development and engineering; Increased accessibility of GAI tools, interfaces, and systems, Incident response and containment." ;
    ak:identifier "A0414_NIST2024" ;
    ak:name "Organizational Role Adjustment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0414_NIST2024 .

mitigation:A0415_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Interface Use Policy"@en ;
    ak:description "Define acceptable use policies for GAI interfaces, modalities, and human-AI configurations (i.e., for chatbots and decision-making tasks), including criteria for the kinds of queries GAI applications should refuse to respond to." ;
    ak:identifier "A0415_NIST2024" ;
    ak:name "Interface Use Policy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0415_NIST2024 .

mitigation:A0416_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User Feedback Mechanism"@en ;
    ak:description "Establish policies for user feedback mechanisms for GAI systems which include thorough instructions and any mechanisms for recourse." ;
    ak:identifier "A0416_NIST2024" ;
    ak:name "User Feedback Mechanism" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0416_NIST2024 .

mitigation:A0417_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Threat Modeling Process"@en ;
    ak:description "Engage in threat modeling to anticipate potential risks from GAI systems" ;
    ak:identifier "A0417_NIST2024" ;
    ak:name "Threat Modeling Process" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0417_NIST2024 .

mitigation:A0418_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Measurement Improvement"@en ;
    ak:description "Establish policies and procedures that address continual improvement processes for GAI risk measurement. Address general risks associated with a lack of explainability and transparency in GAI systems by using ample documentation and techniques such as: application of gradient-based attributions, occlusion/term reduction, counterfactual prompts and prompt engineering, and analysis of embeddings; Assess and update risk measurement approaches at regular cadences" ;
    ak:identifier "A0418_NIST2024" ;
    ak:name "Risk Measurement Improvement" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0418_NIST2024 .

mitigation:A0419_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Standardized Measurement Protocols"@en ;
    ak:description "Establish policies, procedures, and processes detailing risk measurement in context of use with standardized measurement protocols and structured public feedback exercises such as AI red-teaming or independent external evaluations." ;
    ak:identifier "A0419_NIST2024" ;
    ak:name "Standardized Measurement Protocols" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0419_NIST2024 .

mitigation:A0420_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Lifecycle Oversight Functions"@en ;
    ak:description "Establish policies, procedures, and processes for oversight functions (e.g., senior leadership, legal, compliance, including internal evaluation) across the GAI lifecycle, from problem formulation and supply chains to system decommission." ;
    ak:identifier "A0420_NIST2024" ;
    ak:name "Lifecycle Oversight Functions" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0420_NIST2024 .

mitigation:A0421_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Terms of Service Establishment"@en ;
    ak:description "Establish terms of use and terms of service for GAI systems." ;
    ak:identifier "A0421_NIST2024" ;
    ak:mitigates risk:atlas-data-usage-rights,
        risk:atlas-model-usage-rights,
        risk:llm032025-supply-chain ;
    ak:name "Terms of Service Establishment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0421_NIST2024 .

mitigation:A0422_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Actor Inclusion in Risk ID"@en ;
    ak:description "Include relevant AI Actors in the GAI system risk identification process." ;
    ak:identifier "A0422_NIST2024" ;
    ak:name "Actor Inclusion in Risk ID" ;
