mitigation:A0120_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent Delphi Risk Assessments"@en ;
    ak:description "Is your organization collaborating with independent experts to conduct full Delphi processes to more accurately assess the risks associated with large development or deployment decisions?" ;
    ak:identifier "A0120_Future_of_Life_Institute2024" ;
    ak:name "Independent Delphi Risk Assessments" ;
