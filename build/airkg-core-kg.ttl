        owl:NamedIndividual ;
    rdfs:label "Financial incentives"@en ;
    ak:description "Financial incentives of leadership; whether it has a mandate to prioritize safety over profits." ;
    ak:identifier "A0112_Future_of_Life_Institute2024" ;
    ak:name "Financial incentives" ;
