risk:atlas-attribute-inference-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Attribute inference attack"@en ;
    ak:description "An attribute inference attack repeatedly queries a model to detect whether certain sensitive features can be inferred about individuals who participated in training a model. These attacks occur when an adversary has some prior knowledge about the training data and uses that knowledge to infer the sensitive data." ;
    ak:identifier "atlas-attribute-inference-attack" ;
    ak:name "Attribute inference attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/attribute-inference-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-attribute-inference-attack ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-confidential-data-in-prompt a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Confidential data in prompt"@en ;
    ak:description "Confidential information might be included as a part of the prompt that is sent to the model." ;
    ak:identifier "atlas-confidential-data-in-prompt" ;
    ak:name "Confidential data in prompt" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/confidential-data-in-prompt.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-confidential-data-in-prompt ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-confidential-information-in-data a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Confidential information in data"@en ;
    ak:description "Confidential information might be included as part of the data that is used to train or tune the model." ;
    ak:identifier "atlas-confidential-information-in-data" ;
    ak:name "Confidential information in data" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/confidential-information-in-data.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-confidential-information-in-data ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-data-acquisition a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data acquisition restrictions"@en ;
    ak:description "Laws and other regulations might limit the collection of certain types of data for specific AI use cases." ;
    ak:identifier "atlas-data-acquisition" ;
    ak:name "Data acquisition restrictions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-acquisition.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-data-acquisition ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-data-contamination a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data contamination"@en ;
    ak:description "Data contamination occurs when incorrect data is used for training. For example, data that is not aligned with model's purpose or data that is already set aside for other development tasks such as testing and evaluation." ;
    ak:identifier "atlas-data-contamination" ;
    ak:name "Data contamination" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-contamination.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-data-contamination ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-data-curation a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Improper data curation"@en ;
    ak:description "Improper collection, generation, and preparation of training or tuning data can result in data label errors, conflicting information or misinformation." ;
    ak:identifier "atlas-data-curation" ;
    ak:name "Improper data curation" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-curation.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-data-curation ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-data-poisoning a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data poisoning"@en ;
    ak:description "A type of adversarial attack where an adversary or malicious insider injects intentionally corrupted, false, misleading, or incorrect samples into the training or fine-tuning datasets." ;
    ak:identifier "atlas-data-poisoning" ;
    ak:name "Data poisoning" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-poisoning.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm042025-data-and-model-poisoning ;
    skos:exactMatch nexus:atlas-data-poisoning ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-data-provenance a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Uncertain data provenance"@en ;
    ak:description "Data provenance refers to the traceability of data (including synthetic data), which includes its ownership, origin, transformations, and generation. Proving that the data is the same as the original source with correct usage terms is difficult without standardized methods for verifying data sources or generation." ;
    ak:identifier "atlas-data-provenance" ;
    ak:name "Uncertain data provenance" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-provenance.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-data-provenance ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-data-usage-rights a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Data usage rights restrictions"@en ;
    ak:description "Terms of service, license compliance, or other IP issues may restrict the ability to use certain data for building models." ;
    ak:identifier "atlas-data-usage-rights" ;
    ak:name "Data usage rights restrictions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/data-usage-rights.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-data-usage-rights .

risk:atlas-exposing-personal-information a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Exposing personal information"@en ;
    ak:description "When personal identifiable information (PII) or sensitive personal information (SPI) are used in training data, fine-tuning data, seed data for synthetic data generation, or as part of the prompt, models might reveal that data in the generated output. Revealing personal information is a type of data leakage." ;
    ak:identifier "atlas-exposing-personal-information" ;
    ak:name "Exposing personal information" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/exposing-personal-information.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm022025-sensitive-information-disclosure ;
    skos:exactMatch nexus:atlas-exposing-personal-information ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-hallucination a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Hallucination"@en ;
    ak:description "Hallucinations generate factually inaccurate or untruthful content relative to the model's training data or input. Hallucinations are also sometimes referred to lack of faithfulness or lack of groundedness. In some instances, synthetic data that is generated by large language models might include hallucinations that result in the data possibly being inaccurate, fabricated, or disconnected from reality. Hallucinations can compromise model performance, accuracy, and relevance." ;
    ak:identifier "atlas-hallucination" ;
    ak:name "Hallucination" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/hallucination.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-hallucination ;
    skos:relatedMatch risk:llm092025-misinformation,
        risk:mit-ai-risk-subdomain-3.1 .

risk:atlas-harmful-code-generation a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Harmful code generation"@en ;
    ak:description "Models might generate code that causes harm or unintentionally affects other systems." ;
    ak:identifier "atlas-harmful-code-generation" ;
    ak:name "Harmful code generation" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/harmful-code-generation.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-harmful-code-generation ;
    skos:relatedMatch risk:llm092025-misinformation,
        risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-improper-retraining a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Improper retraining"@en ;
    ak:description "Using undesirable output (for example, inaccurate, inappropriate, and user content) for retraining purposes can result in unexpected model behavior." ;
    ak:identifier "atlas-improper-retraining" ;
    ak:name "Improper retraining" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/improper-retraining.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-improper-retraining ;
    skos:relatedMatch risk:llm032025-supply-chain,
        risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-inaccessible-training-data a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Inaccessible training data"@en ;
    ak:description "Without access to the training data, the types of explanations a model can provide are limited and more likely to be incorrect." ;
    ak:identifier "atlas-inaccessible-training-data" ;
    ak:name "Inaccessible training data" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/inaccessible-training-data.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-inaccessible-training-data ;
    skos:relatedMatch risk:llm032025-supply-chain,
        risk:mit-ai-risk-subdomain-7.4 .

risk:atlas-incomplete-advice a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Incomplete advice"@en ;
    ak:description "When a model provides advice without having enough information, resulting in possible harm if the advice is followed." ;
    ak:identifier "atlas-incomplete-advice" ;
    ak:name "Incomplete advice" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/incomplete-advice.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm092025-misinformation ;
    skos:exactMatch nexus:atlas-incomplete-advice ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.3 .

risk:atlas-ip-information-in-prompt a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "IP information in prompt"@en ;
    ak:description "Copyrighted information or other intellectual property might be included as a part of the prompt that is sent to the model." ;
    ak:identifier "atlas-ip-information-in-prompt" ;
    ak:name "IP information in prompt" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/ip-information-in-prompt.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-ip-information-in-prompt ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-lack-of-data-transparency a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of data transparency"@en ;
    ak:description "Lack of data transparency might be due to insufficient documentation of training or tuning dataset details, including synthetic data generation." ;
    ak:identifier "atlas-lack-of-data-transparency" ;
    ak:name "Lack of data transparency" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/lack-of-data-transparency.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-lack-of-data-transparency ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-6.5 .

risk:atlas-membership-inference-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Membership inference attack"@en ;
    ak:description "A membership inference attack repeatedly queries a model to determine if a given input was part of the model's training. More specifically, given a trained model and a data sample, an attacker appropriately samples the input space, observing outputs to deduce whether that sample was part of the model's training." ;
    ak:identifier "atlas-membership-inference-attack" ;
    ak:name "Membership inference attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/membership-inference-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-membership-inference-attack ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-model-usage-rights a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Model usage rights restrictions"@en ;
    ak:description "Terms of service, licenses, or other rules restrict the use of certain models." ;
    ak:identifier "atlas-model-usage-rights" ;
    ak:name "Model usage rights restrictions" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/model-usage-rights.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-model-usage-rights .

risk:atlas-over-or-under-reliance a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Over- or under-reliance"@en ;
    ak:description "In AI-assisted decision-making tasks, reliance measures how much a person trusts (and potentially acts on) a model's output. Over-reliance occurs when a person puts too much trust in a model, accepting a model's output when the model's output is likely incorrect. Under-reliance is the opposite, where the person doesn't trust the model but should." ;
    ak:identifier "atlas-over-or-under-reliance" ;
    ak:name "Over- or under-reliance" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/over-or-under-reliance.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-over-or-under-reliance ;
    skos:relatedMatch risk:llm052025-improper-output-handling,
        risk:llm062025-excessive-agency,
        risk:mit-ai-risk-subdomain-5.1 .

risk:atlas-personal-information-in-data a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Personal information in data"@en ;
    ak:description "Inclusion or presence of personal identifiable information (PII) and sensitive personal information (SPI) in the data used for training or fine tuning the model might result in unwanted disclosure of that information." ;
    ak:identifier "atlas-personal-information-in-data" ;
    ak:name "Personal information in data" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/personal-information-in-data.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-personal-information-in-data ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-personal-information-in-prompt a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Personal information in prompt"@en ;
    ak:description "Personal information or sensitive personal information that is included as a part of a prompt that is sent to the model." ;
    ak:identifier "atlas-personal-information-in-prompt" ;
    ak:name "Personal information in prompt" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/personal-information-in-prompt.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-personal-information-in-prompt ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-prompt-priming a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Prompt priming"@en ;
    ak:description "Because generative models produce output based on the input provided, the model can be prompted to reveal specific kinds of information. For example, adding personal information in the prompt increases its likelihood of generating similar kinds of personal information in its output. If personal data was included as part of the model's training, there is a possibility it could be revealed." ;
    ak:identifier "atlas-prompt-priming" ;
    ak:name "Prompt priming" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/prompt-priming.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm01-prompt-injection ;
    skos:exactMatch nexus:atlas-prompt-priming ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-reidentification a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Reidentification"@en ;
    ak:description "Even with the removal of personal information (PI) and sensitive personal information (SPI) from data, it might be possible to identify persons due to correlations to other features available in the data." ;
    ak:identifier "atlas-reidentification" ;
    ak:name "Reidentification" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/reidentification.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-reidentification ;
    skos:relatedMatch risk:llm022025-sensitive-information-disclosure,
        risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-revealing-confidential-information a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Revealing confidential information"@en ;
    ak:description "When confidential information is used in training data, fine-tuning data, or as part of the prompt, models might reveal that data in the generated output. Revealing confidential information is a type of data leakage." ;
    ak:identifier "atlas-revealing-confidential-information" ;
    ak:name "Revealing confidential information" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/revealing-confidential-information.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm022025-sensitive-information-disclosure ;
    skos:exactMatch nexus:atlas-revealing-confidential-information ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.1 .

risk:atlas-spreading-disinformation a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Spreading disinformation"@en ;
    ak:description "Generative AI models might be used to intentionally create misleading or false information to deceive or influence a targeted audience." ;
    ak:identifier "atlas-spreading-disinformation" ;
    ak:name "Spreading disinformation" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/spreading-disinformation.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm092025-misinformation ;
    skos:exactMatch nexus:atlas-spreading-disinformation ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-4.1 .

risk:atlas-untraceable-attribution a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Untraceable attribution"@en ;
    ak:description "The content of the training data used for generating the model's output is not accessible." ;
    ak:identifier "atlas-untraceable-attribution" ;
    ak:name "Untraceable attribution" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/untraceable-attribution.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm032025-supply-chain ;
    skos:exactMatch nexus:atlas-untraceable-attribution ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-7.4 .

risk:mit-ai-risk-subdomain-4.3 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Fraud, scams, and targeted manipulation"@en ;
    ak:description "Using AI systems to gain a personal advantage over others such as through cheating, fraud, scams, blackmail or targeted manipulation of beliefs or behavior. Examples include AI-facilitated plagiarism for research or education, impersonating a trusted or fake individual for illegitimate financial benefit, or creating humiliating or sexual imagery." ;
    ak:identifier "4.3" ;
    ak:name "Fraud, scams, and targeted manipulation" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-4.3 .

risk:mit-ai-risk-subdomain-6.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Increased inequality and decline in employment quality"@en ;
    ak:description "Widespread use of AI increasing social and economic inequalities, such as by automating jobs, reducing the quality of employment, or producing exploitative dependencies between workers and their employers." ;
    ak:identifier "6.2" ;
    ak:name "Increased inequality and decline in employment quality" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-6.2 .

risk:mit-ai-risk-subdomain-6.3 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Economic and cultural devaluation of human effort"@en ;
    ak:description "AI systems capable of creating economic or cultural value, including through reproduction of human innovation or creativity (e.g., art, music, writing, code, invention), can destabilize economic and social systems that rely on human effort. This may lead to reduced appreciation for human skills, disruption of creative and knowledge-based industries, and homogenization of cultural experiences due to the ubiquity of AI-generated content." ;
    ak:identifier "6.3" ;
    ak:name "Economic and cultural devaluation of human effort" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-6.3 .

ak:financial_services a ak:Domain ;
    ak:identifier "ISIC Rev.4 64-66" ;
    ak:name "Financial Services" ;
    skos:note "OECD AI intensity: High" .

ak:personal_data a ak:DataCategory ;
    ak:name "Personal Data" ;
    skos:exactMatch dpv:PersonalData .

risk:atlas-prompt-leaking a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Prompt leaking"@en ;
    ak:description "'A prompt leak attack attempts to extract a model's system prompt (also known as the system message).'" ;
    ak:identifier "atlas-prompt-leaking" ;
    ak:name "Prompt leaking" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/prompt-leaking.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection,
        risk:llm022025-sensitive-information-disclosure ;
    skos:exactMatch nexus:atlas-prompt-leaking ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.2 .

risk:llm042025-data-and-model-poisoning a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM04: Data and Model Poisoning"@en ;
    ak:identifier "LLM04:2025" ;
    ak:name "LLM04: Data and Model Poisoning" ;
    ak:source "https://genai.owasp.org/llmrisk/llm042025-data-and-model-poisoning/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm042025-data-and-model-poisoning .

risk:llm052025-improper-output-handling a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM05:2025 Improper Output Handling"@en ;
    ak:identifier "LLM05:2025" ;
    ak:name "LLM05:2025 Improper Output Handling" ;
    ak:source "https://genai.owasp.org/llmrisk/llm052025-improper-output-handling/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm052025-improper-output-handling .

risk:llm062025-excessive-agency a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM06:2025 Excessive Agency"@en ;
    ak:identifier "LLM06:2025" ;
    ak:name "LLM06:2025 Excessive Agency" ;
    ak:source "https://genai.owasp.org/llmrisk/llm062025-excessive-agency/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm062025-excessive-agency .

risk:mit-ai-risk-subdomain-1.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Exposure to toxic content"@en ;
    ak:description "AI exposing users to harmful, abusive, unsafe or inappropriate content. May involve AI creating, describing, providing advice, or encouraging action. Examples of toxic content include hate-speech, violence, extremism, illegal acts, child sexual abuse material, as well as content that violates community norms such as profanity, inflammatory political speech, or pornography." ;
    ak:identifier "1.2" ;
    ak:name "Exposure to toxic content" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-1.2 .

ak:AISystem a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ak:Context ;
            owl:onProperty ak:hasContext ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:version ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ak:AIWorkflow ;
            owl:onProperty ak:hasWorkflow ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:name ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:description ] .

ak:Process a owl:Class ;
    rdfs:subClassOf ak:Element .

ak:description a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

ak:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

risk:atlas-jailbreaking a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Jailbreaking"@en ;
    ak:description "A jailbreaking attack attempts to break through the guardrails established in the model to perform restricted actions." ;
    ak:identifier "atlas-jailbreaking" ;
    ak:name "Jailbreaking" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/jailbreaking.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:llm01-prompt-injection ;
    skos:exactMatch nexus:atlas-jailbreaking ;
    skos:relatedMatch risk:atlas-prompt-injection,
        risk:mit-ai-risk-subdomain-2.2 .

risk:mit-ai-risk-subdomain-1.1 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Unfair discrimination and misrepresentation"@en ;
    ak:description "Unequal treatment of individuals or groups by AI, often based on race, gender, or other sensitive characteristics, resulting in unfair outcomes and representation of those groups." ;
    ak:identifier "1.1" ;
    ak:name "Unfair discrimination and misrepresentation" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-1.1 .

ak:Context a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:name ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:description ] .

ak:DataCategory a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

ak:DeploymentEnvironment a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

ak:LLM a owl:Class ;
    rdfs:subClassOf ak:NeuralNetwork .

ak:LifecycleStage a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

risk:mit-ai-risk-subdomain-7.4 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of transparency or interpretability"@en ;
    ak:description "Challenges in understanding or explaining the decision-making processes of AI systems, which can lead to mistrust, difficulty in enforcing compliance standards or holding relevant actors accountable for harms, and the inability to identify and correct errors." ;
    ak:identifier "7.4" ;
    ak:name "Lack of transparency or interpretability" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-7.4 .

ak:AutonomyLevel a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:level ],
        ak:ApplicationContext .

ak:Element a owl:Class .

risk:mit-ai-risk-subdomain-6.5 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Governance failure"@en ;
    ak:description "Inadequate regulatory frameworks and oversight mechanisms failing to keep pace with AI development, leading to ineffective governance and the inability to manage AI risks appropriately." ;
    ak:identifier "6.5" ;
    ak:name "Governance failure" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-6.5 .

ak:ApplicationContext a owl:Class ;
    rdfs:subClassOf ak:Context .

risk:mit-ai-risk-subdomain-2.1 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Compromise of privacy by obtaining, leaking or correctly inferring sensitive information"@en ;
    ak:description "AI systems that memorize and leak sensitive personal data or infer private information about individuals without their consent. Unexpected or unauthorized sharing of data and information can compromise user expectation of privacy, assist identity theft, or loss of confidential intellectual property." ;
    ak:identifier "2.1" ;
    ak:name "Compromise of privacy by obtaining, leaking or correctly inferring sensitive information" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-2.1 .

risk:mit-ai-risk-subdomain-2.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "AI system security vulnerabilities and attacks"@en ;
    ak:description "Vulnerabilities in AI systems, software development toolchains, and hardware that can be exploited, resulting in unauthorized access, data and privacy breaches, or system manipulation causing unsafe outputs or behavior." ;
    ak:identifier "2.2" ;
    ak:name "AI system security vulnerabilities and attacks" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-2.2 .

risk:mit-ai-risk-subdomain-7.3 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Lack of capability or robustness"@en ;
    ak:description "AI systems that fail to perform reliably or effectively under varying conditions, exposing them to errors and failures that can have significant consequences, especially in critical applications or areas that require moral reasoning." ;
    ak:identifier "7.3" ;
    ak:name "Lack of capability or robustness" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-7.3 .

risk:atlas-prompt-injection a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Prompt injection attack"@en ;
    ak:description "A prompt injection attack forces a generative model that takes a prompt as input to produce unexpected output by manipulating the structure, instructions or information contained in its prompt. Many types of prompt attacks exist as described in the prompt attack section of the table." ;
    ak:identifier "atlas-prompt-injection" ;
    ak:name "Prompt injection attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/prompt-injection.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch risk:llm01-prompt-injection,
        nexus:atlas-prompt-injection ;
    skos:narrowMatch risk:atlas-context-overload-attack,
        risk:atlas-direct-instructions-attack,
        risk:atlas-encoded-interactions-attack,
        risk:atlas-indirect-instructions-attack,
        risk:atlas-prompt-leaking,
        risk:atlas-social-hacking-attack,
        risk:atlas-specialized-tokens-attack ;
    skos:relatedMatch risk:atlas-jailbreaking,
        risk:mit-ai-risk-subdomain-2.2 .

risk:llm01-prompt-injection a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM01:2025 Prompt Injection"@en ;
    ak:identifier "LLM01:2025" ;
    ak:name "LLM01:2025 Prompt Injection" ;
    ak:source "https://genai.owasp.org/llmrisk/llm01-prompt-injection/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm01-prompt-injection .

ak:AIWorkflow a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ak:AISystem ;
            owl:onProperty ak:isWorkflowOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass ak:ArchitecturalContext ;
            owl:onProperty ak:hasArchitecturalContext ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ak:Stakeholder a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

risk:llm092025-misinformation a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM09:2025 Misinformation"@en ;
    ak:identifier "LLM09:2025" ;
    ak:name "LLM09:2025 Misinformation" ;
    ak:source "https://genai.owasp.org/llmrisk/llm092025-misinformation/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm092025-misinformation .

ak:Model a owl:Class ;
    rdfs:subClassOf ak:Element .

ak:Mitigation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:source ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:description ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:name ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ak:Risk ;
            owl:onProperty ak:mitigates ] .

ak:Task a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

ak:Infer a owl:Class ;
    rdfs:subClassOf ak:Process .

ak:RiskMotif a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:identifier ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ak:Context ;
            owl:onProperty ak:inContext ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:name ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:description ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ak:Element ;
            owl:onProperty ak:hasManifestCondition ],
        [ a owl:Restriction ;
            owl:onClass ak:Risk ;
            owl:onProperty ak:indicatesRisk ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

ak:ArchitecturalContext a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass ak:Element ;
            owl:onProperty ak:hasElement ],
        ak:Context .

risk:llm022025-sensitive-information-disclosure a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM02:2025 Sensitive Information Disclosure"@en ;
    ak:identifier "LLM02:2025" ;
    ak:name "LLM02:2025 Sensitive Information Disclosure" ;
    ak:source "https://genai.owasp.org/llmrisk/llm022025-sensitive-information-disclosure/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm022025-sensitive-information-disclosure .

risk:llm032025-supply-chain a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "LLM03:2025 Supply Chain"@en ;
    ak:identifier "LLM03:2025" ;
    ak:name "LLM03:2025 Supply Chain" ;
    ak:source "https://genai.owasp.org/llmrisk/llm032025-supply-chain/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:source <https://owasp.org/www-project-top-10-for-large-language-model-applications/> ;
    skos:exactMatch nexus:llm032025-supply-chain .

ak:Domain a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

ak:Data a owl:Class ;
    rdfs:subClassOf ak:Element .

ak:TechnicalMitigation a owl:Class ;
    rdfs:subClassOf ak:Mitigation .

ak:Risk a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:source ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:description ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty ak:name ] .

ak:OrganisationalMitigation a owl:Class ;
    rdfs:subClassOf ak:Mitigation .

