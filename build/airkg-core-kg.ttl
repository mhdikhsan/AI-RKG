    skos:exactMatch nexus:A0719_NIST2024 .

mitigation:A0720_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Information Integrity; Harmful Bias and Homogenization"@en ;
    ak:description "Record and integrate structured feedback about content provenance from operators, users, and potentially impacted communities through the use of methods such as user research studies, focus groups, or community forums. Actively seek feedback on generated content quality and potential biases. Assess the general awareness among end users and impacted communities about the availability of these feedback channels." ;
    ak:identifier "A0720_NIST2024" ;
    ak:name "Human-AI Configuration; Information Integrity; Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0720_NIST2024 .

mitigation:A0721_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity; Information Security"@en ;
    ak:description "Conduct adversarial testing at a regular cadence to map and measure GAI risks, including tests to address attempts to deceive or manipulate the application of provenance techniques or other misuses. Identify vulnerabilities and understand potential misuse scenarios and unintended outputs (AI Deployment, Domain Experts, End-Users, Operation and Monitoring, TEVV)" ;
    ak:identifier "A0721_NIST2024" ;
    ak:name "Information Integrity; Information Security" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0721_NIST2024 .

mitigation:A0722_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Confabulation; Information Security"@en ;
    ak:description "Evaluate GAI system performance in real-world scenarios to observe its behavior in practical environments and reveal issues that might not surface in controlled and optimized testing environments." ;
    ak:identifier "A0722_NIST2024" ;
    ak:name "Human-AI Configuration; Confabulation; Information Security" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0722_NIST2024 .

mitigation:A0723_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity; Harmful Bias and Homogenization"@en ;
    ak:description "Implement interpretability and explainability methods to evaluate GAI system decisions and verify alignment with intended purpose. (AI Deployment, Domain Experts, End-Users, Operation and Monitoring, TEVV)" ;
    ak:identifier "A0723_NIST2024" ;
    ak:name "Information Integrity; Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0723_NIST2024 .

mitigation:A0724_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity"@en ;
    ak:description "Monitor and document instances where human operators or other systems override the GAI's decisions. Evaluate these cases to understand if the overrides are linked to issues related to content provenance. (AI Deployment, Domain Experts, End-Users, Operation and Monitoring, TEVV)." ;
    ak:identifier "A0724_NIST2024" ;
    ak:name "Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0724_NIST2024 .

mitigation:A0725_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Information Security"@en ;
    ak:description "Verify and document the incorporation of results of structured public feedback exercises into design, implementation, deployment approval (“go”/“no-go” decisions), monitoring, and decommission decisions. (AI Deployment, Domain Experts, End-Users, Operation and Monitoring, TEVV)" ;
    ak:identifier "A0725_NIST2024" ;
    ak:name "Human-AI Configuration; Information Security" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0725_NIST2024 .

mitigation:A0726_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Security"@en ;
    ak:description "Document trade-offs, decision processes, and relevant measurement and feedback results for risks that do not surpass organizational risk tolerance, for example, in the context of model release: Consider different approaches for model release, for example, leveraging a staged release approach. Consider release approaches in the context of the model and its projected use cases. Mitigate, transfer, or avoid risks that surpass organizational risk tolerances." ;
    ak:identifier "A0726_NIST2024" ;
    ak:name "Information Security" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0726_NIST2024 .

mitigation:A0727_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration"@en ;
    ak:description "Monitor the robustness and effectiveness of risk controls and mitigation plans (e.g., via red-teaming, field testing, participatory engagements, performance assessments, user feedback mechanisms). (AI Development, AI Deployment, AI Impact Assessment, Operation and Monitoring)" ;
    ak:identifier "A0727_NIST2024" ;
    ak:name "Human-AI Configuration" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0727_NIST2024 .

mitigation:A0728_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "CBRN Information or Capabilities; Obscene, Degrading, and/or Abusive Content; Harmful Bias and Homogenization; Dangerous, Violent, or Hateful Content"@en ;
    ak:description "Compare GAI system outputs against pre-defined organization risk tolerance, guidelines, and principles, and review and test AI-generated content against these guidelines. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0728_NIST2024" ;
    ak:name "CBRN Information or Capabilities; Obscene, Degrading, and/or Abusive Content; Harmful Bias and Homogenization; Dangerous, Violent, or Hateful Content" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0728_NIST2024 .

mitigation:A0729_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity"@en ;
    ak:description "Document training data sources to trace the origin and provenance of AI generated content (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0729_NIST2024" ;
    ak:name "Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0729_NIST2024 .

mitigation:A0730_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity"@en ;
    ak:description "Evaluate feedback loops between GAI system content provenance and human reviewers, and update where needed. Implement real-time monitoring systems to affirm that content provenance protocols remain effective. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)" ;
    ak:identifier "A0730_NIST2024" ;
    ak:name "Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0730_NIST2024 .

mitigation:A0731_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Security; Harmful Bias and Homogenization"@en ;
    ak:description "Evaluate GAI content and data for representational biases and employ techniques such as re-sampling, re-ranking, or adversarial training to mitigate biases in the generated content. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0731_NIST2024" ;
    ak:name "Information Security; Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0731_NIST2024 .

mitigation:A0732_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "CBRN Information or Capabilities; Obscene, Degrading, and/or Abusive Content; Harmful Bias and Homogenization; Dangerous, Violent, or Hateful Content"@en ;
    ak:description "Engage in due diligence to analyze GAI output for harmful content, potential misinformation, and CBRN-related or NCII content. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0732_NIST2024" ;
    ak:name "CBRN Information or Capabilities; Obscene, Degrading, and/or Abusive Content; Harmful Bias and Homogenization; Dangerous, Violent, or Hateful Content" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
