    skos:exactMatch nexus:A0468_NIST2024 .

mitigation:A0469_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Quality Standards"@en ;
    ak:description "Establish policies for collection, retention, and minimum quality of data, in consideration of the following risks: Disclosure of inappropriate CBRN information; Use of Illegal or dangerous content; Offensive cyber capabilities; Training data imbalances that could give rise to harmful biases; Leak of personally identifiable information, including facial likenesses of individuals." ;
    ak:identifier "A0469_NIST2024" ;
    ak:name "Data Quality Standards" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0469_NIST2024 .

mitigation:A0470_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party IP Protection"@en ;
    ak:description "Implement policies and practices defining how third-party intellectual property and training data will be used, stored, and protected." ;
    ak:identifier "A0470_NIST2024" ;
    ak:mitigates risk:atlas-ip-information-in-prompt,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Third-Party IP Protection" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0470_NIST2024 .

mitigation:A0471_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-Tuned Model Re-evaluation"@en ;
    ak:description "Re-evaluate models that were fine-tuned or enhanced on top of third-party models." ;
    ak:identifier "A0471_NIST2024" ;
    ak:name "Fine-Tuned Model Re-evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0471_NIST2024 .

mitigation:A0472_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Domain Adaptation Risk Assessment"@en ;
    ak:description "Re-evaluate risks when adapting GAI models to new domains. Additionally, establish warning systems to determine if a GAI system is being used in a new domain where previous assumptions (relating to context of use or mapped risks such as security, and safety) may no longer hold." ;
    ak:identifier "A0472_NIST2024" ;
    ak:name "Domain Adaptation Risk Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0472_NIST2024 .

mitigation:A0473_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "PII Detection Methods"@en ;
    ak:description "Leverage approaches to detect the presence of PII or sensitive data in generated output text, image, video, or audio." ;
    ak:identifier "A0473_NIST2024" ;
    ak:mitigates risk:atlas-personal-information-in-data,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "PII Detection Methods" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0473_NIST2024 .

mitigation:A0474_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Training Data Diligence"@en ;
    ak:description "Conduct appropriate diligence on training data use to assess intellectual property, and privacy, risks, including to examine whether use of proprietary or sensitive training data is consistent with applicable laws." ;
    ak:identifier "A0474_NIST2024" ;
    ak:mitigates risk:atlas-attribute-inference-attack,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Training Data Diligence" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0474_NIST2024 .

mitigation:A0475_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Provenance Testing Practices"@en ;
    ak:description "Apply TEVV practices for content provenance (e.g., probing a system's synthetic data generation capabilities for potential misuse or vulnerabilities." ;
    ak:identifier "A0475_NIST2024" ;
    ak:name "Provenance Testing Practices" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0475_NIST2024 .

mitigation:A0476_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Provenance Harm Identification"@en ;
    ak:description "Identify potential content provenance harms of GAI, such as misinformation or disinformation, deepfakes, including NCII, or tampered content. Enumerate and rank risks based on their likelihood and potential impact, and determine how well provenance solutions address specific risks and/or harms." ;
    ak:identifier "A0476_NIST2024" ;
    ak:mitigates risk:atlas-spreading-disinformation,
        risk:llm092025-misinformation ;
    ak:name "Provenance Harm Identification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0476_NIST2024 .

mitigation:A0477_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Use Disclosure Consideration"@en ;
    ak:description "Consider disclosing use of GAI to end users in relevant contexts, while considering the objective of disclosure, the context of use, the likelihood and magnitude of the risk posed, the audience of the disclosure, as well as the frequency of the disclosures." ;
    ak:identifier "A0477_NIST2024" ;
    ak:name "Use Disclosure Consideration" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0477_NIST2024 .

mitigation:A0478_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk-Based Feedback Prioritization"@en ;
    ak:description "Prioritize GAI structured public feedback processes based on risk assessment estimates." ;
    ak:identifier "A0478_NIST2024" ;
    ak:name "Risk-Based Feedback Prioritization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0478_NIST2024 .

mitigation:A0479_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adversarial Role-Playing"@en ;
    ak:description "Conduct adversarial role-playing exercises, GAI red-teaming, or chaos testing to identify anomalous or unforeseen failure modes." ;
    ak:identifier "A0479_NIST2024" ;
    ak:name "Adversarial Role-Playing" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0479_NIST2024 .

mitigation:A0480_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Threat Profiling"@en ;
    ak:description "Profile threats and negative impacts arising from GAI systems interacting with, manipulating, or generating content, and outlining known and potential vulnerabilities and the likelihood of their occurrence." ;
    ak:identifier "A0480_NIST2024" ;
    ak:name "Threat Profiling" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0480_NIST2024 .

mitigation:A0481_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Context-Based Impact Measures"@en ;
    ak:description "Determine context-based measures to identify if new impacts are present due to the GAI system, including regular engagements with downstream AI Actors to identify and quantify new contexts of unanticipated impacts of GAI systems." ;
    ak:identifier "A0481_NIST2024" ;
    ak:name "Context-Based Impact Measures" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0481_NIST2024 .

mitigation:A0482_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Input Actor Engagement"@en ;
    ak:description "Plan regular engagements with AI Actors responsible for inputs to GAI systems, including third-party data and algorithms, to review and evaluate unanticipated impacts." ;
    ak:identifier "A0482_NIST2024" ;
    ak:name "Input Actor Engagement" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0482_NIST2024 .

mitigation:A0483_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Origin Tracing Methods"@en ;
    ak:description "Employ methods to trace the origin and modifications of digital content." ;
    ak:identifier "A0483_NIST2024" ;
    ak:name "Origin Tracing Methods" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0483_NIST2024 .

mitigation:A0484_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Provenance Analysis Tools"@en ;
    ak:description "Integrate tools designed to analyze content provenance and detect data anomalies, verify the authenticity of digital signatures, and identify patterns associated with misinformation or manipulation." ;
    ak:identifier "A0484_NIST2024" ;
    ak:name "Provenance Analysis Tools" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0484_NIST2024 .

mitigation:A0485_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Demographic Metric Disaggregation"@en ;
    ak:description "Disaggregate evaluation metrics by demographic factors to identify any discrepancies in how content provenance mechanisms work across diverse populations." ;
    ak:identifier "A0485_NIST2024" ;
    ak:name "Demographic Metric Disaggregation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0485_NIST2024 .

mitigation:A0486_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Feedback Exercise Metrics"@en ;
    ak:description "Develop a suite of metrics to evaluate structured public feedback exercises informed by representative AI Actors." ;
    ak:identifier "A0486_NIST2024" ;
    ak:name "Feedback Exercise Metrics" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0486_NIST2024 .

mitigation:A0487_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Novel Risk Measurement Methods"@en ;
    ak:description "Evaluate novel methods and technologies for the measurement of GAI-related risks including in content provenance, offensive cyber, and CBRN, while maintaining the models' ability to produce valid, reliable, and factually accurate outputs." ;
    ak:identifier "A0487_NIST2024" ;
    ak:name "Novel Risk Measurement Methods" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0487_NIST2024 .

mitigation:A0488_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Equitable Output Monitoring"@en ;
    ak:description "Implement continuous monitoring of GAI system impacts to identify whether GAI outputs are equitable across various sub-populations. Seek active and direct feedback from affected communities via structured feedback mechanisms or red-teaming to monitor and improve outputs." ;
    ak:identifier "A0488_NIST2024" ;
    ak:name "Equitable Output Monitoring" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0488_NIST2024 .

mitigation:A0489_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Quality Evaluation"@en ;
    ak:description "Evaluate the quality and integrity of data used in training and the provenance of AI-generated content, for example by employing techniques like chaos engineering and seeking stakeholder feedback." ;
    ak:identifier "A0489_NIST2024" ;
    ak:name "Data Quality Evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0489_NIST2024 .

mitigation:A0490_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Feedback Exercise Use Cases"@en ;
    ak:description "Define use cases, contexts of use, capabilities, and negative impacts where structured human feedback exercises, e.g., GAI red-teaming, would be most beneficial for GAI risk measurement and management based on the context of use." ;
    ak:identifier "A0490_NIST2024" ;
    ak:name "Feedback Exercise Use Cases" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0490_NIST2024 .

mitigation:A0491_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Unmeasurable Risk Tracking"@en ;
    ak:description "Track and document risks or opportunities related to all GAI risks that cannot be measured quantitatively, including explanations as to why some risks cannot be measured (e.g., due to technological limitations, resource constraints, or trustworthy considerations). Include unmeasured risks in marginal risks." ;
    ak:identifier "A0491_NIST2024" ;
    ak:name "Unmeasurable Risk Tracking" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0491_NIST2024 .

mitigation:A0492_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Interest Group Definition"@en ;
    ak:description "Define relevant groups of interest (e.g., demographic groups, subject matter experts, experience with GAI technology) within the context of use as part of plans for gathering structured public feedback." ;
    ak:identifier "A0492_NIST2024" ;
    ak:name "Interest Group Definition" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0492_NIST2024 .

mitigation:A0493_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Evaluation Engagement"@en ;
    ak:description "Engage in internal and external evaluations, GAI red-teaming, impact assessments, or other structured human feedback exercises in consultation with representative AI Actors with expertise and familiarity in the context of use, and/or who are representative of the populations associated with the context of use." ;
    ak:identifier "A0493_NIST2024" ;
    ak:name "External Evaluation Engagement" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0493_NIST2024 .

mitigation:A0494_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Feedback Independence Verification"@en ;
    ak:description "Verify those conducting structured human feedback exercises are not directly involved in system development tasks for the same GAI model." ;
    ak:identifier "A0494_NIST2024" ;
    ak:name "Feedback Independence Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0494_NIST2024 .

mitigation:A0495_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Statistical Bias Management"@en ;
    ak:description "Assess and manage statistical biases related to GAI content provenance through techniques such as re-sampling, re-weighting, or adversarial training." ;
    ak:identifier "A0495_NIST2024" ;
    ak:name "Statistical Bias Management" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0495_NIST2024 .

mitigation:A0496_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Provenance Privacy Documentation"@en ;
    ak:description "Document how content provenance data is tracked and how that data interacts with privacy and security. Consider: Anonymizing data to protect the privacy of human subjects; Leveraging privacy output filters; Removing any personally identifiable information (PII) to prevent potential harm or misuse." ;
    ak:identifier "A0496_NIST2024" ;
    ak:name "Provenance Privacy Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0496_NIST2024 .

mitigation:A0497_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Participation Withdrawal Options"@en ;
    ak:description "Provide human subjects with options to withdraw participation or revoke their consent for present or future use of their data in GAI applications." ;
    ak:identifier "A0497_NIST2024" ;
    ak:name "Participation Withdrawal Options" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0497_NIST2024 .

mitigation:A0498_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Privacy-Enhancing Technologies"@en ;
    ak:description "Use techniques such as anonymization, differential privacy or other privacy-enhancing technologies to minimize the risks associated with linking AI-generated content back to individual human subjects." ;
    ak:identifier "A0498_NIST2024" ;
    ak:name "Privacy-Enhancing Technologies" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0498_NIST2024 .

mitigation:A0499_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Baseline Model Selection"@en ;
    ak:description "Consider baseline model performance on suites of benchmarks when selecting a model for fine tuning or enhancement with retrieval-augmented generation." ;
    ak:identifier "A0499_NIST2024" ;
    ak:name "Baseline Model Selection" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0499_NIST2024 .

mitigation:A0500_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Capability Claims Evaluation"@en ;
    ak:description "Evaluate claims of model capabilities using empirically validated methods" ;
    ak:identifier "A0500_NIST2024" ;
    ak:name "Capability Claims Evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0500_NIST2024 .

mitigation:A0501_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-Deployment Results Sharing"@en ;
    ak:description "Share results of pre-deployment testing with relevant GAI Actors, such as those with system release approval authority" ;
    ak:identifier "A0501_NIST2024" ;
    ak:name "Pre-Deployment Results Sharing" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0501_NIST2024 .

mitigation:A0502_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Purpose-Built Testing Environment"@en ;
    ak:description "Utilize a purpose-built testing environment such as NIST Dioptra to empirically evaluate GAI trustworthy characteristics." ;
    ak:identifier "A0502_NIST2024" ;
    ak:name "Purpose-Built Testing Environment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0502_NIST2024 .

mitigation:A0503_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Performance Extrapolation Avoidance"@en ;
    ak:description "Avoid extrapolating GAI system performance or capabilities from narrow, non-systematic, and anecdotal assessments." ;
    ak:identifier "A0503_NIST2024" ;
    ak:name "Performance Extrapolation Avoidance" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0503_NIST2024 .

mitigation:A0504_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human Domain Knowledge Documentation"@en ;
    ak:description "Document the extent to which human domain knowledge is employed to improve GAI system performance, via, e.g., RLHF, fine-tuning, retrieval-augmented generation, content moderation, business rules." ;
    ak:identifier "A0504_NIST2024" ;
    ak:name "Human Domain Knowledge Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0504_NIST2024 .

mitigation:A0505_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Source and Citation Review"@en ;
    ak:description "Review and verify sources and citations in GAI system outputs during pre-deployment risk measurement and ongoing monitoring activities" ;
    ak:identifier "A0505_NIST2024" ;
    ak:name "Source and Citation Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0505_NIST2024 .

mitigation:A0506_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Anthropomorphization Tracking"@en ;
    ak:description "Track and document instances of anthropomorphization (e.g., human images, mentions of human feelings, cyborg imagery or motifs) in GAI system interfaces." ;
    ak:identifier "A0506_NIST2024" ;
    ak:name "Anthropomorphization Tracking" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0506_NIST2024 .

mitigation:A0507_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Provenance Verification"@en ;
    ak:description "Verify GAI system training data and TEVV data provenance, and that fine-tuning or retrieval-augmented generation data is grounded" ;
    ak:identifier "A0507_NIST2024" ;
    ak:mitigates risk:atlas-data-curation,
        risk:atlas-data-poisoning,
        risk:atlas-data-provenance,
        risk:atlas-exposing-personal-information,
        risk:atlas-lack-of-data-transparency,
        risk:llm022025-sensitive-information-disclosure,
        risk:llm032025-supply-chain,
        risk:llm042025-data-and-model-poisoning ;
    ak:name "Data Provenance Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0507_NIST2024 .

mitigation:A0508_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Guardrail Review"@en ;
    ak:description "Regularly review security and safety guardrails, especially if the GAI system is being operated in novel circumstances. This includes reviewing reasons why the GAI system was initially assessed as being safe to deploy." ;
    ak:identifier "A0508_NIST2024" ;
    ak:name "Security Guardrail Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0508_NIST2024 .

mitigation:A0509_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Value Chain Wellbeing Assessment"@en ;
    ak:description "Assess adverse impacts, including health and wellbeing impacts for value chain or other AI Actors that are exposed to sexually explicit, offensive, or violent information during GAI training and maintenance." ;
    ak:identifier "A0509_NIST2024" ;
    ak:name "Value Chain Wellbeing Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0509_NIST2024 .

mitigation:A0510_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Training Data Harm Assessment"@en ;
    ak:description "Assess existence or levels of harmful bias, intellectual property infringement, data privacy violations, obscenity, extremism, violence, or CBRN information in system training data." ;
    ak:identifier "A0510_NIST2024" ;
    ak:name "Training Data Harm Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0510_NIST2024 .

mitigation:A0511_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-Tuned Safety Re-evaluation"@en ;
    ak:description "Re-evaluate safety features of fine-tuned models when the negative risk exceeds organizational risk tolerance." ;
    ak:identifier "A0511_NIST2024" ;
    ak:name "Fine-Tuned Safety Re-evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0511_NIST2024 .

mitigation:A0512_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Generated Code Review"@en ;
    ak:description "Review GAI system outputs for validity and safety: Review generated code to assess risks that may arise from unreliable downstream decision-making." ;
    ak:identifier "A0512_NIST2024" ;
    ak:mitigates risk:atlas-harmful-code-generation,
        risk:llm092025-misinformation ;
    ak:name "Generated Code Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0512_NIST2024 .

mitigation:A0513_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Architecture Monitoring Verification"@en ;
    ak:description "Verify that GAI system architecture can monitor outputs and performance, and handle, recover from, and repair errors when security anomalies, threats and impacts are detected." ;
    ak:identifier "A0513_NIST2024" ;
    ak:name "Architecture Monitoring Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0513_NIST2024 .

mitigation:A0514_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Inappropriate Query Handling"@en ;
    ak:description "Verify that systems properly handle queries that may give rise to inappropriate, malicious, or illegal usage, including facilitating manipulation, extortion, targeted impersonation, cyber-attacks, and weapons creation." ;
    ak:identifier "A0514_NIST2024" ;
    ak:name "Inappropriate Query Handling" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0514_NIST2024 .

mitigation:A0515_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety Circumvention Evaluation"@en ;
    ak:description "Regularly evaluate GAI system vulnerabilities to possible circumvention of safety measures." ;
    ak:identifier "A0515_NIST2024" ;
    ak:name "Safety Circumvention Evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0515_NIST2024 .

mitigation:A0516_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Vulnerability Assessment"@en ;
    ak:description "Apply established security measures to: Assess likelihood and magnitude of vulnerabilities and threats such as backdoors, compromised dependencies, data breaches, eavesdropping, man-in-the-middle attacks, reverse engineering, autonomous agents, model theft or exposure of model weights, AI inference, bypass, extraction, and other baseline security concerns." ;
    ak:identifier "A0516_NIST2024" ;
    ak:name "Security Vulnerability Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0516_NIST2024 .

mitigation:A0517_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Benchmarking"@en ;
    ak:description "Benchmark GAI system security and resilience related to content provenance against industry standards and best practices. Compare GAI system security features and content provenance methods against industry state-of-the-art" ;
    ak:identifier "A0517_NIST2024" ;
    ak:name "Security Benchmarking" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0517_NIST2024 .

mitigation:A0518_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User Satisfaction Survey"@en ;
    ak:description "Conduct user surveys to gather user satisfaction with the AI-generated content and user perceptions of content authenticity. Analyze user feedback to identify concerns and/or current literacy levels related to content provenance and understanding of labels on content." ;
    ak:identifier "A0518_NIST2024" ;
    ak:name "User Satisfaction Survey" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0518_NIST2024 .

mitigation:A0519_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Effectiveness Metrics"@en ;
    ak:description "Identify metrics that reflect the effectiveness of security measures, such as data provenance, the number of unauthorized access attempts, inference, bypass, extraction, penetrations, or provenance verification." ;
    ak:identifier "A0519_NIST2024" ;
    ak:name "Security Effectiveness Metrics" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0519_NIST2024 .

mitigation:A0520_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Authentication Method Reliability"@en ;
    ak:description "Measure reliability of content authentication methods, such as watermarking, cryptographic signatures, digital fingerprints, as well as access controls, conformity assessment, and model integrity verification, which can help support the effective implementation of content provenance techniques. Evaluate the rate of false positives and false negatives in content provenance, as well as true positives and true negatives for verification." ;
    ak:identifier "A0520_NIST2024" ;
    ak:name "Authentication Method Reliability" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0520_NIST2024 .

mitigation:A0521_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Implementation Rate"@en ;
    ak:description "Measure the rate at which recommendations from security checks and incidents are implemented. Assess how quickly the AI system can adapt and improve based on lessons learned from security incidents and feedback" ;
    ak:identifier "A0521_NIST2024" ;
    ak:name "Security Implementation Rate" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0521_NIST2024 .

mitigation:A0522_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "AI Red-Teaming Resilience"@en ;
    ak:description "Perform AI red-teaming to assess resilience against: Abuse to facilitate attacks on other systems (e.g., malicious code generation, enhanced phishing content), GAI attacks (e.g., prompt injection), ML attacks (e.g., adversarial examples/prompts, data poisoning, membership inference, model extraction, sponge examples)." ;
    ak:identifier "A0522_NIST2024" ;
    ak:mitigates risk:atlas-prompt-injection,
        risk:llm01-prompt-injection ;
    ak:name "AI Red-Teaming Resilience" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0522_NIST2024 .

mitigation:A0523_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-Tuning Security Verification"@en ;
    ak:description "Verify fine-tuning does not compromise safety and security controls." ;
    ak:identifier "A0523_NIST2024" ;
    ak:name "Fine-Tuning Security Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0523_NIST2024 .

mitigation:A0524_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Measure Effectiveness"@en ;
    ak:description "Regularly assess and verify that security measures remain effective and have not been compromised." ;
    ak:identifier "A0524_NIST2024" ;
    ak:name "Security Measure Effectiveness" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0524_NIST2024 .

mitigation:A0525_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Policy Violation Statistics"@en ;
    ak:description "Compile statistics on actual policy violations, take-down requests, and intellectual property infringement for organizational GAI systems: Analyze transparency reports across demographic groups, languages groups." ;
    ak:identifier "A0525_NIST2024" ;
    ak:name "Policy Violation Statistics" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0525_NIST2024 .

mitigation:A0526_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Annotator Instruction Documentation"@en ;
    ak:description "Document the instructions given to data annotators or AI red-teamers." ;
    ak:identifier "A0526_NIST2024" ;
    ak:name "Annotator Instruction Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0526_NIST2024 .

mitigation:A0527_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Digital Content Transparency"@en ;
    ak:description "Use digital content transparency solutions to enable the documentation of each instance where content is generated, modified, or shared to provide a tamper-proof history of the content, promote transparency, and enable traceability. Robust version control systems can also be applied to track changes across the AI lifecycle over time." ;
    ak:identifier "A0527_NIST2024" ;
    ak:name "Digital Content Transparency" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0527_NIST2024 .

mitigation:A0528_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User Instruction Adequacy"@en ;
    ak:description "Verify adequacy of GAI system user instructions through user testing." ;
    ak:identifier "A0528_NIST2024" ;
    ak:name "User Instruction Adequacy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0528_NIST2024 .

mitigation:A0529_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "ML Explanation Application"@en ;
    ak:description "Apply and document ML explanation results such as: Analysis of embeddings, Counterfactual prompts, Gradient-based attributions, Model compression/surrogate models, Occlusion/term reduction." ;
    ak:identifier "A0529_NIST2024" ;
    ak:name "ML Explanation Application" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0529_NIST2024 .

mitigation:A0530_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "GAI Model Documentation"@en ;
    ak:description "Document GAI model details including: Proposed use and organizational value; Assumptions and limitations, Data collection methodologies; Data provenance; Data quality; Model architecture (e.g., convolutional neural network, transformers, etc.); Optimization objectives; Training algorithms; RLHF approaches; Fine-tuning or retrieval-augmented generation approaches; Evaluation data; Ethical considerations; Legal and regulatory requirements." ;
    ak:identifier "A0530_NIST2024" ;
    ak:name "GAI Model Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0530_NIST2024 .

mitigation:A0531_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Exposure Red-Teaming"@en ;
    ak:description "Conduct AI red-teaming to assess issues such as: Outputting of training data samples, and subsequent reverse engineering, model extraction, and membership inference risks; Revealing biometric, confidential, copyrighted, licensed, patented, personal, proprietary, sensitive, or trade-marked information; Tracking or revealing location information of users or members of training datasets." ;
    ak:identifier "A0531_NIST2024" ;
    ak:mitigates risk:atlas-confidential-data-in-prompt,
        risk:atlas-confidential-information-in-data,
        risk:atlas-revealing-confidential-information,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Data Exposure Red-Teaming" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0531_NIST2024 .

mitigation:A0532_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "End-User Expectation Engagement"@en ;
    ak:description "Engage directly with end-users and other stakeholders to understand their expectations and concerns regarding content provenance. Use this feedback to guide the design of provenance data-tracking techniques." ;
    ak:identifier "A0532_NIST2024" ;
    ak:name "End-User Expectation Engagement" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0532_NIST2024 .

mitigation:A0533_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Deduplication Verification"@en ;
    ak:description "Verify deduplication of GAI training data samples, particularly regarding synthetic data" ;
    ak:identifier "A0533_NIST2024" ;
    ak:name "Data Deduplication Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0533_NIST2024 .

mitigation:A0534_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Bias Benchmark Application"@en ;
    ak:description "Apply use-case appropriate benchmarks (e.g., Bias Benchmark Questions, Real Hateful or Harmful Prompts, Winogender Schemas15) to quantify systemic bias, stereotyping, denigration, and hateful content in GAI system outputs; Document assumptions and limitations of benchmarks, including any actual or possible training/test data cross contamination, relative to in-context deployment environment." ;
    ak:identifier "A0534_NIST2024" ;
    ak:name "Bias Benchmark Application" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0534_NIST2024 .

mitigation:A0624_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Ownership by Capability"@en ;
    ak:description "Take responsibility for risk assessment and risk management tasks for which your organization has access to information, capability, or opportunity to develop capability sufficient for constructive action, or that is substantially greater than others in the value chain" ;
    ak:identifier "A0624_Barrett2024" ;
    ak:name "Risk Ownership by Capability" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0624_Barrett2024 .

mitigation:A0625_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk-Tolerance Thresholds"@en ;
    ak:description "Set risk-tolerance thresholds to prevent unacceptable risks" ;
    ak:identifier "A0625_Barrett2024" ;
    ak:name "Risk-Tolerance Thresholds" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0625_Barrett2024 .

mitigation:A0626_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Anticipate Misuse & Impact"@en ;
    ak:description "Identify reasonably foreseeable uses, and misuses or abuses for a GPAIS (e.g, auto- mated generation of toxic or illegal content or disinformation, or aiding with proliferation of cyber, chemical, biological, or radiological weapons), and identify reasonably foreseeable potential impacts (e.g., to fundamental rights)" ;
    ak:identifier "A0626_Barrett2024" ;
    ak:name "Anticipate Misuse & Impact" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0626_Barrett2024 .

mitigation:A0627_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Assess Catastrophic Risk"@en ;
    ak:description "Identify whether a GPAIS could lead to significant, severe, or catastrophic impacts, e.g., because of correlated failures or errors across high-stakes deployment domains, dan- gerous emergent behaviors or vulnerabilities, or harmful misuses and abuses" ;
    ak:identifier "A0627_Barrett2024" ;
    ak:name "Assess Catastrophic Risk" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0627_Barrett2024 .

mitigation:A0628_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Red-Team for Dangerous Behaviors"@en ;
    ak:description "Use red teams and adversarial testing as part of extensive interaction with GPAIS to identify dangerous capabilities, vulnerabilities, or other emergent properties of such systems" ;
    ak:identifier "A0628_Barrett2024" ;
    ak:name "Red-Team for Dangerous Behaviors" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0628_Barrett2024 .

mitigation:A0629_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Tracking"@en ;
    ak:description "Track important identified risks (e.g., vulnerabilities from data poisoning and other attacks or objectives mis-specification) even if they cannot yet be measured" ;
    ak:identifier "A0629_Barrett2024" ;
    ak:name "Risk Tracking" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0629_Barrett2024 .

mitigation:A0630_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Apply Lifecycle Risk Controls"@en ;
    ak:description "Implement risk-reduction controls as appropriate throughout a GPAIS lifecycle, e.g., independent auditing, incremental scale-up, red-teaming, structured access or staged release, and other steps" ;
    ak:identifier "A0630_Barrett2024" ;
    ak:name "Apply Lifecycle Risk Controls" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0630_Barrett2024 .

mitigation:A0631_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclose Risks to Stakeholders"@en ;
    ak:description "Incorporate identified AI system risk factors, and circumstances that could result in impacts or harms, into reporting and engagement with internal and external stake- holders (e.g., to downstream developers, regulators, users, impacted communities, etc.) on the AI system as appropriate, e.g., using model cards, system cards, and other transparency mechanisms" ;
    ak:identifier "A0631_Barrett2024" ;
    ak:name "Disclose Risks to Stakeholders" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0631_Barrett2024 .

mitigation:A0632_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Mitigation Rationale"@en ;
    ak:description "Document the process used in considering risk mitigation controls, the options considered, and reasons for choices." ;
    ak:identifier "A0632_Barrett2024" ;
    ak:name "Document Mitigation Rationale" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0632_Barrett2024 .

mitigation:A0633_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Ensure Legal Compliance"@en ;
    ak:description "Legal and regulatory requirements involving AI are understood, managed, and documented." ;
    ak:identifier "A0633_Barrett2024" ;
    ak:name "Ensure Legal Compliance" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0633_Barrett2024 .

mitigation:A0634_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Trustworthy AI practices"@en ;
    ak:description "The characteristics of trustworthy AI are integrated into organizational policies, processes, procedures, and practices." ;
    ak:identifier "A0634_Barrett2024" ;
    ak:name "Trustworthy AI practices" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0634_Barrett2024 .

mitigation:A0635_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Align Risk Management to Tolerance"@en ;
    ak:description "Processes, procedures, and practices are in place to determine the needed level of risk management activities based on the organization’s risk tolerance." ;
    ak:identifier "A0635_Barrett2024" ;
    ak:name "Align Risk Management to Tolerance" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0635_Barrett2024 .

mitigation:A0636_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Transparent RM Policies"@en ;
    ak:description "The risk management process and its outcomes are established through transparent policies, procedures, and other controls based on organizational risk priorities." ;
    ak:identifier "A0636_Barrett2024" ;
    ak:name "Transparent RM Policies" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0636_Barrett2024 .

mitigation:A0637_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitoring of RM policies"@en ;
    ak:description "Ongoing monitoring and periodic review of the risk management process and its outcomes are planned and organizational roles and responsibilities clearly defined, including determining the frequency of periodic review." ;
    ak:identifier "A0637_Barrett2024" ;
    ak:name "Monitoring of RM policies" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0637_Barrett2024 .

mitigation:A0638_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Inventory AI Systems"@en ;
    ak:description "Mechanisms are in place to inventory AI systems and are resourced according to organizational risk priorities." ;
    ak:identifier "A0638_Barrett2024" ;
    ak:name "Inventory AI Systems" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0638_Barrett2024 .

mitigation:A0639_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Decommission AI Systems Safely"@en ;
    ak:description "Processes and procedures are in place for decommissioning and phasing out AI systems safely and in a manner that does not increase risks or decrease the organization’s trustworthiness." ;
    ak:identifier "A0639_Barrett2024" ;
    ak:name "Decommission AI Systems Safely" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0639_Barrett2024 .

mitigation:A0640_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Define AI Risk Roles"@en ;
    ak:description "Roles and responsibilities and lines of communication related to mapping, measuring, and managing AI risks are documented and are clear to individuals and teams throughout the organization." ;
    ak:identifier "A0640_Barrett2024" ;
    ak:name "Define AI Risk Roles" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0640_Barrett2024 .

mitigation:A0641_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Train on AI Risk"@en ;
    ak:description "The organization’s personnel and partners receive AI risk management training to enable them to perform their duties and responsibilities consistent with related policies, procedures, and agreements" ;
    ak:identifier "A0641_Barrett2024" ;
    ak:name "Train on AI Risk" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0641_Barrett2024 .

mitigation:A0642_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Executive Risk Accountability"@en ;
    ak:description "Executive leadership of the organization takes responsibility for decisions about risks associated with AI sys- tem development and deployment." ;
    ak:identifier "A0642_Barrett2024" ;
    ak:name "Executive Risk Accountability" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0642_Barrett2024 .

mitigation:A0643_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Diverse Risk Voices"@en ;
    ak:description "Decision-making related to mapping, measuring, and managing AI risks throughout the lifecycle is informed by a diverse team (e.g., diversity of demographics, disciplines, experience, expertise, and backgrounds)." ;
    ak:identifier "A0643_Barrett2024" ;
    ak:name "Diverse Risk Voices" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0643_Barrett2024 .

mitigation:A0644_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Oversight Roles"@en ;
    ak:description "Policies and procedures are in place to define and differentiate roles and responsibilities for human-AI configurations and oversight of AI systems." ;
    ak:identifier "A0644_Barrett2024" ;
    ak:name "Human-AI Oversight Roles" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0644_Barrett2024 .

mitigation:A0645_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety-First Culture"@en ;
    ak:description "Organizational policies and practices are in place to foster a critical thinking and safety- first mindset in the design, development, deployment, and uses of AI systems to minimize potential negative impacts." ;
    ak:identifier "A0645_Barrett2024" ;
    ak:name "Safety-First Culture" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0645_Barrett2024 .

mitigation:A0646_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document & Share AI Risk Impacts"@en ;
    ak:description "Organizational teams document the risks and potential impacts of the AI technology they design, develop, deploy, evaluate, and use, and they communicate about the impacts more broadly." ;
    ak:identifier "A0646_Barrett2024" ;
    ak:name "Document & Share AI Risk Impacts" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0646_Barrett2024 .

mitigation:A0647_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Detect & Share Incidents"@en ;
    ak:description "Organizational practices are in place to enable AI testing, identification of incidents, and information sharing." ;
    ak:identifier "A0647_Barrett2024" ;
    ak:name "Detect & Share Incidents" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0647_Barrett2024 .

mitigation:A0648_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Feedback on Impacts"@en ;
    ak:description "Organizational policies and practices are in place to collect, consider, prioritize, and integrate feedback from those external to the team that developed or deployed the AI system regarding the potential individual and societal impacts related to AI risks." ;
    ak:identifier "A0648_Barrett2024" ;
    ak:name "External Feedback on Impacts" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0648_Barrett2024 .

mitigation:A0649_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Feedback on System Design"@en ;
    ak:description "Mechanisms are established to enable the team that developed or deployed AI systems to regularly incorporate adjudicated feedback from relevant AI actors into system design and implementation." ;
    ak:identifier "A0649_Barrett2024" ;
    ak:name "External Feedback on System Design" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0649_Barrett2024 .

mitigation:A0650_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Risk"@en ;
    ak:description "Policies and procedures are in place that address AI risks associated with third-party entities, including risks of infringement of a third-party’s intellectual property or other rights." ;
    ak:identifier "A0650_Barrett2024" ;
    ak:name "Third-Party Risk" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0650_Barrett2024 .

mitigation:A0651_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Contingency Planning for Third-Party Failures"@en ;
    ak:description "Contingency processes are in place to handle failures or incidents in third-party data or AI systems deemed to be high-risk." ;
    ak:identifier "A0651_Barrett2024" ;
    ak:name "Contingency Planning for Third-Party Failures" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0651_Barrett2024 .

mitigation:A0652_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Intended Use & Context"@en ;
    ak:description "Intended purposes, potentially beneficial uses, context-specific laws, norms and expectations, and prospective settings in which the AI system will be deployed are understood and documented." ;
    ak:identifier "A0652_Barrett2024" ;
    ak:name "Document Intended Use & Context" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0652_Barrett2024 .

mitigation:A0653_Barrett2024 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Prioritize Interdisciplinary Collaboration"@en ;
    ak:description "Interdisciplinary AI actors, competencies, skills, and capacities for establish- ing context reflect de- mographic diversity and broad domain and user experience expertise, and their participation is documented. Oppor- tunities for interdisci- plinary collaboration are prioritized." ;
    ak:identifier "A0653_Barrett2024" ;
    ak:name "Prioritize Interdisciplinary Collaboration" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0653_Barrett2024 .

mitigation:A0654_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document AI Mission & Goals"@en ;
    ak:description "The organization’s mission and relevant goals for AI technology are understood and documented." ;
    ak:identifier "A0654_Barrett2024" ;
    ak:name "Document AI Mission & Goals" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0654_Barrett2024 .

mitigation:A0655_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Business Use"@en ;
    ak:description "The business value or context of business use has been clearly defined or – in the case of assessing existing AI systems – re-evaluated." ;
    ak:identifier "A0655_Barrett2024" ;
    ak:name "Business Use" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0655_Barrett2024 .

mitigation:A0656_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Tolerance Thresholds"@en ;
    ak:description "Organizational risk tolerances are determined and documented." ;
    ak:identifier "A0656_Barrett2024" ;
    ak:name "Risk Tolerance Thresholds" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0656_Barrett2024 .

mitigation:A0657_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Elicit Requirements & Assess Impacts"@en ;
    ak:description "System requirements (e.g., “the system shall respect the privacy of its users”) are elicited from and understood by relevant AI actors. Design decisions take socio-technical implications into account to address AI risks" ;
    ak:identifier "A0657_Barrett2024" ;
    ak:name "Elicit Requirements & Assess Impacts" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0657_Barrett2024 .

mitigation:A0658_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Define Tasks & Methods"@en ;
    ak:description "The specific tasks and methods used to implement the tasks that the AI system will support are defined (e.g., classifiers, generative models, recommenders)." ;
    ak:identifier "A0658_Barrett2024" ;
    ak:name "Define Tasks & Methods" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0658_Barrett2024 .

mitigation:A0659_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Limits & Oversight"@en ;
    ak:description "Information about the AI system’s knowledge limits and how system output may be utilized and overseen by humans is documented. Documen- tation provides sufficient information to assist relevant AI actors when making decisions and tak- ing subsequent actions." ;
    ak:identifier "A0659_Barrett2024" ;
    ak:name "Document Limits & Oversight" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0659_Barrett2024 .

mitigation:A0660_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document TEVV & Integrity"@en ;
    ak:description "Scientific integrity and TEVV considerations are identified and docu- mented, including those related to experimental design, data collection and selection (e.g., availability, represen- tativeness, suitability), system trustworthiness, and construct validation" ;
    ak:identifier "A0660_Barrett2024" ;
    ak:name "Document TEVV & Integrity" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0660_Barrett2024 .

mitigation:A0661_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Intended Benefits"@en ;
    ak:description "Potential benefits of intend- ed AI system functionality and performance are ex- amined and documented" ;
    ak:identifier "A0661_Barrett2024" ;
    ak:name "Document Intended Benefits" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0661_Barrett2024 .

mitigation:A0662_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document AI Error Costs"@en ;
    ak:description "Potential costs, in- cluding non-monetary costs, which result from expected or realized AI errors or system func- tionality and trustwor- thiness – as connected to organizational risk tolerance – are exam- ined and documented." ;
    ak:identifier "A0662_Barrett2024" ;
    ak:name "Document AI Error Costs" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0662_Barrett2024 .

mitigation:A0663_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Application Scope"@en ;
    ak:description "Targeted application scope is specified and documented based on the system’s capability, established context, and AI system categorization." ;
    ak:identifier "A0663_Barrett2024" ;
    ak:name "Document Application Scope" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0663_Barrett2024 .

mitigation:A0664_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Operator Proficiency"@en ;
    ak:description "Processes for operator and practitioner proficiency with AI system performance and trustworthiness – and relevant technical standards and certifications – are defined, assessed, and documented." ;
    ak:identifier "A0664_Barrett2024" ;
    ak:name "Document Operator Proficiency" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0664_Barrett2024 .

mitigation:A0665_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Define Human Oversight Protocols"@en ;
    ak:description "Processes for human oversight are defined, assessed, and documented in accordance with organizational policies from the Govern function" ;
    ak:identifier "A0665_Barrett2024" ;
    ak:name "Define Human Oversight Protocols" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0665_Barrett2024 .

mitigation:A0666_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document AI RM Third Party Framework"@en ;
    ak:description "Approaches for mapping AI technology and legal risks of its components – including the use of third-party data or software – are in place, followed, and docu- mented, as are risks of infringement of a third party’s intellectual prop- erty or other rights." ;
    ak:identifier "A0666_Barrett2024" ;
    ak:name "Document AI RM Third Party Framework" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0666_Barrett2024 .

mitigation:A0667_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Internal & Third-Party Controls"@en ;
    ak:description "Internal risk controls for components of the AI system, including third- party AI technologies, are identified and documented." ;
    ak:identifier "A0667_Barrett2024" ;
    ak:name "Document Internal & Third-Party Controls" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0667_Barrett2024 .

mitigation:A0668_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Assess & Document Risk Magnitude"@en ;
    ak:description "Likelihood and magnitude of each identified impact (both potentially beneficial and harmful) based on expected use, past uses of AI systems in similar contexts, public incident reports, feedback from those external to the team that developed or deployed the AI system, or other data are identified and documented." ;
    ak:identifier "A0668_Barrett2024" ;
    ak:name "Assess & Document Risk Magnitude" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0668_Barrett2024 .

mitigation:A0669_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Establish Feedback Integration Processes"@en ;
    ak:description "Practices and personnel for supporting regular engagement with relevant AI actors and integrating feedback about positive, negative, and unanticipated impacts are in place and documented." ;
    ak:identifier "A0669_Barrett2024" ;
    ak:name "Establish Feedback Integration Processes" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0669_Barrett2024 .

mitigation:A0670_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Select & Document Risk Metrics"@en ;
    ak:description "Approaches and metrics for measurement of AI risks enumerated during the Map function are selected for implementation starting with the most significant AI risks. The risks or trustworthiness characteristics that will not – or cannot – be measured are properly documented." ;
    ak:identifier "A0670_Barrett2024" ;
    ak:name "Select & Document Risk Metrics" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0670_Barrett2024 .

mitigation:A0671_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluate Risk Metrics & Controls"@en ;
    ak:description "Appropriateness of AI metrics and effectiveness of existing controls are regularly assessed and updated, including reports of errors and potential impacts on affected communities." ;
    ak:identifier "A0671_Barrett2024" ;
    ak:name "Evaluate Risk Metrics & Controls" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0671_Barrett2024 .

mitigation:A0672_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Involve Independent & External Assessors"@en ;
    ak:description "Internal experts who did not serve as front-line developers for the system and/ or independent assessors are involved in regular assessments and updates. Domain experts, users, AI actors external to the team that developed or deployed the AI system, and affected communities are consulted in support of assessments as necessary per organizational risk tolerance." ;
    ak:identifier "A0672_Barrett2024" ;
    ak:name "Involve Independent & External Assessors" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0672_Barrett2024 .

mitigation:A0673_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document TEVV Tools & Metrics"@en ;
    ak:description "Test sets, metrics, and details about the tools used during TEVV are documented." ;
    ak:identifier "A0673_Barrett2024" ;
    ak:name "Document TEVV Tools & Metrics" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0673_Barrett2024 .

mitigation:A0674_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Ensure Ethical Human Evaluation"@en ;
    ak:description "Evaluations involving human subjects meet applicable requirements (including human subject protection) and are representative of the relevant population." ;
    ak:identifier "A0674_Barrett2024" ;
    ak:name "Ensure Ethical Human Evaluation" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0674_Barrett2024 .

mitigation:A0675_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Measure & Document Deployment Performance"@en ;
    ak:description "AI system performance or assurance criteria are measured qualitatively or quantitatively and demonstrated for conditions similar to deployment setting(s). Measures are documented" ;
    ak:identifier "A0675_Barrett2024" ;
    ak:name "Measure & Document Deployment Performance" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0675_Barrett2024 .

mitigation:A0676_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitor System in Production"@en ;
    ak:description "The functionality and behavior of the AI system and its components – as identified in the Map function – are monitored when in production." ;
    ak:identifier "A0676_Barrett2024" ;
    ak:name "Monitor System in Production" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0676_Barrett2024 .

mitigation:A0677_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Demonstrate Validity & Generalization Limits"@en ;
    ak:description "The AI system to be deployed is demonstrated to be valid and reliable. Limitations of the generalizability beyond the conditions under which the technology was developed are documented." ;
    ak:identifier "A0677_Barrett2024" ;
    ak:name "Demonstrate Validity & Generalization Limits" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0677_Barrett2024 .

mitigation:A0678_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluate Safety & Failure Modes"@en ;
    ak:description "The AI system is evaluated regularly for safety risks – as identified in the Map function. The AI system to be deployed is demonstrated to be safe, its residual negative risk does not exceed the risk tolerance, and it can fail safely, particularly if made to operate beyond its knowledge limits. Safety metrics reflect system reliability and robustness, real- time monitoring, and response times for AI system failures." ;
    ak:identifier "A0678_Barrett2024" ;
    ak:name "Evaluate Safety & Failure Modes" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0678_Barrett2024 .

mitigation:A0679_Barrett2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluate Security & Resilience"@en ;
    ak:description "AI system security and resilience – as identified in the Map function – are evaluated and documented." ;
    ak:identifier "A0679_Barrett2024" ;
    ak:name "Evaluate Security & Resilience" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0679_Barrett2024 .

mitigation:A0680_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Explain & Document Model Behavior"@en ;
    ak:description "The AI model is explained, validated, and documented, and AI system output is interpreted within its context – as identified in the Map function – to inform responsible use and governance." ;
    ak:identifier "A0680_Barrett2024" ;
    ak:name "Explain & Document Model Behavior" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0680_Barrett2024 .

mitigation:A0681_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Examine & Document Privacy Risk"@en ;
    ak:description "Privacy risk of the AI system – as identified in the Map function – is examined and documented." ;
    ak:identifier "A0681_Barrett2024" ;
    ak:name "Examine & Document Privacy Risk" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0681_Barrett2024 .

mitigation:A0682_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluate & Document Fairness"@en ;
    ak:description "Fairness and bias – as identified in the Map function – are evaluated and results are documented." ;
    ak:identifier "A0682_Barrett2024" ;
    ak:name "Evaluate & Document Fairness" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0682_Barrett2024 .

mitigation:A0683_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Assess Environmental Impact"@en ;
    ak:description "Environmental impact and sustainability of AI model training and management activities – as identified in the Map function – are assessed and documented." ;
    ak:identifier "A0683_Barrett2024" ;
    ak:name "Assess Environmental Impact" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0683_Barrett2024 .

mitigation:A0684_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluate TEVV Effectiveness"@en ;
    ak:description "Effectiveness of the employed TEVV metrics and processes in the Measure function are evaluated and documented." ;
    ak:identifier "A0684_Barrett2024" ;
    ak:name "Evaluate TEVV Effectiveness" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0684_Barrett2024 .

mitigation:A0685_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Track Emergent AI Risks"@en ;
    ak:description "Approaches, personnel, and documentation are in place to regularly identify and track existing, unanticipated, and emergent AI risks based on factors such as intended and actual performance in deployed contexts." ;
    ak:identifier "A0685_Barrett2024" ;
    ak:name "Track Emergent AI Risks" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0685_Barrett2024 .

mitigation:A0686_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Consider Alternatives for Hard-to-Measure Risks"@en ;
    ak:description "Risk tracking approaches are considered for settings where AI risks are difficult to assess using currently available measurement techniques or where metrics are not yet available." ;
    ak:identifier "A0686_Barrett2024" ;
    ak:name "Consider Alternatives for Hard-to-Measure Risks" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0686_Barrett2024 .

mitigation:A0687_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Enable User Feedback & Appeals"@en ;
    ak:description "Feedback processes for end users and impacted communities to report problems and appeal system outcomes are established and inte- grated into AI system evaluation metrics." ;
    ak:identifier "A0687_Barrett2024" ;
    ak:name "Enable User Feedback & Appeals" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0687_Barrett2024 .

mitigation:A0688_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Align Risk Metrics with Context"@en ;
    ak:description "Measurement approach- es for identifying AI risks are connected to deployment context(s) and informed through consultation with do- main experts and other end users. Approaches are documented." ;
    ak:identifier "A0688_Barrett2024" ;
    ak:name "Align Risk Metrics with Context" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0688_Barrett2024 .

mitigation:A0689_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Validate Trustworthiness with Expert Input"@en ;
    ak:description "Measurement results regarding AI system trustworthiness in deployment context(s) and across the AI lifecycle are informed by input from domain experts and relevant AI actors to validate whether the system is performing consistently as intended. Results are documented." ;
    ak:identifier "A0689_Barrett2024" ;
    ak:name "Validate Trustworthiness with Expert Input" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0689_Barrett2024 .

mitigation:A0690_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Performance Shifts from Field Data"@en ;
    ak:description "Measurable performance improvements or declines based on consultations with relevant AI actors, including affected communities, and field data about context-relevant risks and trustworthiness characteristics are identified and document" ;
    ak:identifier "A0690_Barrett2024" ;
    ak:name "Document Performance Shifts from Field Data" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0690_Barrett2024 .

mitigation:A0691_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Determine Deployment Readiness"@en ;
    ak:description "A determination is made as to whether the AI system achieves its intended purposes and stated objectives and whether its development or deployment should proceed." ;
    ak:identifier "A0691_Barrett2024" ;
    ak:name "Determine Deployment Readiness" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0691_Barrett2024 .

mitigation:A0692_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Prioritize Risk Treatment"@en ;
    ak:description "Treatment of documented AI risks is prioritized based on impact, likelihood, and available resources or methods." ;
    ak:identifier "A0692_Barrett2024" ;
    ak:name "Prioritize Risk Treatment" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0692_Barrett2024 .

mitigation:A0693_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Plan & Document Risk Responses"@en ;
    ak:description "Responses to the AI risks deemed high priority, as identified by the Map function, are developed, planned, and documented. Risk response options can include mitigating, transferring, avoiding, or accepting." ;
    ak:identifier "A0693_Barrett2024" ;
    ak:name "Plan & Document Risk Responses" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0693_Barrett2024 .

mitigation:A0694_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Document Residual Risks"@en ;
    ak:description "Negative residual risks (defined as the sum of all unmitigated risks) to both downstream acquirers of AI systems and end users are documented." ;
    ak:identifier "A0694_Barrett2024" ;
    ak:name "Document Residual Risks" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0694_Barrett2024 .

mitigation:A0695_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Consider Resources & Alternatives"@en ;
    ak:description "Resources required to manage AI risks are taken into account – along with viable non-AI alternative systems, approaches, or methods – to reduce the magnitude or likelihood of potential impacts." ;
    ak:identifier "A0695_Barrett2024" ;
    ak:name "Consider Resources & Alternatives" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0695_Barrett2024 .

mitigation:A0696_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sustain Deployed System Value"@en ;
    ak:description "Mechanisms are in place and applied to sustain the value of deployed AI systems." ;
    ak:identifier "A0696_Barrett2024" ;
    ak:name "Sustain Deployed System Value" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0696_Barrett2024 .

mitigation:A0697_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Respond to Unknown Risks"@en ;
    ak:description "Procedures are followed to respond to and recover from a previously unknown risk when it is identified." ;
    ak:identifier "A0697_Barrett2024" ;
    ak:name "Respond to Unknown Risks" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0697_Barrett2024 .

mitigation:A0698_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Deactivate Misaligned Systems"@en ;
    ak:description "Mechanisms are in place and applied, and responsibilities are assigned and understood, to supersede, disengage, or deactivate AI systems that demonstrate performance or outcomes inconsistent with intended use." ;
    ak:identifier "A0698_Barrett2024" ;
    ak:name "Deactivate Misaligned Systems" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0698_Barrett2024 .

mitigation:A0699_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitor Third-Party Risks"@en ;
    ak:description "AI risks and benefits from third-party resources are regularly monitored, and risk controls are applied and documented." ;
    ak:identifier "A0699_Barrett2024" ;
    ak:name "Monitor Third-Party Risks" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0699_Barrett2024 .

mitigation:A0700_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitor Pre-trained Models"@en ;
    ak:description "Pre-trained models which are used for development are monitored as part of AI system regular monitoring and maintenance." ;
    ak:identifier "A0700_Barrett2024" ;
    ak:name "Monitor Pre-trained Models" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0700_Barrett2024 .

mitigation:A0701_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement Post-deployment Monitoring Plan"@en ;
    ak:description "Post-deployment AI system monitoring plans are implemented, including mechanisms for capturing and evaluating input from users and other relevant AI actors, appeal and override, decommissioning, incident response, recovery, and change management." ;
    ak:identifier "A0701_Barrett2024" ;
    ak:name "Implement Post-deployment Monitoring Plan" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0701_Barrett2024 .

mitigation:A0702_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Integrate Continuous Improvement"@en ;
    ak:description "Measurable activities for continual improvements are integrated into AI system updates and include regular engagement with interested parties, including relevant AI actors." ;
    ak:identifier "A0702_Barrett2024" ;
    ak:name "Integrate Continuous Improvement" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0702_Barrett2024 .

mitigation:A0703_Barrett2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Report & Respond to Incidents"@en ;
    ak:description "Incidents and errors are communicated to relevant AI actors, including affected communities. Processes for tracking, responding to, and recovering from incidents and errors are followed and documented." ;
    ak:identifier "A0703_Barrett2024" ;
    ak:name "Report & Respond to Incidents" ;
    ak:source "https://cltc.berkeley.edu/wp-content/uploads/2023/11/Berkeley-GPAIS-Foundation-Model-Risk-Management-Standards-Profile-v1.0.pdf#page=83"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0703_Barrett2024 .

mitigation:A0707_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Bias and Homogenization Assessment"@en ;
    ak:description "Conduct fairness assessments to measure systemic bias. Measure GAI system performance across demographic groups and subgroups, addressing both quality of service and any allocation of services and resources. Quantify harms using: field testing with sub-group populations to determine likelihood of exposure to generated content exhibiting harmful bias, AI red-teaming with counterfactual and low-context (e.g., “leader,” “bad guys”) prompts. For ML pipelines or business processes with categorical or numeric outcomes that rely on GAI, apply general fairness metrics (e.g., demographic parity, equalized odds, equal opportunity, statistical hypothesis tests), to the pipeline or business outcome where appropriate; Custom, context-specific metrics developed in collaboration with domain experts and affected communities; Measurements of the prevalence of denigration in generated content in deployment (e.g., subsampling a fraction of traffic and manually annotating denigrating content)" ;
    ak:identifier "A0707_NIST2024" ;
    ak:name "Harmful Bias and Homogenization Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0707_NIST2024 .

mitigation:A0708_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Assessments for Environmental; Harmful Bias and Homogenization"@en ;
    ak:description "Identify the classes of individuals, groups, or environmental ecosystems which might be impacted by GAI systems through direct engagement with potentially impacted communities." ;
    ak:identifier "A0708_NIST2024" ;
    ak:name "Assessments for Environmental; Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0708_NIST2024 .

mitigation:A0709_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Bias and Homogenization Data Review"@en ;
    ak:description "Review, document, and measure sources of bias in GAI training and TEVV data: Differences in distributions of outcomes across and within groups, including intersecting groups; Completeness, representativeness, and balance of data sources; demographic group and subgroup coverage in GAI system training data; Forms of latent systemic bias in images, text, audio, embeddings, or other complex or unstructured data; Input data features that may serve as proxies for demographic group membership (i.e., image metadata, language dialect) or otherwise give rise to emergent bias within GAI systems; The extent to which the digital divide may negatively impact representativeness in GAI system training and TEVV data; Filtering of hate speech or content in GAI system training data; Prevalence of GAI-generated data in GAI system training data" ;
    ak:identifier "A0709_NIST2024" ;
    ak:name "Harmful Bias and Homogenization Data Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0709_NIST2024 .

mitigation:A0710_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Bias and Homogenization Assessment"@en ;
    ak:description "Assess the proportion of synthetic to non-synthetic training data and verify training data is not overly homogenous or GAI-produced to mitigate concerns of model collapse." ;
    ak:identifier "A0710_NIST2024" ;
    ak:name "Harmful Bias and Homogenization Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0710_NIST2024 .

mitigation:A0711_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Dangerous, Violent, or Hateful Content Mitigation"@en ;
    ak:description "Assess safety to physical environments when deploying GAI systems" ;
    ak:identifier "A0711_NIST2024" ;
    ak:name "Dangerous, Violent, or Hateful Content Mitigation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0711_NIST2024 .

mitigation:A0712_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Environmental Degradation Minimisation"@en ;
    ak:description "Document anticipated environmental impacts of model development, maintenance, and deployment in product design decisions." ;
    ak:identifier "A0712_NIST2024" ;
    ak:name "Environmental Degradation Minimisation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0712_NIST2024 .

mitigation:A0713_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Environmental Impact Assessment"@en ;
    ak:description "Measure or estimate environmental impacts (e.g., energy and water consumption) for training, fine tuning, and deploying models: Verify tradeoffs between resources used at inference time versus additional resources required at training time." ;
    ak:identifier "A0713_NIST2024" ;
    ak:name "Environmental Impact Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0713_NIST2024 .

mitigation:A0714_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Effectiveness of Carbon Capture"@en ;
    ak:description "Verify effectiveness of carbon capture or offset programs for GAI training and applications, and address green-washing concerns." ;
    ak:identifier "A0714_NIST2024" ;
    ak:name "Effectiveness of Carbon Capture" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0714_NIST2024 .

mitigation:A0715_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Confabulation; Information Integrity; Harmful Bias and Homogenization Measurement Error Models"@en ;
    ak:description "Create measurement error models for pre-deployment metrics to demonstrate construct validity for each metric (i.e., does the metric effectively operationalize the desired concept): Measure or estimate, and document, biases or statistical variance in applied metrics or structured human feedback processes; Leverage domain expertise when modeling complex societal constructs such as hateful content." ;
    ak:identifier "A0715_NIST2024" ;
    ak:name "Confabulation; Information Integrity; Harmful Bias and Homogenization Measurement Error Models" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0715_NIST2024 .

mitigation:A0716_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Bias and Homogenization Assessments"@en ;
    ak:description "Conduct impact assessments on how AI-generated content might affect different social, economic, and cultural groups." ;
    ak:identifier "A0716_NIST2024" ;
    ak:name "Harmful Bias and Homogenization Assessments" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0716_NIST2024 .

mitigation:A0717_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Information Integrity Studies"@en ;
    ak:description "Conduct studies to understand how end users perceive and interact with GAI content and accompanying content provenance within context of use. Assess whether the content aligns with their expectations and how they may act upon the information presented." ;
    ak:identifier "A0717_NIST2024" ;
    ak:name "Human-AI Configuration; Information Integrity Studies" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0717_NIST2024 .

mitigation:A0718_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Bias and Homogenization Evaluation"@en ;
    ak:description "Evaluate potential biases and stereotypes that could emerge from the AIgenerated content using appropriate methodologies including computational testing methods as well as evaluating structured feedback input (AI Deployment, Domain Experts, End-Users, Operation and Monitoring, TEVV)" ;
    ak:identifier "A0718_NIST2024" ;
    ak:name "Harmful Bias and Homogenization Evaluation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0718_NIST2024 .

mitigation:A0719_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Information Integrity; Harmful Bias and Homogenization"@en ;
    ak:description "Provide input for training materials about the capabilities and limitations of GAI systems related to digital content transparency for AI Actors, other professionals, and the public about the societal impacts of AI and the role of diverse and inclusive content generation (AI Deployment, Affected Individuals and Communities, End-Users, Operation and Monitoring, TEVV)" ;
    ak:identifier "A0719_NIST2024" ;
    ak:name "Human-AI Configuration; Information Integrity; Harmful Bias and Homogenization" ;
