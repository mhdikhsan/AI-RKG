risk:atlas-context-overload-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Context overload attack"@en ;
    ak:description "Overloading the prompt with excessive tokens, for instance with many-shot examples, can predispose models to a vulnerable state." ;
    ak:identifier "atlas-context-overload-attack" ;
    ak:name "Context overload attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/context-overload-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection ;
    skos:exactMatch nexus:atlas-context-overload-attack .

risk:atlas-decision-bias a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Decision bias"@en ;
    ak:description "Decision bias occurs when one group is unfairly advantaged over another due to decisions of the model. This might be caused by biases in the data and also amplified as a result of the model's training." ;
    ak:identifier "atlas-decision-bias" ;
    ak:name "Decision bias" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/decision-bias.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-decision-bias ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-1.1 .

risk:atlas-direct-instructions-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Direct instructions attack"@en ;
    ak:description "Prompts, questions, or requests designed to elicit undesirable responses from the application. This approach directly instructs the model to engage in the undesired behavior." ;
    ak:identifier "atlas-direct-instructions-attack" ;
    ak:name "Direct instructions attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/direct-instructions-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection ;
    skos:exactMatch nexus:atlas-direct-instructions-attack .

risk:atlas-encoded-interactions-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Encoded interactions attack"@en ;
    ak:description "Prompts that use specific encoding, styles, syntactical and typographical transformations like typographical errors or irregular spacing, or complex formatting to govern the interaction, rendering the model vulnerable." ;
    ak:identifier "atlas-encoded-interactions-attack" ;
    ak:name "Encoded interactions attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/encoded-interactions-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection ;
    skos:exactMatch nexus:atlas-encoded-interactions-attack .

risk:atlas-evasion-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Evasion attack"@en ;
    ak:description "Evasion attacks attempt to make a model output incorrect results by slightly perturbing the input data sent to the trained model." ;
    ak:identifier "atlas-evasion-attack" ;
    ak:name "Evasion attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/evasion-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-evasion-attack ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-2.2 .

risk:atlas-harmful-output a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Harmful output"@en ;
    ak:description "A model might generate language that leads to physical harm. The language might include overtly violent, covertly dangerous, or otherwise indirectly unsafe statements." ;
    ak:identifier "atlas-harmful-output" ;
    ak:name "Harmful output" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/harmful-output.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:exactMatch nexus:atlas-harmful-output ;
    skos:relatedMatch risk:mit-ai-risk-subdomain-1.2 .

risk:atlas-indirect-instructions-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Indirect instructions attack"@en ;
    ak:description "Prompts, questions, or requests designed to elicit undesirable responses from the application. Unlike direct instructions attacks, the model is instructed to use instructions that are embedded in external data like a website." ;
    ak:identifier "atlas-indirect-instructions-attack" ;
    ak:name "Indirect instructions attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/indirect-instructions-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection ;
    skos:exactMatch nexus:atlas-indirect-instructions-attack .

risk:atlas-social-hacking-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Social hacking attack"@en ;
    ak:description "Manipulative prompts that use social engineering techniques, such as role-playing or hypothetical scenarios, to persuade the model into generating harmful content." ;
    ak:identifier "atlas-social-hacking-attack" ;
    ak:name "Social hacking attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/social-hacking-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection ;
    skos:exactMatch nexus:atlas-social-hacking-attack .

risk:atlas-specialized-tokens-attack a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Specialized tokens attack"@en ;
    ak:description "Prompt attacks that include specialized tokens, often algorithmically designed, to target and exploit vulnerabilities in the model." ;
    ak:identifier "atlas-specialized-tokens-attack" ;
    ak:name "Specialized tokens attack" ;
    ak:source "https://www.ibm.com/docs/en/watsonx/saas?topic=SSYOK8/wsj/ai-risk-atlas/specialized-tokens-attack.html"^^xsd:anyURI ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:source <https://www.ibm.com/docs/en/watsonx/saas?topic=ai-risk-atlas> ;
    skos:broadMatch risk:atlas-prompt-injection ;
    skos:exactMatch nexus:atlas-specialized-tokens-attack .

risk:mit-ai-risk-subdomain-3.1 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "False or misleading information"@en ;
    ak:description "AI systems that inadvertently generate or spread incorrect or deceptive information, which can lead to inaccurate beliefs in users and undermine their autonomy. Humans that make decisions based on false beliefs can experience physical, emotional or material harms" ;
    ak:identifier "3.1" ;
    ak:name "False or misleading information" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-3.1 .

risk:mit-ai-risk-subdomain-4.1 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Disinformation, surveillance, and influence at scale"@en ;
    ak:description "Using AI systems to conduct large-scale disinformation campaigns, malicious surveillance, or targeted and sophisticated automated censorship and propaganda, with the aim to manipulate political processes, public opinion and behavior." ;
    ak:identifier "4.1" ;
    ak:name "Disinformation, surveillance, and influence at scale" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-4.1 .

risk:mit-ai-risk-subdomain-5.2 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Loss of human agency and autonomy"@en ;
    ak:description "Humans delegating key decisions to AI systems, or AI systems making decisions that diminish human control and autonomy, potentially leading to humans feeling disempowered, losing the ability to shape a fulfilling life trajectory or becoming cognitively enfeebled." ;
    ak:identifier "5.2" ;
    ak:name "Loss of human agency and autonomy" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-5.2 .

risk:mit-ai-risk-subdomain-6.6 a ak:Risk,
        owl:NamedIndividual ;
    rdfs:label "Environmental harm"@en ;
    ak:description "The development and operation of AI systems causing environmental harm, such as through energy consumption of data centers, or material and carbon footprints associated with AI hardware." ;
    ak:identifier "6.6" ;
    ak:name "Environmental harm" ;
    ak:source "https://airisk.mit.edu/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:mit-ai-risk-subdomain-6.6 .

ak:Generate a owl:Class ;
    rdfs:subClassOf ak:Process .

ak:RegulatoryContext a owl:Class ;
    rdfs:subClassOf ak:ApplicationContext .

ak:account_records a ak:Data .

ak:ai_subject a ak:Stakeholder ;
    ak:name "AI Subject" ;
    skos:closeMatch dpv:HumanSubject .

ak:answer a ak:Data .

ak:bank_support_assistant a ak:AISystem ;
    ak:hasContext ak:financial_services,
        ak:public_website ;
    ak:hasWorkflow ak:fraud_scoring_workflow,
        ak:question_answering_workflow ;
    ak:name "Bank AI Asisstant" .

ak:fraud_model a ak:StatisticalModel ;
    ak:name "Transaction fraud classifier" .

ak:fraud_score a ak:Data .

