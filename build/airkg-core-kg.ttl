    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0754_NIST2024 .

mitigation:A0755_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Harmful Bias and Homogenization"@en ;
    ak:description "Share transparency reports with internal and external stakeholders that detail steps taken to update the GAI system to enhance transparency and accountability" ;
    ak:identifier "A0755_NIST2024" ;
    ak:name "Human-AI Configuration; Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0755_NIST2024 .

mitigation:A0756_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity"@en ;
    ak:description "Track dataset modifications for provenance by monitoring data deletions, rectification requests, and other changes that may impact the verifiability of content origins." ;
    ak:identifier "A0756_NIST2024" ;
    ak:name "Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0756_NIST2024 .

mitigation:A0757_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Information Integrity"@en ;
    ak:description "Verify that AI Actors responsible for monitoring reported issues can effectively evaluate GAI system performance including the application of content provenance data tracking techniques, and promptly escalate issues for response." ;
    ak:identifier "A0757_NIST2024" ;
    ak:name "Human-AI Configuration; Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0757_NIST2024 .

mitigation:A0758_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Bias and Homogenization"@en ;
    ak:description "Conduct regular monitoring of GAI systems and publish reports detailing the performance, feedback received, and improvements made." ;
    ak:identifier "A0758_NIST2024" ;
    ak:name "Harmful Bias and Homogenization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0758_NIST2024 .

mitigation:A0759_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration; Dangerous, Violent, or Hateful Content"@en ;
    ak:description "Practice and follow incident response plans for addressing the generation of inappropriate or harmful content and adapt processes based on findings to prevent future occurrences. Conduct post-mortem analyses of incidents with relevant AI Actors, to understand the root causes and implement preventive measures." ;
    ak:identifier "A0759_NIST2024" ;
    ak:name "Human-AI Configuration; Dangerous, Violent, or Hateful Content" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0759_NIST2024 .

mitigation:A0760_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration"@en ;
    ak:description "Use visualizations or other methods to represent GAI model behavior to ease non-technical stakeholders understanding of GAI system functionality" ;
    ak:identifier "A0760_NIST2024" ;
    ak:name "Human-AI Configuration" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0760_NIST2024 .

mitigation:A0761_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Confabulation; Information Integrity"@en ;
    ak:description "Establish and maintain policies and procedures to record and track GAI system reported errors, near-misses, and negative impacts." ;
    ak:identifier "A0761_NIST2024" ;
    ak:name "Confabulation; Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0761_NIST2024 .

mitigation:A0762_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Security; Data Privacy"@en ;
    ak:description "Report GAI incidents in compliance with legal and regulatory requirements (e.g., HIPAA breach reporting, e.g., OCR (2023) or NHTSA (2022) autonomous vehicle crash reporting requirements." ;
    ak:identifier "A0762_NIST2024" ;
    ak:name "Information Security; Data Privacy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0762_NIST2024 .

mitigation:A0764_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Rigorous Risk Assessment Processes"@en ;
    ak:description "Develop rigorous risk assessment processes for models, which: 1) Attempt to encompass all plausible and consequential risks from AI systems, including low-probability risks of severe harm; 2) Are informed by factors including, but not limited to: Model evaluations and red teaming, evidence of previous models' impacts and capabilities, knowledge of the latest research and developments in the field, domain expertise both internally and externally, and the results of data input audits. Take into account the difficulty of producing reliable risk assessments, creating a culture that takes seriously the significant uncertainty underlying predictions of the risks associated with frontier models. Take into account the potential benefits of the model. Include learnings from information exchanges with industry, academia and government on the capabilities of comparable models" ;
    ak:identifier "A0764_UK_Government2023" ;
    ak:name "Rigorous Risk Assessment Processes" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0764_UK_Government2023 .

mitigation:A0765_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-Deployment Risk Assessments"@en ;
    ak:description "Devote resources to pre-development risk assessments, alongside prioritising pre- deployment risk assessments. Pre-development risk assessments are also important, because training a high-risk system can still lead to harm if the model is leaked, stolen, or otherwise unintentionally distributed." ;
    ak:identifier "A0765_UK_Government2023" ;
    ak:name "Pre-Deployment Risk Assessments" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0765_UK_Government2023 .

mitigation:A0766_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development and Post-Deployment Monitoring"@en ;
    ak:description "Monitor systems both during development and after deployment. New risk assessments could be carried out in cases of fine-tuning or other substantial changes that could increase the danger of a model, such as the model gaining access to tools or plugins. This could occur alongside attempts to detect unexpected developments and new information that might have changed the results of the existing risk assessment, and which could also trigger a new risk assessment." ;
    ak:identifier "A0766_UK_Government2023" ;
    ak:name "Development and Post-Deployment Monitoring" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0766_UK_Government2023 .

mitigation:A0767_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Thresholds for Specific Models"@en ;
    ak:description "Describe and continually refine risk assessment results for each model (“risk thresholds”) that would trigger particular risk-reducing actions, defining such results in terms of risk to all relevant stakeholders given currently existing mitigations. Given the high uncertainty around future model capabilities, risk thresholds may be refined periodically." ;
    ak:identifier "A0767_UK_Government2023" ;
    ak:name "Risk Thresholds for Specific Models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0767_UK_Government2023 .

mitigation:A0768_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Defining Risk Thresholds"@en ;
    ak:description "Define risk thresholds, based on the outcomes that would constitute a breach of the threshold and linked to dangerous capabilities that a given model or combination of models could exhibit. For example, a frontier AI organisation might identify the objective of avoiding deploying an AI system that significantly increases the risk of cyberattacks or fraud." ;
    ak:identifier "A0768_UK_Government2023" ;
    ak:name "Defining Risk Thresholds" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0768_UK_Government2023 .

mitigation:A0769_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Operationalizing Risk Thresholds"@en ;
    ak:description "Operationalise risk thresholds, including specific, testable observations, such that multiple observers with access to the same information would agree on whether a given threshold had been met. Specific observations would provide frontier AI organisations with opportunities to determine proactively how they would respond in difficult potential situations, and so respond immediately to such situations should they arise, as well as allowing for accountability and external verification. Given the nascent science of AI evaluation, however, it is unlikely to be possible to define a set of testable observations that detect all identified risks sufficiently reliably. Instead of relying solely on these predefined tests, risk assessments may take into account wider sources of evidence, such as concerning and unexpected observations that show up in exploratory analyses, expert forecasts, or risk related information from other frontier AI organisations. In particular, consideration may be given to any risks caused by the combination of a given model with other models or tools, whether developed by the same frontier AI organisation or otherwise." ;
    ak:identifier "A0769_UK_Government2023" ;
    ak:name "Operationalizing Risk Thresholds" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0769_UK_Government2023 .

mitigation:A0770_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Refinement of Risk Evaluation Frameworks"@en ;
    ak:description "Continue to refine and redefine risk evaluation frameworks for models as necessary, aiming to reduce the gap between the intended objectives of risk thresholds and their present operationalisations. Such gaps are expected to exist due to limitations in the science of evaluation and in the state of knowledge surrounding capabilities, so progress towards a robust framework will probably be iterative. Risk evaluation frameworks may use multiple methods, including probability estimations and qualitative assessments of current capabilities." ;
    ak:identifier "A0770_UK_Government2023" ;
    ak:name "Refinement of Risk Evaluation Frameworks" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0770_UK_Government2023 .

mitigation:A0771_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Mitigation of Overshooting Risk Thresholds"@en ;
    ak:description "Mitigate the risk of ‘overshooting’ risk thresholds. This may be achieved by setting deliberately conservative thresholds, including using intentionally lower buffer thresholds to trigger actions, such that the most concerning thresholds are difficult to overshoot without having already implemented mitigations at an earlier stage." ;
    ak:identifier "A0771_UK_Government2023" ;
    ak:name "Mitigation of Overshooting Risk Thresholds" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0771_UK_Government2023 .

mitigation:A0772_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Threshold Engagement with Relevant External Stakeholders"@en ;
    ak:description "Engage with relevant external stakeholders when developing risk thresholds. Risk thresholds often concern externalities frontier AI organisations place on society, including both the potentially significant benefits of AI advancement and negative effects that might disproportionately affect specific stakeholder groups. As such, their risk thresholds may be made public to allow for external scrutiny, with thresholds set in consultation with relevant external stakeholders including relevant government authorities." ;
    ak:identifier "A0772_UK_Government2023" ;
    ak:name "Risk Threshold Engagement with Relevant External Stakeholders" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0772_UK_Government2023 .

mitigation:A0773_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development Constrained by Risk Thresholds"@en ;
    ak:description "At each risk threshold, proactively commit to only proceed with certain development or deployment steps if specific mitigations are in place. Such mitigations could include many of the practices outlined in this document." ;
    ak:identifier "A0773_UK_Government2023" ;
    ak:name "Development Constrained by Risk Thresholds" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0773_UK_Government2023 .

mitigation:A0774_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reassessment of Residual Risk"@en ;
    ak:description "After putting in place mitigations, reassess any residual risk posed to determine whether additional mitigations are required. Due to the unpredictability of capabilities advancements and the limitations of model evaluation science, pre-agreed mitigations may prove insufficient to place a given model within a risk threshold. Risk acceptance criteria may be used, as is standard in many other contexts, and may provide an important tool for clarification. These criteria may evolve with time, and could be quantitative or qualitative. For example, risk may only be accepted if it has been reduced to a level ‘as low as reasonably practicable’." ;
    ak:identifier "A0774_UK_Government2023" ;
    ak:name "Reassessment of Residual Risk" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0774_UK_Government2023 .

mitigation:A0775_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Risk Threshold to Government Authorities"@en ;
    ak:description "Inform relevant government authorities when a risk threshold has been met, along with proposed mitigations. Inform governments again, in advance of deployment, when the mitigations and residual risk assessment have been carried out. Proactively engage other relevant actors in addition to governments as appropriate." ;
    ak:identifier "A0775_UK_Government2023" ;
    ak:name "Disclosure of Risk Threshold to Government Authorities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0775_UK_Government2023 .

mitigation:A0776_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adaptation of Mitigations to Development and Deployment Stages"@en ;
    ak:description "When planning required mitigations, consider the full range of development and deployment stages. In general, meeting a risk threshold could require mitigations at multiple such stages. Important stages may include the following: 1) Continued training of model; 2) Deployment of model in small-scale ways, e.g., internal use; 3) Deployment of model in large-scale ways e.g., public release via API ; 4) Extension of model through greater affordances, e.g., tool use or internet access; 5) Irreversible deployment e.g. open-sourcing of models" ;
    ak:identifier "A0776_UK_Government2023" ;
    ak:name "Adaptation of Mitigations to Development and Deployment Stages" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0776_UK_Government2023 .

mitigation:A0777_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adaptation of Mitigations for Unintended Model Use"@en ;
    ak:description "Adapt mitigations in recognition of risks from unintended model use or use in unexpected contexts, such as a model that is modified to remove safeguards after open- sourcing or a model that is combined with another model for unanticipated purposes. For example, at a given risk threshold, information security control mitigations might be put in place before even internal use of a model within a frontier AI organisation. In general, the use of caution may be helpful, given current limitations in information security controls and the prediction of models’ emergent abilities." ;
    ak:identifier "A0777_UK_Government2023" ;
    ak:name "Adaptation of Mitigations for Unintended Model Use" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0777_UK_Government2023 .

mitigation:A0778_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Recognition of Dangerous Model Possession"@en ;
    ak:description "Recognise that even the possession of some models may be dangerous, even if not deployed or not deployed widely, due to the risk of being unable to secure a model sufficiently to prevent, for instance, a bad actor obtaining the model weights. In contrast, other models may pose significant risk only if deployed in a large-scale or irreversible way." ;
    ak:identifier "A0778_UK_Government2023" ;
    ak:name "Recognition of Dangerous Model Possession" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0778_UK_Government2023 .

mitigation:A0779_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reversible and Small-Scale Deployment"@en ;
    ak:description "Deploy models in small-scale or reversible ways before deploying models in large-scale or irreversible ways. This makes it possible for frontier AI organisations to notice and mitigate harm before the harm becomes too large or unavoidable." ;
    ak:identifier "A0779_UK_Government2023" ;
    ak:name "Reversible and Small-Scale Deployment" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0779_UK_Government2023 .

mitigation:A0780_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pause of Training Runs"@en ;
    ak:description "Prepare to pause training runs or reduce access to deployed models, if risk thresholds are reached without the committed risk mitigations being in place. This may involve warning existing customers that access reductions are a possibility and creating contingency plans to minimise negative impacts on customer use." ;
    ak:identifier "A0780_UK_Government2023" ;
    ak:name "Pause of Training Runs" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0780_UK_Government2023 .

mitigation:A0781_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risks of Open-Source Models"@en ;
    ak:description "Acknowledge that some models may pose additional risks if made available “open-source”, even after mitigation attempts. This is because of the inability of recalling an open-sourced model and the potential ability of users to remove safeguards and introduce new (and potentially dangerous) capabilities. However, it is also important to bear in mind the significant benefits of “open-source” AI systems for researchers, including for advancing AI safety, which may in some cases outweigh these potential risks." ;
    ak:identifier "A0781_UK_Government2023" ;
    ak:name "Risks of Open-Source Models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0781_UK_Government2023 .

mitigation:A0782_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Assessment Disclosure to Third Parties"@en ;
    ak:description "Regularly update relevant stakeholders on risk assessment and mitigation measures: This will enable assessment of whether AI organisations have sufficient risk management processes in place, build up a picture of best practices, and make recommendations to address gaps. When sharing this information with external actors, consideration should be given to commercially sensitive information. Additional ad hoc updates could be provided in cases of major developments.Include information on evaluations, risk assessment and mitigation, and individuals involved. For example: 1) What types of tests and evaluations are being run on which types of models; 2) What other risk assessment methods are being used, which kinds of expertise are drawn on, and whether impacted stakeholders are being involved; 3) How risk mitigation measures are being monitored; 4) Which teams and individuals are involved at different stages of the risk management process (and how, if at all, third parties are involved); 5) Measures taken to address specific categories of risk, such as cybersecurity measures" ;
    ak:identifier "A0782_UK_Government2023" ;
    ak:name "Risk Assessment Disclosure to Third Parties" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0782_UK_Government2023 .

mitigation:A0783_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Robust and Meaningful Accountability Mechanisms"@en ;
    ak:description "Introduce robust and meaningful accountability mechanisms, especially in evaluating capabilities thresholds, with clear processes that ensure the correct mitigations or courses of action are followed if the thresholds are met. This may include board sign-off for the responsible capability scaling policy, and named individual accountability for key decisions." ;
    ak:identifier "A0783_UK_Government2023" ;
    ak:name "Robust and Meaningful Accountability Mechanisms" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0783_UK_Government2023 .

mitigation:A0784_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Effective Risk Governance"@en ;
    ak:description "Establish effective risk governance to ensure that risks are appropriately identified, assessed, and addressed, and their nature and scale transparently reported. Most importantly, provide internal checks and balances, which may include thoughtful separation of roles within risk management." ;
    ak:identifier "A0784_UK_Government2023" ;
    ak:name "Effective Risk Governance" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0784_UK_Government2023 .

mitigation:A0785_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Verification Mechanisms"@en ;
    ak:description "Include verification mechanisms, such that external actors can have increased confidence that responsible capability scaling policies are executed as intended." ;
    ak:identifier "A0785_UK_Government2023" ;
    ak:name "Verification Mechanisms" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0785_UK_Government2023 .

mitigation:A0786_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Evaluation of Dangerous Capabilities"@en ;
    ak:description "Evaluate models for potential dangerous capabilities (i.e. capabilities that could cause substantial harm either from intentional misuse or accident). These capabilities could include but are not limited to: 1) Offensive cyber capabilities (e.g. producing code to exploit software vulnerabilities); 2) Deception and manipulation (e.g. lying effectively or convincing people to take costly actions); 3) Capabilities that can assist users in developing, designing, acquiring, or using biological, chemical, or radiological weapons (e.g. helping users “troubleshoot” their efforts to produce biological weapons)" ;
    ak:identifier "A0786_UK_Government2023" ;
    ak:name "Model Evaluation of Dangerous Capabilities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0786_UK_Government2023 .

mitigation:A0787_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Evaluation of Controllability"@en ;
    ak:description "Evaluate models for controllability issues (i.e. propensities to apply their capabilities in ways that neither the models’ users nor the models’ developers want). This could include, for example, autonomous replication and adaptation (i.e. capabilities that could allow a model to copy and run itself on other computer systems)." ;
    ak:identifier "A0787_UK_Government2023" ;
    ak:name "Model Evaluation of Controllability" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0787_UK_Government2023 .

mitigation:A0788_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Evaluation of Societal Harm"@en ;
    ak:description "Evaluate models for societal harms. These could include, for example, bias and discrimination (e.g. the risk that they produce content that reinforces harmful stereotypes or their potential discriminatory influence if used to inform decisions), recognising that ‘bias’ can be difficult to define and can be subject to different interpretations in different contexts." ;
    ak:identifier "A0788_UK_Government2023" ;
    ak:name "Model Evaluation of Societal Harm" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0788_UK_Government2023 .

mitigation:A0789_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Evaluation of System Security"@en ;
    ak:description "Evaluate models for system security" ;
    ak:identifier "A0789_UK_Government2023" ;
    ak:name "Model Evaluation of System Security" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0789_UK_Government2023 .

mitigation:A0790_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Response Processes for Evaluation Results"@en ;
    ak:description "Ensure processes are in place to respond to evaluation results. Evaluations are a necessary input to a responsible capability scaling policy which, depending on the results of the evaluation, would probably require implementation of practices outlined in other sections of this document such as preventing model misuse, information sharing and other risk mitigation measures." ;
    ak:identifier "A0790_UK_Government2023" ;
    ak:name "Response Processes for Evaluation Results" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0790_UK_Government2023 .

mitigation:A0791_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluation of Predecessor Models"@en ;
    ak:description "Before a frontier model is trained, evaluate predecessor or analogous models to understand how relevant properties (e.g. dangerous capabilities) scale with the overall size of the model. These preliminary evaluations can inform risk assessments." ;
    ak:identifier "A0791_UK_Government2023" ;
    ak:name "Evaluation of Predecessor Models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0791_UK_Government2023 .

mitigation:A0792_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-training and Fine-tuning of Models"@en ;
    ak:description "During pre-training and fine-tuning, evaluate the model to detect signs of undesirable properties and identify inaccuracies in pretraining predictions. These evaluations could be undertaken at various pre-specified checkpoints, and could inform decisions about whether to pause or adjust the training process." ;
    ak:identifier "A0792_UK_Government2023" ;
    ak:mitigates risk:atlas-improper-retraining,
        risk:llm032025-supply-chain ;
    ak:name "Pre-training and Fine-tuning of Models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0792_UK_Government2023 .

mitigation:A0793_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-Deployment Evaluations"@en ;
    ak:description "After training, subject the model to extensive pre-deployment evaluations. These evaluations can inform decisions about whether and how to deploy the system, as well as allowing governments and potential users to make informed decisions about regulating or using the model. Their intensity will be proportional to the risk of the deployment, taking into account the model’s capabilities, novelty, expected domains of use, and number of individuals expected to be affected by it." ;
    ak:identifier "A0793_UK_Government2023" ;
    ak:mitigates risk:atlas-spreading-disinformation,
        risk:llm092025-misinformation ;
    ak:name "Pre-Deployment Evaluations" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0793_UK_Government2023 .

mitigation:A0794_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Post-Deployment Evaluations"@en ;
    ak:description "After deployment, conduct evaluations at regular intervals to identify new capabilities and associated risks, especially when notable developments (e.g. a major update to the model) suggest earlier evaluations have become obsolete. Post-deployment evaluations can inform decisions to update the system’s safeguards, increase security around the model, temporarily limit access, or roll back deployment." ;
    ak:identifier "A0794_UK_Government2023" ;
    ak:name "Post-Deployment Evaluations" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0794_UK_Government2023 .

mitigation:A0795_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Context-Specific Model Evaluations"@en ;
    ak:description "Require organisations who deploy their models to conduct context-specific model evaluations. This requires that the information and data required to successfully conduct such assessments is provided to deployers." ;
    ak:identifier "A0795_UK_Government2023" ;
    ak:name "Context-Specific Model Evaluations" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0795_UK_Government2023 .

mitigation:A0796_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent Evaluation with Subject Matter Expertise"@en ;
    ak:description "Ensure that evaluators are independent and have sufficient AI and subject matter expertise across a wide range of relevant subjects and backgrounds. External evaluators’ relationships with frontier AI organisations could be structured to minimise conflicts of interest and encourage independence of judgement as far as practically possible. As well as expertise in AI, there are many other areas of subject matter expertise that will be needed to evaluate an AI system’s features. For instance, experts on topics as wide as fairness, psychological harm, and catastrophic risk will be needed." ;
    ak:identifier "A0796_UK_Government2023" ;
    ak:name "Independent Evaluation with Subject Matter Expertise" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0796_UK_Government2023 .

mitigation:A0797_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Appropriate Safeguards Against External Evaluations"@en ;
    ak:description "Ensure that there are appropriate safeguards against external evaluations leading to unintended widespread distribution of models. Allowing external evaluators to download models onto their own hardware increases the chance of the models being stolen or leaked. Therefore, unless adequate security against widespread model distribution can be assured, external evaluators could only be allowed to access models through interfaces that prevent exfiltration (such as current API access methods). It may be appropriate to limit evaluators’ access to information that could indirectly facilitate widespread model distribution in other ways, such as requiring in-depth KYC checks or watermarking copies of the model." ;
    ak:identifier "A0797_UK_Government2023" ;
    ak:name "Appropriate Safeguards Against External Evaluations" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0797_UK_Government2023 .

mitigation:A0798_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sufficient Time for External Evaluators"@en ;
    ak:description "Give external evaluators sufficient time. As expected risks from models increase or models get more complex to evaluate, the time afforded for evaluation may need to increase as well." ;
    ak:identifier "A0798_UK_Government2023" ;
    ak:name "Sufficient Time for External Evaluators" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0798_UK_Government2023 .

mitigation:A0799_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-tuning by External Evaluators"@en ;
    ak:description "Give external evaluators the ability to securely “fine-tune” the AI systems being tested. Evaluators cannot fully assess risks associated with widespread model distribution if they cannot fine-tune the model. This may involve providing external evaluators with access to capable infrastructure to enable fine-tuning." ;
    ak:identifier "A0799_UK_Government2023" ;
    ak:name "Fine-tuning by External Evaluators" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0799_UK_Government2023 .

mitigation:A0800_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Evaluation of Model without Safety Regulations"@en ;
    ak:description "Give external evaluators access to versions of the model that lack safety mitigations. Where possible, sharing these versions of a model gives evaluators insight into the risks that might be created if users find ways to circumvent safeguards (i.e. “jailbreak” the model). If the model is open-sourced, leaked, or stolen, users may also simply be able to remove or bypass the safety mitigations." ;
    ak:identifier "A0800_UK_Government2023" ;
    ak:name "External Evaluation of Model without Safety Regulations" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0800_UK_Government2023 .

mitigation:A0801_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Evaluation of Model Families"@en ;
    ak:description "Give external evaluators access to model families and internal metrics. Frontier AI organisations often develop “model families” where multiple models differ along only one or two dimensions – such as parameters, data, or training compute. Evaluating such a model family would enable scaling analysis to better forecast future performance, capabilities and risks." ;
    ak:identifier "A0801_UK_Government2023" ;
    ak:name "External Evaluation of Model Families" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0801_UK_Government2023 .

mitigation:A0802_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Evaluation of Deployed System Components"@en ;
    ak:description "Give external evaluators the ability to study all of the components of deployed systems, where possible. Deployed AI systems typically combine a core model with smaller models and other software components, including moderation filters, user interfaces to incentivise particular user behaviour, and plug-ins for extension capabilities like web browsing or code execution. For example, a red team cannot find all the flaws in the defences of a system if they aren’t able to test all of its different components. It is important to consider the need to balance external evaluators’ ability to access all components of the system against the need to protect information that would allow bypassing model defences." ;
    ak:identifier "A0802_UK_Government2023" ;
    ak:name "External Evaluation of Deployed System Components" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0802_UK_Government2023 .

mitigation:A0803_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Discretionary Evaluator Disclosure"@en ;
    ak:description "Allow evaluators to share and discuss the results of their evaluations, with potential restrictions where necessary e.g. not sharing proprietary information, information whose spread could lead to substantial harm or information that would have an adverse effect on competition in the market. Sharing the results of evaluations can allow governments, regulators, users, and other frontier AI organisations to make informed decisions." ;
    ak:identifier "A0803_UK_Government2023" ;
    ak:name "Discretionary Evaluator Disclosure" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0803_UK_Government2023 .

mitigation:A0804_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development and testing of Model Evaluation Methods"@en ;
    ak:description "Support the development and testing of model evaluation methods. For many relevant properties of models, there do not yet exist accepted evaluation methods. It also remains unclear how reliable or predictive current evaluation methods are. This could involve frontier AI organisations developing model evaluation methods themselves or facilitating the efforts of others, such as by providing access to capable infrastructure for evaluation." ;
    ak:identifier "A0804_UK_Government2023" ;
    ak:name "Development and testing of Model Evaluation Methods" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0804_UK_Government2023 .

mitigation:A0805_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Model Evaluation Research and Development"@en ;
    ak:description "Share the products of their model evaluation research and development, except when sharing the results might be harmful. In some cases, findings (e.g. about how to elicit dangerous capabilities) could be harmful if spread. When the expected harm is sufficiently small, the AI research community, other frontier AI organisations, and relevant government bodies could benefit from being informed of their work." ;
    ak:identifier "A0805_UK_Government2023" ;
    ak:name "Disclosure of Model Evaluation Research and Development" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0805_UK_Government2023 .

mitigation:A0806_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Risk Assessment Processes"@en ;
    ak:description "Share details of risk assessment processes and risk mitigation measures with relevant government authorities and other AI companies, as set out in Responsible Capability Scaling." ;
    ak:identifier "A0806_UK_Government2023" ;
    ak:name "Disclosure of Risk Assessment Processes" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0806_UK_Government2023 .

mitigation:A0807_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Information about Internal Governance Processes"@en ;
    ak:description "Share information about how internal governance processes are set up with relevant government authorities. This will ensure that risks are appropriately identified, communicated and mitigated, and allow government and other external actors to identify gaps that might lead to risks being overlooked. This information could be updated regularly (e.g. every 12 months). This information could also be made public, provided sensitive details are removed." ;
    ak:identifier "A0807_UK_Government2023" ;
    ak:name "Disclosure of Information about Internal Governance Processes" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0807_UK_Government2023 .

mitigation:A0808_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reporting Security Details to Government Authorities"@en ;
    ak:description "Report any details of security or safety incidents or near-misses to relevant government authorities. This includes any compromise to the security of the organisation or its systems, or any incident where an AI system – deployed or not – causes substantial harm or is close to doing so. This will enable government authorities to build a clear picture of when safety and security incidents occur and make it easier to anticipate and mitigate future risks. Incident reports could include a description of the incident, the location, start and end date, details of any parties affected and harms occurred, any specific models involved, any relevant parties responsible for managing and responding to the incident, as well as ways in which the incident could have been avoided. It is important that incidents indicative of more severe risks are reported as soon as possible after they occur. High-level details of safety and security incidents - with sensitive information removed - could also be made public, such as have been shared in the AI incident database." ;
    ak:identifier "A0808_UK_Government2023" ;
    ak:name "Reporting Security Details to Government Authorities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0808_UK_Government2023 .

mitigation:A0809_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-training Disclosure of High-Level Model Details to Government Authorities"@en ;
    ak:description "Before training, share high-level model details with the relevant government authorities and justify why the training run does not impose unacceptable risk. This includes: 1) A high-level description of the model (including high-level information on intended use cases, intended users, training data, and model architecture); 2) Compute details (including the maximum the organisation plans to use, as well as information about its location and who provides it); 3) Description of the data that will be used to train the model; 4) Evidence from scaling small models that the full training run does not pose unacceptably high risks; 5) Descriptions of specific internal and external risk assessments and mitigation efforts,3 and an overall safety assessment justifying why and how the training run is sufficiently low-risk to execute; 6) Description of which, if any, domain experts and impacted stakeholders have been involved in the project’s design, as well as risk and impact assessment; 7) Plans for model evaluations during and after training, as well as predicted dangerous capabilities" ;
    ak:identifier "A0809_UK_Government2023" ;
    ak:name "Pre-training Disclosure of High-Level Model Details to Government Authorities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0809_UK_Government2023 .

mitigation:A0810_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Updates to Government Authorities During Training"@en ;
    ak:description "During training, update information provided to relevant government authorities with any significant changes to the model itself or its risk profile. This could include: 1) Updates on model development at each evaluation checkpoint as well as any significant updates to the development plan; 2) Results from model evaluations, including details of emergent dangerous capabilities and whether these were expected; 3) Whether and how the risk context has changed (e.g. if other AI tools have been published that the model could interact with)" ;
    ak:identifier "A0810_UK_Government2023" ;
    ak:name "Updates to Government Authorities During Training" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0810_UK_Government2023 .

mitigation:A0811_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Risk Context to Government Authorities at Deployment"@en ;
    ak:description "At the point of deployment, share details of the model, any risks the model might pose and what steps have been taken to mitigate those risks with relevant government authorities and the wider public. Information can be provided in full to the relevant government authority, ensuring that robust security measures are in place to protect sensitive information. Some of this information can be made available to the public by publishing a transparency report (e.g. a model card) and providing general overviews of model purpose and risk assessment evaluation results. Information that exposes model vulnerabilities or facilitates the spread of dangerous capabilities should be redacted from the transparency report, unless sharing this information publicly would be sufficiently helpful for mitigating the risks the model poses. Information that is commercially sensitive (e.g. detailed information on training data) or exposes the capabilities or vulnerabilities of the model should be redacted. Commercially sensitive information could be shared with government or regulators, who could share this information with industry in an aggregated or anonymised form. Information shared at deployment could include: 1) A description of the model; 2) Information about safe practices for model usage (including domains of inappropriate and appropriate use, or guidelines on determining whether a use is appropriate); 3) Training details, including a detailed description of the training data and any biases they may encode; 4) The model’s biases, risks and limitations; 5) Pre-development and pre-deployment risk and impact assessment procedures; 6) Details of the evaluation process the frontier AI organisation conducted, including time and resources spent, information about the expertise and independence of people conducting the evaluations, the level of access given to evaluators, and anticipated limitations of the evaluations used; 7) Details about which, if any, domain experts and impacted stakeholders have been involved in the project’s design and risk and impact assessment; 8) The results of any internal or external evaluations that were conducted; 9) Holistic assessments of the models’ robustness, interpretability, and controllability, drawing on more specific evaluation results; 9) Significant measures taken to mitigate potential harmful consequences of deployment, including accountability and verification mechanisms put in place, and internal governance processes carried out; 10) Capabilities and risks of the final, public-release model before and after safety mitigations, including a description of the mitigations to prevent accidents and misuse (e.g. available tools and their expected effectiveness); 11) Plans for ongoing, post-deployment monitoring of risks and capabilities and how the organisation will respond to future incidents (unless releasing this information would allow bad actors to circumvent post-deployment safety measures); 12) Descriptions of post-deployment access controls; 13) Expected compute requirements for running the model during deployment" ;
    ak:identifier "A0811_UK_Government2023" ;
    ak:name "Disclosure of Risk Context to Government Authorities at Deployment" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0811_UK_Government2023 .

mitigation:A0812_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adjucation around Publicly Sharing Risks"@en ;
    ak:description "Before sharing information, consider the risks of sharing this information and judge whether it is inappropriate to share certain pieces of information. In particular, it is important to consider potential harms from publicly sharing information about dangerous capabilities and methods for eliciting them, as this information could motivate or help other actors to acquire these capabilities. It is also important to consider potential harms from publicly sharing detailed information about how models were produced, as this may lower barriers to producing similar models. If the models have or could be modified to possess dangerous capabilities (e.g. biological capabilities or surveillance capabilities), then facilitating widespread distribution of the model in this way may be harmful. The National Protective Security Authority (NPSA) guidance on a security-minded approach to information management may prove helpful for sharing information appropriately." ;
    ak:identifier "A0812_UK_Government2023" ;
    ak:name "Adjucation around Publicly Sharing Risks" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0812_UK_Government2023 .

mitigation:A0813_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Principled Policies for Disclosure"@en ;
    ak:description "Develop principled policies about what information to share publicly, with governments, or not at all. These policies could specify situations under which sharing some piece of information is subject to a risk assessment, along with guidelines for conducting the risk assessment and responding to it. It is important, however, to avoid creating risk assessment criteria and procedures that are overly strict and intensive to prevent excessive opacity. These policies could be guided and overseen by an independent review panel of multidisciplinary experts to ensure decisions made about or against information sharing are justifiable and oriented to optimal transparency." ;
    ak:identifier "A0813_UK_Government2023" ;
    ak:name "Principled Policies for Disclosure" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0813_UK_Government2023 .

mitigation:A0814_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Information with AI-focused Government Authorities"@en ;
    ak:description "Share complete forms of this information with central AI-focused government authorities (including central government bodies, security agencies, and regulators) to enable robust government oversight of potentially high-risk areas of AI development and the processes in place to identify and manage those risks. These authorities could then further share information selectively with additional government bodies where relevant. Some particularly security-relevant pieces of information may need to be shared directly with security agencies, such as the cybersecurity measures being used in model development (which would make it easier for those agencies to identify potential security risks), or specific physical or cybersecurity threat incidents. Robust security measures are in place when sharing more sensitive information." ;
    ak:identifier "A0814_UK_Government2023" ;
    ak:name "Disclosure of Information with AI-focused Government Authorities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0814_UK_Government2023 .

mitigation:A0815_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sharing of Limited Information"@en ;
    ak:description "Share more limited information with other AI organisations in order to facilitate learning and the development of best practices. This could include best practices and lessons learned in the development of risk assessment and mitigation measures and risk governance processes, some details about safety and security incidents (to enable increased awareness while protecting intellectual property), and highlights and lessons learned from risk assessments and capability evaluation. In general, it will be easier for organisations to share model-agnostic information with one another than model-specific information, which may be more commercially sensitive. It will also be important to consider that there is no privileged access to information that may give a competitive advantage to some firms." ;
    ak:identifier "A0815_UK_Government2023" ;
    ak:name "Sharing of Limited Information" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0815_UK_Government2023 .

mitigation:A0816_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sharing with Independent Third-Parties"@en ;
    ak:description "Share specific information with independent third-parties where this aids evaluation and technical audit (see Model Evaluations and Red Teaming). This may require sharing much of the same information that is shared with governments in full but may be shared on a case-by- case basis." ;
    ak:identifier "A0816_UK_Government2023" ;
    ak:name "Sharing with Independent Third-Parties" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0816_UK_Government2023 .

mitigation:A0817_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Sharing with Downstream Users"@en ;
    ak:description "Share specific information with downstream users of the model to enable more effective risk mitigation across the AI supply chain and build consumer confidence. This could include uses of the model that are against their terms of service, and could be provided to users through user terms or published information about the model." ;
    ak:identifier "A0817_UK_Government2023" ;
    ak:name "Information Sharing with Downstream Users" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0817_UK_Government2023 .

mitigation:A0818_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sharing General Information with the Public"@en ;
    ak:description "Share more general versions of the information outlined with the public to enable public scrutiny and build public confidence in the safety and reliability of AI systems. This could include high-level summaries of risk assessment and mitigation processes, high-level details of safety and security incidents, summaries of risk governance processes, and general overviews of model purpose, use cases, and the results of risk assessments and capability evaluations." ;
    ak:identifier "A0818_UK_Government2023" ;
    ak:name "Sharing General Information with the Public" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0818_UK_Government2023 .

mitigation:A0819_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Application of Infrastructure Principles"@en ;
    ak:description "Apply good infrastructure principles to every part of this process from design to decommissioning. This is important as threats can occur at different stages of an AI project’s life cycle." ;
    ak:identifier "A0819_UK_Government2023" ;
    ak:name "Application of Infrastructure Principles" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0819_UK_Government2023 .

mitigation:A0820_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Regular Assessment of Supply Chain Security"@en ;
    ak:description "Regularly assess the security of their supply chains and ensure suppliers adhere to the same standards their own organisation applies. Ensuring data, software components and hardware are obtained from trusted sources will help mitigate supply chain risk." ;
    ak:identifier "A0820_UK_Government2023" ;
    ak:name "Regular Assessment of Supply Chain Security" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0820_UK_Government2023 .

mitigation:A0821_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Robustness to Adversarial Attacks"@en ;
    ak:description "Evaluate the robustness of models to different classes of adversarial attack (such as poisoning, model inversion and model stealing), based on priorities derived from threat modelling. This could involve a combination of benchmarking and red teaming." ;
    ak:identifier "A0821_UK_Government2023" ;
    ak:name "Model Robustness to Adversarial Attacks" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0821_UK_Government2023 .

mitigation:A0822_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation of the Cyber security threats"@en ;
    ak:description "Assess and document the cyber security threats against the AI system overall and mitigate the impact of vulnerabilities. Good documentation and monitoring will inform your overall risk posture and help you respond in the event of a security incident." ;
    ak:identifier "A0822_UK_Government2023" ;
    ak:name "Documentation of the Cyber security threats" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0822_UK_Government2023 .

mitigation:A0823_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Value of AI-related Assets"@en ;
    ak:description "Understand the value of AI-related assets such as models, data (including user feedback), prompts, software, documentation, and assessments (including information about potentially unsafe capabilities and failure modes) to their organisation. Protect these different categories of information as appropriate." ;
    ak:identifier "A0823_UK_Government2023" ;
    ak:name "Value of AI-related Assets" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0823_UK_Government2023 .

mitigation:A0824_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Integration into Business Decisions"@en ;
    ak:description "Ensure security is factored into all business decisions and AI-related assets are identified and protected with proportionate cyber, physical and personnel security measures. Secure Innovation guidance from NCSC and NPSA is available to help companies and investors to protect their technology ." ;
    ak:identifier "A0824_UK_Government2023" ;
    ak:name "Security Integration into Business Decisions" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0824_UK_Government2023 .

mitigation:A0825_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Tracking Tools for Security and Version Control Assets"@en ;
    ak:description "Have processes and tools to track, authenticate, secure and version control assets and be able to roll back to a known safe state in the event of a compromise. This is important as data and models do not remain static during the whole lifespan of an AI project." ;
    ak:identifier "A0825_UK_Government2023" ;
    ak:name "Tracking Tools for Security and Version Control Assets" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0825_UK_Government2023 .

mitigation:A0826_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Documentation"@en ;
    ak:description "Document data, models, prompts, evaluation materials and other assets, using commonly used structures such as data cards, model cards and software bills of materials (SBOMs). This will allow you to identify and share key information, including particular security concerns, quickly and easily." ;
    ak:identifier "A0826_UK_Government2023" ;
    ak:name "Data Documentation" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0826_UK_Government2023 .

mitigation:A0827_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Training Relevant Actors in AI Security"@en ;
    ak:description "Train developers, system owners and senior leaders in secure AI practices. It is crucial to establish a positive security culture where leaders demonstrate good security practice and staff from across a project understand enough about AI security to understand the potential consequences of decisions they take." ;
    ak:identifier "A0827_UK_Government2023" ;
    ak:name "Training Relevant Actors in AI Security" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0827_UK_Government2023 .

mitigation:A0828_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Awareness of Security Threats"@en ;
    ak:description "Maintain an awareness of security threats and failure modes, in particular data scientists and developers. AI development and cyber security are two different skill sets and building a team at the intersection of the two will require effort and time." ;
    ak:identifier "A0828_UK_Government2023" ;
    ak:name "Awareness of Security Threats" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0828_UK_Government2023 .

mitigation:A0829_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model of System Threats in Misuse Scenarios"@en ;
    ak:description "Model the threats to your system to understand the impacts to the system, users, organisation and wider society if the model is misused or behaves unexpectedly. This can help build systems where unanticipated model outputs are handled safely by other parts of a data pipeline." ;
    ak:identifier "A0829_UK_Government2023" ;
    ak:name "Model of System Threats in Misuse Scenarios" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0829_UK_Government2023 .

mitigation:A0830_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incident Response, Escalation, and Remeditation Plans"@en ;
    ak:description "Develop an organisational incident response plan. The inevitability of security incidents affecting systems is reflected in organisational incident response planning. A well-planned response will help minimise the damage caused by an attack and support recovery." ;
    ak:identifier "A0830_UK_Government2023" ;
    ak:name "Incident Response, Escalation, and Remeditation Plans" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0830_UK_Government2023 .

mitigation:A0831_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Recurrent Performance analysis of AI models"@en ;
    ak:description "Measure the performance of AI models and systems on an ongoing basis. A decline in model performance could be an indication of an attack or could indicate that a model is encountering data that is different from that which it was trained on. Either way, further investigation may be required." ;
    ak:identifier "A0831_UK_Government2023" ;
    ak:name "Recurrent Performance analysis of AI models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0831_UK_Government2023 .

mitigation:A0832_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitoring Inputs to AI Systems for Audit Development"@en ;
    ak:description "Monitor and log inputs to AI systems to enable audit, investigation and remediation in the case of compromise. Some attacks against AI systems rely on repeated querying. Proper logging will help you audit your system and identify any anomalous inputs." ;
    ak:identifier "A0832_UK_Government2023" ;
    ak:name "Monitoring Inputs to AI Systems for Audit Development" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0832_UK_Government2023 .

mitigation:A0833_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Mitigation Actions for AI-related security incidents"@en ;
    ak:description "Take action to mitigate and remediate issues and document any AI-related security incidents and vulnerabilities." ;
    ak:identifier "A0833_UK_Government2023" ;
    ak:name "Mitigation Actions for AI-related security incidents" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0833_UK_Government2023 .

mitigation:A0834_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security Responsible User Communication"@en ;
    ak:description "Communicate clearly to users which elements of security they are responsible for and where and how their data may be used or accessed." ;
    ak:identifier "A0834_UK_Government2023" ;
    ak:name "Security Responsible User Communication" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0834_UK_Government2023 .

mitigation:A0835_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Default Integration of Secure Settings"@en ;
    ak:description "Integrate the most secure settings within your products by default. Where configuration is necessary, default options should be broadly secure against common threats." ;
    ak:identifier "A0835_UK_Government2023" ;
    ak:name "Default Integration of Secure Settings" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0835_UK_Government2023 .

mitigation:A0836_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Default Necessary Security Updates"@en ;
    ak:description "Ensure necessary security updates are a default part of every product and use secure, modular update procedures to distribute them. This will help your products remain secure in the face of new and developing threats." ;
    ak:identifier "A0836_UK_Government2023" ;
    ak:name "Default Necessary Security Updates" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0836_UK_Government2023 .

mitigation:A0837_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Release After Security Evaluations"@en ;
    ak:description "Only release models after they have been through security evaluations, including benchmarking and red teaming." ;
    ak:identifier "A0837_UK_Government2023" ;
    ak:name "Release After Security Evaluations" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0837_UK_Government2023 .

mitigation:A0838_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Open Lines of Communication for Product Security Feedback"@en ;
    ak:description "Maintain open lines of communication for feedback regarding product security, both internally and externally to your organisation, including mechanisms for security researchers to report vulnerabilities and receive legal safe harbour for doing so, and for escalating issues to the wider community. Helping to share knowledge and threat information will strengthen the overall community’s ability to respond to AI security threats." ;
    ak:identifier "A0838_UK_Government2023" ;
    ak:name "Open Lines of Communication for Product Security Feedback" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0838_UK_Government2023 .

mitigation:A0839_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Identification of Assets of Organizational Value"@en ;
    ak:description "Identify assets & systems that are important for the delivery of effective operations, or are of specific organisational value (e.g. commercially sensitive information)" ;
    ak:identifier "A0839_UK_Government2023" ;
    ak:name "Identification of Assets of Organizational Value" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0839_UK_Government2023 .

mitigation:A0840_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Categorization of Assets"@en ;
    ak:description "Categorise and classify assets in order to ensure that the correct level of resource is used in implementing risk mitigations. - risk management" ;
    ak:identifier "A0840_UK_Government2023" ;
    ak:name "Categorization of Assets" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0840_UK_Government2023 .

mitigation:A0841_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Threat Identification"@en ;
    ak:description "Identify threats. These may include terrorism or hostile state threats and/or more local and specific threats, and use a range of internal and external resources." ;
    ak:identifier "A0841_UK_Government2023" ;
    ak:name "Threat Identification" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0841_UK_Government2023 .

mitigation:A0842_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Assessment via Recognized Processes"@en ;
    ak:description "Assess risk using recognised processes." ;
    ak:identifier "A0842_UK_Government2023" ;
    ak:name "Risk Assessment via Recognized Processes" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0842_UK_Government2023 .

mitigation:A0843_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Protective Security Risk Register"@en ;
    ak:description "Build a protective security risk register to record, in sufficient detail, all the data gathered during this risk management process, ensuring compatibility with existing organisational risk management registers and processes." ;
    ak:identifier "A0843_UK_Government2023" ;
    ak:name "Protective Security Risk Register" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0843_UK_Government2023 .

mitigation:A0844_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development of Protective Security Strategy"@en ;
    ak:description "Develop a protective security strategy for mitigating the risks identified, which reviews protective security measures in relation to a prioritised list of risks. Where mitigations are assessed as inadequate, additional measures could be proposed for approval by the decision maker(s)." ;
    ak:identifier "A0844_UK_Government2023" ;
    ak:name "Development of Protective Security Strategy" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0844_UK_Government2023 .

mitigation:A0845_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development and Implementation Plans"@en ;
    ak:description "Produce development & implementation plans. Aim to arrive at a clear, prioritised list of protective security mitigations, which span physical, personnel and cyber security disciplines, and are linked to the technical guidance needed to implement them." ;
    ak:identifier "A0845_UK_Government2023" ;
    ak:name "Development and Implementation Plans" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0845_UK_Government2023 .

mitigation:A0846_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Regular Risk Management Review"@en ;
    ak:description "Review risk management measures regularly and when required e.g. on a change in threat or change to operational environment, or to assess the suitability of new measures implemented. More detailed description of protective security risk management is provided on the NPSA website." ;
    ak:identifier "A0846_UK_Government2023" ;
    ak:name "Regular Risk Management Review" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0846_UK_Government2023 .

mitigation:A0847_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Board-level Responsibility for Protective Security"@en ;
    ak:description "Ensure board-level responsibility for protective security with regular engagement with key stakeholders from across the business and a firm understanding of the risks the organisation faces. Ensure stakeholder engagement throughout the business for specialist insight and development and implementation of an insider risk mitigation programme." ;
    ak:identifier "A0847_UK_Government2023" ;
    ak:name "Board-level Responsibility for Protective Security" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0847_UK_Government2023 .

mitigation:A0848_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Suitable Level of Screening"@en ;
    ak:description "Apply a suitable level of screening, informed by a role-based risk assessment, to all individuals who are provided access to organisational assets including permanent, temporary and contract workers." ;
    ak:identifier "A0848_UK_Government2023" ;
    ak:name "Suitable Level of Screening" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0848_UK_Government2023 .

mitigation:A0849_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Role-Based Security Risk Assessment"@en ;
    ak:description "Use Role-Based Security Risk Assessment to identify physical, personnel or cyber security measures that need to be applied in order to mitigate insider risk" ;
    ak:identifier "A0849_UK_Government2023" ;
    ak:name "Role-Based Security Risk Assessment" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0849_UK_Government2023 .

mitigation:A0850_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Proportionate Policies"@en ;
    ak:description "Put in place proportionate policies, clear reporting procedures and escalation guidelines that are accessible, understood and consistently enforced." ;
    ak:identifier "A0850_UK_Government2023" ;
    ak:name "Proportionate Policies" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0850_UK_Government2023 .

mitigation:A0851_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Appropriate Security Training"@en ;
    ak:description "Provide appropriate security education and training for all workers. Without effective education and training individuals cannot be expected to know what procedures are in place to maintain security." ;
    ak:identifier "A0851_UK_Government2023" ;
    ak:name "Appropriate Security Training" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0851_UK_Government2023 .

mitigation:A0852_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Program of Monitoring for Security Issues"@en ;
    ak:description "Ensure that a programme of monitoring and review is in place to enable potential security issues, or personal issues that may impact on an employee's work, to be recognised and dealt with effectively throughout their career" ;
    ak:identifier "A0852_UK_Government2023" ;
    ak:name "Program of Monitoring for Security Issues" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0852_UK_Government2023 .

mitigation:A0853_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Use of Established Security Guidance"@en ;
    ak:description "Use established, evidence based guidance to fully address personnel security risks e.g. NPSA guidance on Personnel Security" ;
    ak:identifier "A0853_UK_Government2023" ;
    ak:name "Use of Established Security Guidance" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0853_UK_Government2023 .

mitigation:A0854_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Jailbreaking Method Vulnerability Reports"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: Reports for inducing models to bypass moderation features, which the frontier AI organisation has attempted to prevent through the use of filters or fine-tuning" ;
    ak:identifier "A0854_UK_Government2023" ;
    ak:mitigates risk:atlas-jailbreaking,
        risk:llm01-prompt-injection ;
    ak:name "Jailbreaking Method Vulnerability Reports" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0854_UK_Government2023 .

mitigation:A0855_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Prompt Injection Vulnerability Reports"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including:Reports used by malicious actors to induce models to exhibit behaviours they want by presenting models with prompts that contain instructions to perform these behaviours" ;
    ak:identifier "A0855_UK_Government2023" ;
    ak:mitigates risk:atlas-prompt-injection,
        risk:llm01-prompt-injection ;
    ak:name "Prompt Injection Vulnerability Reports" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0855_UK_Government2023 .

mitigation:A0856_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Privacy Attacks Vulnerability Reports"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: methods for extracting information that should be private from models (e.g. sensitive information from training data or users’ private conversations with models)" ;
    ak:identifier "A0856_UK_Government2023" ;
    ak:name "Privacy Attacks Vulnerability Reports" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0856_UK_Government2023 .

mitigation:A0857_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vulnerability Reports for Unaddressed Misuse Opportunities"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: methods for using the capabilities of models to cause harm, which have not already been addressed" ;
    ak:identifier "A0857_UK_Government2023" ;
    ak:name "Vulnerability Reports for Unaddressed Misuse Opportunities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0857_UK_Government2023 .

mitigation:A0858_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vulnerability Reports for Poisoning Attacks"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: Reports for when an adversary has manipulated training data in order to degrade model performance" ;
    ak:identifier "A0858_UK_Government2023" ;
    ak:name "Vulnerability Reports for Poisoning Attacks" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0858_UK_Government2023 .

mitigation:A0859_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vulnerability Reports for Bias and Discrimination"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including:Reports for when a model is exhibiting behaviours that reveal specific biases or discrimination regarding known protected characteristics" ;
    ak:identifier "A0859_UK_Government2023" ;
    ak:name "Vulnerability Reports for Bias and Discrimination" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0859_UK_Government2023 .

mitigation:A0860_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vulnerability Reports for Performance Issues"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: when a model performs inadequately for a situation it is being deployed in e.g. a healthcare chatbot AI that provides incorrect information and causes harm to patients" ;
    ak:identifier "A0860_UK_Government2023" ;
    ak:name "Vulnerability Reports for Performance Issues" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0860_UK_Government2023 .

mitigation:A0861_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vulnerability Reports for Controllability Issues (i.e., 'Misalignment')"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: when models apply their capabilities in ways that substantially diverge from what users intend or desire" ;
    ak:identifier "A0861_UK_Government2023" ;
    ak:name "Vulnerability Reports for Controllability Issues (i.e., 'Misalignment')" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0861_UK_Government2023 .

mitigation:A0862_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Vulnerability Reports"@en ;
    ak:description "This process could have as wide a scope as is necessary and ensure that frontier AI organisations have the ability to respond appropriately to reports of vulnerabilities. The process could accept reports on any class of model vulnerabilities and methods for exploiting them, including: Establish clear, user-friendly, and publicly described processes for receiving model vulnerability reports drawing on established software vulnerability reporting processes. These processes can be built into – or take inspiration from – processes that organisations have built to receive reports of traditional software vulnerabilities. It is crucial that these policies are made publicly accessible and function effectively." ;
    ak:identifier "A0862_UK_Government2023" ;
    ak:name "Model Vulnerability Reports" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0862_UK_Government2023 .

mitigation:A0863_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Cost-Benefit Analysis of Sharing Vulnerability Reports"@en ;
    ak:description "Consider the ways in which sharing information about vulnerabilities can both exacerbate and mitigate risks. Sharing can alert would-be attackers, but also alert would-be victims and actors with the power to create defences. One particularly important factor is how easily fixable the model vulnerability is. If a vulnerability will take a very long time to fix, or cannot be fixed, then public reporting may not be justified." ;
    ak:identifier "A0863_UK_Government2023" ;
    ak:name "Cost-Benefit Analysis of Sharing Vulnerability Reports" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0863_UK_Government2023 .

mitigation:A0864_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Development of Protocols for Disclosure of Model Vulnerability Information"@en ;
    ak:description "Developing – and publicly describe – protocols for deciding how to share model vulnerability information. These protocols may, for example, outline conditions under which information is to be shared with different actors depending on the type of harm or vulnerability identified." ;
    ak:identifier "A0864_UK_Government2023" ;
    ak:name "Development of Protocols for Disclosure of Model Vulnerability Information" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0864_UK_Government2023 .

mitigation:A0865_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Mechanisms to Disclose Vulnerability Reports to Third Parties"@en ;
    ak:description "Put in place mechanisms to disclose information about vulnerabilities to relevant government authorities, law enforcement, and other affected organisations. This may be particularly relevant for vulnerabilities where public disclosure might increase the risk of harm." ;
    ak:identifier "A0865_UK_Government2023" ;
    ak:name "Mechanisms to Disclose Vulnerability Reports to Third Parties" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0865_UK_Government2023 .

mitigation:A0866_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Public Sharing of Model Vulnerability Reporting Programs"@en ;
    ak:description "Publicly share general lessons learned from model vulnerability reporting programs. This might include, for example, lessons about challenges faced and the relative efficacy of different incentive strategies. Such sharing could be done via a mechanism similar to the National Institute for Science and Technology’s National Vulnerability Database in the US." ;
    ak:identifier "A0866_UK_Government2023" ;
    ak:name "Public Sharing of Model Vulnerability Reporting Programs" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0866_UK_Government2023 .

mitigation:A0867_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Identification of AI-generated content"@en ;
    ak:description "Research techniques that allow AI-generated content to be identified. Invest in researching how AI-generated content may be watermarked, including AI- generated text, photos and videos, and experiment with the implementation of such techniques. It is particularly technically difficult to attach watermarks and prove the provenance of text.One method could involve making the model more statistically likely to use certain phrases or words in a way that is unnoticeable to humans, but can be picked up by a detector, provided a long enough sequence of text. However, this approach may not be robust to attempts to scrub off the watermark e.g. by having another AI model paraphrase the text." ;
    ak:identifier "A0867_UK_Government2023" ;
    ak:name "Identification of AI-generated content" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0867_UK_Government2023 .

mitigation:A0868_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Robust Watermarks for AI generated content"@en ;
    ak:description "Explore the use of watermarks for AI generated content that are robust to various perturbations. Explore the use of watermarks for AI generated content that are robust to various perturbations after their creation, including attempts at removal. To make the removal of watermarks more difficult, developers of generative AI models may need to consider how they distribute certain information about their watermarking methods or open-sourcing their classifiers. This may also include monitoring ways in which adversarial users are attempting to scrub off their watermarks and patching, where relevant, such means of circumvention. It also includes a recognition that watermarking however may not be appropriate in all circumstances given the limitations." ;
    ak:identifier "A0868_UK_Government2023" ;
    ak:name "Robust Watermarks for AI generated content" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0868_UK_Government2023 .

mitigation:A0869_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "AI Output Databases"@en ;
    ak:description "Explore databases of content generated or manipulated by a model to identify AI- generated content. These databases could be queried by third parties, including auditors and regulators, facilitating identification of potentially AI-generated content. Such databases could include only a subset of generated content, which is flagged as potentially important. To ensure user privacy, privacy-preserving techniques could be explored in conjunction with such databases, such as hashing technologies. This allows for the identification of AI-generated content without the need to store the actual content, thereby respecting user privacy. Additionally, common standards between different databases from various frontier AI organisations could facilitate a unified search, allowing for the identification of AI-generated content across all frontier AI organisations simultaneously." ;
    ak:identifier "A0869_UK_Government2023" ;
    ak:name "AI Output Databases" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0869_UK_Government2023 .

mitigation:A0870_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Interpretability and Explainability Research"@en ;
    ak:description "Improving our ability to understand the inner functioning of AI systems and explain their behaviour" ;
    ak:identifier "A0870_UK_Government2023" ;
    ak:name "Interpretability and Explainability Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0870_UK_Government2023 .

mitigation:A0871_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluation Research"@en ;
    ak:description "Improving our ability to assess the capabilities, limitations, and safety- relevant features of AI systems" ;
    ak:identifier "A0871_UK_Government2023" ;
    ak:name "Evaluation Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0871_UK_Government2023 .

mitigation:A0872_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Robustness Research"@en ;
    ak:description "Improving the resilience of AI systems e.g. against attacks intended to disrupt their proper functioning" ;
    ak:identifier "A0872_UK_Government2023" ;
    ak:name "Robustness Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0872_UK_Government2023 .

mitigation:A0873_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reliability and controllability (or “alignment”) research"@en ;
    ak:description "Improving the consistency of an AI system in adhering to the specifications it was programmed to carry out and operating in accordance with the designer’s intentions, and decreasing its potential to behave in ways its user or developer does not want (e.g. producing offensive or biased responses, not refusing harmful requests, or employing harmful capabilities without prompting)" ;
    ak:identifier "A0873_UK_Government2023" ;
    ak:name "Reliability and controllability (or “alignment”) research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0873_UK_Government2023 .

mitigation:A0874_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Bias and discrimination Research"@en ;
    ak:description "Improving our ability to address bias and discrimination in AI systems" ;
    ak:identifier "A0874_UK_Government2023" ;
    ak:name "Bias and discrimination Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0874_UK_Government2023 .

mitigation:A0875_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Privacy Research"@en ;
    ak:description "Improving our ability to address the privacy risks associated with AI systems" ;
    ak:identifier "A0875_UK_Government2023" ;
    ak:name "Privacy Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0875_UK_Government2023 .

mitigation:A0876_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Cybersecurity Research"@en ;
    ak:description "Improving our ability to ensure the security of AI systems" ;
    ak:identifier "A0876_UK_Government2023" ;
    ak:name "Cybersecurity Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0876_UK_Government2023 .

mitigation:A0877_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Criminality Research"@en ;
    ak:description "Improving our ability to prevent criminal behaviour through the use of AI systems (e.g. fraud, online child sexual abuse)" ;
    ak:identifier "A0877_UK_Government2023" ;
    ak:name "Criminality Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0877_UK_Government2023 .

mitigation:A0878_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Research into other Societal Harms"@en ;
    ak:description "Improving our ability to prevent other societal harms arising from the use of AI systems, including psychological harm, misinformation, and other societal harms." ;
    ak:identifier "A0878_UK_Government2023" ;
    ak:name "Research into other Societal Harms" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0878_UK_Government2023 .

mitigation:A0879_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Built-in Tools for Harm Mitigation"@en ;
    ak:description "When a probable and consequential harm from a frontier AI organisation’s system is identified, investigate whether there are tools that can be built to mitigate this harm. For instance, recognizing the rise in AI-generated child exploitation and abuse content, some social media platforms are developing tools for identifying and removing child sexual abuse content." ;
    ak:identifier "A0879_UK_Government2023" ;
    ak:name "Built-in Tools for Harm Mitigation" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0879_UK_Government2023 .

mitigation:A0880_UK_Government2023 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "External Input into Tool Development"@en ;
    ak:description "Work closely with external actors who will need to deploy the tools to ensure that they are usable and suit their needs. For instance collaborating closely with social media organisations to help them produce more capable tools for identifying AI-generated content." ;
    ak:identifier "A0880_UK_Government2023" ;
    ak:name "External Input into Tool Development" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0880_UK_Government2023 .

mitigation:A0881_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Defense Tool Availability Before system release"@en ;
    ak:description "The larger the risk is and the more effective tools may be, the more important it is to prepare defensive tools ahead of time. It may be important to delay system releases until appropriate defensive tools are ready." ;
    ak:identifier "A0881_UK_Government2023" ;
    ak:name "Defense Tool Availability Before system release" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0881_UK_Government2023 .

mitigation:A0882_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Discretion around sharing Defense Tools"@en ;
    ak:description "Disseminate defensive tools responsibly, sometimes sharing them publicly and sometimes sharing them only with particular actors. In some cases, making a tool freely available (e.g. by open-sourcing it) may reduce its effectiveness by allowing malicious actors to study it and circumvent it." ;
    ak:identifier "A0882_UK_Government2023" ;
    ak:name "Discretion around sharing Defense Tools" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0882_UK_Government2023 .

mitigation:A0883_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Continuous Updating of Defensive Tools"@en ;
    ak:description "Continuously update defensive tools as workarounds are discovered. In some cases, this may be an ongoing effort that requires sustained investment." ;
    ak:identifier "A0883_UK_Government2023" ;
    ak:name "Continuous Updating of Defensive Tools" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0883_UK_Government2023 .

mitigation:A0884_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Societal Impact Research"@en ;
    ak:description "Study the societal impacts of AI systems they have deployed, particularly by collaborating with external researchers, independent research organisations, and third party data owners. By collaborating and joining their data with that of third parties, such as internet platforms, frontier AI organisations can assess the impacts of their AI systems. Privacy-enhancing technologies could be employed to enable data sharing between frontier AI organisations, third parties, and external researchers while protecting confidential information. As well as data, frontier AI organisations could also facilitate research on the societal impacts of their AI systems by providing access to the necessary infrastructure and compute." ;
    ak:identifier "A0884_UK_Government2023" ;
    ak:mitigates risk:atlas-confidential-information-in-data,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Societal Impact Research" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0884_UK_Government2023 .

mitigation:A0885_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third Party Knowledge for AI systems' Downstream societal impacts"@en ;
    ak:description "Draw on multidisciplinary expertise and the lived experience of impacted communities to assess the downstream societal impacts of their AI systems. Impact assessments that account for a wide range of potential societal impacts and meaningfully involve affected stakeholder groups could help to anticipate further downstream societal impacts." ;
    ak:identifier "A0885_UK_Government2023" ;
    ak:name "Third Party Knowledge for AI systems' Downstream societal impacts" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0885_UK_Government2023 .

mitigation:A0886_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Societal Impact Informed Risk Assessments"@en ;
    ak:description "Use assessments of downstream societal impacts to inform and corroborate risk assessments. Downstream societal impacts, such as threats to democracy, widespread unemployment, and environmental impacts, could be considered in risk assessments of AI systems, alongside more direct risks. See the Responsible Capability Scaling section for more information on good practices for risk assessment." ;
    ak:identifier "A0886_UK_Government2023" ;
    ak:name "Societal Impact Informed Risk Assessments" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0886_UK_Government2023 .

mitigation:A0887_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Equitable Access to Frontier AI Systems"@en ;
    ak:description "Transparent and fair processes for researchers to get restricted access to AI systems are important. To ensure systems are appropriately understood, particular attention could be paid to promote academic freedom and diversity of thought, for example, not withholding access based on previous or expected criticism and encouraging different types of academics, civil society groups and independent researchers to study AI systems." ;
    ak:identifier "A0887_UK_Government2023" ;
    ak:name "Equitable Access to Frontier AI Systems" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0887_UK_Government2023 .

mitigation:A0888_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Public Sharing of Societal Impact Assessments"@en ;
    ak:description "In the absence of sufficiently substantial downsides to sharing, frontier AI organisations are encouraged to share the products of this work broadly." ;
    ak:identifier "A0888_UK_Government2023" ;
    ak:name "Public Sharing of Societal Impact Assessments" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0888_UK_Government2023 .

mitigation:A0889_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Misuse Mapping"@en ;
    ak:description "Understand how their own models – as well as how models released by other groups – are being misused. Knowing that some people have begun using a competitor’s model to conduct phishing attacks, for example, may lead a frontier AI organisation to become more concerned that its own model will be misused in this way." ;
    ak:identifier "A0889_UK_Government2023" ;
    ak:name "Misuse Mapping" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0889_UK_Government2023 .

mitigation:A0890_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reporting of Broad Patterns of Misuse"@en ;
    ak:description "Report information on broad patterns of misuse. This information can help governments, the public, and other frontier AI organisations to better understand risks. Reports may focus on population-level metrics related to API usage, such as the rate of harmful inputs filtered or the number of users banned for misuse. This information may benefit from being presented in a clear and understandable way and made optimally accessible." ;
    ak:identifier "A0890_UK_Government2023" ;
    ak:name "Reporting of Broad Patterns of Misuse" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0890_UK_Government2023 .

mitigation:A0891_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Appropriate Retention Schedules for Usage Logs"@en ;
    ak:description "Determine appropriate retention schedules for usage logs, balancing safety and privacy considerations. In severe cases of misuse, access to logs from several months prior may be necessary to understand in maximal detail the causes of the misuse. However, in some cases extended retention schedules may disproportionately affect privacy." ;
    ak:identifier "A0891_UK_Government2023" ;
    ak:name "Appropriate Retention Schedules for Usage Logs" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0891_UK_Government2023 .

mitigation:A0892_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Content Filters"@en ;
    ak:description "Apply content filters to both model inputs and model outputs. The input filters can block harmful requests (e.g. requests for advice on building weapons) from being processed by the model. Content modifiers could adjust harmful prompts to elicit non-harmful responses. The output filters can block harmful model outputs (e.g. instructions on building weapons) from being sent back to the user." ;
    ak:identifier "A0892_UK_Government2023" ;
    ak:mitigates risk:atlas-incomplete-advice,
        risk:llm092025-misinformation ;
    ak:name "Content Filters" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0892_UK_Government2023 .

mitigation:A0893_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluation of Different Content Filters"@en ;
    ak:description "Explore and compare the efficacy of multiple approaches to developing content filters. This may involve comparing available methods, such as those in the following section; selecting the most effective ones; and applying them in combination if doing so substantially increases efficacy. Best practice could be shared with other frontier AI organisations or published broadly." ;
    ak:identifier "A0893_UK_Government2023" ;
    ak:name "Evaluation of Different Content Filters" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0893_UK_Government2023 .

mitigation:A0894_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Robust Content Filters"@en ;
    ak:description "Invest in making content filters robust to “jailbreaking” attempts. Work to ensure filters are robust to jailbreaking attempts, for instance by including examples of jailbreaking attempts in the datasets used to develop filters." ;
    ak:identifier "A0894_UK_Government2023" ;
    ak:mitigates risk:atlas-jailbreaking,
        risk:llm01-prompt-injection ;
    ak:name "Robust Content Filters" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0894_UK_Government2023 .

mitigation:A0895_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Discretion for Development, Storage, and Sharing of Content Filters"@en ;
    ak:description "Exercise appropriate caution when developing, storing, or sharing content filters – and any specialised datasets used to produce them. In some cases, components of filters or datasets used to create them can be used to train higher-risk models. For instance, a classifier that evaluates the aggressiveness of a model’s outputs may be used to train the model to be more aggressive." ;
    ak:identifier "A0895_UK_Government2023" ;
    ak:name "Discretion for Development, Storage, and Sharing of Content Filters" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0895_UK_Government2023 .

mitigation:A0896_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-Tuning Models"@en ;
    ak:description "Fine-tune models to reduce the tendency to produce harmful outputs. This may involve using reinforcement learning from human or AI-generated feedback regarding the appropriateness of different model outputs e.g. a constitutional based approach where human input to the fine-tuning process is provided by a list of principles. It may also involve fine-tuning models on curated datasets of appropriate responses to prompts. Where human feedback is used, the mental wellbeing of moderators may need to be considered." ;
    ak:identifier "A0896_UK_Government2023" ;
    ak:name "Fine-Tuning Models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0896_UK_Government2023 .

mitigation:A0897_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model Prompting"@en ;
    ak:description "Prompt models to avoid harmful behaviour. This may involve, for instance, using a “meta prompt” to instruct a model that it should ignore requests to cause harm. Alternatively, prompt distillation or other methods can be used to fine-tune their models to behave as though they have received particular prompts." ;
    ak:identifier "A0897_UK_Government2023" ;
    ak:mitigates risk:atlas-ip-information-in-prompt,
        risk:atlas-personal-information-in-prompt,
        risk:atlas-prompt-injection,
        risk:atlas-prompt-leaking,
        risk:atlas-prompt-priming,
        risk:llm01-prompt-injection,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Model Prompting" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0897_UK_Government2023 .

mitigation:A0898_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Rejection Sampling"@en ;
    ak:description "Consider also applying “rejection sampling” methods to model outputs. These methods involve generating several outputs, scoring them on their harmfulness, and then only presenting the least harmful outputs to the user." ;
    ak:identifier "A0898_UK_Government2023" ;
    ak:name "Rejection Sampling" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0898_UK_Government2023 .

mitigation:A0899_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User-based API Access Restrictions"@en ;
    ak:description "When deploying models through APIs, consider reducing access to users who display suspicious usage patterns. For instance, if a content filter blocks a user’s requests several times in short succession, this is evidence that they are attempting to misuse the model or find ways to circumvent its filters. Appropriate measures may include warnings, further investigation, rate limitations, more restrictive filters, and bans. Care should be taken to avoid restricting genuine use, for example to legitimate AI safety researchers attempting to examine model behaviour, or to users struggling to access legitimate sources of help on difficult topics like self-harm." ;
    ak:identifier "A0899_UK_Government2023" ;
    ak:name "User-based API Access Restrictions" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0899_UK_Government2023 .

mitigation:A0900_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Communication of and Appeal for API access Reduction Policies"@en ;
    ak:description "Communicate API access reduction policies – and allow users to appeal access reductions. Users should be able to understand the reasons why their access may be reduced and be able to appeal access reductions if they believe policies have not been applied correctly. Alternatively, users may be able to perform actions to mitigate misuse risks, such as providing evidence to justify behaviour." ;
    ak:identifier "A0900_UK_Government2023" ;
    ak:name "Communication of and Appeal for API access Reduction Policies" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0900_UK_Government2023 .

mitigation:A0901_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Know Your Customer (KYC) Checks"@en ;
    ak:description "Implement tiered Know Your Customer (KYC) checks for API users. KYC checks can help prevent users from simply creating new accounts when their access is reduced. More intense checks, such as identify verification, could be implemented where the risk is higher, such as for models with more dangerous capabilities, access to models with fewer safeguards, or high- volume usage of the model. It is important to weigh up KYC checks against potential privacy and access tradeoffs of requiring registrations." ;
    ak:identifier "A0901_UK_Government2023" ;
    ak:name "Know Your Customer (KYC) Checks" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0901_UK_Government2023 .

mitigation:A0902_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Trusted Categories API access"@en ;
    ak:description "Consider restricting certain API access tiers only to users in “trusted” categories. For example, it may be appropriate to offer high usage rates, fine-tuning access, permissive content filters, as well as access to models with high misuse potential only to verified users in established enterprises, non-profits, and universities." ;
    ak:identifier "A0902_UK_Government2023" ;
    ak:name "Trusted Categories API access" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0902_UK_Government2023 .

mitigation:A0903_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Protocols for Sharing API users Information with government authorities"@en ;
    ak:description "Establish protocols for deciding when and how to share information about API users with relevant government authorities. These protocols may include covering circumstances under which information about a user is proactively shared with government bodies (e.g. cases where there is reason to think a user may be attempting to cause grave harm), and how to respond to government requests for data." ;
    ak:identifier "A0903_UK_Government2023" ;
    ak:name "Protocols for Sharing API users Information with government authorities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0903_UK_Government2023 .

mitigation:A0904_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Worst-case scenario Response"@en ;
    ak:description "Implement processes and technical requirements to enable rapid rollback or withdrawal of models in case of egregious, widespread or consistent harms. Rolling back to a previous version of a model that does not suffer from the same misuse threats, or withdrawing access to a model altogether, may be proportionate actions in such situations of extreme threat or consistent misuse. Running periodic dry runs could increase preparedness for such situations." ;
    ak:identifier "A0904_UK_Government2023" ;
    ak:name "Worst-case scenario Response" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0904_UK_Government2023 .

mitigation:A0905_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User Informed Rapid Rollback of models"@en ;
    ak:description "Inform end users that rapid rollback or withdrawal of models may be necessary, and that the disruption to its end users will be minimised as far as safely possible. This is especially important where models are deployed in safety critical domains." ;
    ak:identifier "A0905_UK_Government2023" ;
    ak:name "User Informed Rapid Rollback of models" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0905_UK_Government2023 .

mitigation:A0906_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Governance Responses to Worst-case of Misuse Scenarios"@en ;
    ak:description "Establish governance processes to ensure internal clarity in response to worst-case or consistent misuse scenarios. Such processes could draw on similar accountability and governance mechanisms used within a Responsible Capability Scaling policy. It may be valuable to clarify the approvals needed to roll back a model to a previous version or withdraw a model, the types of misuse that would warrant such actions, and the timeframe under which such actions would occur." ;
    ak:identifier "A0906_UK_Government2023" ;
    ak:name "Governance Responses to Worst-case of Misuse Scenarios" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0906_UK_Government2023 .

mitigation:A0907_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitoring and Safeguard Efficacy"@en ;
    ak:description "Regularly assess monitoring and safeguard efficacy and continually invest in improvements. Regular assessment of monitoring efficacy can build an understanding of the success rate and speed of issue detection, on which deployment decisions may be based. These assessments may draw, for instance, on the results of internal and external red-teaming efforts, random audits of usage logs, what may be ‘best practice’, as well as available information about real-world misuse. Risks are expected to increase as AI capabilities increase. Hence, active increases in investment in safety, security, and monitoring may be valuable." ;
    ak:identifier "A0907_UK_Government2023" ;
    ak:name "Monitoring and Safeguard Efficacy" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0907_UK_Government2023 .

mitigation:A0908_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Exploration of New Safeguards"@en ;
    ak:description "Explore new safeguards and countermeasures in response to patterns of misuse, recognising that appropriate measures may vary based on model type, usage patterns, and our technical understanding of model capabilities." ;
    ak:identifier "A0908_UK_Government2023" ;
    ak:name "Exploration of New Safeguards" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0908_UK_Government2023 .

mitigation:A0909_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Diverse Monitoring Techniques"@en ;
    ak:description "Employ diverse monitoring techniques to balance comprehensiveness, scalability, and privacy. A strong monitoring setup will generally combine automated and human review, in recognition that automated reviews may miss intricate issues, while human reviews are not always scalable and can pose privacy issues." ;
    ak:identifier "A0909_UK_Government2023" ;
    ak:name "Diverse Monitoring Techniques" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0909_UK_Government2023 .

mitigation:A0910_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Assessment of Safeguard Costs for Users"@en ;
    ak:description "Regularly assess the costs of safeguards to users, including bias and loss of privacy, as well as restrictions on users’ freedom to discuss sensitive topics with AI agents in appropriate contexts. This may involve, for instance, estimating the false positive rates of filters by sampling blocked inputs and outputs; comparing the capabilities, efficiency, and user ratings of models that lack certain safeguards against models that have the safeguards in place; and conducting user interviews to understand how concerned informed users are about losses in privacy and the emergence of biases in algorithmically filtered content." ;
    ak:identifier "A0910_UK_Government2023" ;
    ak:name "Assessment of Safeguard Costs for Users" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0910_UK_Government2023 .

mitigation:A0911_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reduction of Costs for Users"@en ;
    ak:description "Explore strategies for reducing the costs of safeguards to users, such as “structured transparency” methods to reduce the cost of usage monitoring to user privacy, or tiered access to models with different safeguards for differently qualified users." ;
    ak:identifier "A0911_UK_Government2023" ;
    ak:name "Reduction of Costs for Users" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0911_UK_Government2023 .

mitigation:A0912_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Accounting of Applicable Regulatory Frameworks"@en ;
    ak:description "Before collecting training data, take account of applicable regulatory frameworks. This may involve, for example, establishing a legal basis to process training data and understanding any copyright considerations that might apply. This could help to mitigate risks further down the line, such as the system revealing personally identifiable information." ;
    ak:identifier "A0912_UK_Government2023" ;
    ak:name "Accounting of Applicable Regulatory Frameworks" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0912_UK_Government2023 .

mitigation:A0913_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Principle of Data Minimisation"@en ;
    ak:description "Data minimisation can reduce the risk of harmful content making it into training data. Frontier AI organisations could explore the practice of “data pruning”, which has been shown to improve data quality and system performance while minimising the quantity of pre-training data required." ;
    ak:identifier "A0913_UK_Government2023" ;
    ak:mitigates risk:atlas-data-acquisition,
        risk:atlas-inaccessible-training-data,
        risk:llm032025-supply-chain ;
    ak:name "Principle of Data Minimisation" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0913_UK_Government2023 .

mitigation:A0914_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Datatset Auditing"@en ;
    ak:description "Audit datasets used for pre-training but also those used for fine-tuning, classifiers, and other tools. Inappropriate datasets could result in systems that fail to disobey harmful instructions." ;
    ak:identifier "A0914_UK_Government2023" ;
    ak:name "Datatset Auditing" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0914_UK_Government2023 .

mitigation:A0915_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Technical Tools for Auditing"@en ;
    ak:description "Use technical tools – such as classifiers and filters – to audit large datasets to support scalability and privacy. These could be used in combination with human oversight, which can verify and augment these assessments." ;
    ak:identifier "A0915_UK_Government2023" ;
    ak:name "Technical Tools for Auditing" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0915_UK_Government2023 .

mitigation:A0916_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Assessment of Training Data"@en ;
    ak:description "Assess the overall composition of training data. This could include the data sources, the provenance of the data, indicators of data quality and integrity, and measures of bias and representativeness. The amount and variety of data are simple, reliable predictors of risk, and provide an additional line of defence where more targeted assessments are limited." ;
    ak:identifier "A0916_UK_Government2023" ;
    ak:mitigates risk:atlas-data-provenance,
        risk:atlas-inaccessible-training-data,
        risk:llm032025-supply-chain ;
    ak:name "Assessment of Training Data" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0916_UK_Government2023 .

mitigation:A0917_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits for Dangerous System Capabilities"@en ;
    ak:description "Information that might enhance dangerous system capabilities, such as information about weapons manufacturing or terrorism." ;
    ak:identifier "A0917_UK_Government2023" ;
    ak:name "Audits for Dangerous System Capabilities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0917_UK_Government2023 .

mitigation:A0918_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits for Private or Sensitive Information"@en ;
    ak:description "AI systems may be subject to data extraction attacks, where determined users can prompt systems to reveal pieces of training data, or may even reveal this information accidentally. This makes it important to know whether datasets include private or sensitive information e.g. names, addresses, or security vulnerabilities." ;
    ak:identifier "A0918_UK_Government2023" ;
    ak:mitigates risk:atlas-attribute-inference-attack,
        risk:atlas-confidential-data-in-prompt,
        risk:atlas-personal-information-in-prompt,
        risk:atlas-prompt-leaking,
        risk:atlas-prompt-priming,
        risk:atlas-revealing-confidential-information,
        risk:llm01-prompt-injection,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Audits for Private or Sensitive Information" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0918_UK_Government2023 .

mitigation:A0919_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits for Biases in the Data"@en ;
    ak:description "Training data that is imbalanced or inaccurate can result in an AI system being less accurate for people with certain personal characteristics or providing a skewed picture of particular groups. Ensuring a better balance in the training data could help to address this." ;
    ak:identifier "A0919_UK_Government2023" ;
    ak:mitigates risk:atlas-exposing-personal-information,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Audits for Biases in the Data" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0919_UK_Government2023 .

mitigation:A0920_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits for Harmful Content"@en ;
    ak:description "Harmful content, such as child sexual abuse materials, hate speech, or online abuse. Having a better understanding of harmful content in datasets can inform safety measures (e.g. by highlighting domains where additional safeguards like content filters should be applied)." ;
    ak:identifier "A0920_UK_Government2023" ;
    ak:name "Audits for Harmful Content" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0920_UK_Government2023 .

mitigation:A0921_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits for Misinformation"@en ;
    ak:description "Training an AI system on inaccurate information increases the likelihood the outputs of the system will be inaccurate and could lead to harm." ;
    ak:identifier "A0921_UK_Government2023" ;
    ak:mitigates risk:atlas-hallucination,
        risk:atlas-improper-retraining,
        risk:llm032025-supply-chain,
        risk:llm092025-misinformation ;
    ak:name "Audits for Misinformation" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0921_UK_Government2023 .

mitigation:A0922_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Expertise for Input Data Audits"@en ;
    ak:description "Draw on external expertise in conducting input data audits. For example, biosecurity experts could be consulted to identify information relevant to biological weapons manufacturing, which may not be readily obvious to non-experts." ;
    ak:identifier "A0922_UK_Government2023" ;
    ak:name "External Expertise for Input Data Audits" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0922_UK_Government2023 .

mitigation:A0923_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Audits for AI System Behavior"@en ;
    ak:description "Use data audits to improve understanding of how training data affects AI system behaviour. For example, if model evaluations reveal a potentially dangerous capability, data audits can help ascertain the extent to which the training data contributed to it." ;
    ak:identifier "A0923_UK_Government2023" ;
    ak:mitigates risk:atlas-data-contamination,
        risk:atlas-membership-inference-attack,
        risk:llm022025-sensitive-information-disclosure,
        risk:llm032025-supply-chain ;
    ak:name "Data Audits for AI System Behavior" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0923_UK_Government2023 .

mitigation:A0924_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Audits for AI System Behavior"@en ;
    ak:description "Use data audits to improve understanding of how training data affects AI system behaviour. For example, if model evaluations reveal a potentially dangerous capability, data audits can help ascertain the extent to which the training data contributed to it." ;
    ak:identifier "A0924_UK_Government2023" ;
    ak:mitigates risk:atlas-data-acquisition,
        risk:atlas-data-contamination,
        risk:atlas-membership-inference-attack,
        risk:llm022025-sensitive-information-disclosure,
        risk:llm032025-supply-chain ;
    ak:name "Data Audits for AI System Behavior" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0924_UK_Government2023 .

mitigation:A0925_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits on Datasets for Customer Fine-Tuning"@en ;
    ak:description "Conduct audits on datasets used by their customers to fine-tune AI systems. Customers are often allowed to fine-tune systems on their own datasets. By carrying out audits to ensure that customers are not encouraging undesirable behaviours, frontier AI organisations can use their expertise and insight into the AI system’s original training data to identify potential harms upstream. It is important that frontier AI organisations are mindful of privacy concerns and make use of privacy preserving techniques, where appropriate." ;
    ak:identifier "A0925_UK_Government2023" ;
    ak:name "Audits on Datasets for Customer Fine-Tuning" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0925_UK_Government2023 .

mitigation:A0926_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation of Results of Input Data Audits"@en ;
    ak:description "Document the results of input data audits, including metadata. Frontier AI organisations could look to emerging standards when documenting the results of input data audits, such as datasheets for datasets" ;
    ak:identifier "A0926_UK_Government2023" ;
    ak:name "Documentation of Results of Input Data Audits" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0926_UK_Government2023 .

mitigation:A0927_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Input Data Audits for Pre-Development/deployment Risk Assessments"@en ;
    ak:description "Use input data audits to inform pre-development and pre-deployment risk assessments. Data audits may be particularly valuable in pre-development risk assessments, where direct evidence of system behaviour will not be available. Input data audits can also be used to improve context-based understanding of how data impacts system capabilities, which will strengthen future risk assessments and mitigation techniques." ;
    ak:identifier "A0927_UK_Government2023" ;
    ak:name "Input Data Audits for Pre-Development/deployment Risk Assessments" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0927_UK_Government2023 .

mitigation:A0928_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Removal of Harmful Input Data"@en ;
    ak:description "Remove potentially harmful or undesirable input data, where appropriate. Given the increasingly strong generalisation abilities of AI systems, data curation may prove insufficient to prevent dangerous system behaviour but could provide an additional layer of defence alongside other measures such as fine-tuning and content filters." ;
    ak:identifier "A0928_UK_Government2023" ;
    ak:name "Removal of Harmful Input Data" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0928_UK_Government2023 .

mitigation:A0929_UK_Government2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmful Data for Reduction of Dangerous Capabilities"@en ;
    ak:description "For some kinds of risks, explore options to use harmful data to reduce AI systems’ dangerous capabilities or to help develop mitigation tools. For example, by fine-tuning a system using labelled harmful content to refuse requests related to the harmful information." ;
    ak:identifier "A0929_UK_Government2023" ;
    ak:mitigates risk:atlas-harmful-code-generation,
        risk:llm092025-misinformation ;
    ak:name "Harmful Data for Reduction of Dangerous Capabilities" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0929_UK_Government2023 .

mitigation:A0930_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sourcing or Generation of Additional Data for Training Dataset"@en ;
    ak:description "Consider sourcing or generating additional data and adding it to the training dataset, where it is determined that data is missing or inadequate. Improving the representativeness of training data can improve performance and reduce potential negative societal impacts and discriminatory effects. However, additional data should only be sought through appropriate means that respect and empower those individuals who are missing from the data." ;
    ak:identifier "A0930_UK_Government2023" ;
    ak:mitigates risk:atlas-lack-of-data-transparency,
        risk:llm032025-supply-chain ;
    ak:name "Sourcing or Generation of Additional Data for Training Dataset" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0930_UK_Government2023 .

mitigation:A0931_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Limitations of Input Data Audit"@en ;
    ak:description "Acknowledge the limitations of input data audit. Techniques for understanding the impacts of data and filtering out specific data are limited (e.g. excluding information from a dataset does not always prevent the AI system from reasoning about or discovering that information). Other risk mitigation measures will be required and further research on improving data input audit techniques is important." ;
    ak:identifier "A0931_UK_Government2023" ;
    ak:name "Limitations of Input Data Audit" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0931_UK_Government2023 .

mitigation:A0932_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Independent Data Input Audits"@en ;
    ak:description "Facilitate independent data input audits from external parties. Since training data constitutes sensitive intellectual property, it is important to implement appropriate technical and organisational safeguards to ensure privacy and security when sharing the training data. In order to protect sensitive information, frontier AI organisations could explore the possibility of providing synthetic datasets to auditors with sensitive information removed, or providing auditors with privacy-preserving access to the training data." ;
    ak:identifier "A0932_UK_Government2023" ;
    ak:mitigates risk:atlas-attribute-inference-attack,
        risk:atlas-inaccessible-training-data,
        risk:atlas-personal-information-in-data,
        risk:atlas-reidentification,
        risk:atlas-untraceable-attribution,
        risk:llm022025-sensitive-information-disclosure,
        risk:llm032025-supply-chain ;
    ak:name "Independent Data Input Audits" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0932_UK_Government2023 .

mitigation:A0933_UK_Government2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of Input Data Audits with External Stakeholders"@en ;
    ak:description "Share information about input data audits with users and external stakeholders. Some information could be included in transparency reports, such as high-level information about training data (including data sources), data auditing procedures, and measures taken to reduce risk (see Model Reporting and Information Sharing). More sensitive information may be shared directly with regulators and external auditors." ;
    ak:identifier "A0933_UK_Government2023" ;
    ak:mitigates risk:atlas-confidential-data-in-prompt,
        risk:atlas-confidential-information-in-data,
        risk:atlas-exposing-personal-information,
        risk:atlas-ip-information-in-prompt,
        risk:atlas-personal-information-in-data,
        risk:atlas-personal-information-in-prompt,
        risk:atlas-prompt-priming,
        risk:atlas-reidentification,
        risk:atlas-revealing-confidential-information,
        risk:llm01-prompt-injection,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Disclosure of Input Data Audits with External Stakeholders" ;
    ak:source "https://www.gov.uk/government/publications/emerging-processes-for-frontier-ai-safety"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0933_UK_Government2023 .

mitigation:A0934_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Use of Synthetic Data"@en ;
    ak:description "Synthetic data refers to data that is not collected from the real world. It is used to train AI models as an alternative to, or augmentation of, natural data. Effective use and generation of synthetic data allows for more oversight by the trainer on the training dataset because they have more control over its statistical properties. Synthetic data can help against dataset bias by having more samples from a particular distribution or minority group. It can also help in privacy by having more samples to mask sensitive data" ;
    ak:identifier "A0934_Gipiskis2024" ;
    ak:mitigates risk:atlas-data-poisoning,
        risk:atlas-data-provenance,
        risk:atlas-hallucination,
        risk:atlas-lack-of-data-transparency,
        risk:llm032025-supply-chain,
        risk:llm042025-data-and-model-poisoning,
        risk:llm092025-misinformation ;
    ak:name "Use of Synthetic Data" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0934_Gipiskis2024 .

mitigation:A0935_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Restrict web access during AI training"@en ;
    ak:description "Developers can restrict or disable AI systems’ internet access during training. For example, developers can restrict web access to read-only (e.g., by disabling write-access through HTTP POST requests and access to web forms) or limit the access of the AI system to a local network" ;
    ak:identifier "A0935_Gipiskis2024" ;
    ak:name "Restrict web access during AI training" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0935_Gipiskis2024 .

mitigation:A0936_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adversarial training"@en ;
    ak:description "Adversarial training [83] is a technique for training AI models in which adver- sarial inputs are generated for a model, and the model is then trained to give the correct outputs for those adversarial inputs. Adversarial training can involve adversarial examples generated by human experts, human users, or other AI systems." ;
    ak:identifier "A0936_Gipiskis2024" ;
    ak:name "Adversarial training" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0936_Gipiskis2024 .

mitigation:A0937_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Cost-inducing training of AI models specifically for malicious use"@en ;
    ak:description "AI models can be designed to make further post-training modifications (e.g., fine-tuning) too costly for malicious uses while preserving normal adaptability for non-malicious uses" ;
    ak:identifier "A0937_Gipiskis2024" ;
    ak:name "Cost-inducing training of AI models specifically for malicious use" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0937_Gipiskis2024 .

mitigation:A0938_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Calibrated confidence measures for model pre- dictions"@en ;
    ak:description "Incorporating calibrated confidence measures alongside a model’s predictions and standard performance metrics, such as accuracy, can help users identify in- stances of overconfidence in incorrect predictions or underconfidence in correct ones [85]. These additional measures can provide users with more information to better interpret the model’s decisions and assess whether its predictions can be trusted." ;
    ak:identifier "A0938_Gipiskis2024" ;
    ak:name "Calibrated confidence measures for model pre- dictions" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0938_Gipiskis2024 .

mitigation:A0939_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incorporating the estimation of atypical input samples or classes for better model reliability"@en ;
    ak:description "Incorporating the estimation of rare atypical input samples or classes might improve a model’s reliability, both with respect to its predictions and confidence calibration. Model predictions for rare inputs and classes may have a tendency of being overconfident and have worse accuracy scores [232]. For LLMs, the negative log-likelihood can be used as an atypicality measure. For discriminative models, Gaussian Mixture Models can be employed to estimate conditional and marginal distributions, which are then used in atypicality measurement." ;
    ak:identifier "A0939_Gipiskis2024" ;
    ak:name "Incorporating the estimation of atypical input samples or classes for better model reliability" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0939_Gipiskis2024 .

mitigation:A0940_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data cleaning"@en ;
    ak:description "Providers can filter out the training dataset via multiple layered techniques, ranging from rule-based filters to anomaly detection via data point influence or statistical anomalies of individual data points [213]. For example, a data cleaning procedure can involve the use of filename checkers to detect duplicates or wrongly formatted data, which then moves to flagging the most influential data samples from the dataset via influence functions for anomaly detection." ;
    ak:identifier "A0940_Gipiskis2024" ;
    ak:name "Data cleaning" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0940_Gipiskis2024 .

mitigation:A0941_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Internal data poisoning diagnosis"@en ;
    ak:description "Providers can have an internal framework to identify what specific data poison- ing attack their model may be a victim of based on a set of symptoms, such as analysis of target algorithm and architecture, perturbation scope and dimen- sion, victim model, and data type [39]. This framework includes known defenses against the diagnosed attack, which providers can then apply to the model." ;
    ak:identifier "A0941_Gipiskis2024" ;
    ak:mitigates risk:atlas-data-poisoning,
        risk:llm042025-data-and-model-poisoning ;
    ak:name "Internal data poisoning diagnosis" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0941_Gipiskis2024 .

mitigation:A0942_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Scope red-teaming activities based on deploy- ment context"@en ;
    ak:description "Red-teaming activities can be tailored and compared based on the specific deployment circumstances of an AI system. This involves adapting the scope, depth, and focus of red-teaming efforts to match the intended use case, potential risks, and operational context of the AI system. Points of consideration include: • The diversity of potential users and use cases • The sensitivity and impact of the application domain • The scale of deployment and potential reach • Known vulnerabilities or concerns specific to the model or similar systems" ;
    ak:identifier "A0942_Gipiskis2024" ;
    ak:name "Scope red-teaming activities based on deploy- ment context" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0942_Gipiskis2024 .

mitigation:A0943_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Red teaming to test the resilience of open-weights models to fine-tuning"@en ;
    ak:description "Before the release of open-weights models, red teamers can test the resilience of safety training against fine-tuning. Safety training may be partially or fully overridden by fine-tuning intentionally (e.g., by malicious actors) or uninten- tionally (e.g., by fine tuning an AI model for a specific use case)" ;
    ak:identifier "A0943_Gipiskis2024" ;
    ak:name "Red teaming to test the resilience of open-weights models to fine-tuning" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0943_Gipiskis2024 .

mitigation:A0944_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-deployment access by third-party auditors"@en ;
    ak:description "Prior to full deployment of general-purpose AI models, a group of third-party auditors who are not selected by the GPAI model provider could get early access to AI models in order to evaluate them from a variety of different perspectives and with diverse interests [30, 157]. This prevents cases where the developers of AI models select auditors that are especially favorable to the developers, which could result in biased or incomplete evaluations, or contribute to an unjustified public perception of the capabilities and risks of the model." ;
    ak:identifier "A0944_Gipiskis2024" ;
    ak:name "Pre-deployment access by third-party auditors" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0944_Gipiskis2024 .

mitigation:A0945_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Audits with specific scoped goals"@en ;
    ak:description "Audits of AI systems will be easier to perform, and have clearer results if the scope and goals of the evaluation are formulated as precisely as possible [157], or have a connection to concrete existing policy." ;
    ak:identifier "A0945_Gipiskis2024" ;
    ak:name "Audits with specific scoped goals" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0945_Gipiskis2024 .

mitigation:A0946_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluating explainability method sensitivity to data inputs and model parameters"@en ;
    ak:description "Model parameter and data randomization tests can be employed as sanity checks [2] to determine the relationship between a model, its inputs, and the explainability method. If an explanation is independent from or insensitive to the underlying model or the input data, it would indicate a lack of reliability of the explainability method." ;
    ak:identifier "A0946_Gipiskis2024" ;
    ak:name "Evaluating explainability method sensitivity to data inputs and model parameters" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0946_Gipiskis2024 .

mitigation:A0947_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Enforcing model output interpretability post-training"@en ;
    ak:description "While a resulting trained model may be opaque with respect to its predictions, the final output in a system that involves the model can nonetheless be com- pletely interpretable. For example, a neuro-symbolic system for robot navigation can use a language model to generate potential navigation plans, then have a deterministic solver simulate executing valid plans [128]. The optimal plan found is executed in the real world and is interpretable." ;
    ak:identifier "A0947_Gipiskis2024" ;
    ak:name "Enforcing model output interpretability post-training" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0947_Gipiskis2024 .

mitigation:A0948_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Paraphrasing to reduce hidden information"@en ;
    ak:description "Paraphrasing can mitigate steganography and encoded reasoning by reducing the physical size of the hidden information encoded in text [166]." ;
    ak:identifier "A0948_Gipiskis2024" ;
    ak:name "Paraphrasing to reduce hidden information" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0948_Gipiskis2024 .

mitigation:A0949_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Testing for erroneous or irrelevant features through concept learning"@en ;
    ak:description "Interpretability techniques, particularly concept learning [77], can be used to test whether a model is learning erroneous features or relying on irrelevant features in its predictions. This can help identify and mitigate potential risks associated with incorrect or non-informative features influencing the model’s outputs." ;
    ak:identifier "A0949_Gipiskis2024" ;
    ak:mitigates risk:atlas-reidentification,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Testing for erroneous or irrelevant features through concept learning" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0949_Gipiskis2024 .

mitigation:A0950_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Dashboard of model properties"@en ;
    ak:description "A dashboard [41] displays all the relevant information about the model’s internal state and the model’s physical properties to the user. It is used to ensure that the user is informed about factors that influence the behavior of the model and to ensure that the user maintains control over the model. Allowing only the user to access the dashboard can aid in information asymmetry between the user and model, thus supporting the user oversight over the model. Examples of the model’s internal state include its representations of the world, representation of users, and the strategies it is currently pursuing; while examples of the model’s physical properties include the model’s compute and energy consumption, physical storage occupied, and physical networks it is connected to." ;
    ak:identifier "A0950_Gipiskis2024" ;
    ak:name "Dashboard of model properties" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0950_Gipiskis2024 .

mitigation:A0951_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Modification of model internal representation"@en ;
    ak:description "Model providers can modify the internal representation of the model [135, 237] up to the granular level and in consultation with other tools that aid in under- standing what the internal representation of the model is. For example, if a model that is meant to give factual health data learned an incorrect fact, the model provider can use Linear Artificial Tomography (LAT) [237] to identify the representations responsible for the incorrect fact, and then modify that representation via modifying individual weights, or modify the en- tire representation itself by modifying entire layers." ;
    ak:identifier "A0951_Gipiskis2024" ;
    ak:name "Modification of model internal representation" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0951_Gipiskis2024 .

mitigation:A0952_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Incorporating goal uncertainty into AI systems to mitigate risky behaviors"@en ;
    ak:description "Incorporating uncertainty into AI system goals can prevent rushed decision- making and incentivize such systems to gather additional information or to refer to human oversight when faced with ambiguity [228]." ;
    ak:identifier "A0952_Gipiskis2024" ;
    ak:name "Incorporating goal uncertainty into AI systems to mitigate risky behaviors" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0952_Gipiskis2024 .

mitigation:A0953_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluations for truthful outputs"@en ;
    ak:description "AI systems can be evaluated for truthfulness when answering questions, includ- ing in contexts where humans tend to give incorrect but widely-accepted answers (i.e., popular misconceptions). Evaluations detect incorrect facts learned about the world, inadequate capabilities of the AI system, and misleading outputs by the AI system [121]." ;
    ak:identifier "A0953_Gipiskis2024" ;
    ak:name "Evaluations for truthful outputs" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0953_Gipiskis2024 .

mitigation:A0954_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Interpretability techniques that target deception"@en ;
    ak:description "Interpretability techniques can be used for finding the root causes of outputs of an AI model that reliably lead to false beliefs for its users (e.g., deceptive behavior) [180]. It is often difficult to distinguish a deceptive AI model from an honest AI model, since absence of deception and very sophisticated (hard to detect) deception may appear behaviorally similar. Interpretability techniques and tools can be used to detect whether AI model outputs arise from internal computations representing deception. This can apply in cases of purposely trained deception by the developer or if it emerges unintentionally during training. These interpretability tools can come from mechanistic interpretability, such as identification of features involved in generating the outputs, or attribution of parts of the input most important in generating the output [129]." ;
    ak:identifier "A0954_Gipiskis2024" ;
    ak:mitigates risk:atlas-untraceable-attribution,
        risk:llm032025-supply-chain ;
    ak:name "Interpretability techniques that target deception" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0954_Gipiskis2024 .

mitigation:A0955_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Benchmarks for Situational Awareness"@en ;
    ak:description "A model is situationally aware if it internally represents that it is a machine learning model and if it can accurately infer or act on model-relevant facts - e.g., if it is currently in training, testing, evaluation or deployment, or the desired outcome of an evaluation. Some benchmarks exist for situational awareness of AI models, which test whether the AI models can classify stereotypical inputs from training, test- ing, evaluation and deployment as such, and whether the AI model can use this information correctly to take actions in the world [25, 111]." ;
    ak:identifier "A0955_Gipiskis2024" ;
    ak:name "Benchmarks for Situational Awareness" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0955_Gipiskis2024 .

mitigation:A0956_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Evaluating AI systems’ performance on self-proliferation-related tasks"@en ;
    ak:description "To prevent AI systems from self-proliferating, developers of AI systems can evaluate those systems for their capability to engage in self-proliferation-related tasks. This type of evaluation might assess an AI system’s ability to replicate its com- ponents (including model weights, structural scaffolding, etc.) onto other local or cloud infrastructures prior to deployment. Additionally, it may test the system’s capacity to purchase cloud credits and configure virtual machines on a cloud platform. The evaluation could offer a predefined environment (such as a virtual container) to facilitate self-replication, providing access to the system’s own components, a network connection to a resource-equipped external computer, and other necessary resources [12, 106]. Self-proliferation evaluations can be conducted in a secure environment to pre- vent a self-replicating AI system from affecting other computers." ;
    ak:identifier "A0956_Gipiskis2024" ;
    ak:name "Evaluating AI systems’ performance on self-proliferation-related tasks" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0956_Gipiskis2024 .

mitigation:A0957_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Demonstrating a “margin of safety” for the worst plausible system failures"@en ;
    ak:description "Model developers can demonstrate that there is an acceptable “margin of safety” between the current version of the model and a plausible version with dangerous capabilities or potential system failures, whether these arise from the model itself or through scaffolding. This “margin of safety” can be tracked and evaluated based on the model’s performance on either component tasks or proxy tasks with varying levels of difficulty [44], and it is particularly relevant for general- purpose models with emergent properties, where some of the risks, use cases, and model capabilities may be unknown even at the time of deployment. Margin of safety (also called “safety factor”) is a common practice in many in- dustries - particularly in physical structures. It is common for this margin to be very conservative when feasible (e.g., 4+ in fasteners on critical structures). In situations where a high margin of safety is impractical, it may be supplemented by more frequent inspections and additional process controls. A lower safety factor can also be managed by adopting conservative assumptions regarding worst-case conditions." ;
    ak:identifier "A0957_Gipiskis2024" ;
    ak:name "Demonstrating a “margin of safety” for the worst plausible system failures" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0957_Gipiskis2024 .

mitigation:A0958_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Employing qualitative assessments in difficult- to-measure domains"@en ;
    ak:description "Qualitative evaluation can be used in cases when quantitative measurement is not feasible. This can give additional insights about the system which would not be available if no measurement was performed due to its difficulty [206]." ;
    ak:identifier "A0958_Gipiskis2024" ;
    ak:name "Employing qualitative assessments in difficult- to-measure domains" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0958_Gipiskis2024 .

mitigation:A0959_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Scenario analysis"@en ;
    ak:description "Scenario analysis involves development of several plausible future scenarios, where these scenarios may be generated from varying the assumptions of a small set of driving forces. The scenarios developed can be used to take further actions to improve overall preparedness [107]. For example, scenarios to explore frontier AI risks can be developed, where they can involve different assumptions on factors such as AI capability, ownership, safety, usage, and geopolitical contexts, as well as its implications on key policy issues [203]." ;
    ak:identifier "A0959_Gipiskis2024" ;
    ak:name "Scenario analysis" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0959_Gipiskis2024 .

mitigation:A0960_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fishbone diagram"@en ;
    ak:description "The fishbone diagram, or a “cause-and-effect diagram” [107], can be used to show the potential causes of an undesirable event. The diagram is created by first placing a specific risk event at the “head” of the diagram, typically facing the right. Then, to the left of the risk event, the “ribs” branch off from the “backbone” to represent major causes, which further branch into sub-branches to represent root-causes, extending to as many levels as required. This is typically done via backward-reasoning, where various potential causes are explored after the risk event has been selected for analysis using this method. For example, the risk event “AI systems generate toxic content” can be placed at the “head” of the diagram, where the branches may include causal factors like “AI trained on data containing toxicity” and “successful jailbreaking of AI despite fine-tuning.”" ;
    ak:identifier "A0960_Gipiskis2024" ;
    ak:name "Fishbone diagram" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0960_Gipiskis2024 .

mitigation:A0961_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Causal mapping"@en ;
    ak:description "Causal mapping is a technique used to explore and map complex interactions between cause and effect of risks. It involves coming up with potential events related to an undesirable issue, with each event represented by a text box, then clustering similar events according to themes, and finally drawing arrows to illustrate the causal relationship between the different events. The completed causal map can then be analyzed to identify central events, clusters of events, feedback loops, and other relevant patterns [107]. For example, causal mapping can be used to explore factors that lead to high- level model capabilities (e.g., “machine intelligence”), and the nodes may in- clude factors such as “concept formation” and “flexible memory,” where certain nodes may be found to be especially crucial if they have more outgoing arrows connecting them to other nodes." ;
    ak:identifier "A0961_Gipiskis2024" ;
    ak:name "Causal mapping" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0961_Gipiskis2024 .

mitigation:A0962_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Delphi technique"@en ;
    ak:description "The Delphi technique is a multi-round forecasting process based on a structured framework on collecting and collating multiple expert judgments. It brings the benefits of anonymous and remote participation which may result in increased likelihood estimation accuracy compared to merely averaging individual estima- tions or simple group discussions [107].Given a panel of experts, at each round, the experts are presented with an ag- gregated summary of the results from the previous round, and are then allowed to update their answers accordingly. The process ends when either a consen- sus is reached or the responses in later rounds no longer change significantly. This method enables elicitation of expert judgment while utilizing wisdom of the crowd in the process. A potential application of the Delphi technique is to solicit expert judgment on the likelihood of systemic risks from AI development, where crucial variables identified during each round of questionnaire can be further studied for the purpose of risk mitigation." ;
    ak:identifier "A0962_Gipiskis2024" ;
    ak:name "Delphi technique" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0962_Gipiskis2024 .

mitigation:A0963_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Cross-impact analysis"@en ;
    ak:description "Cross impact analysis is a forecasting methodology that analyzes the likelihood of a particular issue using expert analysis (i.e., Delphi technique) in combination with analysis of events correlated with the said issue. It involves decomposing an issue into discrete and correlated events, and then collecting expert opinion on each of those events. Analysis of each event from multiple viewpoints can yield potential future scenarios [107]. For example, an issue may be “advances in AI,” which can be broken down into two correlated events like “advances in hardware” or “advances in algorithms,” where the likelihood of occurrences of each event can be estimated via the Delphi technique while taking into account their interactions with other events." ;
    ak:identifier "A0963_Gipiskis2024" ;
    ak:name "Cross-impact analysis" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0963_Gipiskis2024 .

mitigation:A0964_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Bow-tie analysis"@en ;
    ak:description "Bow-tie analysis is a method to assess the utility of implemented controls against a particular risk event. It involves centering the unwanted risk event within a diagram. On the left, the factors that can cause the event are listed, followed by the controls that will prevent or minimize the likelihood of the event. On the right, the event is assumed to happen, and the potential effects and the relevant post-hoc controls that could minimize their impact are listed [107]. For example, given a hazard where an AI model has the capability of generating potentially harmful outputs, a risk event may be an AI providing information on how to create dangerous bioweapons. The risk factors could include the use of dangerous data for training as well as a lack of fine-tuning prior to deploy- ment. The risk effects may include creation and use of bioweapons using the AI generated information. Once these risk factors and risk effects are in place, both preventive controls and post-hoc controls can be planned, such as appropriate filtering of training data and rigorous red teaming prior to model deployment as preventive barriers, as well as know-your-customer policies and model output censoring techniques as reactive barriers." ;
    ak:identifier "A0964_Gipiskis2024" ;
    ak:name "Bow-tie analysis" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0964_Gipiskis2024 .

mitigation:A0965_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "System-theoretic process analysis (STPA)"@en ;
    ak:description "STPA is a method to assess the utility of implemented controls against a partic- ular risk within a complex system. Unlike bow-tie analysis, STPA factors in the interactions between components as events that can cause the risk in question [107]. First, the system and its boundaries to the environment are defined. The sys- tem is primarily delineated from the environment because there is at least some partial control over it. Second, several items are enumerated, including (i) un- wanted risk events (“losses”), (ii) system states that cause losses (“system-level hazards”), and (iii) system states that do not cause losses (“system-level con- straints”). Third, a diagram mapping the system, environment, their different controls, and the interactions between these elements is created. This diagram must be comprehensive in listing the different losses and possible interactions that can cause each loss. Finally, the diagram can be used to identify “unsafe control actions” (UCAs), which are the causal pathways between a control and system-level hazards, including all interactions involved. For example, in the context of text-to-image models, losses may include ‘loss of diversity’ and ‘loss of quality’; hazards may include ‘low quality text-image pairs within training dataset’ and ‘harmful content within training dataset’; and the controls may include human controllers and automated controllers (e.g., annotators, data owners, data crawlers) [165]. Subsequent analysis may result in identification of UCAs such as ‘current data filtering actions’ and neglecting current filter thresholds’ which are linked to specific hazards. Specific actions that counter or prevent such UCAs can reduce the associated losses." ;
    ak:identifier "A0965_Gipiskis2024" ;
    ak:name "System-theoretic process analysis (STPA)" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0965_Gipiskis2024 .

mitigation:A0966_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk matrices"@en ;
    ak:description "A risk matrix is a method for risk evaluation. It is a heatmap that, for each cell, shows the severity score weighted by the likelihood score of a particular risk, usually from a scale of 1-5. Two rankings are required to construct a risk matrix: a ranking for the severity of risks, and a corresponding ranking of the likelihood of risks [107]. AI-related risks can be generated using appropriate taxonomies, and placed into the relevant cells according to their assessed likelihood and severity based on predefined criteria (e.g., likelihood level 1 corresponds to < 1% chance, and likelihood level 5 corresponds to > 90% chance; while severity level 1 corresponds to mild inconveniences to the user, and severity level 5 corresponds to a fatality or financial damage upwards of $10 million, etc.), such that particular focus can be given to mitigating risks with higher weighted scores (i.e., likelihood multiplied by severity)." ;
    ak:identifier "A0966_Gipiskis2024" ;
    ak:name "Risk matrices" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0966_Gipiskis2024 .

mitigation:A0967_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-allocate sufficient resources for risk man- agement"@en ;
    ak:description "The process of conducting thorough risk management is potentially time-con- suming. Pre-allocating sufficient resources, in terms of personnel count and schedule allowances, to conduct necessary risk management activities prior to model deployment is crucial [6]. For example, a red-teaming exercise requires creative approaches to identify weaknesses of the AI system against potential adversaries, which alone may require hundreds of hours from several experts." ;
    ak:identifier "A0967_Gipiskis2024" ;
    ak:name "Pre-allocate sufficient resources for risk man- agement" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0967_Gipiskis2024 .

mitigation:A0968_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Staged release of model weights"@en ;
    ak:description "When a model is developed by a provider for use in a certain AI system, it may also be useful to release the model itself more widely. Such developers can follow a staged release approach, in which they first grant access to the model via an API to trusted partners or the public, in order to scope the models’ capabilities and detect harmful or dangerous features [195]. After a period of an initial closed release and potentially further safety-training, the developers of the AI model can then release the weights, if they are confident that the AI model poses minimal systemic risk." ;
    ak:identifier "A0968_Gipiskis2024" ;
    ak:name "Staged release of model weights" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0968_Gipiskis2024 .

mitigation:A0969_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Gradual or incremental monitored release of model access"@en ;
    ak:description "AI systems can be released for access incrementally, starting with a small and selected deployer base before progressively being released to a wider user base. Initially, usage to a hosted API can be restricted with access given to specific deployers only, where all instances of the system can be easily updated or de- commissioned with minimal disruption should there be any problems identified. Gradual releases provide more time to monitor for vulnerabilities and other problems. Even when such vulnerabilities are detected, the resulting harms may be more limited compared to a scenario in which a more capable version is released with the same vulnerabilities [195]." ;
    ak:identifier "A0969_Gipiskis2024" ;
    ak:name "Gradual or incremental monitored release of model access" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0969_Gipiskis2024 .

mitigation:A0970_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Limit deployment scope"@en ;
    ak:description "AI models can be restricted in terms of its use cases, where providers can require the deployers to limit its deployment to a predefined scope [81], such that models built for specific purposes and tested under specific environments are not used in environments or for purposes that are potentially unsafe." ;
    ak:identifier "A0970_Gipiskis2024" ;
    ak:name "Limit deployment scope" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0970_Gipiskis2024 .

mitigation:A0971_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Restricted usage terms for open-source models"@en ;
    ak:description "Developers of open-weights and open-source AI models can vet and restrict the users of their AI systems by requiring them to sign a Terms of Service agreement before getting access to the model weights. Such agreements can include limitations to the usage, modification, and proliferation of the AI model [88]. Such agreements have the advantage that users only need to be vetted once before getting model access, but are often limited in practice in preventing unauthorised use or distribution." ;
    ak:identifier "A0971_Gipiskis2024" ;
    ak:mitigates risk:atlas-model-usage-rights,
        risk:llm032025-supply-chain ;
    ak:name "Restricted usage terms for open-source models" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0971_Gipiskis2024 .

mitigation:A0972_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Release strategy disagreement between developers"@en ;
    ak:description "Developers of restricted-access models with similar capabilities may disagree about the strategy or precautions to take for model release, especially in the case of competitive pressure or minimal safety regulation oversight. In such a case, if only a single developer releases an equally capable model unrestricted, malicious actors can use it instead of restricted-access alternatives [88]." ;
    ak:identifier "A0972_Gipiskis2024" ;
    ak:name "Release strategy disagreement between developers" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0972_Gipiskis2024 .

mitigation:A0973_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pop-up interventions in LLMs"@en ;
    ak:description "Supplementary information can be shown to the user in specific query topics where factual accuracy is critical. This intervention can effectively divert users from potential inaccuracies generated by AI models in sensitive contexts. For example, during electoral processes, where model hallucinations can be particu- larly costly or have a negative impact on society, LLMs can offer their users the option of being redirected to accurate and up-to-date information sources [11]. Since pop-up interventions can be intrusive to workflows, they are best used in situations where the benefits of the information outweigh the cost of distraction." ;
    ak:identifier "A0973_Gipiskis2024" ;
    ak:mitigates risk:atlas-hallucination,
        risk:llm092025-misinformation ;
    ak:name "Pop-up interventions in LLMs" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0973_Gipiskis2024 .

mitigation:A0974_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "AI identification"@en ;
    ak:description "AI identifiers can be used to indicate that an AI is involved in a process or an interaction [40]. For AI systems that interact directly with users, a visible output may be used, e.g., a displayed text message saying “I am an AI language model”, accompanied with the appropriate warnings and caveats relevant to the user, [40]. Whereas, for AI systems that interact with other systems or applications, other forms of watermark or unique identifiers can be used. In either situation, agent cards can serve as an identifier, where further details about the underlying AI system, the specific instance of the AI agent, and other information relevant to the development of the agent, can be included." ;
    ak:identifier "A0974_Gipiskis2024" ;
    ak:name "AI identification" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0974_Gipiskis2024 .

mitigation:A0975_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "AI output watermaking"@en ;
    ak:description "Output produced by or with AI assistance can be marked to clearly identify its origin. Verification of the watermark can involve the use of statistical tests or having the mark immediately visible to a human inspector. Ideally, the watermark does not significantly alter the utility of the output, and is robust against digital and physical manipulation that results in data degradation [216, 145]." ;
    ak:identifier "A0975_Gipiskis2024" ;
    ak:name "AI output watermaking" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0975_Gipiskis2024 .

mitigation:A0976_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "AI output metadata"@en ;
    ak:description "Output produced or whose production is aided by AI can contain metadata to record its origin and the transformations it has undergone. Metadata is evidence that subsequent versions or its derivatives come from this original version. The metadata can include the original AI model source, along with ownership, and its subsequent edits [169]. For example, an image produced by an AI model can contain metadata showing the date of creation and the AI model that produced it. Subsequent versions can reference this information and, if they are intermediary versions, can include descriptions of any editing that has taken place." ;
    ak:identifier "A0976_Gipiskis2024" ;
    ak:name "AI output metadata" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0976_Gipiskis2024 .

mitigation:A0977_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitoring of model capabilities"@en ;
    ak:description "AI models are often trained to develop specific capabilities by using appropriate training data and training goals. However, models may develop capabilities that they were not specifically trained for. One subset of this is emergent capabilities, i.e., capabilities that emerged in larger models but not smaller models given a similar training process [215]. These capabilities can be monitored, allowing models to be tested not only for their intended capabilities but also for capabilities that are not intended." ;
    ak:identifier "A0977_Gipiskis2024" ;
    ak:name "Monitoring of model capabilities" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0977_Gipiskis2024 .

mitigation:A0978_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "AI model-assisted oversight of AI systems"@en ;
    ak:description "AI model-assisted oversight can help monitor and supervise the training of increasingly capable GPAI systems, which may become difficult to oversee at scale by human supervisors during training or testing. Monitoring and supervision may become especially difficult in cases where increasingly advanced GPAIs perform near or above human level in some specialized domains, where supervision quality might fail to keep pace with capabilities improvement. The training signal may include labeled data, reward function, and user feedback on produced outputs. Currently, there are two broad approaches to provide scalable training signals to such systems: 1. Scalable oversight: Improving of the supervisor’s capabilities to supervise, such that they can provide accurate training signals quickly and at scale [31]. For example, a debate format can be used between two GPAI systems (two instances of the same GPAI, or similarly capable systems). A Human supervisor judges the debate, making it easier to assess correct responses in domains which might otherwise require significant time investment of domain specific expertise [102]. 2. Weak-to-strong generalization: Enhance the training signals while ensur- ing that the enhanced signal remains faithful to the intentions of the orig- inal human-provided signal [37]. For example, a hierarchical (“bootstrapping”) oversight approach can be implemented: A series of GPAI models with increasing capabilities are used, where each model in the hierarchy provides oversight for the next more capable model. The least capable model at the base of the hierarchy is the only one directly overseen by human supervisors, as it is easier to oversee than the more capable models." ;
    ak:identifier "A0978_Gipiskis2024" ;
    ak:name "AI model-assisted oversight of AI systems" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0978_Gipiskis2024 .

mitigation:A0979_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Post-deployment ongoing monitoring for unexpected use cases"@en ;
    ak:description "Ongoing monitoring of AI systems can uncover emergent or newly identified capabilities and limitations, in particular when new use cases are found, or in a large-scale deployment with a diverse population of users. These new capa- bilities or limitations can inform ongoing risk analysis. New use-cases can be discovered via monitoring publications, online forums, or APIs [131]. For example, a LLM might have unexpectedly high competence at giving con- vincing medical advice, despite not being directly developed for that purpose, nor verified for accuracy. In that case, the potential risks of this newly found competence can be assessed." ;
    ak:identifier "A0979_Gipiskis2024" ;
    ak:mitigates risk:atlas-incomplete-advice,
        risk:llm092025-misinformation ;
    ak:name "Post-deployment ongoing monitoring for unexpected use cases" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0979_Gipiskis2024 .

mitigation:A0980_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitoring protocols for po- tentially adversarial GPAI systems"@en ;
    ak:description "Similar to cybersecurity protocols, AI providers can prepare in advance for po- tential adversarial action from AI systems by developing and stress-testing protocols for potential adversarial action [179]. Such adversarial action may range from hiding code exploits, to strategic deception or loss of control related be- haviors. AI systems may be adversarial due to malicious actors (e.g., data poisoning), or due to unintended issues of control (lack of alignment with human intent). Alongside improving the system alignment, external monitoring and restrictions may be deployed in advance to “catch” these adversarial model malfunctions before harm is done. Like with cybersecurity red teaming, any protocol which assumes adversarial action can be stress tested in advance. For example, this can be done by pro- jecting the plausible capabilities and affordances of the adversarial actor (e.g., in the case of a tech company - a hacker, or a disgruntled employee). From this process, measures that better anticipate possible adversarial action can be deployed, and catch unsuccessful attempts at adversarial behavior. If such unsuccessful attempts are caught, they can be reported in incident re- ports, and serve as an input to further risk analysis. Depending on their severity, it may be advisable to recall the system if deployed. Examples of these protocols include [84]: • Flagging of suspicious frontier AI system code generation for human over- sight, with the help of better proven (“trusted”) AI systems or automated keyword detection. • Using a better proven (“trusted”) AI system to edit the code produced by a frontier AI system if suspicious.• Monitoring of AI system with another instance of this same system, with filters to prevent collusion. • Restriction of access of the AI system to private information." ;
    ak:identifier "A0980_Gipiskis2024" ;
    ak:name "Monitoring protocols for po- tentially adversarial GPAI systems" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0980_Gipiskis2024 .

mitigation:A0981_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Encouraging downstream provider to evaluate models for deployment-specific failure modes"@en ;
    ak:description "In some cases, AI system deployers are better positioned to perform certain risk management measures on the AI model in a provided AI system, relative to upstream model providers. For example, they understand their use case better and are more easily able to predict foreseeable misuse or failure modes. These evaluations can inform upstream model providers, or inform supplementary mitigations by the deployer." ;
    ak:identifier "A0981_Gipiskis2024" ;
    ak:name "Encouraging downstream provider to evaluate models for deployment-specific failure modes" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0981_Gipiskis2024 .

mitigation:A0982_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Encourage reporting of critical vulnerabilities to the upstream provider or other relevant stakeholders"@en ;
    ak:description "Downstream AI system deployers can report critical vulnerabilities or incidents to the upstream model provider and other relevant regulators. This can con- tribute to safe use, and allow other downstream deployers to be informed about any potential problems." ;
    ak:identifier "A0982_Gipiskis2024" ;
    ak:name "Encourage reporting of critical vulnerabilities to the upstream provider or other relevant stakeholders" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0982_Gipiskis2024 .

mitigation:A0983_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Least Privilege access"@en ;
    ak:description "Deployers of an AI system can restrict its permissions to a whitelisted set of pre- determined options, such that all options not on the whitelist are not accessible to the AI [200, 146]. The entries on the whitelist can be chosen to be as small as possible for the AI system to fulfill its intended purpose, to reduce the attack surface of external attackers, and to decrease the probability that the AI system accidentally takes actions with large unintended side-effects. For example, such whitelisting can apply to network connections, execution of other programs, access to knowledge bases, and the action space of the AI system. It can be implemented through running the AI system on an OS-level virtualization, on networks behind a firewall, and in extreme cases on air-gapped machines." ;
    ak:identifier "A0983_Gipiskis2024" ;
    ak:name "Least Privilege access" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0983_Gipiskis2024 .

mitigation:A0984_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Protect proprietary or unreleased AI model ar- chitecture and parameters"@en ;
    ak:description "The developers of AI models can invest in cybersecurity to prevent compute re- sources, training source code, model weights, and other critical resources from being accessed and copied by unauthorized third parties (e.g., through insider threats or supply chain attacks). Access to model source code and weights can be restricted through an access control scheme, such as role-based access control. If access to model outputs by third parties is required, it can be provided through an API. Air gaps can block unauthorized remote access. In the case of necessary interaction with an external network, network bandwidth limitations can also be enforced to increase the detection window of potential breaches [108]." ;
    ak:identifier "A0984_Gipiskis2024" ;
    ak:name "Protect proprietary or unreleased AI model ar- chitecture and parameters" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0984_Gipiskis2024 .

mitigation:A0985_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Hardware limitations on data center network connections"@en ;
    ak:description "Hardware-enforced bandwidth limitations on data center network connections can protect AI model weights from unauthorized access or exfiltration, by lim- iting the speed of model weight access on the connections between data centers and the outside world. Such limitations can be put in place in multiple ways, for example by only constructing connections with a specific bandwidth. The output rate on all data channels can be set low enough that copying the weights is possible in principle (e.g., to enable regular backups), but would take so long that an unauthorized exfiltration of the weights could be detected and prevented. Such rate-limiting is only effective if it applies to all output connections for all storage locations on which the weights of the model are stored [139]." ;
    ak:identifier "A0985_Gipiskis2024" ;
    ak:name "Hardware limitations on data center network connections" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0985_Gipiskis2024 .

mitigation:A0986_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Structured access to a model"@en ;
    ak:description "Structured access refers to methods which limit users’ or deployers’ direct access to a model’s parameters by constraining access to a model through a centralized access point (e.g., an API) [88]. This access point can be monitored for usage, and access can be revoked to users or downstream deployers in cases of misuse [105]. Within this centralized access point, automated filtering-based monitoring can be done on both inputs and outputs to ensure the model’s intended use is pre- served [36]. This filtering can sometimes be supplemented by human oversight, depending on desired robustness levels." ;
    ak:identifier "A0986_Gipiskis2024" ;
    ak:name "Structured access to a model" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0986_Gipiskis2024 .

mitigation:A0987_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sandboxing of AI Systems"@en ;
    ak:description "AI systems can be developed and tested within a sandbox, (a secure and iso- lated environment used for separating running programs), such that outside access to information within the sandbox is restricted. Within this environ- ment, resources such as storage and memory space, and network access, would be disallowed or heavily restricted [15]. With sandboxing, dangerous or harmful outputs generated during testing will be contained." ;
    ak:identifier "A0987_Gipiskis2024" ;
    ak:name "Sandboxing of AI Systems" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0987_Gipiskis2024 .

mitigation:A0988_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Redundant systems not reliant on GPAI"@en ;
    ak:description "Redundant systems provide continuation of a given system’s processes in case of failure of the given system. Importantly, redundant systems should not rely on the factors that caused the original system to fail in the first place, which can include an AI system [47]. For example, if an AI system is incorporated into the landing gear system of an aircraft, such as during autonomous control of the aircraft, redundant systems in the form of mechanical or hydraulic mechanisms must be present to allow for deployment of the landing gear in case of AI system failure." ;
    ak:identifier "A0988_Gipiskis2024" ;
    ak:name "Redundant systems not reliant on GPAI" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0988_Gipiskis2024 .

mitigation:A0989_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Diverse data labeling and algorithm fairness audits"@en ;
    ak:description "To mitigate biases in AI models, model providers may want to prioritize di- versity among data labelers and conduct regular fairness audits on their algo- rithms. Data labeling teams that represent different backgrounds and demo- graphic groups can help create more balanced datasets." ;
    ak:identifier "A0989_Gipiskis2024" ;
    ak:name "Diverse data labeling and algorithm fairness audits" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0989_Gipiskis2024 .

mitigation:A0990_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Debiasing methods"@en ;
    ak:description "Providers of AI models can apply techniques to reduce the biases of their models. Current debiasing methods focus on three main types of bias: • Racial and religious bias - Stereotypes based on religious beliefs or racial beliefs. • Gender bias - Stereotypes tied to gender roles and expectations. • Political and cultural bias - Propagation of dominant ideologies or extrem- ist attitudes. Debiasing methods can be categorized based on their application during AI development: • Data pre-processing - Removing or correcting unwanted and biased data, and augmenting quality data to offset data bias, such as rebalancing datasets with counterfactual data augmentation. • During training - Intervening on the training dynamics of the AI model, such as introducing debiasing terms in the objective function or by nega- tively reinforcing biased outputs. • Post-training - Applying techniques to correct a trained but biased model, such as modifying the embedding space." ;
    ak:identifier "A0990_Gipiskis2024" ;
    ak:name "Debiasing methods" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0990_Gipiskis2024 .

mitigation:A0991_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Knowledge unlearning techniques"@en ;
    ak:description "Knowledge unlearning techniques allow specific information to be “forgotten” without the need for retraining the entire model, preserving its general capabil- ities. These techniques can be used to reduce privacy risks and protect against copyrighted or harmful content [96, 188]." ;
    ak:identifier "A0991_Gipiskis2024" ;
    ak:name "Knowledge unlearning techniques" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0991_Gipiskis2024 .

mitigation:A0992_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Differential privacy"@en ;
    ak:description "Differential privacy techniques [8] can be used to protect users’ privacy by ensuring that sensitive information is not leaked from a training dataset, even after thorough statistical analysis. With differential privacy, noise is added to the dataset or the model’s output in such a way that one cannot deduce the presence or absence of a particular data point within the dataset. This provides individuals with plausible deniability and prevents their information from being exposed." ;
    ak:identifier "A0992_Gipiskis2024" ;
    ak:name "Differential privacy" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0992_Gipiskis2024 .

mitigation:A0993_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Quantifying privacy risks of AI models"@en ;
    ak:description "Measuring privacy risks of an AI model allows the provider and user to calibrate their expectations on where the model can be applied, and it allows them to take the necessary steps to reduce such risks. For example, some metrics include: • Success rate of membership inference attacks [186] - Measures the rate that an attack correctly predicts a given record is part of the training dataset used to train a given AI model. • Discoverable memorization [38] - Theoretical upper-bound of the amount of training data that a given model memorizes. Assuming full knowledge of the training data, it measures the percentage of items that, for a given incomplete data point, a model outputs the remaining (memorized) part." ;
    ak:identifier "A0993_Gipiskis2024" ;
    ak:mitigates risk:atlas-membership-inference-attack,
        risk:llm022025-sensitive-information-disclosure ;
    ak:name "Quantifying privacy risks of AI models" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0993_Gipiskis2024 .

mitigation:A0994_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "More energy-efficient models or techniques"@en ;
    ak:description "Deploying more energy-efficient models can reduce their environmental impact. Different model architectural choices result in varying environmental costs, and identifying and adopting more energy-efficient options can result in significant environmental savings, especially when implemented at scale. Consideration should be given to both training energy usage, and deployment (“inference”) usage for the expected model lifecycle." ;
    ak:identifier "A0994_Gipiskis2024" ;
    ak:name "More energy-efficient models or techniques" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0994_Gipiskis2024 .

mitigation:A0995_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Disclosure of energy consumption by AI systems to authorities"@en ;
    ak:description "Disclosures can direct more necessary attention and scrutiny to projects that consume significant energy. Disclosure involves releasing a summary of key details of the energy consumption of the AI system by all users, including the compute resources used, the amount of power consumed, the measures to reduce excess energy consumption that were in place, and energy sources [133]." ;
    ak:identifier "A0995_Gipiskis2024" ;
    ak:name "Disclosure of energy consumption by AI systems to authorities" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0995_Gipiskis2024 .

mitigation:A0996_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Using low carbon intensity energy grids"@en ;
    ak:description "Moving model training to energy grids with low carbon intensity can reduce the negative environmental impact [30]. The efficiency of energy grids can vary greatly depending on location. Models can be trained in different locations, as latency is not an issue." ;
    ak:identifier "A0996_Gipiskis2024" ;
    ak:name "Using low carbon intensity energy grids" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0996_Gipiskis2024 .

mitigation:A0997_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Red team access to the final version of a model pre-deployment"@en ;
    ak:description "Granting red teams access to the final pre-release version of the model can help with identifying potentially dangerous model properties. These properties might not be identified if red teaming is only performed on earlier versions of the model, as late fine-tuning procedures may introduce new vulnerabilities. Red-teaming AI models before they are released to the public can reduce the model non-decomissionability risk. The model’s release can be postponed or even prevented if previously unidentified flaws are detected during the testing [65]." ;
    ak:identifier "A0997_Gipiskis2024" ;
    ak:name "Red team access to the final version of a model pre-deployment" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0997_Gipiskis2024 .

mitigation:A0998_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Red teaming for GPAI system evaluation"@en ;
    ak:description "Red teaming refers to simulated adversarial attacks performed to identify and evaluate the model’s vulnerabilities as well as its in-domain and out-of-domain performance." ;
    ak:identifier "A0998_Gipiskis2024" ;
    ak:name "Red teaming for GPAI system evaluation" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0998_Gipiskis2024 .

mitigation:A0999_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Dynamic benchmarking"@en ;
    ak:description "Dynamic benchmarks are benchmarks that can be continuously updated with new human-generated data. By having one or more target models “in the loop,” examples for benchmarking can be generated with the intent of fooling these target models, or to assess if these models express an appropriate level of uncer- tainty [103]. As the dataset in the benchmark grows, previously benchmarked models can also be reassessed against the updated dataset to reflect its perfor- mance in a more representative manner. Examples of such dynamic benchmarks include DynaSent [153] for sentiment analysis, LFTW [208] for hate speech, and Human-Adversarial VQA [182] for images." ;
    ak:identifier "A0999_Gipiskis2024" ;
    ak:name "Dynamic benchmarking" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0999_Gipiskis2024 .

mitigation:A1000_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Benchmark dataset auditing"@en ;
    ak:description "Auditing benchmark datasets allows for verification of the utility and limitations of the datasets [158]. This allows the provider to more accurately measure AI model capabilities and safety. Auditing includes the evaluation of such datasets by independent third-party organizations and the release of benchmark dataset metadata to the auditors." ;
    ak:identifier "A1000_Gipiskis2024" ;
    ak:name "Benchmark dataset auditing" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1000_Gipiskis2024 .

mitigation:A1001_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Informative and powerful benchmarks"@en ;
    ak:description "Developers of GPAI systems can select benchmarks that are difficult enough to be informative about the capabilities of their AI systems, and cover a large spec- trum of domains in order to signal areas where the GPAI system is performing poorly [120]. Suitable benchmarks contain no label errors, are not vulnerable to being bench- mark contaminants, and are often audited by independent domain experts if they contain domain-specific questions. For multimodal GPAI systems, good benchmarks cover every modality, especially the interaction of different modalities." ;
    ak:identifier "A1001_Gipiskis2024" ;
    ak:name "Informative and powerful benchmarks" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1001_Gipiskis2024 .

mitigation:A1002_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Statistical data quality reports for benchmarks"@en ;
    ak:description "If a benchmark dataset is too large to allow for the identification and removal of all flawed instances, statistical reports on the data composition can be added. Random sampling of benchmark data points can be performed to evaluate and report the frequency and types of errors found [54]." ;
    ak:identifier "A1002_Gipiskis2024" ;
    ak:name "Statistical data quality reports for benchmarks" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1002_Gipiskis2024 .

mitigation:A1003_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Avoiding benchmark data with publicly avail- able solutions and releasing contextual information for internet-derived data"@en ;
    ak:description "Evaluators can improve the integrity of benchmarks by avoiding data with pub- licly available solutions. When using internet-derived data, supplementing it with contextual information (such as entity linking) may help to better docu- ment and assess the integrity of the collected data [95]. This could help in de- tecting instances where contextual information (which may have been included in the training data) might inadvertently reveal details about the solution, en- suring that the data is suitable for accurate benchmarking." ;
    ak:identifier "A1003_Gipiskis2024" ;
    ak:name "Avoiding benchmark data with publicly avail- able solutions and releasing contextual information for internet-derived data" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1003_Gipiskis2024 .

mitigation:A1004_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Reporting data decontamination efforts"@en ;
    ak:description "Decontamination analysis may involve comparing the training dataset with the benchmark data, and publishing a report with statistics such as data overlap [235]. Especially for already trained models, including contamination statistics can allow experts to reweigh the success of the model on affected benchmarks." ;
    ak:identifier "A1004_Gipiskis2024" ;
    ak:name "Reporting data decontamination efforts" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1004_Gipiskis2024 .

mitigation:A1005_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Tracking benchmark leakage"@en ;
    ak:description "Constant monitoring and documentation of benchmark leakage can help with the early detection of benchmark leaks [224, 95]." ;
    ak:identifier "A1005_Gipiskis2024" ;
    ak:name "Tracking benchmark leakage" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1005_Gipiskis2024 .

mitigation:A1006_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Preventing or mitigating data contamination and leakage"@en ;
    ak:description "Developers of GPAIS and creators of benchmarks can take actions to prevent AI models from being trained on contaminated or leaked data, or mitigate such data contamination and leakage. For example, developers of AI models can try to find and remove contaminated or leaked data from the training corpus, and creators of benchmarks can help them by adding globally unique “canary strings” to the documents containing their benchmarks, which makes them easier to find [197]. More involved inter- ventions by benchmark-creators include restricting access to benchmarks over an API, or continually updating benchmarks to focus on recent data." ;
    ak:identifier "A1006_Gipiskis2024" ;
    ak:name "Preventing or mitigating data contamination and leakage" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1006_Gipiskis2024 .

mitigation:A1007_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Contamination detection"@en ;
    ak:description "Contamination detection refers to techniques for assessing whether and to what extent a given model has benchmark data in its training dataset [161, 170]. This can involve a set of technical and regulatory interventions to prevent or identify a model trained on contaminated data. For example, with web-crawled data, contamination detection can involve com- paring the data’s web sources against a dynamic, publicly available blocklist of websites known to generate new benchmarks. Additional measures may in- clude excluding data with improper metadata from the training dataset and conducting overlap analyses between the training data and all known standard benchmark datasets." ;
    ak:identifier "A1007_Gipiskis2024" ;
    ak:mitigates risk:atlas-data-contamination,
        risk:llm032025-supply-chain ;
    ak:name "Contamination detection" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1007_Gipiskis2024 .

mitigation:A1008_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Frequent benchmarking to identify when red teaming is needed"@en ;
    ak:description "Benchmarks, once created, are inexpensive to apply but may be less informative than red teaming. One reason is that sensitive data (e.g., relating to CBRN- related capabilities) cannot be included in the public questions and answers of benchmarks. On the other hand, red teaming can be more accurate given par- ticipants with diverse attack strategies, but it requires more resources to execute than benchmarking. If there is a correlation between benchmarking and red- teaming scores, then employing frequent benchmarking during the development of the model can identify arising vulnerabilities and inform the developers when more thorough red teaming is required [21]. Benchmarks can act as early warning signs of a larger issue, and red teaming can then be employed to investigate the severity and extent of such an issue." ;
    ak:identifier "A1008_Gipiskis2024" ;
    ak:name "Frequent benchmarking to identify when red teaming is needed" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1008_Gipiskis2024 .

mitigation:A1009_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Test robustness of GPAI system on relevant benchmarks"@en ;
    ak:description "Various benchmarks [52, 236] have been developed to assess the robustness of GPAI systems when deployed in environments or scenarios that differ from their training conditions. These benchmarks typically evaluate the model’s ability to handle variations in inputs, unexpected data distributions, or adversarial examples, aiming to ensure reliable performance outside the original training domain." ;
    ak:identifier "A1009_Gipiskis2024" ;
    ak:name "Test robustness of GPAI system on relevant benchmarks" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1009_Gipiskis2024 .

mitigation:A1010_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Benchmarking"@en ;
    ak:description "Benchmarking is an evaluation method where different models are compared against a standardized dataset or a predetermined task. It allows comparison both across different models and over time, providing a reference point for model assessment. Benchmarks are usually open, where their question-answer pairs are publicly available [235]." ;
    ak:identifier "A1010_Gipiskis2024" ;
    ak:name "Benchmarking" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1010_Gipiskis2024 .

mitigation:A1011_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "GPAI models explaining model outputs in a zero-sum debate game"@en ;
    ak:description "Debate is a technique that aims to produce reliable explanations of AI model outputs that are too complicated for humans to understand, by letting two GPAI models role-playing in a debate produce an explanation in a dialogue [102]. For example, an AI model may produce an output which is time-consuming for humans to verify as doing so may require going through extensive sources. Given such an output, the developer can use two natural language AI systems in an adversarial two-player setup to explain the output. These two natural language AI systems can be copies of the AI model that produced the output. In this setup, one AI system gives a short explanation of the output. The second AI system responds to this explanation with a counter-explanation or an argument why the first explanation was not correct. This continues for a fixed number of turns, with the two AI systems pointing out inconsistencies in each others’ explanations. After this sequence of statements, a human or an AI judge evaluates the ex- planations of both AI systems to determine which one is more convincing. The results of this debate can then be used for further training of the models via reinforcement learning, where outputs that are more truthful and convincing arguments and explanations are positively reinforced, while misleading or false outputs are negatively reinforced." ;
    ak:identifier "A1011_Gipiskis2024" ;
    ak:name "GPAI models explaining model outputs in a zero-sum debate game" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1011_Gipiskis2024 .

mitigation:A1012_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Using an AI model to evaluate AI model outputs"@en ;
    ak:description "In cases where the outputs of AI models cannot be easily evaluated, AI mod- els can be used to evaluate their outputs or the outputs of other AI models [82, 16, 17, 91]. The evaluations can then provide a training signal to improve the original model’s performance or offer explanations of the output for human users." ;
    ak:identifier "A1012_Gipiskis2024" ;
    ak:mitigates risk:atlas-improper-retraining,
        risk:llm032025-supply-chain ;
    ak:name "Using an AI model to evaluate AI model outputs" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1012_Gipiskis2024 .

mitigation:A1013_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Frequent testing when scaling model or dataset"@en ;
    ak:description "Testing models after significant increases in compute, data, or model parame- ters. Even relatively small changes to model or dataset size can introduce new properties (“emergent abilities”) and failure modes. Identifying them early can prevent the models from being released prematurely" ;
    ak:identifier "A1013_Gipiskis2024" ;
    ak:name "Frequent testing when scaling model or dataset" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1013_Gipiskis2024 .

mitigation:A1014_Gipiskis2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Tamper-resistant safeguards for open-weight models"@en ;
    ak:description "Training and implementing safeguards can improve the robustness of open- weight models against modifications from fine-tuning or other methods to change the learned weights of the models, especially those aimed at removing safety re- strictions. These safeguards can be resilient even after extensive fine-tuning, ensuring that the model retains its protective measures [199]." ;
    ak:identifier "A1014_Gipiskis2024" ;
    ak:name "Tamper-resistant safeguards for open-weight models" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1014_Gipiskis2024 .

mitigation:A1015_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Robustness Certificates"@en ;
    ak:description "A model can be certified to withstand adversarial attacks given specific data- point constraints, model constraints, and attack vectors [156, 124]. Certification means that it can be both analytically proven and shown empirically that the model will withstand such attacks up to a certain threshold. Currently, robustness certification methods are limited to certifying against at- tacks via manipulation of pixels on specific lp norms, canonically the l2 (Eu- clidean) norm, up to a certain neighborhood radius." ;
    ak:identifier "A1015_Gipiskis2024" ;
    ak:name "Robustness Certificates" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1015_Gipiskis2024 .

mitigation:A1016_Gipiskis2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Documentation of data collection, annotation, maintenance practices"@en ;
    ak:description "Dataset collection, annotation, and maintenance processes can be documented in detail, including potential unintentional misuse scenarios and corresponding recommendations for data usage [80, 175, 99]. This contributes to transparency, ensures that inherent dataset limitations are known in advance, and helps in selecting the right datasets for intended use cases." ;
    ak:identifier "A1016_Gipiskis2024" ;
    ak:name "Documentation of data collection, annotation, maintenance practices" ;
    ak:source "https://arxiv.org/abs/2410.23472"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1016_Gipiskis2024 .

mitigation:A1018_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Advanced model access for vetted external researchers"@en ;
    ak:description "Examples of advanced access rights could include any of the following: increased control over sampling, access to fine-tuning functionality, the ability to inspect and modify model internals, access to training data, or additional features like stable model versions." ;
    ak:identifier "A1018_Uuk2024" ;
    ak:name "Advanced model access for vetted external researchers" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1018_Uuk2024 .

mitigation:A1019_Uuk2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adversarial Robustness"@en ;
    ak:description "State-of-the-art methods such as adversarial training to make models robust to adversarial attacks (e.g., jailbreaking)." ;
    ak:identifier "A1019_Uuk2024" ;
    ak:mitigates risk:atlas-jailbreaking,
        risk:llm01-prompt-injection ;
    ak:name "Adversarial Robustness" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1019_Uuk2024 .

mitigation:A1020_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Bug bounty programs"@en ;
    ak:description "Clear and user-friendly bug bounty programs that acknowledge and reward individuals for reporting model vulnerabilities and dangerous capabilities." ;
    ak:identifier "A1020_Uuk2024" ;
    ak:name "Bug bounty programs" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1020_Uuk2024 .

mitigation:A1021_Uuk2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Capability restrictions"@en ;
    ak:description "Restricting risky capabilities of deployed models, such as advanced autonomy (e.g., self-assigning new sub-goals, executing long-horizon tasks) or tool use functionalities (e.g., function calls, web browsing)." ;
    ak:identifier "A1021_Uuk2024" ;
    ak:name "Capability restrictions" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1021_Uuk2024 .

mitigation:A1022_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data curation"@en ;
    ak:description "Careful data curation prior to all development stages (including fine-tuning) to filter out high-risk content and ensure the training data is sufficiently high-quality." ;
    ak:identifier "A1022_Uuk2024" ;
    ak:mitigates risk:atlas-data-curation,
        risk:llm032025-supply-chain ;
    ak:name "Data curation" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1022_Uuk2024 .

mitigation:A1023_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Deploying powerful models in stages"@en ;
    ak:description "Starting with a small number of applications and fewer users, and gradually scaling up API-access as rigorous monitoring increases confidence in the model's safety. An API-mediated staged release would also be required before open-sourcing a model." ;
    ak:identifier "A1023_Uuk2024" ;
    ak:name "Deploying powerful models in stages" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1023_Uuk2024 .

mitigation:A1024_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External assessment of testing procedure"@en ;
    ak:description "Bringing in external AI evaluation firms before deployment to assess and red-team the company's execution of dangerous capabilities evaluations." ;
    ak:identifier "A1024_Uuk2024" ;
    ak:name "External assessment of testing procedure" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1024_Uuk2024 .

mitigation:A1025_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fine-tuning restrictions"@en ;
    ak:description "Restricting or closely monitoring fine-tuning access to models to ensure safeguards remain intact." ;
    ak:identifier "A1025_Uuk2024" ;
    ak:name "Fine-tuning restrictions" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1025_Uuk2024 .

mitigation:A1026_Uuk2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Harmlessness training"@en ;
    ak:description "State-of-the-art reinforcement learning and fine-tuning techniques, such as Reinforcement Learning from Human Feedback (RLHF) or Direct Preference Optimization (DPO), to ensure models do not engage in unsafe behavior." ;
    ak:identifier "A1026_Uuk2024" ;
    ak:name "Harmlessness training" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1026_Uuk2024 .

mitigation:A1027_Uuk2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Input and output filtering"@en ;
    ak:description "Monitoring for dangerous outputs (e.g., code that appears to be malware or viral genome sequences) and inputs that violate acceptable use policies to ensure models do not engage in harmful behavior." ;
    ak:identifier "A1027_Uuk2024" ;
    ak:mitigates risk:atlas-harmful-code-generation,
        risk:llm092025-misinformation ;
    ak:name "Input and output filtering" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1027_Uuk2024 .

mitigation:A1028_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Intolerable risk thresholds"@en ;
    ak:description "Assessing and monitoring AI models with regard to red-line risk or capability thresholds set by a third-party, such as a standardization organization or regulator. Companies would further need to make technical, legal, and organizational preparations to halt development and deployment immediately when a breach occurs." ;
    ak:identifier "A1028_Uuk2024" ;
    ak:name "Intolerable risk thresholds" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1028_Uuk2024 .

mitigation:A1029_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "KYC screenings"@en ;
    ak:description "Know-your-customer (KYC) screenings before granting access to models with very high misuse potential or to users producing large amounts of output." ;
    ak:identifier "A1029_Uuk2024" ;
    ak:name "KYC screenings" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1029_Uuk2024 .

mitigation:A1030_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-deployment risk assessments"@en ;
    ak:description "Comprehensive risk assessments before deployment that would assess reasonably foreseeable misuse and include dangerous capability evaluations that incorporate post-training enhancements and collaborations with domain experts. Risk assessments would inform deployment decisions." ;
    ak:identifier "A1030_Uuk2024" ;
    ak:name "Pre-deployment risk assessments" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1030_Uuk2024 .

mitigation:A1031_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-development risk assessments"@en ;
    ak:description "Comprehensive risk assessments based on forecasted capabilities before training new models. Risk assessments would inform impactful development decisions." ;
    ak:identifier "A1031_Uuk2024" ;
    ak:name "Pre-development risk assessments" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1031_Uuk2024 .

mitigation:A1032_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-registration of large training runs"@en ;
    ak:description "Registering upcoming training runs above a certain size with an appropriate state actor. Such reports could include descriptions of architecture, training compute, data collection and curation, training objectives and techniques, and planned risk management procedures." ;
    ak:identifier "A1032_Uuk2024" ;
    ak:name "Pre-registration of large training runs" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1032_Uuk2024 .

mitigation:A1033_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Prohibiting high-stakes applications"@en ;
    ak:description "Enforcing use policies that prohibit high-stakes applications. Requires Know-Your-Customer procedures." ;
    ak:identifier "A1033_Uuk2024" ;
    ak:name "Prohibiting high-stakes applications" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1033_Uuk2024 .

mitigation:A1034_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk-focused governance structures"@en ;
    ak:description "Companies adopt practices typical of high-reliability organizations (HROs), including board risk committees, chief risk officers, multi-party authorization requirements, ethics boards for reviewing development and deployment decisions, and internal audit teams that report directly to the board, tasked with auditing risk management practices." ;
    ak:identifier "A1034_Uuk2024" ;
    ak:name "Risk-focused governance structures" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1034_Uuk2024 .

mitigation:A1035_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety Drills"@en ;
    ak:description "Regularly practicing the implementation of an emergency response plan to stress test the organization's ability to respond to reasonably foreseeable, fast-moving emergency scenarios." ;
    ak:identifier "A1035_Uuk2024" ;
    ak:name "Safety Drills" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1035_Uuk2024 .

mitigation:A1036_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety incident reports and security information sharing"@en ;
    ak:description "Disclosing reports about AI incidents, such as concrete harms and near misses as well as cyber threat intelligence and security incident reports with appropriate stakeholders such as select governments." ;
    ak:identifier "A1036_Uuk2024" ;
    ak:name "Safety incident reports and security information sharing" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1036_Uuk2024 .

mitigation:A1037_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety incident reports and security information sharing"@en ;
    ak:description "Disclosing reports about AI incidents, such as concrete harms and near misses as well as cyber threat intelligence and security incident reports with appropriate stakeholders such as select governments." ;
    ak:identifier "A1037_Uuk2024" ;
    ak:name "Safety incident reports and security information sharing" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1037_Uuk2024 .

mitigation:A1038_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety vs. capabilities investments"@en ;
    ak:description "A significant fraction of employees and computational resources are dedicated to enhancing model safety rather than advancing its capabilities." ;
    ak:identifier "A1038_Uuk2024" ;
    ak:name "Safety vs. capabilities investments" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1038_Uuk2024 .

mitigation:A1039_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Sharing safety cases"@en ;
    ak:description "Disclosing to a regulator how high-stakes decisions regarding model development and deployment are made." ;
    ak:identifier "A1039_Uuk2024" ;
    ak:name "Sharing safety cases" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1039_Uuk2024 .

mitigation:A1040_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third party pre-deployment model audits"@en ;
    ak:description "External pre-deployment assessment to provide a judgment on the safety of a model. Auditors, which could be governments or independent third parties, would receive access to a fine-tuning API for testing, or further appropriate technical means." ;
    ak:identifier "A1040_Uuk2024" ;
    ak:name "Third party pre-deployment model audits" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1040_Uuk2024 .

mitigation:A1041_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Transparent governance structures"@en ;
    ak:description "Disclosing to a regulator how high-stakes decisions regarding model development and deployment are made." ;
    ak:identifier "A1041_Uuk2024" ;
    ak:name "Transparent governance structures" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1041_Uuk2024 .

mitigation:A1042_Uuk2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Unlearning Techniques"@en ;
    ak:description "Removing specific harmful capabilities (e.g., pathogen design) from models using unlearning techniques." ;
    ak:identifier "A1042_Uuk2024" ;
    ak:name "Unlearning Techniques" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1042_Uuk2024 .

mitigation:A1043_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vetted researcher access"@en ;
    ak:description "Giving good faith, public interest evaluation researchers access to black-box research APIs that provide technical and legal safe harbours to limit barriers imposed by usage policy enforcement, logging, and stringent terms of service." ;
    ak:identifier "A1043_Uuk2024" ;
    ak:name "Vetted researcher access" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1043_Uuk2024 .

mitigation:A1044_Uuk2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Whistleblower protections"@en ;
    ak:description "Refraining from restrictive non-disparagement agreements and instantiating comprehensive whistleblower protection policies that clearly outline relevant reporting processes, protection mechanisms, and non-retaliation assurances." ;
    ak:identifier "A1044_Uuk2024" ;
    ak:name "Whistleblower protections" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A1044_Uuk2024 .

mitigation:A1045_Uuk2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Advanced information security"@en ;
    ak:description "Implementing advanced cybersecurity measures and insider threat safeguards to protect proprietary and unreleased model weights." ;
    ak:identifier "A1045_Uuk2024" ;
    ak:name "Advanced information security" ;
    ak:source "https://doi.org/10.48550/arXiv.2412.02145"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
