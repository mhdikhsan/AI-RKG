        owl:NamedIndividual ;
    rdfs:label "Downstream Impact Verification"@en ;
    ak:description "Verify that downstream GAI system impacts (such as the use of third-party plugins) are included in the impact documentation process." ;
    ak:identifier "A0423_NIST2024" ;
    ak:name "Downstream Impact Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
