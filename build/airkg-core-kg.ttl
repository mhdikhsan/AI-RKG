        owl:NamedIndividual ;
    rdfs:label "Internal review"@en ;
    ak:description "Information regarding internal review mechanisms and audit functions that are relevant to decisions about the development and deployment of highly capable AI models. This includes ethics boards, board risk committees, and audit functions that test risk management practices." ;
    ak:identifier "A0122_Future_of_Life_Institute2024" ;
    ak:name "Internal review" ;
