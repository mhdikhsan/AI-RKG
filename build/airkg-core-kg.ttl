mitigation:A0116_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Government access to AI systems"@en ;
    ak:description "Is the firm proactively granting government officials free access to its most capable systems so the government can better understand what the technology is capable of?" ;
    ak:identifier "A0116_Future_of_Life_Institute2024" ;
    ak:name "Government access to AI systems" ;
