mitigation:A0170_Future_of_Life_Institute2024 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Testimonies to policymakers"@en ;
    ak:description "Public information related to direct communication with policymakers. We note whether company leadership used the opportunity to inform policymakers about the potential for catastrophic risks from advanced AI. Note that we have selected the most explicit risk-related statements. These do reflect overall communication strategies." ;
    ak:identifier "A0170_Future_of_Life_Institute2024" ;
    ak:name "Testimonies to policymakers" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
