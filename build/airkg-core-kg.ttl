    skos:exactMatch nexus:A0732_NIST2024 .

mitigation:A0733_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Human-AI Configuration"@en ;
    ak:description "Use feedback from internal and external AI Actors, users, individuals, and communities, to assess impact of AI-generated content. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0733_NIST2024" ;
    ak:name "Human-AI Configuration" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0733_NIST2024 .

mitigation:A0734_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Information Integrity"@en ;
    ak:description "Use real-time auditing tools where they can be demonstrated to aid in the tracking and validation of the lineage and authenticity of AI-generated data. (AI Deployment, AI Impact Assessment, Governance and Oversight, Operation and Monitoring)." ;
    ak:identifier "A0734_NIST2024" ;
    ak:name "Information Integrity" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
