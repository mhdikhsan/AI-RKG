ak:mitigatedBy a owl:ObjectProperty ;
    rdfs:domain ak:Risk ;
    rdfs:range ak:Mitigation ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf ak:mitigates .

ak:mobile_app a ak:DeploymentEnvironment ;
    ak:name "Mobile App" .

ak:motif1 a ak:RiskMotif ;
    ak:description "A large language model (LLM) is used to infer on data supplied by a user" ;
    ak:hasManifestCondition ak:motif1_input ;
    ak:identifier "M-001" ;
    ak:inContext ak:motif1_architeture ;
    ak:indicatesRisk ak:prompt_injection ;
    ak:name "LLLM infer on supplied data" .

ak:motif2 a ak:RiskMotif ;
    ak:description "A large language model (LLM) is used to infer on personal data supplied by a user" ;
    ak:hasManifestCondition ak:motif2_output,
        ak:motif2_stored ;
    ak:identifier "M-002" ;
    ak:inContext ak:motif2_architeture,
        ak:personal_data ;
    ak:indicatesRisk ak:sensitive_data_exposure ;
    ak:name "LLLM infer on supplied personal data" .

ak:motif3 a ak:RiskMotif ;
    ak:description "required explainable for decision from LLM output in financial domain" ;
    ak:hasManifestCondition ak:motif3_output ;
    ak:identifier "M-003" ;
    ak:inContext ak:financial_services,
        ak:motif3_architecture ;
    ak:indicatesRisk ak:unexplainable_output ;
    ak:name "LLM use in financial services domain" .

