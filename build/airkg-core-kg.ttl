mitigation:A0163_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Windfall Plan"@en ;
    ak:description "Rapid advances in AI could lead to immense power concentration. Has your organization made any preparations for future scenarios in which the firm experiences extreme windfall profits? Has the organization developed a plan for redistributing vast resources to all of humanity?" ;
    ak:identifier "A0163_Future_of_Life_Institute2024" ;
    ak:name "Windfall Plan" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0163_Future_of_Life_Institute2024 .

mitigation:A0164_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Chief Risk Officer (CRO)"@en ;
    ak:identifier "A0164_Future_of_Life_Institute2024" ;
