mitigation:A0143_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Protections that guard critical decisions against stakeholder pressure"@en ;
    ak:description "Is your firm's governance structure set up in a way that would allow its leadership to prioritize safety in critical situations even if such a decision runs counter to the profit incentive (e.g., choosing not to deploy very capable yet critically dangerous AI systems)? Are there any protections that guard such decisions against shareholder pressure (e.g., in the form of lawsuits)? Are shareholders briefed that such situations might arise in the future? Please describe how your firm prioritizes safety (e.g., relevant policies, legal structure, etc.)." ;
    ak:identifier "A0143_Future_of_Life_Institute2024" ;
    ak:name "Protections that guard critical decisions against stakeholder pressure" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0143_Future_of_Life_Institute2024 .

mitigation:A0144_Future_of_Life_Institute2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Public explanation of governance structure"@en ;
    ak:description "Has your organization released a public resource explaining the firm’s governance structure? Such a resource should make transparent how important decisions regarding the development and deployment of frontier AI models are made. If yes, please share a URL." ;
    ak:identifier "A0144_Future_of_Life_Institute2024" ;
    ak:name "Public explanation of governance structure" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0144_Future_of_Life_Institute2024 .

