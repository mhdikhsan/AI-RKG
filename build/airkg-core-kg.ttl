        owl:NamedIndividual ;
    rdfs:label "Internal red teaming exercises for cybersecurity infrastructure"@en ;
    ak:identifier "A0166_Future_of_Life_Institute2024" ;
    ak:name "Internal red teaming exercises for cybersecurity infrastructure" ;
