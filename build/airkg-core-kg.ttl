        owl:NamedIndividual ;
    rdfs:label "CBRN Information or Capabilities; Confabulation"@en ;
    ak:description "Use organizational risk tolerance to evaluate acceptable risks and performance metrics and decommission or retrain pre-trained models that perform outside of defined limits." ;
    ak:identifier "A0750_NIST2024" ;
    ak:name "CBRN Information or Capabilities; Confabulation" ;
