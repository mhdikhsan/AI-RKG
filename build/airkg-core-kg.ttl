    skos:exactMatch nexus:A0170_Future_of_Life_Institute2024 .

mitigation:A0171_Schuett2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Alignment Techniques"@en ;
    ak:description "AGI labs should implement state-of-the-art safety and alignment techniques." ;
    ak:identifier "A0171_Schuett2023" ;
    ak:name "Alignment Techniques" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0171_Schuett2023 .

mitigation:A0172_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "API access to powerful models"@en ;
    ak:description "AGI labs should strongly consider only deploying powerful models via an application programming interface (API)." ;
    ak:identifier "A0172_Schuett2023" ;
    ak:name "API access to powerful models" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0172_Schuett2023 .

mitigation:A0173_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Avoid Capabilities Jumps"@en ;
    ak:description "AGI labs should not deploy models that are much more capable than any existing models.*" ;
    ak:identifier "A0173_Schuett2023" ;
    ak:name "Avoid Capabilities Jumps" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0173_Schuett2023 .

mitigation:A0174_Schuett2023 a ak:Mitigation,
        owl:NamedIndividual ;
    rdfs:label "Avoiding Hype"@en ;
    ak:description "AGI labs should avoid releasing powerful models in a way that is likely to create hype around AGI (e.g. by overstating results or announcing them in attention-grabbing ways)." ;
    ak:identifier "A0174_Schuett2023" ;
    ak:name "Avoiding Hype" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0174_Schuett2023 .

mitigation:A0175_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Background checks"@en ;
    ak:description "AGI labs should perform rigorous background checks before hiring/appointing members of the board of directors, senior executives, and key employees.*" ;
    ak:identifier "A0175_Schuett2023" ;
    ak:name "Background checks" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0175_Schuett2023 .

mitigation:A0176_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Board risk committee"@en ;
    ak:description "AGI labs should have a board risk committee, i.e. a permanent committee within the board of directors which oversees the lab’s risk management practices.*" ;
    ak:identifier "A0176_Schuett2023" ;
    ak:name "Board risk committee" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0176_Schuett2023 .

mitigation:A0177_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Bug bounty programs"@en ;
    ak:description "AGI labs should have bug bounty programs, i.e. recognize and compensate people for reporting unknown vulnerabilities and dangerous capabilities." ;
    ak:identifier "A0177_Schuett2023" ;
    ak:name "Bug bounty programs" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0177_Schuett2023 .

mitigation:A0178_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Dangerous capability evaluations"@en ;
    ak:description "AGI labs should run evaluations to assess their models’ dangerous capabilities (e.g. misuse potential, ability to manipulate, and power-seeking behavior)." ;
    ak:identifier "A0178_Schuett2023" ;
    ak:name "Dangerous capability evaluations" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0178_Schuett2023 .

mitigation:A0179_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Dual control"@en ;
    ak:description "Critical decisions in model development and deployment should be made by at least two people (e.g. promotion to production, changes to training datasets, or modifications to production).*" ;
    ak:identifier "A0179_Schuett2023" ;
    ak:name "Dual control" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0179_Schuett2023 .

mitigation:A0180_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Emergency response plan"@en ;
    ak:description "AGI labs should have and practice implementing an emergency response plan. This might include switching off systems, overriding their outputs, or restricting access." ;
    ak:identifier "A0180_Schuett2023" ;
    ak:name "Emergency response plan" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0180_Schuett2023 .

mitigation:A0181_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Enterprise risk management"@en ;
    ak:description "AGI labs should implement an enterprise risk management (ERM) framework (e.g. the NIST AI Risk Management Framework or ISO 31000). This framework should be tailored to an AGI context and primarily focus on the lab’s impact on society." ;
    ak:identifier "A0181_Schuett2023" ;
    ak:name "Enterprise risk management" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0181_Schuett2023 .

mitigation:A0182_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Gradual scaling"@en ;
    ak:description "AGI labs should only gradually increase the amount of compute used for their largest training runs." ;
    ak:identifier "A0182_Schuett2023" ;
    ak:name "Gradual scaling" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0182_Schuett2023 .

mitigation:A0183_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Increasing levels of external scrutiny"@en ;
    ak:description "AGI labs should increase the level of external scrutiny in proportion to the capabilities of their models." ;
    ak:identifier "A0183_Schuett2023" ;
    ak:name "Increasing levels of external scrutiny" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0183_Schuett2023 .

mitigation:A0184_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Industry sharing of security information"@en ;
    ak:description "AGI labs should share threat intelligence and information about security incidents with each other.*" ;
    ak:identifier "A0184_Schuett2023" ;
    ak:name "Industry sharing of security information" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0184_Schuett2023 .

mitigation:A0185_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Internal audit"@en ;
    ak:description "AGI labs should have an internal audit team, i.e. a team which assesses the effectiveness of the lab’s risk management practices. This team must be organizationally independent from senior management and report directly to the board of directors." ;
    ak:identifier "A0185_Schuett2023" ;
    ak:name "Internal audit" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0185_Schuett2023 .

mitigation:A0186_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Internal review before publications"@en ;
    ak:description "Before publishing research, AGI labs should conduct an internal review to assess potential harms." ;
    ak:identifier "A0186_Schuett2023" ;
    ak:name "Internal review before publications" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0186_Schuett2023 .

mitigation:A0187_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "KYC screening"@en ;
    ak:description "AGI labs should conduct know-your-customer (KYC) screenings before giving people the ability to use powerful models.*" ;
    ak:identifier "A0187_Schuett2023" ;
    ak:name "KYC screening" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0187_Schuett2023 .

mitigation:A0188_Schuett2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Military-grade information security"@en ;
    ak:description "The information security of AGI labs should be proportional to the capabilities of their models, eventually matching or exceeding that of intelligence agencies (e.g. sufficient to defend against nation states)." ;
    ak:identifier "A0188_Schuett2023" ;
    ak:name "Military-grade information security" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0188_Schuett2023 .

mitigation:A0189_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Model containment"@en ;
    ak:description "AGI labs should contain models with sufficiently dangerous capabilities (e.g. via boxing or air-gapping)." ;
    ak:identifier "A0189_Schuett2023" ;
    ak:name "Model containment" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0189_Schuett2023 .

mitigation:A0190_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitor systems and their uses"@en ;
    ak:description "AGI labs should closely monitor deployed systems, including how they are used and what impact they have on society." ;
    ak:identifier "A0190_Schuett2023" ;
    ak:name "Monitor systems and their uses" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0190_Schuett2023 .

mitigation:A0191_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Monitor systems and their uses"@en ;
    ak:description "AGI labs should closely monitor deployed systems, including how they are used and what impact they have on society." ;
    ak:identifier "A0191_Schuett2023" ;
    ak:name "Monitor systems and their uses" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0191_Schuett2023 .

mitigation:A0192_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "No unsafe open-sourcing"@en ;
    ak:description "AGI labs should not open-source powerful models, unless they can demonstrate that it is sufficiently safe to do so." ;
    ak:identifier "A0192_Schuett2023" ;
    ak:name "No unsafe open-sourcing" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0192_Schuett2023 .

mitigation:A0193_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Notify a state actor before deployment"@en ;
    ak:description "AGI labs should notify appropriate state actors before deploying powerful models." ;
    ak:identifier "A0193_Schuett2023" ;
    ak:name "Notify a state actor before deployment" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0193_Schuett2023 .

mitigation:A0194_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Notify affected parties"@en ;
    ak:description "AGI labs should notify parties who will be negatively affected by a powerful model before deploying it.*" ;
    ak:identifier "A0194_Schuett2023" ;
    ak:name "Notify affected parties" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0194_Schuett2023 .

mitigation:A0195_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pausing Training of Dangerous Models"@en ;
    ak:description "AGI labs should pause the development process if sufficiently dangerous capabilities are detected." ;
    ak:identifier "A0195_Schuett2023" ;
    ak:name "Pausing Training of Dangerous Models" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0195_Schuett2023 .

mitigation:A0196_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Post-deployment evaluations"@en ;
    ak:description "AGI labs should continually evaluate models for dangerous capabilities after deployment, taking into account new information about the model’s capabilities and how it is being used.*" ;
    ak:identifier "A0196_Schuett2023" ;
    ak:name "Post-deployment evaluations" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0196_Schuett2023 .

mitigation:A0197_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-deployment risk assessment"@en ;
    ak:description "AGI labs should take extensive measures to identify, analyze, and evaluate risks from powerful models before deploying them." ;
    ak:identifier "A0197_Schuett2023" ;
    ak:name "Pre-deployment risk assessment" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0197_Schuett2023 .

mitigation:A0198_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-training risk assessment"@en ;
    ak:description "AGI labs should conduct a risk assessment before training powerful models." ;
    ak:identifier "A0198_Schuett2023" ;
    ak:name "Pre-training risk assessment" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0198_Schuett2023 .

mitigation:A0199_Schuett2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Protection against espionage"@en ;
    ak:description "AGI labs should take adequate measures to tackle the risk of state-sponsored or industrial espionage.*" ;
    ak:identifier "A0199_Schuett2023" ;
    ak:name "Protection against espionage" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0199_Schuett2023 .

mitigation:A0200_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Publish alignment strategy"@en ;
    ak:description "AGI labs should publish their strategies for ensuring that their systems are safe and aligned.*" ;
    ak:identifier "A0200_Schuett2023" ;
    ak:name "Publish alignment strategy" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0200_Schuett2023 .

mitigation:A0201_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Publish internal risk assessment results"@en ;
    ak:description "AGI labs should publish the results or summaries of internal risk assessments, unless this would unduly reveal proprietary information or itself produce significant risk. This should include a justification of why the lab is willing to accept remaining risks.*" ;
    ak:identifier "A0201_Schuett2023" ;
    ak:name "Publish internal risk assessment results" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0201_Schuett2023 .

mitigation:A0202_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Publish results of external scrutiny"@en ;
    ak:description "AGI labs should publish the results or summaries of external scrutiny efforts, unless this would unduly reveal proprietary information or itself produce significant risk.*" ;
    ak:identifier "A0202_Schuett2023" ;
    ak:name "Publish results of external scrutiny" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0202_Schuett2023 .

mitigation:A0203_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Publish views about AGI risk"@en ;
    ak:description "AGI labs should make public statements about their views on the risks and benefits from AGI, including the level of risk they are willing to take in its development." ;
    ak:identifier "A0203_Schuett2023" ;
    ak:name "Publish views about AGI risk" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0203_Schuett2023 .

mitigation:A0204_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Red teaming"@en ;
    ak:description "AGI labs should commission external red teams before deploying powerful models." ;
    ak:identifier "A0204_Schuett2023" ;
    ak:name "Red teaming" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0204_Schuett2023 .

mitigation:A0205_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Report safety incidents"@en ;
    ak:description "AGI labs should report accidents and near misses to appropriate state actors and other AGI labs (e.g. via an AI incident database)." ;
    ak:identifier "A0205_Schuett2023" ;
    ak:name "Report safety incidents" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0205_Schuett2023 .

mitigation:A0206_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Researcher model access"@en ;
    ak:description "AGI labs should give independent researchers API access to deployed models." ;
    ak:identifier "A0206_Schuett2023" ;
    ak:name "Researcher model access" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0206_Schuett2023 .

mitigation:A0207_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety Restrictions"@en ;
    ak:description "AGI labs should establish appropriate safety restrictions for powerful models after deployment (e.g. restrictions on who can use the model, how they can use the model, and whether the model can access the internet)." ;
    ak:identifier "A0207_Schuett2023" ;
    ak:mitigates risk:atlas-data-acquisition,
        risk:atlas-data-usage-rights,
        risk:llm032025-supply-chain ;
    ak:name "Safety Restrictions" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0207_Schuett2023 .

mitigation:A0208_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Safety vs. capabilities"@en ;
    ak:description "A significant fraction of employees of AGI labs should work on enhancing model safety and alignment rather than capabilities." ;
    ak:identifier "A0208_Schuett2023" ;
    ak:name "Safety vs. capabilities" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0208_Schuett2023 .

mitigation:A0209_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security incident response plan"@en ;
    ak:description "AGI labs should have a plan for how they respond to security incidents (e.g. cyberattacks).*" ;
    ak:identifier "A0209_Schuett2023" ;
    ak:name "Security incident response plan" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0209_Schuett2023 .

mitigation:A0210_Schuett2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Security standards"@en ;
    ak:description "AGI labs should comply with information security standards (e.g. ISO/IEC 27001 or NIST Cybersecurity Framework). These standards need to be tailored to an AGI context." ;
    ak:identifier "A0210_Schuett2023" ;
    ak:name "Security standards" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0210_Schuett2023 .

mitigation:A0211_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Staged deployment"@en ;
    ak:description "AGI labs should deploy powerful models in stages. They should start with a small number of applications and fewer users, gradually scaling up as confidence in the model’s safety increases." ;
    ak:identifier "A0211_Schuett2023" ;
    ak:name "Staged deployment" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0211_Schuett2023 .

mitigation:A0212_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Statement about governance structure"@en ;
    ak:description "AGI labs should make public statements about how they make high-stakes decisions regarding model development and deployment.*" ;
    ak:identifier "A0212_Schuett2023" ;
    ak:mitigates risk:atlas-spreading-disinformation,
        risk:llm092025-misinformation ;
    ak:name "Statement about governance structure" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0212_Schuett2023 .

mitigation:A0213_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-party governance audits"@en ;
    ak:description "AGI labs should commission third-party audits of their governance structures.*" ;
    ak:identifier "A0213_Schuett2023" ;
    ak:name "Third-party governance audits" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0213_Schuett2023 .

mitigation:A0214_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-party model audits"@en ;
    ak:description "AGI labs should commission third-party model audits before deploying powerful models." ;
    ak:identifier "A0214_Schuett2023" ;
    ak:name "Third-party model audits" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0214_Schuett2023 .

mitigation:A0215_Schuett2023 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Tracking model weights"@en ;
    ak:description "AGI labs should have a system that is intended to track all copies of the weights of powerful models.*" ;
    ak:identifier "A0215_Schuett2023" ;
    ak:name "Tracking model weights" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0215_Schuett2023 .

mitigation:A0216_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Treat updates similarly to new models"@en ;
    ak:description "AGI labs should treat significant updates to a deployed model (e.g. additional fine-tuning) similarly to its initial development and deployment. In particular, they should repeat the pre-deployment risk assessment." ;
    ak:identifier "A0216_Schuett2023" ;
    ak:name "Treat updates similarly to new models" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0216_Schuett2023 .

mitigation:A0217_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Chief risk officer"@en ;
    ak:description "AGI labs should have a chief risk officer (CRO), i.e. a senior executive who is responsible for risk management." ;
    ak:identifier "A0217_Schuett2023" ;
    ak:name "Chief risk officer" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0217_Schuett2023 .

mitigation:A0218_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Inter-lab scrutinies"@en ;
    ak:description "AGI labs should allow researchers from other labs to scrutinize powerful models before deployment.*" ;
    ak:identifier "A0218_Schuett2023" ;
    ak:name "Inter-lab scrutinies" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0218_Schuett2023 .

mitigation:A0219_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Internal deployments = external deployments"@en ;
    ak:description "AGI labs should treat internal deployments (e.g. using models for writing code) similarly to external deployments. In particular, they should perform a pre-deployment risk assessment." ;
    ak:identifier "A0219_Schuett2023" ;
    ak:name "Internal deployments = external deployments" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0219_Schuett2023 .

mitigation:A0220_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Notify other labs"@en ;
    ak:description "AGI labs should notify other labs before deploying powerful models.*" ;
    ak:identifier "A0220_Schuett2023" ;
    ak:name "Notify other labs" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0220_Schuett2023 .

mitigation:A0221_Schuett2023 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Pre-registration of large training runs"@en ;
    ak:description "AGI labs should register upcoming training runs above a certain size with an appropriate state actor." ;
    ak:identifier "A0221_Schuett2023" ;
    ak:name "Pre-registration of large training runs" ;
    ak:source "https://arxiv.org/abs/2305.07153"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0221_Schuett2023 .

mitigation:A0250_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Annual third-party audit"@en ;
    ak:description "The bill would require a developer, beginning January 1, 2026, to annually retain a third-party auditor to perform an independent audit of compliance with those provisions, as prescribed. The bill would require the auditor to produce an audit report, as prescribed, and would require a developer to retain an unredacted copy of the audit report for as long as the covered model is made available for commercial, public, or foreseeably public use plus 5 years." ;
    ak:identifier "A0250_Wiener2024" ;
    ak:name "Annual third-party audit" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0250_Wiener2024 .

mitigation:A0251_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Capability to promptly enact a full shutdown"@en ;
    ak:description "When enacting a full shutdown, the developer shall take into account, as appropriate, the risk that a shutdown of the covered model, or particular covered model derivatives, could cause disruptions to critical infrastructure." ;
    ak:identifier "A0251_Wiener2024" ;
    ak:name "Capability to promptly enact a full shutdown" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0251_Wiener2024 .

mitigation:A0252_Wiener2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Cybersecurity protocols to prevent the model from being unintentionally stolen"@en ;
    ak:description "Implement reasonable administrative, technical, and physical cybersecurity protections to prevent unauthorized access to, misuse of, or unsafe post-training modifications of, the covered model and all covered model derivatives controlled by the developer that are appropriate in light of the risks associated with the covered model, including from advanced persistent threats or other sophisticated actors." ;
    ak:identifier "A0252_Wiener2024" ;
    ak:name "Cybersecurity protocols to prevent the model from being unintentionally stolen" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0252_Wiener2024 .

mitigation:A0253_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Developers “shall consider” guidance from US AISI and NIST and other reputable standard-setting organizations"@en ;
    ak:identifier "A0253_Wiener2024" ;
    ak:name "Developers “shall consider” guidance from US AISI and NIST and other reputable standard-setting organizations" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0253_Wiener2024 .

mitigation:A0254_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Implement a written safe and security plan (SSP)"@en ;
    ak:description "This bill would enact the Safe and Secure Innovation for Frontier Artificial Intelligence Models Act to, among other things, require that a developer, before beginning to initially train a covered model, as defined, comply with various requirements, including implementing the capability to promptly enact a full shutdown, as defined, and implement a written and separate safety and security protocol, as specified. (3) Implement a written and separate safety and security protocol that does all of the following: (A) Specifies protections and procedures that, if successfully implemented, would successfully comply with the developer’s duty to take reasonable care to avoid producing a covered model or covered model derivative that poses an unreasonable risk of causing or materially enabling a critical harm. (B) States compliance requirements in an objective manner and with sufficient detail and specificity to allow the developer or a third party to readily ascertain whether the requirements of the safety and security protocol have been followed. (C) Identifies a testing procedure, which takes safeguards into account as appropriate, that takes reasonable care to evaluate if both of the following are true: (i) A covered model poses an unreasonable risk of causing or enabling a critical harm. (ii) Covered model derivatives pose an unreasonable risk of causing or enabling a critical harm. (D) Describes in detail how the testing procedure assesses the risks associated with post-training modifications." ;
    ak:identifier "A0254_Wiener2024" ;
    ak:name "Implement a written safe and security plan (SSP)" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0254_Wiener2024 .

mitigation:A0255_Wiener2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Publish a redacted copy of SSP"@en ;
    ak:identifier "A0255_Wiener2024" ;
    ak:name "Publish a redacted copy of SSP" ;
    ak:source "https://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202320240SB1047"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0255_Wiener2024 .

