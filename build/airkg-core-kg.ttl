mitigation:A0424_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Provenance Method Measurement"@en ;
    ak:description "Establish policies for measuring the effectiveness of employed content provenance methodologies (e.g., cryptography, watermarking, steganography, etc.)" ;
    ak:identifier "A0424_NIST2024" ;
    ak:name "Provenance Method Measurement" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0424_NIST2024 .

mitigation:A0425_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Feedback Resource Allocation"@en ;
    ak:description "Allocate time and resources for outreach, feedback, and recourse processes in GAI system development." ;
    ak:identifier "A0425_NIST2024" ;
    ak:name "Feedback Resource Allocation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0425_NIST2024 .

mitigation:A0426_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "User Interaction Documentation"@en ;
    ak:description "Document interactions with GAI systems to users prior to interactive activities, particularly in contexts involving more significant risks." ;
    ak:identifier "A0426_NIST2024" ;
    ak:name "User Interaction Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0426_NIST2024 .

mitigation:A0427_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Content Rights Categorization"@en ;
    ak:description "Categorize different types of GAI content with associated third-party rights (e.g., copyright, intellectual property, data privacy)." ;
    ak:identifier "A0427_NIST2024" ;
    ak:name "Content Rights Categorization" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0427_NIST2024 .

mitigation:A0428_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Joint Educational Activities"@en ;
    ak:description "Conduct joint educational activities and events in collaboration with third parties to promote best practices for managing GAI risks." ;
    ak:identifier "A0428_NIST2024" ;
    ak:name "Joint Educational Activities" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0428_NIST2024 .

mitigation:A0429_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Provenance Success Metrics"@en ;
    ak:description "Develop and validate approaches for measuring the success of content provenance management efforts with third parties (e.g., incidents detected and response times)." ;
    ak:identifier "A0429_NIST2024" ;
    ak:name "Provenance Success Metrics" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0429_NIST2024 .

mitigation:A0430_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Contract and SLA Standards"@en ;
    ak:description "Draft and maintain well-defined contracts and service level agreements (SLAs) that specify content ownership, usage rights, quality standards, security requirements, and content provenance expectations for GAI systems." ;
    ak:identifier "A0430_NIST2024" ;
    ak:name "Contract and SLA Standards" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0430_NIST2024 .

mitigation:A0431_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Supplier Risk Assessment"@en ;
    ak:description "Implement a use-cased based supplier risk assessment framework to evaluate and monitor third-party entities' performance and adherence to content provenance standards and technologies to detect anomalies and unauthorized changes; services acquisition and value chain risk management; and legal compliance." ;
    ak:identifier "A0431_NIST2024" ;
    ak:name "Supplier Risk Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0431_NIST2024 .

mitigation:A0432_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Contract Evaluation Clauses"@en ;
    ak:description "Include clauses in contracts which allow an organization to evaluate third-party GAI processes and standards." ;
    ak:identifier "A0432_NIST2024" ;
    ak:name "Contract Evaluation Clauses" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0432_NIST2024 .

mitigation:A0433_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Entity Inventory"@en ;
    ak:description "Inventory all third-party entities with access to organizational content and establish approved GAI technology and service provider lists." ;
    ak:identifier "A0433_NIST2024" ;
    ak:name "Third-Party Entity Inventory" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0433_NIST2024 .

mitigation:A0434_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Change Records"@en ;
    ak:description "Maintain records of changes to content made by third parties to promote content provenance, including sources, timestamps, metadata." ;
    ak:identifier "A0434_NIST2024" ;
    ak:name "Third-Party Change Records" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0434_NIST2024 .

mitigation:A0435_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Due Diligence Process Update"@en ;
    ak:description "Update and integrate due diligence processes for GAI acquisition and procurement vendor assessments to include intellectual property, data privacy, security, and other risks. For example, update processes to: Address solutions that may rely on embedded GAI technologies; Address ongoing monitoring, assessments, and alerting, dynamic risk assessments, and real-time reporting tools for monitoring third-party GAI risks; Consider policy adjustments across GAI modeling libraries, tools and APIs, fine-tuned models, and embedded tools; Assess GAI vendors, open-source or proprietary GAI tools, or GAI service providers against incident or vulnerability databases." ;
    ak:identifier "A0435_NIST2024" ;
    ak:name "Due Diligence Process Update" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0435_NIST2024 .

mitigation:A0436_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Use Policy Update"@en ;
    ak:description "Update GAI acceptable use policies to address proprietary and open-source GAI technologies and data, and contractors, consultants, and other third-party personnel." ;
    ak:identifier "A0436_NIST2024" ;
    ak:name "Third-Party Use Policy Update" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0436_NIST2024 .

mitigation:A0437_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Value Chain Risk Documentation"@en ;
    ak:description "Document GAI risks associated with system value chain to identify over-reliance on third-party data and to identify fallbacks." ;
    ak:identifier "A0437_NIST2024" ;
    ak:mitigates risk:atlas-over-or-under-reliance,
        risk:llm052025-improper-output-handling,
        risk:llm062025-excessive-agency ;
    ak:name "Value Chain Risk Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0437_NIST2024 .

mitigation:A0438_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Incident Documentation"@en ;
    ak:description "Document incidents involving third-party GAI data and systems, including open-source data and open-source software" ;
    ak:identifier "A0438_NIST2024" ;
    ak:name "Third-Party Incident Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0438_NIST2024 .

mitigation:A0439_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Response Plans"@en ;
    ak:description "Establish incident response plans for third-party GAI technologies: Align incident response plans with impacts enumerated in MAP 5.1; Communicate third-party GAI incident response plans to all relevant AI Actors; Define ownership of GAI incident response functions; Rehearse third-party GAI incident response plans at a regular cadence; Improve incident response plans based on retrospective learning; Review incident response plans for alignment with relevant breach reporting, data protection, data privacy, or other laws." ;
    ak:identifier "A0439_NIST2024" ;
    ak:name "Third-Party Response Plans" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0439_NIST2024 .

mitigation:A0440_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Third-Party Monitoring Policy"@en ;
    ak:description "Establish policies and procedures for continuous monitoring of third-party GAI systems in deployment." ;
    ak:identifier "A0440_NIST2024" ;
    ak:name "Third-Party Monitoring Policy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0440_NIST2024 .

mitigation:A0441_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Redundancy Policy"@en ;
    ak:description "Establish policies and procedures that address GAI data redundancy, including model weights and other system artifacts." ;
    ak:identifier "A0441_NIST2024" ;
    ak:name "Data Redundancy Policy" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0441_NIST2024 .

mitigation:A0442_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Rollover and Fallback Management"@en ;
    ak:description "Establish policies and procedures to test and manage risks related to rollover and fallback technologies for GAI systems, acknowledging that rollover and fallback may include manual processing." ;
    ak:identifier "A0442_NIST2024" ;
    ak:name "Rollover and Fallback Management" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0442_NIST2024 .

mitigation:A0443_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Vendor Contract Review"@en ;
    ak:description "Review vendor contracts and avoid arbitrary or capricious termination of critical GAI technologies or vendor services and non-standard terms that may amplify or defer liability in unexpected ways and/or contribute to unauthorized data collection by vendors or third-parties (e.g., secondary data use). Consider: Clear assignment of liability and responsibility for incidents, GAI system changes over time (e.g., fine-tuning, drift, decay); Request: Notification and disclosure for serious incidents arising from third-party data and systems; Service Level Agreements (SLAs) in vendor contracts that address incident response, response times, and availability of critical support." ;
    ak:identifier "A0443_NIST2024" ;
    ak:name "Vendor Contract Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0443_NIST2024 .

mitigation:A0444_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Purpose Identification Factors"@en ;
    ak:description "When identifying intended purposes, consider factors such as internal vs. external use, narrow vs. broad application scope, fine-tuning, and varieties of data sources (e.g., grounding, retrieval-augmented generation)." ;
    ak:identifier "A0444_NIST2024" ;
    ak:name "Purpose Identification Factors" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0444_NIST2024 .

mitigation:A0445_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Context of Use Documentation"@en ;
    ak:description "Determine and document the expected and acceptable GAI system context of use in collaboration with socio-cultural and other domain experts, by assessing: Assumptions and limitations; Direct value to the organization; Intended operational environment and observed usage patterns; Potential positive and negative impacts to individuals, public safety, groups, communities, organizations, democratic institutions, and the physical environment; Social norms and expectations." ;
    ak:identifier "A0445_NIST2024" ;
    ak:name "Context of Use Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0445_NIST2024 .

mitigation:A0446_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Risk Measurement Planning"@en ;
    ak:description "Document risk measurement plans to address identified risks. Plans may include, as applicable: Individual and group cognitive biases (e.g., confirmation bias, funding bias, groupthink) for AI Actors involved in the design, implementation, and use of GAI systems; Known past GAI system incidents and failure modes; In-context use and foreseeable misuse, abuse, and off-label use; Over reliance on quantitative metrics and methodologies without sufficient awareness of their limitations in the context(s) of use; Standard measurement and structured human feedback approaches; Anticipated human-AI configurations." ;
    ak:identifier "A0446_NIST2024" ;
    ak:name "Risk Measurement Planning" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0446_NIST2024 .

mitigation:A0447_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Illegal Use Identification"@en ;
    ak:description "Identify and document foreseeable illegal uses or applications of the GAI system that surpass organizational risk tolerances." ;
    ak:identifier "A0447_NIST2024" ;
    ak:name "Illegal Use Identification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0447_NIST2024 .

mitigation:A0448_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Interdisciplinary Team Formation"@en ;
    ak:description "Establish and empower interdisciplinary teams that reflect a wide range of capabilities, competencies, demographic groups, domain expertise, educational backgrounds, lived experiences, professions, and skills across the enterprise to inform and conduct risk measurement and management functions." ;
    ak:identifier "A0448_NIST2024" ;
    ak:name "Interdisciplinary Team Formation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0448_NIST2024 .

mitigation:A0449_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Representative Data Verification"@en ;
    ak:description "Verify that data or benchmarks used in risk measurement, and users, participants, or subjects involved in structured GAI public feedback exercises are representative of diverse in-context user populations." ;
    ak:identifier "A0449_NIST2024" ;
    ak:name "Representative Data Verification" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0449_NIST2024 .

mitigation:A0450_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Origin Practices"@en ;
    ak:description "Establish known assumptions and practices for determining data origin and content lineage, for documentation and evaluation purposes." ;
    ak:identifier "A0450_NIST2024" ;
    ak:name "Data Origin Practices" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0450_NIST2024 .

mitigation:A0451_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Content Flow Testing"@en ;
    ak:description "Institute test and evaluation for data and content flows within the GAI system, including but not limited to, original data sources, data transformations, and decision-making criteria." ;
    ak:identifier "A0451_NIST2024" ;
    ak:mitigates risk:atlas-untraceable-attribution,
        risk:llm032025-supply-chain ;
    ak:name "Content Flow Testing" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0451_NIST2024 .

mitigation:A0452_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Upstream Dependency Documentation"@en ;
    ak:description "Identify and document how the system relies on upstream data sources, including for content provenance, and if it serves as an upstream dependency for other systems." ;
    ak:identifier "A0452_NIST2024" ;
    ak:name "Upstream Dependency Documentation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0452_NIST2024 .

mitigation:A0453_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "External Network Analysis"@en ;
    ak:description "Observe and analyze how the GAI system interacts with external networks, and identify any potential for negative externalities, particularly where content provenance might be compromised." ;
    ak:identifier "A0453_NIST2024" ;
    ak:name "External Network Analysis" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0453_NIST2024 .

mitigation:A0454_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Output Accuracy Assessment"@en ;
    ak:description "Assess the accuracy, quality, reliability, and authenticity of GAI output by comparing it to a set of known ground truth data and by using a variety of evaluation methods (e.g., human oversight and automated evaluation, proven cryptographic techniques, review of content inputs)." ;
    ak:identifier "A0454_NIST2024" ;
    ak:name "Output Accuracy Assessment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0454_NIST2024 .

mitigation:A0455_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Data Quality Review"@en ;
    ak:description "Review and document accuracy, representativeness, relevance, suitability of data used at different stages of AI life cycle." ;
    ak:identifier "A0455_NIST2024" ;
    ak:name "Data Quality Review" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0455_NIST2024 .

mitigation:A0456_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Fact-Checking Deployment"@en ;
    ak:description "Deploy and document fact-checking techniques to verify the accuracy and veracity of information generated by GAI systems, especially when the information comes from multiple (or unknown) sources." ;
    ak:identifier "A0456_NIST2024" ;
    ak:name "Fact-Checking Deployment" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0456_NIST2024 .

mitigation:A0457_NIST2024 a ak:TechnicalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Synthetic Content Detection"@en ;
    ak:description "Develop and implement testing techniques to identify GAI produced content (e.g., synthetic media) that might be indistinguishable from human-generated content." ;
    ak:identifier "A0457_NIST2024" ;
    ak:name "Synthetic Content Detection" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0457_NIST2024 .

mitigation:A0458_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Adversarial Testing Plans"@en ;
    ak:description "Implement plans for GAI systems to undergo regular adversarial testing to identify vulnerabilities and potential manipulation or misuse." ;
    ak:identifier "A0458_NIST2024" ;
    ak:name "Adversarial Testing Plans" ;
