        owl:NamedIndividual ;
    rdfs:label "Deepfake creation policy"@en ;
    ak:description "Can individuals use your firm’s AI systems to create deepfakes (i.e., synthetic audio or visual representations) of a specific individual?" ;
    ak:identifier "A0108_Future_of_Life_Institute2024" ;
    ak:name "Deepfake creation policy" ;
