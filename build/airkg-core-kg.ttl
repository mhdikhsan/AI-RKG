mitigation:A0462_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Proficiency Test Delineation"@en ;
    ak:description "Delineate human proficiency tests from tests of GAI capabilities." ;
    ak:identifier "A0462_NIST2024" ;
    ak:name "Proficiency Test Delineation" ;
