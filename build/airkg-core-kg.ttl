mitigation:A0466_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "IP Infringement Response"@en ;
    ak:description "Implement processes for responding to potential intellectual property infringement claims or other rights." ;
    ak:identifier "A0466_NIST2024" ;
    ak:name "IP Infringement Response" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0466_NIST2024 .

mitigation:A0467_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Governance Connection"@en ;
    ak:description "Connect new GAI policies, procedures, and processes to existing model, data, software development, and IT governance and to legal, compliance, and risk management activities." ;
    ak:identifier "A0467_NIST2024" ;
    ak:name "Governance Connection" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://airisk.mit.edu/> ;
    skos:exactMatch nexus:A0467_NIST2024 .

mitigation:A0468_NIST2024 a ak:OrganisationalMitigation,
        owl:NamedIndividual ;
    rdfs:label "Training Data Curation"@en ;
    ak:description "Document training data curation policies, to the extent possible and according to applicable laws and policies." ;
    ak:identifier "A0468_NIST2024" ;
    ak:mitigates risk:atlas-data-curation,
        risk:llm032025-supply-chain ;
    ak:name "Training Data Curation" ;
    ak:source "https://airisk.mit.edu/blog/mapping-ai-risk-mitigations"^^xsd:anyURI ;
