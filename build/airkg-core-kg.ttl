        owl:NamedIndividual ;
    rdfs:label "Watermarking"@en ;
    ak:description "Information regarding integrated watermarking systems." ;
    ak:identifier "A0161_Future_of_Life_Institute2024" ;
    ak:name "Watermarking" ;
    ak:source "https://futureoflife.org/document/fli-ai-safety-index-2024/"^^xsd:anyURI ;
