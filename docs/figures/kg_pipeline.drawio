          <mxGeometry x="445" y="295" width="155" height="200" as="geometry" />
        </mxCell>
        <mxCell id="gQA" value="Quality assurance &amp;amp; publication" style="rounded=1;arcSize=6;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=-2;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="-10" y="515" width="780" height="105" as="geometry" />
        </mxCell>
        <mxCell id="gOut" value="Outputs" style="rounded=1;arcSize=6;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=-2;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="-10" y="635" width="780" height="105" as="geometry" />
        </mxCell>

        <!-- ===== Sources ===== -->
        <mxCell id="sNexus" value="&lt;b&gt;IBM AI Atlas Nexus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;IBM Risk Atlas, OWASP LLM Top 10, MIT AI Risk Repository + controls, SSSOM crosswalks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="390" y="30" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sInc" value="&lt;b&gt;AIID + AVID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;AI incident snapshot, vulnerability records;&lt;br&gt;used only for risk-motif extraction&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="0" y="30" width="370" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Row 1: KG construction (left to right) ===== -->
        <mxCell id="pFetch" value="&lt;b&gt;1. acquire&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;pinned versions,&lt;br&gt;SHA-256 checksums&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="0" y="172" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pStage" value="&lt;b&gt;2. stage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;clean, sorted,&lt;br&gt;deterministic CSVs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="200" y="172" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pMap" value="&lt;b&gt;3. map&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;RML via Morph-KGC,&lt;br&gt;N-Triples per licence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="172" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pMerge" value="&lt;b&gt;4. merge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ontology + imported&lt;br&gt;+ accepted triples&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="172" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- ===== LLM-assisted extraction ===== -->
        <mxCell id="lMit" value="&lt;b&gt;llm_mitigation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;links from staged risks &amp;amp; controls&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="0" y="300" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="lMotif" value="&lt;b&gt;llm_motif&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;motifs from staged incidents&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
