        <mxCell id="lAccepted" value="&lt;b&gt;accepted&lt;br&gt;links &amp;amp; motifs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;(CSV)&lt;/span&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#e1d5e7;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="305" y="375" width="120" height="68" as="geometry" />
        </mxCell>

        <!-- ===== Ontology ===== -->
        <mxCell id="oCore" value="&lt;b&gt;airkg.ttl +&lt;br&gt;contexts.ttl&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="325" width="125" height="55" as="geometry" />
