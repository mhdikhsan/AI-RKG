        <mxCell id="lMap" value="&lt;b&gt;Mitigation–risk&lt;br&gt;mapping table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;LLM-generated CSV&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
