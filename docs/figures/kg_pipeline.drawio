<mxfile host="drawio" version="24.7.17">
  <diagram id="kg-pipeline" name="KG construction pipeline">
    <mxGraphModel dx="800" dy="800" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="790" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Group frames (behind) ===== -->
        <mxCell id="gSources" value="Sources (pinned versions)" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=-2;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="-10" y="0" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gBuild" value="KG construction" style="rounded=1;arcSize=6;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=right;spacingRight=8;spacingTop=-2;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="-10" y="145" width="780" height="105" as="geometry" />
        </mxCell>
        <mxCell id="gLLM" value="LLM-assisted extraction (human in the loop)" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=-2;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="-10" y="270" width="445" height="225" as="geometry" />
