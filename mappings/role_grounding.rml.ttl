# Hand-written grounding links of roles to external vocabularies (rdfs:seeAlso / skos:*Match)
# Input: staging/role_grounding.csv (validated by scripts/roles.py from sources/manual/role_grounding.csv).
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@base <http://example.org/airkg/mapping/role_grounding#> .

<#Grounding>
  rml:logicalSource [ rml:source "staging/role_grounding.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rml:reference "role_iri" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [
    rr:predicateMap [ rml:reference "predicate_iri" ] ;
    rr:objectMap    [ rml:reference "target_iri" ; rr:termType rr:IRI ]
  ] .
