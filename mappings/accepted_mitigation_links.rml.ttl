@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix ak:   <http://example.org/airkg#> .
@base <http://example.org/airkg/mapping/accepted_mitigation_links#> .

<#AcceptedLink>
  rml:logicalSource [ rml:source "staging/accepted_mitigation_links.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rml:reference "mitigation_iri" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate ak:mitigates ; rr:objectMap [ rml:reference "risk_iri" ; rr:termType rr:IRI ] ] .
