@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix ak:   <http://example.org/airkg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.org/airkg/mapping/risks#> .

<#Risk>
  rml:logicalSource [ rml:source "staging/risks.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rml:reference "iri" ; rr:termType rr:IRI ; rr:class ak:Risk, owl:NamedIndividual ] ;
  rr:predicateObjectMap
    [ rr:predicate ak:name ;        rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ,
    [ rr:predicate rdfs:label ;     rr:objectMap [ rml:reference "name" ; rr:language "en" ] ] ,
    [ rr:predicate ak:identifier ;  rr:objectMap [ rml:reference "catalogue_identifier" ; rr:datatype xsd:string ] ] ,
    [ rr:predicate ak:source ;      rr:objectMap [ rml:reference "source_url" ; rr:datatype xsd:anyURI ] ] ,
   
    # empty when copy_descriptions is false for the catalogue (no triple)
    
    [ rr:predicate ak:description ; rr:objectMap [ rml:reference "description" ; rr:datatype xsd:string ] ] ,
    [ rr:predicate skos:exactMatch ; rr:objectMap [ rml:reference "nexus_iri" ; rr:termType rr:IRI ] ] ,
    [ rr:predicate dct:license ;    rr:objectMap [ rml:reference "license" ; rr:termType rr:IRI ] ] ,
    [ rr:predicate dct:source ;     rr:objectMap [ rml:reference "catalogue_url" ; rr:termType rr:IRI ] ] .
