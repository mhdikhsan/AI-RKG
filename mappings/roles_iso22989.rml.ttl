# ISO/IEC 22989:2022 stakeholder roles -> ak:StakeholderRole
# Input: staging/stakeholder_roles.csv (from sources/manual/iso22989_roles.csv, scripts/roles.py).
# ak:source = the standard's URL; ak:identifier = clause number.
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix ak:   <http://example.org/airkg#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.org/airkg/mapping/roles_iso22989#> .

<#IsoRole>
  rml:logicalSource [ rml:source "staging/stakeholder_roles.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rml:reference "iri" ; rr:termType rr:IRI ; rr:class ak:StakeholderRole, owl:NamedIndividual ] ;
  rr:predicateObjectMap
    [ rr:predicate ak:name ;       rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ,
    [ rr:predicate rdfs:label ;    rr:objectMap [ rml:reference "name" ; rr:language "en" ] ] ,
    [ rr:predicate ak:identifier ; rr:objectMap [ rml:reference "clause" ; rr:datatype xsd:string ] ] ,
    [ rr:predicate ak:source ;     rr:objectMap [ rml:reference "source" ; rr:datatype xsd:anyURI ] ] ,
    [ rr:predicate ak:specialises ; rr:objectMap [ rml:reference "parent_iri" ; rr:termType rr:IRI ] ] .
