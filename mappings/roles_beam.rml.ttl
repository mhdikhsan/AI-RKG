# BEAM process classes reused as component roles -> ak:ComponentRole
# Input: staging/component_roles_beam.csv (written by scripts/roles.py).
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix ak:   <http://example.org/airkg#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.org/airkg/mapping/roles_beam#> .

<#BeamRole>
  rml:logicalSource [ rml:source "staging/component_roles_beam.csv" ; rml:referenceFormulation ql:CSV ] ;
  rr:subjectMap [ rml:reference "iri" ; rr:termType rr:IRI ; rr:class ak:ComponentRole, owl:NamedIndividual ] ;
  rr:predicateObjectMap
    [ rr:predicate ak:name ;      rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ,
    [ rr:predicate rdfs:label ;   rr:objectMap [ rml:reference "name" ; rr:language "en" ] ] ,
    [ rr:predicate rdfs:seeAlso ; rr:objectMap [ rml:reference "beam_iri" ; rr:termType rr:IRI ] ] ,
    # empty for core roles -> no triple
    [ rr:predicate ak:specialises ; rr:objectMap [ rml:reference "parent_iri" ; rr:termType rr:IRI ] ] .
