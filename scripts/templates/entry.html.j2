{% extends "_base.html.j2" %}
{% block title %}{{ e.title }}{% endblock %}
{% block body %}
<div>{% for t in e.types %}<span class="chip">{{ t }}</span>{% endfor %}<span class="chip">{{ e.origin }}</span></div>
<h1>{{ e.title }}</h1>
<div class="iri">{{ e.iri }}</div>
<p class="note"><a href="{{ e.ttl_name }}">Turtle</a></p>
{% if e.description %}<p>{{ e.description }}</p>{% endif %}

<h2>Properties</h2>
<table>
{% for p in e.props %}
  <tr><td class="p">{{ p.label }}</td><td>
  {% for v in p['values'] %}{% if v.href %}<a href="{{ v.href }}">{{ v.text }}</a>{% else %}{{ v.text }}{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}
  </td></tr>
{% endfor %}
</table>

{% if e.incoming %}
<h2>Referenced by</h2>
<table>
{% for p in e.incoming %}
  <tr><td class="p">{{ p.label }}</td><td>
  {% for v in p['values'] %}{% if v.href %}<a href="{{ v.href }}">{{ v.text }}</a>{% else %}{{ v.text }}{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}
  </td></tr>
{% endfor %}
</table>
{% endif %}

<footer>
{% if e.attribution %}{{ e.attribution }} Licence: <a href="{{ e.license }}">{{ e.license }}</a>.{% else %}Authored in the AI-RKG core module (<code>ontology/airkg-core.ttl</code>).{% endif %}
{% if e.candidate_note %}<br><span class="warn">{{ e.candidate_note }}</span>{% endif %}
</footer>
{% endblock %}
