<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} – AI-RKG core</title>
<style>
  :root { --bg:#ffffff; --fg:#1d2330; --muted:#5d6675; --line:#e2e5ea; --accent:#2457c5; --chip:#eef2f8; --warn:#8a5a00; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#14171c; --fg:#e4e7ec; --muted:#9aa3b0; --line:#2b313a; --accent:#7ea6ff; --chip:#1f252e; --warn:#e0b25a; }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif; }
  main { max-width: 980px; margin: 0 auto; padding: 24px 16px 48px; }
  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
  header.top { border-bottom:1px solid var(--line); padding:10px 16px; font-size:13px; color:var(--muted); }
  header.top a { margin-right: 14px; }
  h1 { font-size: 24px; margin: 8px 0 4px; } h2 { font-size: 17px; margin: 28px 0 8px; }
  .iri { font-family: ui-monospace, Consolas, monospace; font-size: 13px; color: var(--muted); word-break: break-all; }
  .chip { display:inline-block; background:var(--chip); border:1px solid var(--line); border-radius: 999px;
          padding: 1px 9px; font-size: 12px; margin: 2px 4px 2px 0; }
  table { width:100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align:left; vertical-align: top; padding: 6px 8px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; white-space: nowrap; }
  td.p { width: 210px; font-family: ui-monospace, Consolas, monospace; font-size: 12.5px; color: var(--muted); }
  .note { font-size: 13px; color: var(--muted); }
  .warn { color: var(--warn); }
  input[type=search] { width:100%; padding:8px 10px; font:inherit; color:var(--fg); background:var(--bg);
          border:1px solid var(--line); border-radius:6px; margin: 8px 0; }
  footer { margin-top: 36px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  @media (max-width: 640px) { td.p { width: auto; } table { font-size: 13px; } }
</style>
</head>
<body>
<header class="top"><a href="{{ root }}index.html">AI-RKG core – index</a><span>{{ provenance }}</span></header>
<main>
{% block body %}{% endblock %}
</main>
</body>
</html>
